Protection_StackMonitoring_005_0003:
  property:
    need_stack_share: true
    sc: 
      - SC1
      - SC2

  pre_condition:
    PROTECTION_HOOK1:
      type: PROTECTION_HOOK
      hookstat: AK_STOP
    SHUTDOWN_HOOK1:
      type: SHUTDOWN_HOOK
      hookstat: AK_STOP
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
    C2ISR1:
      type: C2ISR
      intno: INTNO_SELF_C2ISR_MID_A
      iniintpri: INT_PRI_MID
      rtnstat: AK_STOP

  do_0:
    id: TASK1
    syssrv: aktg_stack[1][0] = 0;
    gcov: true

  post_condition_0:

  do_1:
    id: TASK1
    syssrv: AktspRaiseInterrupt(INTNO_SELF_C2ISR_MID_A)

  post_condition_1:
    PROTECTION_HOOK1:
      hookstat: AK_ACTIVATE

  do_2:
    id: PROTECTION_HOOK1
    syssrv: CheckAssert(FatalError == E_OS_STACKFAULT)

  post_condition_2:

  do_3:
    id: PROTECTION_HOOK1
    syssrv: return(PRO_SHUTDOWN)

  post_condition_3:
    PROTECTION_HOOK1:
      hookstat: AK_STOP
    SHUTDOWN_HOOK1:
      hookstat: AK_ACTIVATE

  do_4:
    id: SHUTDOWN_HOOK1
    syssrv: CheckAssert(Error == E_OS_STACKFAULT)

  post_condition_4:
