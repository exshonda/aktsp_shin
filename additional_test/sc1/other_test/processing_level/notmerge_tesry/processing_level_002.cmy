######################################################################
# processing_level_002_0001.yaml
######################################################################
processing_level_002_0001:
  property:
    sc: 
      - SC1
      - SC2

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
    ERROR_HOOK1:
      type: ERROR_HOOK
      hookstat: AK_ACTIVATE
    C1ISR1:
      type: C1ISR
      intno: INTNO_SELF_C1ISR_MID
      iniintpri: INT_PRI_ISR1_MID
      rtnstat: AK_STOP

  do:
    id: ERROR_HOOK1
    syssrv: AktspRaiseInterrupt(INTNO_SELF_C1ISR_MID)
    gcov: true

  post_condition:
    ERROR_HOOK1:
      hookstat: AK_STOP
    C1ISR1:
      rtnstat: AK_ACTIVATE
