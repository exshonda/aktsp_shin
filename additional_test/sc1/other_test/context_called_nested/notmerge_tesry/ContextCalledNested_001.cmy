######################################################################
# ContextCalledNested_001_0006.yaml
######################################################################
ContextCalledNested_001_0006:
  property:
    sc: 
      - SC1

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      spolicy: AK_SCHFULL
      inipri: TSK_PRI_MID
    ALARM_CBACK1:
      type: ALARM_CBACK
      cbstat: AK_STOP
    ALARM1:
      type: ALARM
      almact: AK_ALM_CBACK
      counter: COUNTER1
      astat: AK_SET
      almval: ANY_ALMVAL_A
      cycle: 0
      callback: ALARM_CBACK1
    COUNTER1:
      type: COUNTER
      mincyc: ANY_MINCYC_A
      maxval: ANY_MAXVAL_A
      curval: ANY_ALMVAL_A-1
      ctype: AK_SOFTWARE
      cstat: AK_CS_NULL
    ERROR_HOOK1:
      type: ERROR_HOOK
      hookstat: AK_STOP
      target_error_hook_cfg:
        - AK_SC1_SINGLE
    PROTECTION_HOOK1:
      type: PROTECTION_HOOK
      hookstat: AK_STOP
      var:
        vname1:
          type: TaskType
          global: true

  do_0:
    id: TASK1
    syssrv: IncrementCounter(COUNTER1)
    rettype: StatusType
    retval: E_OK
    gcov: false

  post_condition_0:
    COUNTER1:
      curval: ANY_ALMVAL_A
      cstat: AK_CS_DOING
    ALARM1:
      astat: AK_UNSET
    ALARM_CBACK1:
      cbstat: AK_ACTIVATE

  do_1:
    id: ALARM_CBACK1
    syssrv: ActivateTask(TASK1)
    rettype: StatusType
    retval: E_OS_CALLEVEL
    gcov: false

  post_condition_1:
    ALARM_CBACK1:
      cbstat: AK_STOP
    ERROR_HOOK1:
      hookstat: AK_ACTIVATE

  do_2:
    id: ERROR_HOOK1
    syssrv: AktspRaiseCPUException()
    gcov: false

  post_condition_2:
    ERROR_HOOK1:
      hookstat: AK_STOP
    PROTECTION_HOOK1:
      hookstat: AK_ACTIVATE

  do_3:
    id: PROTECTION_HOOK1
    syssrv: GetTaskID(&vname1)
    rettype: StatusType
    retval: E_OS_CALLEVEL
    gcov: true

  post_condition_3:
