######################################################################
# ContextCalledNested_001_0001.yaml
######################################################################
ContextCalledNested_001_0001:
  property:
    sc: 
      - SC1

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      spolicy: AK_SCHFULL
      curpri: TSK_PRI_MID
    ERROR_HOOK1:
      type: ERROR_HOOK
      hookstat: AK_STOP
      target_error_hook_cfg:
        - AK_SC1_SINGLE
    SHUTDOWN_HOOK1:
      type: SHUTDOWN_HOOK
      hookstat:  AK_STOP
      var:
        vname1:
          type: TaskType
          global: true

  do_0:
    id: TASK1
    syssrv: ActivateTask(INVALID_TSK_ID)
    rettype: StatusType
    retval: E_OS_ID
    gcov: false

  post_condition_0:
    ERROR_HOOK1:
      hookstat: AK_ACTIVATE

  do_1:
    id: ERROR_HOOK1
    syssrv: ShutdownOS(E_OK)
    gcov: false

  post_condition_1:
    SHUTDOWN_HOOK1:
      hookstat: AK_ACTIVATE
    ERROR_HOOK1:
      hookstat: AK_STOP

  do_2:
    id: SHUTDOWN_HOOK1
    syssrv: GetTaskID(&vname1)
    rettype: StatusType
    retval: E_OS_CALLEVEL
    gcov: true

  post_condition_2:
######################################################################
# ContextCalledNested_001_0002.yaml
######################################################################
ContextCalledNested_001_0002:
  property:
    sc: 
      - SC1

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      spolicy: AK_SCHFULL
      inipri: TSK_PRI_MID
    TASK2:
      type: TASK
      tstat: SUSPENDED
      spolicy: AK_SCHFULL
      inipri: TSK_PRI_HIGH
    PRETASK_HOOK1:
      type: PRETASK_HOOK
      hookstat: AK_STOP
    ERROR_HOOK1:
      type: ERROR_HOOK
      hookstat: AK_STOP
      target_error_hook_cfg:
        - AK_SC1_SINGLE
    SHUTDOWN_HOOK1:
