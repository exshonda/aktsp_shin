    rettype: StatusType
    retval: E_OK
    gcov: false

  post_condition_0:
    PRETASK_HOOK1:
      hookstat: AK_ACTIVATE
    TASK1:
      tstat: READY
    TASK2:
      tstat: RUNNING
      curpri: TSK_PRI_HIGH
      actcnt: 1
      
  do_1:
    id: PRETASK_HOOK1
    syssrv: ActivateTask(TASK1)
    rettype: StatusType
    retval: E_OS_CALLEVEL
    gcov: false

  post_condition_1:
    PRETASK_HOOK1:
      hookstat: AK_STOP
    ERROR_HOOK1:
      hookstat: AK_ACTIVATE

  do_2:
    id: ERROR_HOOK1
