      hookstat: AK_ACTIVATE
    ERROR_HOOK1:
      hookstat: AK_STOP

  do_3:
    id: SHUTDOWN_HOOK1
    syssrv: GetTaskID(&vname1)
    rettype: StatusType
    retval: E_OS_CALLEVEL
    gcov: true

  post_condition_3:
