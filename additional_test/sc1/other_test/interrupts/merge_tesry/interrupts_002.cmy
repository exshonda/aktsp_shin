######################################################################
# interrupts_002_0001.yaml
######################################################################
interrupts_002_0001:
  property:
    sc: 
      - SC1

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
    C2ISR1:
      type: C2ISR
      intno: INTNO_SELF_C2ISR_MID_A
      iniintpri: INT_PRI_MID
      rtnstat: AK_STOP
    C2ISR2:
      type: C2ISR
      intno: INTNO_SELF_C2ISR_HIGH
      iniintpri: INT_PRI_HIGH
      rtnstat: AK_STOP

  do_0:
    id: TASK1
    syssrv: AktspRaiseInterrupt(INTNO_SELF_C2ISR_MID_A)

  post_condition_0:
    TASK1:
      tstat: RUNNING
    C2ISR1:
      rtnstat: AK_ACTIVATE

  do_1:
    id: C2ISR1
    syssrv: AktspRaiseInterrupt(INTNO_SELF_C2ISR_HIGH)

  post_condition_1:
    C2ISR1:
      rtnstat: AK_STOP
    C2ISR2:
      rtnstat: AK_ACTIVATE
######################################################################
# interrupts_002_0002.yaml
######################################################################
interrupts_002_0002:
  property:
    sc: 
      - SC1

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
    C1ISR1:
      type: C1ISR
      intno: INTNO_SELF_C1ISR_MID
      iniintpri: INT_PRI_ISR1_MID
      rtnstat: AK_STOP
    C1ISR2:
      type: C1ISR
      intno: INTNO_SELF_C1ISR_HIGH
      iniintpri: INT_PRI_ISR1_HIGH
      rtnstat: AK_STOP

  do_0:
    id: TASK1
    syssrv: AktspRaiseInterrupt(INTNO_SELF_C1ISR_MID)

  post_condition_0:
    TASK1:
      tstat: RUNNING
    C1ISR1:
      rtnstat: AK_ACTIVATE

  do_1:
    id: C1ISR1
    syssrv: AktspRaiseInterrupt(INTNO_SELF_C1ISR_HIGH)

  post_condition_1:
    C1ISR1:
      rtnstat: AK_STOP
    C1ISR2:
      rtnstat: AK_ACTIVATE
######################################################################
