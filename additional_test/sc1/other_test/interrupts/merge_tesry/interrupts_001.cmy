######################################################################
# interrupts_001_0001.yaml
######################################################################
interrupts_001_0001:
  property:
    sc: 
      - SC1

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      spolicy: AK_SCHFULL
    C2ISR1:
      type: C2ISR
      intno: INTNO_SELF_C2ISR_MID_A
      iniintpri: INT_PRI_MID
      rtnstat: AK_STOP

  do:
    id: TASK1
    syssrv: AktspRaiseInterrupt(INTNO_SELF_C2ISR_MID_A)
    gcov: true

  post_condition:
    TASK1:
      tstat: RUNNING
    C2ISR1:
      rtnstat: AK_ACTIVATE
######################################################################
# interrupts_001_0002.yaml
######################################################################
interrupts_001_0002:
  property:
    sc: 
      - SC1

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      spolicy: AK_SCHNON
    C2ISR1:
      type: C2ISR
      intno: INTNO_SELF_C2ISR_MID_A
      iniintpri: INT_PRI_MID
      rtnstat: AK_STOP

  do:
    id: TASK1
    syssrv: AktspRaiseInterrupt(INTNO_SELF_C2ISR_MID_A)
    gcov: true

  post_condition:
    TASK1:
      tstat: RUNNING
    C2ISR1:
      rtnstat: AK_ACTIVATE
######################################################################
