######################################################################
# FatalError_0005.yaml
######################################################################
FatalError_0005:
  property:
    sc: 
      - SC1
      - SC2

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      inipri: TSK_PRI_MID
      curpri: TSK_PRI_MID
      spolicy: AK_SCHFULL
      ttype: AK_BASIC
    TASK2:
      type: TASK
      tstat: READY
      curpri: TSK_PRI_LOW
      spolicy: AK_SCHFULL
      ttype: AK_BASIC
    INT_STATE1:
      type: INT_STATE
      istat:
        - AK_SUS_ALL_INT: TASK1

  do:
    id: TASK1
    syssrv: return
    gcov: false

  post_condition:
    TASK1:
      tstat: SUSPENDED
    TASK2:
      tstat: RUNNING
    INT_STATE1:
      istat:

######################################################################
