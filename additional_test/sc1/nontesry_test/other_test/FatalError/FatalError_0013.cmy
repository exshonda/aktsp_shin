######################################################################
# FatalError_0013.yaml
######################################################################
FatalError_0013:
  property:
    sc: 
      - SC1
      - SC2

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      inipri: TSK_PRI_MID
      curpri: TSK_PRI_MID
      spolicy: ANY_SPOLICY
    C2ISR1:
      type: C2ISR
      intno: INTNO_SELF_C2ISR_MID_A
      iniintpri: INT_PRI_MID
      rtnstat: AK_ACTIVATE
    C2ISR2:
      type: C2ISR
      intno: INTNO_SELF_C2ISR_MID_B
      iniintpri: INT_PRI_MID
      rtnstat: AK_STOP
      relres:
        - RESOURCE1
    RESOURCE1:
      type: RESOURCE
      resprop: AK_STANDARD
      lockflg: AK_UNLOCK

  do:
    id: C2ISR1
    syssrv: GetResource(RESOURCE1)
    rettype: StatusType
    retval: E_OK

  post_condition:
    C2ISR1:
      getres:
        - RESOURCE1
    RESOURCE1:
      lockflg: AK_LOCK
######################################################################
