######################################################################
# ActivateTask_N_007_0001.yaml
######################################################################
ActivateTask_N_007_0001:
  property:
    sc: 
      - SC1
      - SC2

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      inipri: TSK_PRI_MID
      ttype: AK_BASIC
      actcnt: 1
      spolicy: AK_SCHFULL
      maxact: ANY_BASIC_MAXACT
    TASK2:
      type: TASK
      tstat: SUSPENDED
      inipri: TSK_PRI_HIGH
      ttype: AK_BASIC
      spolicy: AK_SCHFULL
      maxact: ANY_BASIC_MAXACT
    PRETASK_HOOK1:
      type: PRETASK_HOOK
      hookstat: AK_STOP

  do_0:
    id: TASK1
    syssrv: ActivateTask(TASK2)
    rettype: StatusType
    retval: E_OK
    gcov: true

  post_condition_0:
    TASK1:
      tstat: READY
    TASK2:
      tstat: RUNNING
      curpri: TSK_PRI_HIGH
      actcnt: 1
    PRETASK_HOOK1:
      hookstat: AK_ACTIVATE

  do_1:
    id: PRETASK_HOOK1
    syssrv: return
    gcov: false

  post_condition_1:
    TASK1:
      tstat: READY
    TASK2:
      tstat: RUNNING
    PRETASK_HOOK1:
      hookstat: AK_STOP
######################################################################
