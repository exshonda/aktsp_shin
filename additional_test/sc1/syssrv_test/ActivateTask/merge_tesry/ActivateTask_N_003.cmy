######################################################################
# ActivateTask_N_003_0001.yaml
######################################################################
ActivateTask_N_003_0001:
  property:
    sc: 
      - SC1
      - SC2

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      inipri: TSK_PRI_MID
      curpri: TSK_PRI_MID
      ttype: AK_BASIC
      spolicy: AK_SCHNON
    TASK2:
      type: TASK
      tstat: READY
      spolicy: AK_SCHNON
      inipri: TSK_PRI_MID
      curpri: TSK_PRI_MID
      actcnt: 1
      maxact: 2
      ttype: AK_BASIC

  do:
    id: TASK1
    syssrv: ActivateTask(TASK2)
    rettype: StatusType
    retval: E_OK

  post_condition:
    TASK1:
      tstat: RUNNING
    TASK2:
      tstat: READY
      actcnt: 2
