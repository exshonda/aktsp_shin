######################################################################
# ActivateTask_N_002_0001.yaml
######################################################################
ActivateTask_N_002_0001:
  property:
    sc: 
      - SC1
      - SC2

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      inipri: TSK_PRI_MID
      curpri: TSK_PRI_MID
      ttype: AK_BASIC
      spolicy: AK_SCHFULL
    TASK2:
      type: TASK
      tstat: SUSPENDED
      inipri: TSK_PRI_HIGH
      maxact: 1
      ttype: AK_BASIC
      spolicy: AK_SCHFULL
    C2ISR1:
      type: C2ISR
      intno: INTNO_SELF_C2ISR_MID_A
      iniintpri: INT_PRI_MID
      rtnstat: AK_STOP
    C2ISR2:
      type: C2ISR
      intno: INTNO_SELF_C2ISR_LOW
      iniintpri: INT_PRI_LOW
      rtnstat: AK_ACTIVATE

  do_0:
    id: C2ISR2
    syssrv: AktspRaiseInterrupt(INTNO_SELF_C2ISR_MID_A)
    gcov: false

  post_condition_0:
    C2ISR1:
      rtnstat: AK_ACTIVATE
    C2ISR2:
      rtnstat: AK_STOP

  do_1:
    id: C2ISR1
    syssrv: ActivateTask(TASK2)
    rettype: StatusType
    retval: E_OK
    gcov: true

  post_condition_1:
    TASK1:
      tstat: RUNNING
    TASK2:
      tstat: READY
      curpri: TSK_PRI_HIGH
      actcnt: 1
    C2ISR1:
      rtnstat: AK_ACTIVATE
    C2ISR2:
      rtnstat: AK_STOP

  do_2:
    id: C2ISR1
    syssrv: return
    gcov: false

  post_condition_2:
    TASK1:
      tstat: RUNNING
    TASK2:
      tstat: READY
    C2ISR1:
      rtnstat: AK_STOP
    C2ISR2:
      rtnstat: AK_ACTIVATE

  do_3:
    id: C2ISR2
    syssrv: return
    gcov: false

  post_condition_3:
    TASK1:
      tstat: READY
    TASK2:
      tstat: RUNNING
    C2ISR2:
      rtnstat: AK_STOP
