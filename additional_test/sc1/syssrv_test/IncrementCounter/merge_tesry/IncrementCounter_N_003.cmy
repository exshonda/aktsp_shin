######################################################################
# IncrementCounter_N_003_0001.yaml
######################################################################
IncrementCounter_N_003_0001:
  property:
    sc: 
      - SC1
      - SC2

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      inipri: TSK_PRI_LOW
      curpri: TSK_PRI_LOW
      ttype: AK_BASIC
      spolicy: AK_SCHFULL
    TASK2:
      type: TASK
      tstat: SUSPENDED
      inipri: TSK_PRI_HIGH
      ttype: AK_BASIC
      spolicy: AK_SCHFULL
    TASK3:
      type: TASK
      tstat: SUSPENDED
      inipri: TSK_PRI_MID
      ttype: AK_BASIC
      spolicy: AK_SCHFULL
    ALARM1:
      type: ALARM
      almact: AK_ALM_ATSK
      counter: COUNTER1
      astat: AK_SET
      almval: ANY_SCDLTBL_INIT_OFFSET_A-1
      cycle: 0
      task: TASK2
    ALARM2:
      type: ALARM
      almact: AK_ALM_ATSK
      counter: COUNTER1
      astat: AK_SET
      almval: ANY_SCDLTBL_INIT_OFFSET_A-1
      cycle: 0
      task: TASK3
    COUNTER1:
      type:  COUNTER
      ctype: AK_SOFTWARE
      mincyc: ANY_MINCYC_A
      maxval: ANY_MAXVAL_A
      curval: 1
      cstat: AK_CS_NULL

  do_0:
    id: TASK1
    syssrv: IncrementCounter(COUNTER1)
    rettype: StatusType
    retval: E_OK
    gcov: true

  post_condition_0:
    COUNTER1:
      curval: 2
      cstat: AK_CS_DOING
    ALARM1:
      astat: AK_UNSET
    ALARM2:
      astat: AK_SET
    TASK1:
      tstat: READY
    TASK2:
      tstat: RUNNING
      actcnt: 1
      curpri: TSK_PRI_HIGH
    TASK3:
      tstat: SUSPENDED

  do_1:
    id: TASK2
    syssrv: TerminateTask()
    gcov: false

  post_condition_1:
    COUNTER1:
      curval: 2
      cstat: AK_CS_DOING
    ALARM1:
      astat: AK_UNSET
    ALARM2:
      astat: AK_UNSET
    TASK1:
      tstat: READY
    TASK2:
      tstat: SUSPENDED
    TASK3:
      tstat: RUNNING
      actcnt: 1
      curpri: TSK_PRI_MID
