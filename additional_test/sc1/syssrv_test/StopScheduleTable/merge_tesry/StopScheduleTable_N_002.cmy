    syssrv: StopScheduleTable(SCHEDULE_TABLE1)
    rettype: StatusType
    retval: E_OK
    gcov: true

  post_condition_0:
    SCHEDULE_TABLE1:
      ststat: SCHEDULETABLE_STOPPED

  do_1:
    id: TASK1
    syssrv: StartScheduleTableAbs(SCHEDULE_TABLE1,0)
