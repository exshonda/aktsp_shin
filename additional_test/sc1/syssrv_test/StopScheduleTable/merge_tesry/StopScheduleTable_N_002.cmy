    syssrv: IncrementCounter(COUNTER1)
    repeat: (ANY_MAXVAL_A+1)-((5+7)/2)
    rettype: StatusType
    retval: E_OK
    gcov: false

  post_condition_3:
    COUNTER1:
      curval: 0
    SCHEDULE_TABLE1:
      ststat: SCHEDULETABLE_RUNNING
      curval: 0

  do_4:
    id: TASK1
    syssrv: IncrementCounter(COUNTER1)
    rettype: StatusType
    retval: E_OK
    gcov: false

  post_condition_4:
    COUNTER1:
      curval: 1
    SCHEDULE_TABLE1:
      ststat: SCHEDULETABLE_RUNNING
      curval: 1

  do_5:
    id: TASK1
    syssrv: IncrementCounter(COUNTER1)
    rettype: StatusType
    retval: E_OK
    gcov: false

  post_condition_5:
    COUNTER1:
      curval: 2
    SCHEDULE_TABLE1:
      ststat: SCHEDULETABLE_RUNNING
      curval: 2

  do_6:
    id: TASK1
    syssrv: IncrementCounter(COUNTER1)
    rettype: StatusType
    retval: E_OK
    gcov: false

  post_condition_6:
    COUNTER1:
      curval: ANY_SCDLTBL_INIT_OFFSET_A
    SCHEDULE_TABLE1:
      ststat: SCHEDULETABLE_RUNNING
      curval: ANY_SCDLTBL_INIT_OFFSET_A
    TASK1:
      tstat: RUNNING
      actcnt: 1
    TASK2:
      tstat: READY
      actcnt: 2
    TASK3:
      tstat: READY
      actcnt: 1
    TASK4:
      tstat: SUSPENDED
######################################################################
