      inipri: TSK_PRI_MID
      ttype: AK_BASIC
      maxact: 3
    COUNTER1:
      type: COUNTER
      ctype: AK_SOFTWARE
      mincyc: ANY_MINCYC_A
      maxval: ANY_MAXVAL_A
      cstat: AK_CS_NULL
      curval: ANY_SCDLTBL_INIT_OFFSET_A-1
    SCHEDULE_TABLE1:
      type: SCHEDULE_TABLE
      counter: COUNTER1
      syncstrategy: AK_IMPLICIT
      repeat: AK_FALSE
      ststat: SCHEDULETABLE_RUNNING_AND_SYNCHRONOUS
      curval: ANY_SCDLTBL_INIT_OFFSET_A-1
      duration: ANY_MAXVAL_A+1
