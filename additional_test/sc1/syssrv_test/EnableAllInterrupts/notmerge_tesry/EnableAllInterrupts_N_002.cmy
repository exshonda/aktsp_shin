######################################################################
# EnableAllInterrupts_N_002_0001.yaml
######################################################################
EnableAllInterrupts_N_002_0001:
  property:
    sc: 
      - SC1

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
    ALARM_CBACK1:
      type: ALARM_CBACK
      cbstat: AK_STOP
    ALARM1:
      type: ALARM
      almact: AK_ALM_CBACK
      counter: COUNTER1
      astat: AK_SET
      almval: 1
      cycle: 0
      callback: ALARM_CBACK1
    COUNTER1:
      type: COUNTER
      ctype: AK_SOFTWARE
      mincyc: ANY_MINCYC_A
      maxval: ANY_MAXVAL_A
      curval: 0
      cstat: AK_CS_NULL
    INT_STATE1:
      type: INT_STATE
      istat:
    ERROR_HOOK1:
      type: ERROR_HOOK
      hookstat: AK_STOP

  do_0:
    id: TASK1
    syssrv: IncrementCounter(COUNTER1)
    rettype: StatusType
    retval: E_OK
    gcov: false

  post_condition_0:
    COUNTER1:
      curval: 1
      cstat: AK_CS_DOING
    ALARM1:
      astat: AK_UNSET
    ALARM_CBACK1:
      cbstat: AK_ACTIVATE

  do_1:
    id: ALARM_CBACK1
    syssrv: DisableAllInterrupts()
    gcov: false

  post_condition_1:
    ALARM_CBACK1:
      cbstat: AK_ACTIVATE
    INT_STATE1:
      istat:
        - AK_DIS_ALL_INT: ALARM_CBACK1
    ERROR_HOOK1:
      hookstat: AK_STOP

  do_2:
    id: ALARM_CBACK1
    syssrv: ActivateTask(TASK1)
    rettype: StatusType
    retval: E_OS_DISABLEDINT
    gcov: false

  post_condition_2:
    ALARM_CBACK1:
      cbstat: AK_STOP
    INT_STATE1:
      istat:
        - AK_DIS_ALL_INT: ALARM_CBACK1
    ERROR_HOOK1:
      hookstat: AK_ACTIVATE

  do_3:
    id: ERROR_HOOK1
    syssrv: EnableAllInterrupts()
    gcov: true

  post_condition_3:
    ALARM_CBACK1:
      cbstat: AK_STOP
    INT_STATE1:
      istat:
    ERROR_HOOK1:
      hookstat: AK_ACTIVATE
