  do_3:
    id: ERROR_HOOK1
    syssrv: return
    gcov: false

  post_condition_3:
    ERROR_HOOK1:
      hookstat: AK_STOP
    POSTTASK_HOOK1:
      hookstat: AK_ACTIVATE
