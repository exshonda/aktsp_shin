    ERROR_HOOK1:
      type: ERROR_HOOK
      hookstat: AK_STOP
      target_error_hook_cfg:
        - AK_SC1_SINGLE
    INT_STATE1:
      type: INT_STATE
      istat:
        - AK_DIS_ALL_INT: C2ISR1

  do_0:
    id: C2ISR1
    syssrv: ResumeAllInterrupts()
    gcov: true

  post_condition_0:
    INT_STATE1:
      istat:
        - AK_DIS_ALL_INT: C2ISR1
    C2ISR1:
