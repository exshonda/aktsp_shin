######################################################################
# EnableInterruptSource_E_003_0001.yaml
######################################################################
EnableInterruptSource_E_003_0001:
  property:
    sc: 
      - SC1
    need_enadis_interrupt_source: true

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
    C1ISR1:
      type: C1ISR
      intno: INTNO_SELF_C1ISR_MID
      iniintpri: INT_PRI_ISR1_MID
      rtnstat: AK_ACTIVATE
    ERROR_HOOK1:
      type: ERROR_HOOK
      hookstat: AK_STOP
      target_error_hook_cfg:
        - AK_ONLY_SYSTEM

  do:
    id: C1ISR1
    syssrv: EnableInterruptSource(C1ISR1)
    rettype: StatusType
    retval: E_OS_CALLEVEL
    gcov: true

  post_condition:
    C1ISR1:
      rtnstat: AK_ACTIVATE
      target_error_hook_cfg:
        - AK_ONLY_SYSTEM
    ERROR_HOOK1:
      hookstat: AK_STOP
      target_error_hook_cfg:
        - AK_ONLY_SYSTEM
######################################################################
