      rtnstat: AK_ACTIVATE
    C2ISR3:
      rtnstat: AK_STOP
    C2ISR2:
      istat: AK_DISABLE
    INT_STATE1:
      istat:

  do_1:
    id: C2ISR1
    syssrv: AktspRaiseInterrupt(INTNO_SELF_C2ISR_TOP)
    gcov: false

  post_condition_1:
    C2ISR1:
      rtnstat: AK_STOP
    C2ISR3:
      rtnstat: AK_ACTIVATE
    C2ISR2:
      istat: AK_DISABLE

  do_2:
    id: C2ISR3
    syssrv: EnableInterruptSource(C2ISR2)
    rettype: StatusType
    retval: E_OK
    gcov: true

  post_condition_2:
