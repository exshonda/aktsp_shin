######################################################################
# WaitEvent_N_006_0001.yaml
######################################################################
WaitEvent_N_006_0001:
  property:
    sc: 
      - SC1
      - SC2

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      ttype: AK_EXTENDED
      actcnt: 1
      spolicy: AK_SCHFULL
      relevt:
        - EVENT1
      curevt: 0
      maxact: 1
    TASK2:
      type: TASK
      tstat: SUSPENDED
      inipri: TSK_PRI_MID
      ttype: AK_EXTENDED
      spolicy: AK_SCHFULL
      maxact: 1
    POSTTASK_HOOK1:
      type: POSTTASK_HOOK
      hookstat: AK_STOP
    EVENT1:
      type: EVENT

  do_0:
    id: TASK1
    syssrv: WaitEvent(EVENT1)
    rettype: StatusType
    retval: E_OK
    gcov: true

  post_condition_0:
    TASK1:
      tstat: RUNNING
    TASK2:
      tstat: SUSPENDED
    POSTTASK_HOOK1:
      hookstat: AK_ACTIVATE

  do_1:
    id: POSTTASK_HOOK1
    syssrv: return
    gcov: false

  post_condition_1:
    TASK1:
      tstat: WAITING
      waievt: EVENT1
    TASK2:
      tstat: SUSPENDED
    POSTTASK_HOOK1:
      hookstat: AK_STOP
######################################################################