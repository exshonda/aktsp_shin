######################################################################
# GetAlarm_E_001_0001.yaml
######################################################################
GetAlarm_E_001_0001:
  property:
    sc: 
      - SC1
      - SC2

  pre_condition:
    TASK1:
      type: TASK
      tstat: SUSPENDED
      inipri: TSK_PRI_MID
    STARTUP_HOOK1:
      type: STARTUP_HOOK
      hookstat: AK_ACTIVATE
      var:
        vname1:
          type: TickType
          global: true
    ALARM1:
      type: ALARM
      almact: AK_ALM_INCNT
      counter: COUNTER1
      astat: AK_UNSET
      incounter: COUNTER2
    COUNTER1:
      type: COUNTER
      ctype: AK_SOFTWARE
      mincyc: ANY_MINCYC_A
      maxval: ANY_MAXVAL_A
      curval: 0
      cstat: AK_CS_NULL
    COUNTER2:
      type: COUNTER
      ctype: AK_SOFTWARE
      mincyc: ANY_MINCYC_B
      maxval: ANY_MAXVAL_B
      curval: 0
      cstat: AK_CS_NULL
    ERROR_HOOK1:
      type: ERROR_HOOK
      hookstat: AK_STOP
      target_error_hook_cfg:
        - AK_SC1_SINGLE

  do_0:
    id: STARTUP_HOOK1
    syssrv: GetAlarm(ALARM1,&vname1)
    rettype: StatusType
    retval: E_OS_CALLEVEL
    gcov: true

  post_condition_0:
    STARTUP_HOOK1:
      hookstat: AK_STOP
      target_error_hook_cfg:
        - AK_SC1_SINGLE
    ERROR_HOOK1:
      hookstat: AK_ACTIVATE

  do_1:
    id: ERROR_HOOK1
    syssrv: CheckAssert(Error==E_OS_CALLEVEL)
    gcov: false

  post_condition_1:

  do_2:
    id: ERROR_HOOK1
    syssrv: CheckAssert(OSError_GetAlarm_AlarmID()==ALARM1)
    gcov: false

  post_condition_2:

  do_3:
    id: ERROR_HOOK1
    syssrv: CheckAssert(OSError_GetAlarm_Tick()==&vname1)
    gcov: false
    need_si:
      - IOS030

  post_condition_3:

  do_4:
    id: ERROR_HOOK1
    syssrv: CheckAssert(OSErrorGetServiceId()==OSServiceId_GetAlarm)
    gcov: false

  post_condition_4:
######################################################################
# GetAlarm_E_001_0002.yaml
######################################################################
GetAlarm_E_001_0002:
  property:
    sc: 
      - SC1
      - SC2

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      inipri: TSK_PRI_MID
    SHUTDOWN_HOOK1:
      type: SHUTDOWN_HOOK
      hookstat: AK_STOP
      var:
        vname1:
          type: TickType
          global: true
    ALARM1:
      type: ALARM
      almact: AK_ALM_INCNT
      counter: COUNTER1
      astat: AK_SET
      incounter: COUNTER2
      almval: 1
      cycle: 0
    COUNTER1:
      type: COUNTER
      ctype: AK_SOFTWARE
      mincyc: ANY_MINCYC_A
      maxval: ANY_MAXVAL_A
      curval: 0
      cstat: AK_CS_NULL
    COUNTER2:
      type: COUNTER
      ctype: AK_SOFTWARE
      mincyc: ANY_MINCYC_B
      maxval: ANY_MAXVAL_B
      curval: 0
      cstat: AK_CS_NULL
    ERROR_HOOK1:
      type: ERROR_HOOK
      hookstat: AK_STOP
      target_error_hook_cfg:
        - AK_SC1_SINGLE

  do_0:
    id: TASK1
    syssrv: ShutdownOS(E_OK)
    gcov: false

  post_condition_0:
    SHUTDOWN_HOOK1:
      hookstat: AK_ACTIVATE

  do_1:
    id: SHUTDOWN_HOOK1
    syssrv: GetAlarm(ALARM1,&vname1)
    rettype: StatusType
    retval: E_OS_CALLEVEL
    gcov: true

  post_condition_1:
    SHUTDOWN_HOOK1:
      hookstat: AK_STOP
      target_error_hook_cfg:
        - AK_SC1_SINGLE
    ERROR_HOOK1:
      hookstat: AK_ACTIVATE

  do_2:
    id: ERROR_HOOK1
    syssrv: CheckAssert(Error==E_OS_CALLEVEL)
    gcov: false

  post_condition_2:

  do_3:
    id: ERROR_HOOK1
    syssrv: CheckAssert(OSError_GetAlarm_AlarmID()==ALARM1)
    gcov: false

  post_condition_3:

  do_4:
    id: ERROR_HOOK1
    syssrv: CheckAssert(OSError_GetAlarm_Tick()==&vname1)
    gcov: false
    need_si:
      - IOS030

  post_condition_4:

  do_5:
    id: ERROR_HOOK1
    syssrv: CheckAssert(OSErrorGetServiceId()==OSServiceId_GetAlarm)
    gcov: false

  post_condition_5:
######################################################################