######################################################################
# NextScheduleTable_N_004_0001.yaml
######################################################################
NextScheduleTable_N_004_0001:
  property:
    sc: 
      - SC1
      - SC2

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      ttype: AK_BASIC
      spolicy: AK_SCHNON
      maxact: 3
    TASK2:
      type: TASK
      tstat: SUSPENDED
      inipri: TSK_PRI_MID
      ttype: AK_BASIC
      spolicy: AK_SCHNON
      maxact: 3
    TASK3:
      type: TASK
      tstat: SUSPENDED
      inipri: TSK_PRI_MID
      ttype: AK_BASIC
      spolicy: AK_SCHNON
      maxact: 3
    COUNTER1:
      type: COUNTER
      ctype: AK_SOFTWARE
      mincyc: 1
      maxval: ANY_MAXVAL_A
      curval: 0
      cstat: AK_CS_NULL
    SCHEDULE_TABLE1:
      type: SCHEDULE_TABLE
      counter: COUNTER1
      syncstrategy: AK_NONE
      repeat: AK_FALSE
      ststat: SCHEDULETABLE_RUNNING
      duration: 5
      curval: 0
      expoint:
        2:
          acttsk:
            - TASK2
    SCHEDULE_TABLE2:
      type: SCHEDULE_TABLE
      counter: COUNTER1
      syncstrategy: AK_NONE
      repeat: AK_FALSE
      ststat: SCHEDULETABLE_STOPPED
      duration: 5
      expoint:
        4:
          acttsk:
            - TASK3

  do_0:
    id: TASK1
    syssrv: NextScheduleTable(SCHEDULE_TABLE1,SCHEDULE_TABLE2)
    rettype: StatusType
    retval: E_OK
    gcov: true

  post_condition_0:
    SCHEDULE_TABLE1:
      ststat: SCHEDULETABLE_RUNNING
    SCHEDULE_TABLE2:
      ststat: SCHEDULETABLE_NEXT
      stfrom: SCHEDULE_TABLE1

  do_1:
    id: TASK1
    syssrv: IncrementCounter(COUNTER1)
    rettype: StatusType
    retval: E_OK
    gcov: false

  post_condition_1:
    COUNTER1:
      curval: 1
    SCHEDULE_TABLE1:
      ststat: SCHEDULETABLE_RUNNING
      curval: 1
    SCHEDULE_TABLE2:
      ststat: SCHEDULETABLE_NEXT

  do_2:
    id: TASK1
    syssrv: StopScheduleTable(SCHEDULE_TABLE1)
    rettype: StatusType
    retval: E_OK
    gcov: false

  post_condition_2:
    COUNTER1:
      curval: 1
    SCHEDULE_TABLE1:
      ststat: SCHEDULETABLE_STOPPED
    SCHEDULE_TABLE2:
      ststat: SCHEDULETABLE_STOPPED

######################################################################
