      duration: 11
      curval: 0
      expoint:
        2:
          acttsk:
            - TASK2
    SCHEDULE_TABLE2:
      type: SCHEDULE_TABLE
      counter: COUNTER1
      syncstrategy: AK_IMPLICIT
      repeat: AK_FALSE
