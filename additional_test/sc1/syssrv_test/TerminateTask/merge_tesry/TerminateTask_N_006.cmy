######################################################################
# TerminateTask_N_006_0001.yaml
######################################################################
TerminateTask_N_006_0001:
  property:
    sc: 
      - SC1
      - SC2

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      inipri: TSK_PRI_MID
      ttype: AK_BASIC
      actcnt: 1
      spolicy: AK_SCHFULL
      maxact: ANY_BASIC_MAXACT
    POSTTASK_HOOK1:
      type: POSTTASK_HOOK
      hookstat: AK_STOP

  do_0:
    id: TASK1
    syssrv: TerminateTask()
    gcov: true

  post_condition_0:
    TASK1:
      tstat: RUNNING
    POSTTASK_HOOK1:
      hookstat: AK_ACTIVATE

  do_1:
    id: POSTTASK_HOOK1
    syssrv: return
    gcov: false

  post_condition_1:
    TASK1:
      tstat: SUSPENDED
    POSTTASK_HOOK1:
      hookstat: AK_STOP
######################################################################