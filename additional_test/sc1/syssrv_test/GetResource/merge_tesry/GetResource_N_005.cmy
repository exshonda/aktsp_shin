######################################################################
# GetResource_N_005_0001.yaml
######################################################################
GetResource_N_005_0001:
  property:
    sc: 
      - SC1
      - SC2

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      inipri: TSK_PRI_MID
      curpri: TSK_PRI_MID
    C2ISR1:
      type: C2ISR
      intno: INTNO_SELF_C2ISR_LOW
      iniintpri: INT_PRI_LOW
      rtnstat: AK_ACTIVATE
      relres:
        - RESOURCE1
    C2ISR2:
      type: C2ISR
      intno: INTNO_SELF_C2ISR_MID_A
      iniintpri: INT_PRI_MID
      rtnstat: AK_STOP
      relres:
        - RESOURCE1
    C2ISR3:
      type: C2ISR
      intno: INTNO_SELF_C2ISR_HIGH
      iniintpri: INT_PRI_HIGH
      rtnstat: AK_STOP
      relres:
        - RESOURCE1
    RESOURCE1:
      type: RESOURCE
      resprop: AK_STANDARD
      lockflg: AK_UNLOCK

  do_0:
    id: C2ISR1
    syssrv: GetResource(RESOURCE1)
    rettype: StatusType
    retval: E_OK
    gcov: true

  post_condition_0:
    C2ISR1:
      curintpri: INT_PRI_HIGH
      getres:
        - RESOURCE1
    RESOURCE1:
      lockflg: AK_LOCK

  do_1:
    id: C2ISR1
    syssrv: AktspRaiseInterrupt(INTNO_SELF_C2ISR_HIGH)
    gcov: false

  post_condition_1:
    C2ISR1:
      rtnstat: AK_ACTIVATE
      getres:
        - RESOURCE1
    RESOURCE1:
      lockflg: AK_LOCK
    C2ISR2:
      rtnstat: AK_STOP
    C2ISR3:
      rtnstat: AK_STOP

  do_2:
    id: C2ISR1
    syssrv: ReleaseResource(RESOURCE1)
    rettype: StatusType
    retval: E_OK
    gcov: false

  post_condition_2:
    C2ISR1:
      rtnstat: AK_STOP
      curintpri: INT_PRI_LOW
      getres:
    C2ISR2:
      rtnstat: AK_STOP
    C2ISR3:
      rtnstat: AK_ACTIVATE
    RESOURCE1:
      lockflg: AK_UNLOCK
######################################################################
# GetResource_N_005_0002.yaml
######################################################################
GetResource_N_005_0002:
  property:
    sc: 
      - SC1
      - SC2

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      inipri: TSK_PRI_MID
      curpri: TSK_PRI_MID
      spolicy: ANY_SPOLICY
      relres:
        - RESOURCE1
    TASK2:
      type: TASK
      tstat: SUSPENDED
      inipri: TSK_PRI_HIGH
      spolicy: AK_SCHFULL
      relres:
        - RESOURCE1
    C2ISR1:
      type: C2ISR
      intno: INTNO_SELF_C2ISR_MID_A
      iniintpri: INT_PRI_MID
      rtnstat: AK_STOP
      relres:
        - RESOURCE1
    RESOURCE1:
      type: RESOURCE
      resprop: AK_STANDARD
      lockflg: AK_UNLOCK

  do_0:
    id: TASK1
    syssrv: GetResource(RESOURCE1)
    rettype: StatusType
    retval: E_OK
    gcov: true

  post_condition_0:
    TASK1:
      curpri: INT_PRI_MID
      getres:
        - RESOURCE1
    RESOURCE1:
      lockflg: AK_LOCK

  do_1:
    id: TASK1
    syssrv: AktspRaiseInterrupt(INTNO_SELF_C2ISR_MID_A)
    gcov: false

  post_condition_1:
    TASK1:
      tstat: RUNNING
      getres:
        - RESOURCE1
    RESOURCE1:
      lockflg: AK_LOCK
    TASK2:
      tstat: SUSPENDED
    C2ISR1:
      rtnstat: AK_STOP

  do_2:
    id: TASK1
    syssrv: ReleaseResource(RESOURCE1)
    rettype: StatusType
    retval: E_OK
    gcov: false

  post_condition_2:
    TASK1:
      tstat: RUNNING
      curpri: TSK_PRI_MID
      getres:
    TASK2:
      tstat: SUSPENDED
    C2ISR1:
      rtnstat: AK_ACTIVATE
    RESOURCE1:
      lockflg: AK_UNLOCK
######################################################################
# GetResource_N_005_0003.yaml
######################################################################
GetResource_N_005_0003:
  property:
    sc: 
      - SC1
      - SC2

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      inipri: TSK_PRI_LOW
      curpri: TSK_PRI_LOW
      spolicy: ANY_SPOLICY
      relres:
        - RESOURCE1
    TASK2:
      type: TASK
      tstat: SUSPENDED
      inipri: TSK_PRI_MID
      spolicy: AK_SCHFULL
      relres:
        - RESOURCE1
    TASK3:
      type: TASK
      tstat: SUSPENDED
      inipri: TSK_PRI_HIGH
      spolicy: AK_SCHFULL
      relres:
        - RESOURCE1
    RESOURCE1:
      type: RESOURCE
      resprop: AK_STANDARD
      lockflg: AK_UNLOCK

  do_0:
    id: TASK1
    syssrv: GetResource(RESOURCE1)
    rettype: StatusType
    retval: E_OK
    gcov: true

  post_condition_0:
    TASK1:
      curpri: TSK_PRI_HIGH
      getres:
        - RESOURCE1
    RESOURCE1:
      lockflg: AK_LOCK

  do_1:
    id: TASK1
    syssrv: ActivateTask(TASK3)
    rettype: StatusType
    retval: E_OK
    gcov: false

  post_condition_1:
    TASK1:
      tstat: RUNNING
      getres:
        - RESOURCE1
    RESOURCE1:
      lockflg: AK_LOCK
    TASK2:
      tstat: SUSPENDED
    TASK3:
      tstat: READY
      curpri: TSK_PRI_HIGH
      actcnt: 1

  do_2:
    id: TASK1
    syssrv: ReleaseResource(RESOURCE1)
    rettype: StatusType
    retval: E_OK
    gcov: false

  post_condition_2:
    TASK1:
      tstat: READY
      curpri: TSK_PRI_LOW
      getres:
    TASK2:
      tstat: SUSPENDED
    TASK3:
      tstat: RUNNING
    RESOURCE1:
      lockflg: AK_UNLOCK
######################################################################
