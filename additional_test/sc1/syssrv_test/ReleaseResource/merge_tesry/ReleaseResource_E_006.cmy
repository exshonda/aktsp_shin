######################################################################
# ReleaseResource_E_006_0001.yaml
######################################################################
ReleaseResource_E_006_0001:
  property:
    sc: 
      - SC1
      - SC2

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      spolicy: ANY_SPOLICY
    TASK2:
      type: TASK
      tstat: SUSPENDED
      inipri: TSK_PRI_MID
      spolicy: ANY_SPOLICY
      relres:
        - RESOURCE1
    C2ISR1:
      type: C2ISR
      intno: INTNO_SELF_C2ISR_MID_A
      iniintpri: INT_PRI_MID
      rtnstat: AK_ACTIVATE
    RESOURCE1:
      type: RESOURCE
      resprop: AK_STANDARD
      lockflg: AK_UNLOCK
    ERROR_HOOK1:
      type: ERROR_HOOK
      hookstat: AK_STOP
      target_error_hook_cfg:
        - AK_SC1_SINGLE

  do_0:
    id: C2ISR1
    syssrv: ReleaseResource(RESOURCE1)
    rettype: StatusType
    retval: E_OS_NOFUNC
    gcov: true

  post_condition_0:
    ERROR_HOOK1:
      hookstat: AK_ACTIVATE
    C2ISR1:
      rtnstat: AK_STOP

  do_1:
    id: ERROR_HOOK1
    syssrv: CheckAssert(Error==E_OS_NOFUNC)
    gcov: false

  post_condition_1:

  do_2:
    id: ERROR_HOOK1
    syssrv: CheckAssert(OSError_ReleaseResource_ResID()==RESOURCE1)
    gcov: false

  post_condition_2:

  do_3:
    id: ERROR_HOOK1
    syssrv: CheckAssert(OSErrorGetServiceId()==OSServiceId_ReleaseResource)
    gcov: false

  post_condition_3:
######################################################################