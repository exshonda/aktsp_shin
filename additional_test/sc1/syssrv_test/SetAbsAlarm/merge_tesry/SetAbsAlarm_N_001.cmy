######################################################################
# SetAbsAlarm_N_001_0001.yaml
######################################################################
SetAbsAlarm_N_001_0001:
  property:
    sc: 
      - SC1
      - SC2

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
    C2ISR1:
      type: C2ISR
      intno: INTNO_SELF_C2ISR_MID_A 
      iniintpri: INT_PRI_MID
      rtnstat: AK_ACTIVATE
    ALARM1:
      type: ALARM
      almact: AK_ALM_INCNT
      counter: COUNTER1
      astat: AK_UNSET
      incounter: COUNTER2
    COUNTER1:
      type: COUNTER
      ctype: AK_HARDWARE
      curval: 0
    COUNTER2:
      type: COUNTER
      ctype: AK_SOFTWARE
      mincyc: 1
      maxval: ANY_MAXVAL_B
      curval: 0
      cstat: AK_CS_NULL

  do_0:
    id: C2ISR1
    syssrv: SetAbsAlarm(ALARM1,ANY_MAXVAL_A,0)
    rettype: StatusType
    retval: E_OK
    gcov: true

  post_condition_0:
    ALARM1:
      astat: AK_SET
      almval: ANY_MAXVAL_A
      cycle: 0

  do_1:
    id: C2ISR1
    syssrv: AktspIncrementHardwareCounter(COUNTER1)
    repeat: ANY_MAXVAL_A
    gcov: false

  post_condition_1:
    ALARM1:
      astat: AK_UNSET
    COUNTER1:
      curval: ANY_MAXVAL_A%(ANY_MAXVAL_A+1)
    COUNTER2:
      curval: 1
