  post_condition_1:

  do_2:
    id: PROTECTION_HOOK1
    syssrv: return(PRO_IGNORE)

  post_condition_2:
    PROTECTION_HOOK1:
      hookstat: AK_STOP
    C1ISR1:
      rtnstat: AK_ACTIVATE
