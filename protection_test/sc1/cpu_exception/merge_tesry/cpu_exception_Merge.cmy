    C1ISR1:
      type: C1ISR
      intno: INTNO_SELF_C1ISR_MID
      iniintpri: INT_PRI_ISR1_MID
      rtnstat: AK_ACTIVATE

  do_0:
    id: C1ISR1
    syssrv: AktspRaiseCPUException()

  post_condition_0:
    PROTECTION_HOOK1:
      hookstat: AK_ACTIVATE
    C1ISR1:
      rtnstat: AK_STOP

  do_1:
