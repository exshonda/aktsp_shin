######################################################################
# stack_monitoring_NM_2_NP_NS_0001.yaml
######################################################################
stack_monitoring_NM_2_NP_NS_0001:
  property:
    need_stack_share: true
    sc: 
      - SC1
      - SC2

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      var:
        vname1:
          type: AktspStackOverflowInfo
          stk_mode: AK_SMM_MAGIC_NUMBER
          stk_intno: INTNO_SELF_C2ISR_MID_A
    C2ISR1:
      type: C2ISR
      intno: INTNO_SELF_C2ISR_MID_A
      iniintpri: INT_PRI_MID
      rtnstat: AK_STOP

  do:
    id: TASK1
    syssrv: AktspRaiseTaskStackOverflowByInterrupt(AKTSP_TASK_STACK_ADDRESS,AKTSP_TASK_STACK_SIZE,&vname1)
    finish: true

  post_condition:
######################################################################
# stack_monitoring_NM_2_NP_NS_0002.yaml
######################################################################
stack_monitoring_NM_2_NP_NS_0002:
  property:
    need_stack_share: true
    sc: 
      - SC1
      - SC2

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      var:
        vname1:
          type: AktspStackOverflowInfo
          stk_mode: AK_SMM_STACK_POINTER
          stk_intno: INTNO_SELF_C2ISR_MID_A
    C2ISR1:
      type: C2ISR
      intno: INTNO_SELF_C2ISR_MID_A
      iniintpri: INT_PRI_MID
      rtnstat: AK_STOP

  do:
    id: TASK1
    syssrv: AktspRaiseTaskStackOverflowByInterrupt(AKTSP_TASK_STACK_ADDRESS,AKTSP_TASK_STACK_SIZE,&vname1)
    finish: true

  post_condition:
######################################################################
