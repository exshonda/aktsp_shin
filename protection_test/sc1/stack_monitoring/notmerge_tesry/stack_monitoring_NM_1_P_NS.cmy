######################################################################
# stack_monitoring_NM_1_P_NS_0001.yaml
######################################################################
stack_monitoring_NM_1_P_NS_0001:
  property:
    need_stack_share: true
    sc: 
      - SC1
      - SC2

  pre_condition:
    PROTECTION_HOOK1:
      type: PROTECTION_HOOK
      hookstat: AK_STOP
    TASK1:
      type: TASK
      tstat: RUNNING
      inipri: TSK_PRI_MID
      curpri: TSK_PRI_MID
      spolicy: AK_SCHFULL
      var:
        vname1:
          type: AktspStackOverflowInfo
          stk_mode: AK_SMM_MAGIC_NUMBER
          stk_action: AK_SOA_ACTIVATE_TASK
          stk_task: TASK2
    TASK2:
      type: TASK
      tstat: SUSPENDED
      inipri: TSK_PRI_HIGH

  do_0:
    id: TASK1
    syssrv: AktspRaiseTaskStackOverflowByDispatch(AKTSP_TASK_STACK_ADDRESS,AKTSP_TASK_STACK_SIZE,&vname1)

  post_condition_0:
    PROTECTION_HOOK1:
      hookstat: AK_ACTIVATE
    TASK2:
      tstat: READY
      actcnt: 1
      curpri: TSK_PRI_HIGH

  do_1:
    id: PROTECTION_HOOK1
    syssrv: CheckAssert(FatalError == E_OS_STACKFAULT)

  post_condition_1:

  do_2:
    id: PROTECTION_HOOK1
    syssrv: return(PRO_IGNORE)
    finish: true

  post_condition_2:
