forced_task_termination_m_m_3_1717:
  property:
    sc: 
      - SC3
      - SC4

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      inipri: TSK_PRI_MID
      curpri: TSK_PRI_HIGH
      ttype: AK_EXTENDED
      spolicy: AK_SCHFULL
      maxact: 1
      actcnt: 1
      relres:
        - RESOURCE1
      getres:
        - RESOURCE1
      getspn:
        - SPINLOCK1
        - SPINLOCK2
      osap: NT_OSAP_SELF_CORE
    TASK2:
      type: TASK
      tstat: READY
      inipri: TSK_PRI_HIGH
      curpri: TSK_PRI_HIGH
      relres:
        - RESOURCE1
      osap: TR_OSAP_SELF_CORE
    RESOURCE1:
      type: RESOURCE
      resprop: AK_STANDARD
      lockflg: AK_LOCK
      accosap:
        - NT_OSAP_SELF_CORE
    SPINLOCK1:
      type: SPINLOCK
      lockflg: AK_LOCK
      susint: AK_SUS_OS_SPN
      successor: SPINLOCK2
      accosap:
        - NT_OSAP_SELF_CORE
        - TR_OSAP_OTHER_OTHER_CORE
    SPINLOCK2:
      type: SPINLOCK
      lockflg: AK_LOCK
      accosap:
        - NT_OSAP_SELF_CORE
        - TR_OSAP_OTHER_OTHER_CORE
    PROTECTION_HOOK1:
      type: PROTECTION_HOOK
      hookstat: AK_STOP
      coreid: CORE_SELF
    POSTTASK_HOOK1:
      type: POSTTASK_HOOK
      hookstat: AK_STOP
      coreid: CORE_SELF
    INT_STATE1:
      type: INT_STATE
      istat:
        - AK_SUS_OS_INT: TASK1
        - AK_SUS_OS_INT: SPINLOCK1
      coreid: CORE_SELF

  do_0:
    id: TASK1
    syssrv: AktspRaiseCPUException()

  post_condition_0:
    PROTECTION_HOOK1:
      hookstat: AK_ACTIVATE

  do_1:
    id: PROTECTION_HOOK1
    syssrv: CheckAssert(FatalError == E_OS_PROTECTION_EXCEPTION)

  post_condition_1:

  do_2:
    id: PROTECTION_HOOK1
    syssrv: return(PRO_TERMINATETASKISR)

  post_condition_2:
    PROTECTION_HOOK1:
      hookstat: AK_STOP
    TASK1:
      tstat: SUSPENDED
      getres:
      getspn:
    TASK2:
      tstat: RUNNING
    RESOURCE1:
      lockflg: AK_UNLOCK
    SPINLOCK1:
      lockflg: AK_UNLOCK
    SPINLOCK2:
      lockflg: AK_UNLOCK
    INT_STATE1:
      istat:

  do_3:
    id: TASK2
    syssrv: AKTSP_POSTTASKHOOK_NO_BOOT = FALSE

  post_condition_3:
