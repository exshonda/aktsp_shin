        - RESOURCE1
        - RESOURCE2
      getres:
        - RESOURCE3
        - RESOURCE4
      getspn:
        - SPINLOCK1
        - SPINLOCK2
      osap: NT_OSAP_SELF_CORE
    TASK2:
      type: TASK
      tstat: READY
      inipri: TSK_PRI_HIGH
      curpri: TSK_PRI_HIGH
      relres:
        - RESOURCE1
        - RESOURCE2
      osap: TR_OSAP_SELF_CORE
