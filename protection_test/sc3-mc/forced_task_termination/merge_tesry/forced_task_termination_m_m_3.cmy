forced_task_termination_m_m_3_1818:
  property:
    need_stack_share: true
    sc: 
      - SC3
      - SC4

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      inipri: TSK_PRI_MID
      curpri: TSK_PRI_MID
      ttype: AK_EXTENDED
      spolicy: AK_SCHFULL
      maxact: 1
      actcnt: 1
      relres:
        - RESOURCE1
        - RESOURCE2
      getres:
        - RESOURCE1
        - RESOURCE2
      getspn:
        - SPINLOCK1
        - SPINLOCK2
      osap: NT_OSAP_SELF_CORE
    TASK2:
      type: TASK
      tstat: READY
      inipri: TSK_PRI_LOW
      curpri: TSK_PRI_LOW
      relres:
        - RESOURCE1
        - RESOURCE2
      osap: TR_OSAP_SELF_CORE
    RESOURCE1:
      type: RESOURCE
      resprop: AK_STANDARD
      lockflg: AK_LOCK
      accosap:
        - NT_OSAP_SELF_CORE
    RESOURCE2:
      type: RESOURCE
      resprop: AK_STANDARD
      lockflg: AK_LOCK
      accosap:
        - NT_OSAP_SELF_CORE
    SPINLOCK1:
      type: SPINLOCK
      lockflg: AK_LOCK
      susint: AK_SUS_OS_SPN
      successor: SPINLOCK2
      accosap:
        - NT_OSAP_SELF_CORE
        - TR_OSAP_OTHER_OTHER_CORE
    SPINLOCK2:
      type: SPINLOCK
      lockflg: AK_LOCK
      susint: AK_SUS_OS_SPN
      accosap:
        - NT_OSAP_SELF_CORE
        - TR_OSAP_OTHER_OTHER_CORE
    PROTECTION_HOOK1:
      type: PROTECTION_HOOK
      hookstat: AK_STOP
      coreid: CORE_SELF
    POSTTASK_HOOK1:
      type: POSTTASK_HOOK
      hookstat: AK_STOP
      coreid: CORE_SELF
    INT_STATE1:
