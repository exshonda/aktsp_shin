      type: SPINLOCK
      lockflg: AK_LOCK
      susint: AK_SUS_OS_SPN
      successor: SPINLOCK2
      accosap:
        - NT_OSAP_SELF_CORE
        - TR_OSAP_OTHER_OTHER_CORE
    SPINLOCK2:
      type: SPINLOCK
      lockflg: AK_LOCK
      susint: AK_SUS_ALL_SPN
      accosap:
