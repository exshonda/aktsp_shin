      spolicy: AK_SCHFULL
      maxact: 1
      actcnt: 1
      relres:
        - RESOURCE1
      getres:
        - RESOURCE1
      getspn:
        - SPINLOCK1
        - SPINLOCK2
      osap: NT_OSAP_SELF_CORE
    TASK2:
      type: TASK
      tstat: READY
      inipri: TSK_PRI_LOW
      curpri: TSK_PRI_LOW
      spolicy: AK_SCHFULL
      relres:
