forced_task_termination_m_m_4_0084:
  property:
    need_stack_share: true
    sc: 
      - SC3
      - SC4

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      inipri: TSK_PRI_MID
      curpri: TSK_PRI_MID
      ttype: AK_BASIC
      spolicy: AK_SCHFULL
      maxact: 1
      actcnt: 1
      relres:
        - RESOURCE1
        - RESOURCE2
      getres:
        - RESOURCE3
        - RESOURCE4
      getspn:
        - SPINLOCK1
        - SPINLOCK2
      osap: NT_OSAP_SELF_CORE
    TASK2:
      type: TASK
      tstat: READY
      inipri: TSK_PRI_LOW
      curpri: TSK_PRI_LOW
      relres:
        - RESOURCE1
        - RESOURCE2
      osap: TR_OSAP_SELF_CORE
    RESOURCE1:
      type: RESOURCE
      resprop: AK_STANDARD
      lockflg: AK_UNLOCK
      accosap:
        - NT_OSAP_SELF_CORE
    RESOURCE2:
      type: RESOURCE
      resprop: AK_STANDARD
      lockflg: AK_UNLOCK
      accosap:
        - NT_OSAP_SELF_CORE
    RESOURCE3:
      type: RESOURCE
      resprop: AK_LINKED
      linkres: RESOURCE1
      lockflg: AK_LOCK
    RESOURCE4:
      type: RESOURCE
      resprop: AK_LINKED
      linkres: RESOURCE2
      lockflg: AK_LOCK
    SPINLOCK1:
      type: SPINLOCK
      lockflg: AK_LOCK
      successor: SPINLOCK2
      accosap:
        - NT_OSAP_SELF_CORE
        - TR_OSAP_OTHER_OTHER_CORE
    SPINLOCK2:
      type: SPINLOCK
      lockflg: AK_LOCK
      susint: AK_SUS_OS_SPN
      accosap:
        - NT_OSAP_SELF_CORE
        - TR_OSAP_OTHER_OTHER_CORE
    PROTECTION_HOOK1:
      type: PROTECTION_HOOK
      hookstat: AK_STOP
      coreid: CORE_SELF
    POSTTASK_HOOK1:
      type: POSTTASK_HOOK
      hookstat: AK_STOP
      coreid: CORE_SELF
    INT_STATE1:
      type: INT_STATE
      istat:
        - AK_SUS_OS_INT: TASK1
        - AK_SUS_OS_INT: TASK1
        - AK_SUS_OS_INT: SPINLOCK2
      coreid: CORE_SELF

  do_0:
    id: TASK1
    syssrv: AKTSP_NOWRITE_VAL_BY_NT = 1

  post_condition_0:
    PROTECTION_HOOK1:
      hookstat: AK_ACTIVATE

  do_1:
    id: PROTECTION_HOOK1
    syssrv: CheckAssert(FatalError == E_OS_PROTECTION_MEMORY)

  post_condition_1:

  do_2:
    id: PROTECTION_HOOK1
    syssrv: return(PRO_TERMINATETASKISR)

  post_condition_2:
    PROTECTION_HOOK1:
      hookstat: AK_STOP
    TASK1:
      tstat: SUSPENDED
      getres:
      getspn:
    TASK2:
      tstat: RUNNING
    RESOURCE3:
      lockflg: AK_UNLOCK
    RESOURCE4:
      lockflg: AK_UNLOCK
    SPINLOCK1:
      lockflg: AK_UNLOCK
    SPINLOCK2:
      lockflg: AK_UNLOCK
    INT_STATE1:
      istat:

  do_3:
    id: TASK2
    syssrv: AKTSP_POSTTASKHOOK_NO_BOOT = FALSE

  post_condition_3:
