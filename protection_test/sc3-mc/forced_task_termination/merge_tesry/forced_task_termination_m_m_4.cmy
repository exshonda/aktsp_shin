      getspn:
    TASK2:
      tstat: RUNNING
    RESOURCE3:
      lockflg: AK_UNLOCK
    RESOURCE4:
      lockflg: AK_UNLOCK
    SPINLOCK1:
      lockflg: AK_UNLOCK
    SPINLOCK2:
      lockflg: AK_UNLOCK
    INT_STATE1:
      istat:

