# forced_task_termination_m_m_4_0298.yaml
######################################################################
forced_task_termination_m_m_4_0298:
  property:
    need_stack_share: true
    sc: 
      - SC3
      - SC4

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      inipri: TSK_PRI_MID
      curpri: TSK_PRI_HIGH
      ttype: AK_BASIC
      spolicy: AK_SCHFULL
      maxact: ANY_BASIC_MAXACT
      actcnt: ANY_BASIC_MAXACT
      relres:
        - RESOURCE1
        - RESOURCE2
      getres:
        - RESOURCE1
        - RESOURCE2
