        - RESOURCE1
        - RESOURCE2
      osap: TR_OSAP_SELF_CORE
    RESOURCE1:
      type: RESOURCE
      resprop: AK_STANDARD
      lockflg: AK_LOCK
      accosap:
        - NT_OSAP_SELF_CORE
    RESOURCE2:
      type: RESOURCE
      resprop: AK_STANDARD
      lockflg: AK_LOCK
      accosap:
        - NT_OSAP_SELF_CORE
    SPINLOCK1:
      type: SPINLOCK
      lockflg: AK_LOCK
      successor: SPINLOCK2
      accosap:
        - NT_OSAP_SELF_CORE
        - TR_OSAP_OTHER_OTHER_CORE
    SPINLOCK2:
      type: SPINLOCK
      lockflg: AK_LOCK
      accosap:
        - NT_OSAP_SELF_CORE
        - TR_OSAP_OTHER_OTHER_CORE
    PROTECTION_HOOK1:
      type: PROTECTION_HOOK
      hookstat: AK_STOP
      coreid: CORE_SELF
    POSTTASK_HOOK1:
      type: POSTTASK_HOOK
      hookstat: AK_STOP
      coreid: CORE_SELF
    INT_STATE1:
      type: INT_STATE
      istat:
        - AK_SUS_OS_INT: TASK1
        - AK_SUS_OS_INT: TASK1
      coreid: CORE_SELF

  do_0:
    id: TASK1
    syssrv: AKTSP_NOWRITE_VAL_BY_NT = 1

  post_condition_0:
    PROTECTION_HOOK1:
      hookstat: AK_ACTIVATE

  do_1:
    id: PROTECTION_HOOK1
    syssrv: CheckAssert(FatalError == E_OS_PROTECTION_MEMORY)

  post_condition_1:

  do_2:
    id: PROTECTION_HOOK1
    syssrv: return(PRO_TERMINATETASKISR)

