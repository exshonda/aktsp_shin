    PROTECTION_HOOK1:
      hookstat: AK_STOP
    TASK1:
      tstat: READY
      actcnt: ANY_BASIC_MAXACT-1
      bootcnt: 1
      curpri: TSK_PRI_MID
      getres:
      getspn:
    TASK2:
      tstat: RUNNING
    RESOURCE1:
      lockflg: AK_UNLOCK
    RESOURCE2:
      lockflg: AK_UNLOCK
    SPINLOCK1:
      lockflg: AK_UNLOCK
    SPINLOCK2:
      lockflg: AK_UNLOCK
    INT_STATE1:
      istat:

  do_3:
    id: TASK2
    syssrv: AKTSP_POSTTASKHOOK_NO_BOOT = FALSE

  post_condition_3:
