      type: RESOURCE
      resprop: AK_STANDARD
      lockflg: AK_UNLOCK
      accosap:
        - NT_OSAP_SELF_CORE
    RESOURCE3:
      type: RESOURCE
      resprop: AK_LINKED
      linkres: RESOURCE1
      lockflg: AK_LOCK
    SPINLOCK1:
      type: SPINLOCK
      lockflg: AK_LOCK
      susint: AK_SUS_OS_SPN
      successor: SPINLOCK2
      accosap:
        - NT_OSAP_SELF_CORE
        - TR_OSAP_OTHER_OTHER_CORE
    SPINLOCK2:
      type: SPINLOCK
      lockflg: AK_LOCK
      susint: AK_SUS_OS_SPN
      accosap:
        - NT_OSAP_SELF_CORE
        - TR_OSAP_OTHER_OTHER_CORE
    PROTECTION_HOOK1:
