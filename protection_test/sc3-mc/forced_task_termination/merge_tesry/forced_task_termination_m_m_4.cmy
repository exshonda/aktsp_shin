      curpri: TSK_PRI_HIGH
      ttype: AK_BASIC
      spolicy: AK_SCHFULL
      maxact: ANY_BASIC_MAXACT
      actcnt: ANY_BASIC_MAXACT
      relres:
        - RESOURCE1
        - RESOURCE2
      getres:
        - RESOURCE1
        - RESOURCE2
      getspn:
        - SPINLOCK1
        - SPINLOCK2
      osap: NT_OSAP_SELF_CORE
    TASK2:
      type: TASK
      tstat: READY
      inipri: TSK_PRI_HIGH
      curpri: TSK_PRI_HIGH
      relres:
        - RESOURCE1
        - RESOURCE2
      osap: TR_OSAP_SELF_CORE
    RESOURCE1:
      type: RESOURCE
      resprop: AK_STANDARD
      lockflg: AK_LOCK
      accosap:
        - NT_OSAP_SELF_CORE
    RESOURCE2:
      type: RESOURCE
      resprop: AK_STANDARD
      lockflg: AK_LOCK
      accosap:
        - NT_OSAP_SELF_CORE
    SPINLOCK1:
      type: SPINLOCK
      lockflg: AK_LOCK
      susint: AK_SUS_OS_SPN
      successor: SPINLOCK2
      accosap:
        - NT_OSAP_SELF_CORE
        - TR_OSAP_OTHER_OTHER_CORE
    SPINLOCK2:
      type: SPINLOCK
      lockflg: AK_LOCK
      susint: AK_SUS_OS_SPN
      accosap:
        - NT_OSAP_SELF_CORE
        - TR_OSAP_OTHER_OTHER_CORE
    PROTECTION_HOOK1:
      type: PROTECTION_HOOK
      hookstat: AK_STOP
      coreid: CORE_SELF
    POSTTASK_HOOK1:
      type: POSTTASK_HOOK
      hookstat: AK_STOP
      coreid: CORE_SELF
    INT_STATE1:
