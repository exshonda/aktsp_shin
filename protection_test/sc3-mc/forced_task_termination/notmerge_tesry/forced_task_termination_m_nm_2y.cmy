forced_task_termination_m_nm_2y_0403:
  property:
    sc: 
      - SC3
      - SC4

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      inipri: TSK_PRI_MID
      curpri: TSK_PRI_MID
      ttype: AK_EXTENDED
      spolicy: AK_SCHNON
      getspn:
        - SPINLOCK1
      osap: TR_OSAP_SELF_CORE
    TASK2:
      type: TASK
      tstat: READY
      inipri: TSK_PRI_LOW
      curpri: TSK_PRI_LOW
      osap: TR_OSAP_SELF_CORE
    SPINLOCK1:
      type: SPINLOCK
      lockflg: AK_LOCK
      accosap:
        - NT_OSAP_SELF_CORE
        - TR_OSAP_OTHER_OTHER_CORE
    PROTECTION_HOOK1:
      type: PROTECTION_HOOK
      hookstat: AK_STOP
      coreid: CORE_SELF
    POSTTASK_HOOK1:
      type: POSTTASK_HOOK
      hookstat: AK_STOP
      coreid: CORE_SELF
    INT_STATE1:
      type: INT_STATE
      istat:
        - AK_SUS_OS_INT: TASK1
        - AK_SUS_ALL_INT: TASK1
      coreid: CORE_SELF
    SHUTDOWN_HOOK1:
      type: SHUTDOWN_HOOK
      hookstat: AK_STOP
      coreid: CORE_SELF

  do_0:
    id: TASK1
    syssrv: AktspRaiseCPUException()

  post_condition_0:
    PROTECTION_HOOK1:
      hookstat: AK_ACTIVATE

  do_1:
    id: PROTECTION_HOOK1
    syssrv: CheckAssert(FatalError == E_OS_PROTECTION_EXCEPTION)

  post_condition_1:

  do_2:
    id: PROTECTION_HOOK1
    syssrv: return(PRO_TERMINATETASKISR)

  post_condition_2:
    PROTECTION_HOOK1:
      hookstat: AK_STOP
    SHUTDOWN_HOOK1:
      hookstat: AK_ACTIVATE

  do_3:
    id: SHUTDOWN_HOOK1
    syssrv: return
    finish: true

  post_condition_3:
