######################################################################
# forced_task_termination_m_nm_5_0001.yaml
######################################################################
forced_task_termination_m_nm_5_0001:
  property:
    need_stack_share: true
    sc: 
      - SC3
      - SC4

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      inipri: TSK_PRI_MID
      curpri: TSK_PRI_MID
      ttype: AK_BASIC
      spolicy: AK_SCHFULL
      maxact: 1
      actcnt: 1
      getspn:
        - SPINLOCK1
      var:
        vname1:
          type: AktspStackOverflowInfo
          stk_mode: AK_SMM_STACK_POINTER
          stk_action: AK_SOA_ACTIVATE_TASK
          stk_task: TASK2
      osap: TR_OSAP_SELF_CORE
    TASK2:
      type: TASK
      tstat: SUSPENDED
      inipri: TSK_PRI_HIGH
      osap: TR_OSAP_SELF_CORE
    SPINLOCK1:
      type: SPINLOCK
      lockflg: AK_LOCK
      accosap:
        - NT_OSAP_SELF_CORE
        - TR_OSAP_OTHER_OTHER_CORE
    PROTECTION_HOOK1:
      type: PROTECTION_HOOK
      hookstat: AK_STOP
      coreid: CORE_SELF
    POSTTASK_HOOK1:
      type: POSTTASK_HOOK
      hookstat: AK_STOP
      coreid: CORE_SELF
    SHUTDOWN_HOOK1:
      type: SHUTDOWN_HOOK
      hookstat: AK_STOP
      coreid: CORE_SELF

  do_0:
    id: TASK1
    syssrv: AktspRaiseTaskStackOverflowByDispatch(AKTSP_TASK_STACK_ADDRESS,AKTSP_TASK_STACK_SIZE,&vname1)

  post_condition_0:
    TASK2:
      tstat: READY
      actcnt: 1
      curpri: TSK_PRI_HIGH
    PROTECTION_HOOK1:
      hookstat: AK_ACTIVATE

  do_1:
    id: PROTECTION_HOOK1
    syssrv: CheckAssert(FatalError == E_OS_STACKFAULT)

  post_condition_1:

  do_2:
    id: PROTECTION_HOOK1
    syssrv: return(PRO_TERMINATETASKISR)

  post_condition_2:
    PROTECTION_HOOK1:
      hookstat: AK_STOP
    SHUTDOWN_HOOK1:
      hookstat: AK_ACTIVATE

  do_3:
    id: SHUTDOWN_HOOK1
    syssrv: return
    finish: true

  post_condition_3:
