######################################################################
# osap_termination_restart_m_t_3_0001.yaml
######################################################################
osap_termination_restart_m_t_3_0001:
  property:
    sc: 
      - SC3
      - SC4

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      getspn:
        - SPINLOCK1
      osap: NT_OSAP_SELF_CORE
    TASK2:
      type: TASK
      tstat: READY
      curpri: TSK_PRI_MID
      porder: 1
      osap: NT_OSAP_SELF_CORE
    TASK3:
      type: TASK
      tstat: WAITING
      curpri: TSK_PRI_MID
      ttype: AK_EXTENDED
      curevt: 0
      waievt: EVENT1
      relevt:
        - EVENT1
      osap: NT_OSAP_SELF_CORE
    TASK4:
      type: TASK
      tstat: SUSPENDED
      inipri: TSK_PRI_HIGH
      osap: NT_OSAP_SELF_CORE
    TASK5:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      osap: TR_OSAP_OTHER_OTHER_CORE
    TASK7:
      type: TASK
      tstat: READY
      curpri: TSK_PRI_MID

      porder: 2
      var:
        vname1:
          type: ApplicationStateType
      osap: TR_OSAP_SELF_CORE
      accosap:
        - NT_OSAP_SELF_CORE
    SPINLOCK1:
      type: SPINLOCK
      susint: AK_SUS_ALL_SPN
      lockflg: AK_LOCK
      accosap:
        - NT_OSAP_SELF_CORE
        - TR_OSAP_OTHER_OTHER_CORE
    C2ISR1:
      type: C2ISR
      intno: INTNO_OTHER_ISR2_C
      iniintpri: INT_PRI_MID
      rtnstat: AK_ACTIVATE
      osap: TR_OSAP_OTHER_OTHER_CORE
    ERROR_HOOK1:
      type: ERROR_HOOK
      hookstat: AK_STOP
      target_error_hook_cfg:
        - AK_ONLY_SYSTEM
      coreid: CORE_OTHER
    NT_OSAP_SELF_CORE:
      type: OSAP
      osapstat: APPLICATION_ACCESSIBLE
    EVENT1:
      type: EVENT
      mask: EVENTMASK_A
    INT_STATE1:
      type: INT_STATE
      istat:
        - AK_SUS_ALL_INT: SPINLOCK1

  do_0:
    id: C2ISR1
    syssrv: TerminateApplication(NT_OSAP_SELF_CORE,NO_RESTART)
    rettype: StatusType
    retval: E_OK

  post_condition_0:
    NT_OSAP_SELF_CORE:
      osapstat: APPLICATION_TERMINATED

  do_1:
    id: TASK1
    syssrv: ReleaseSpinlock(SPINLOCK1)
    rettype: StatusType
    retval: E_OK

  post_condition_1:
    TASK1:
      tstat: SUSPENDED
      getspn:
    TASK2:
      tstat: SUSPENDED
    TASK3:
      tstat: SUSPENDED
    TASK4:
      tstat: SUSPENDED
    TASK7:
      tstat: RUNNING
    SPINLOCK1:
      lockflg: AK_UNLOCK
    INT_STATE1:
      istat:

  do_2:
    id: TASK7
    syssrv: GetApplicationState(NT_OSAP_SELF_CORE,&vname1)
    rettype: StatusType
    retval: E_OK

  post_condition_2:
    TASK7:
      var:
        vname1:
          value: APPLICATION_TERMINATED

  do_3:
    id: TASK7
    syssrv: AktspCheckTaskTerminated(TASK1,AK_FALSE)
    rettype: StatusType
    retval: E_OS_ACCESS

  post_condition_3:

  do_4:
    id: TASK7
    syssrv: AktspCheckTaskTerminated(TASK2,AK_FALSE)
    rettype: StatusType
    retval: E_OS_ACCESS

  post_condition_4:

  do_5:
    id: TASK7
    syssrv: AktspCheckTaskTerminated(TASK3,AK_FALSE)
    rettype: StatusType
    retval: E_OS_ACCESS

  post_condition_5:

  do_6:
    id: TASK7
    syssrv: AktspCheckTaskTerminated(TASK4,AK_FALSE)
    rettype: StatusType
    retval: E_OS_ACCESS

  post_condition_6:
