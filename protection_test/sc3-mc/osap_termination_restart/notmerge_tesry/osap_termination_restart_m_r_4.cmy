######################################################################
# osap_termination_restart_m_r_4_0001.yaml
######################################################################
osap_termination_restart_m_r_4_0001:
  property:
    sc: 
      - SC3
      - SC4

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      getspn:
        - SPINLOCK1
      osap: NT_OSAP_SELF_CORE
    RESTART_TASK1:
      type: RESTART_TASK
      tstat: SUSPENDED
      inipri: TSK_PRI_MID
      var:
        vname1:
          type: ApplicationStateType
      osap: NT_OSAP_SELF_CORE
    TASK2:
      type: TASK
      tstat: READY
      curpri: TSK_PRI_MID
      osap: NT_OSAP_SELF_CORE
    TASK3:
      type: TASK
      tstat: WAITING
      curpri: TSK_PRI_MID
      ttype: AK_EXTENDED
      curevt: 0
      waievt: EVENT1
      relevt:
        - EVENT1
      osap: NT_OSAP_SELF_CORE
    TASK4:
      type: TASK
      tstat: SUSPENDED
      inipri: TSK_PRI_HIGH
      osap: NT_OSAP_SELF_CORE
    TASK5:
      type: TASK
      tstat: SUSPENDED
      inipri: TSK_PRI_MID
      osap: TR_OSAP_OTHER_OTHER_CORE
    EVENT1:
      type: EVENT
      mask: EVENTMASK_A
    ERROR_HOOK1:
      type: ERROR_HOOK
      hookstat: AK_STOP
      target_error_hook_cfg:
        - AK_ONLY_SYSTEM
      coreid: CORE_SELF
    PROTECTION_HOOK1:
      type: PROTECTION_HOOK
      hookstat: AK_STOP
      coreid: CORE_SELF
    SPINLOCK1:
      type: SPINLOCK
      susint: AK_DO_NOT_CARE
      lockflg: AK_LOCK
      accosap:
        - NT_OSAP_SELF_CORE
        - TR_OSAP_OTHER_OTHER_CORE
    NT_OSAP_SELF_CORE:
      type: OSAP
      osapstat: APPLICATION_ACCESSIBLE

  do_0:
    id: TASK1
    syssrv: AktspRaiseProtectionHook()

  post_condition_0:
    PROTECTION_HOOK1:
      hookstat: AK_ACTIVATE

  do_1:
    id: PROTECTION_HOOK1
    syssrv: return(PRO_TERMINATEAPPL_RESTART)

  post_condition_1:
    PROTECTION_HOOK1:
      hookstat: AK_STOP
    NT_OSAP_SELF_CORE:
      osapstat: APPLICATION_RESTARTING
    RESTART_TASK1:
      tstat: RUNNING
      curpri: TSK_PRI_MID
      actcnt: 1
    TASK1:
      tstat: SUSPENDED
      getspn:
    SPINLOCK1:
      lockflg: AK_UNLOCK
    TASK2:
      tstat: SUSPENDED
    TASK3:
      tstat: SUSPENDED
    TASK4:
      tstat: SUSPENDED

  do_2:
    id: RESTART_TASK1
    syssrv: GetApplicationState(NT_OSAP_SELF_CORE,&vname1)
    rettype: StatusType
    retval: E_OK

  post_condition_2:
    RESTART_TASK1:
      var:
        vname1:
          value: APPLICATION_RESTARTING

  do_3:
    id: RESTART_TASK1
    syssrv: ChainTask(TASK3)
    rettype: StatusType
    retval: E_OK

  post_condition_3:
    RESTART_TASK1:
      tstat: SUSPENDED
    TASK3:
      tstat: RUNNING
      curpri: TSK_PRI_MID
      actcnt: 1
      bootcnt: 1

  do_4:
    id: TASK3
    syssrv: ActivateTask(TASK1)
    rettype: StatusType
    retval: E_OK

  post_condition_4:
    TASK1:
      tstat: READY
      actcnt: 1
      curpri: TSK_PRI_MID
      bootcnt: 1

  do_5:
    id: TASK3
    syssrv: WaitEvent(EVENT1)
    rettype: StatusType
    retval: E_OK

  post_condition_5:
    TASK3:
      tstat: WAITING
      waievt: EVENT1
    TASK1:
      tstat: RUNNING

  do_6:
    id: TASK1
    syssrv: ActivateTask(TASK2)
    rettype: StatusType
    retval: E_OK

  post_condition_6:
    TASK2:
      tstat: READY
      actcnt: 1
      curpri: TSK_PRI_MID

  do_7:
    id: TASK1
    syssrv: GetSpinlock(SPINLOCK1)
    rettype: StatusType
    retval: E_OK

  post_condition_7:
    TASK1:
      getspn:
        - SPINLOCK1
    SPINLOCK1:
      lockflg: AK_LOCK

  do_8:
    id: TASK1
    syssrv: SetEvent(TASK3,EVENT1)
    rettype: StatusType
    retval: E_OK

  post_condition_8:
    TASK2:
      porder: 1
    TASK3:
      tstat: READY
      curevt: EVENT1
      porder: 2
