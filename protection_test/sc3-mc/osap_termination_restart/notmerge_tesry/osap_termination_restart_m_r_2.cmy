    SCHEDULE_TABLE8:
      type: SCHEDULE_TABLE
      counter: COUNTER2
      syncstrategy: AK_NONE
      repeat: AK_FALSE
      ststat: SCHEDULETABLE_NEXT
      stfrom: SCHEDULE_TABLE7
      duration: ANY_SCDLTBL_DURATION_B
      expoint:
        ANY_SCDLTBL_INIT_OFFSET_B:
          acttsk:
            - TASK2
      osap: NT_OSAP_SELF_CORE_2
      accosap:
        - NT_OSAP_SELF_CORE
    SCHEDULE_TABLE9:
      type: SCHEDULE_TABLE
      counter: COUNTER2
      syncstrategy: AK_NONE
      repeat: AK_FALSE
      ststat: SCHEDULETABLE_RUNNING
      curval: 0
      duration: ANY_SCDLTBL_DURATION_A
      expoint:
        ANY_SCDLTBL_INIT_OFFSET_NOT_0_MAX_A:
          acttsk:
            - TASK3
      osap: NT_OSAP_SELF_CORE_2
      accosap:
        - NT_OSAP_SELF_CORE
    SCHEDULE_TABLE10:
      type: SCHEDULE_TABLE
      counter: COUNTER2
      syncstrategy: AK_NONE
      repeat: AK_FALSE
      ststat: SCHEDULETABLE_NEXT
      stfrom: SCHEDULE_TABLE9
      duration: ANY_SCDLTBL_DURATION_B
      expoint:
        ANY_SCDLTBL_INIT_OFFSET_B:
          acttsk:
            - TASK2
      osap: NT_OSAP_SELF_CORE
    NT_OSAP_SELF_CORE:
      type: OSAP
      osapstat: APPLICATION_ACCESSIBLE

  do_0:
    id: C2ISR1
    syssrv: TerminateApplication(NT_OSAP_SELF_CORE,RESTART)
    rettype: StatusType
    retval: E_OK

  post_condition_0:
    NT_OSAP_SELF_CORE:
      osapstat: APPLICATION_RESTARTING
    TASK1:
      tstat: SUSPENDED
    SCHEDULE_TABLE1:
      ststat: SCHEDULETABLE_STOPPED
    SCHEDULE_TABLE3:
      ststat: SCHEDULETABLE_STOPPED
    SCHEDULE_TABLE5:
      ststat: SCHEDULETABLE_STOPPED
    SCHEDULE_TABLE6:
      ststat: SCHEDULETABLE_STOPPED
    SCHEDULE_TABLE7:
      ststat: SCHEDULETABLE_STOPPED
    SCHEDULE_TABLE8:
      ststat: SCHEDULETABLE_STOPPED
    SCHEDULE_TABLE10:
      ststat: SCHEDULETABLE_STOPPED
    RESTART_TASK1:
      tstat: RUNNING
      actcnt: 1
      curpri: TSK_PRI_MID

  do_1:
    id: RESTART_TASK1
    syssrv: ActivateTask(TASK7)
    rettype: StatusType
    retval: E_OK

  post_condition_1:
    RESTART_TASK1:
      tstat: READY
    TASK7:
      tstat: RUNNING
      curpri: TSK_PRI_HIGH
      actcnt: 1

  do_2:
    id: TASK7
    syssrv: GetApplicationState(NT_OSAP_SELF_CORE,&vname1)
    rettype: StatusType
    retval: E_OK

  post_condition_2:
    TASK7:
      var:
        vname1:
          value: APPLICATION_RESTARTING

