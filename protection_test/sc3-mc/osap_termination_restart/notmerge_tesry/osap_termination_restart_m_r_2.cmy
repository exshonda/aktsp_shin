######################################################################
# osap_termination_restart_m_r_2_0001.yaml
######################################################################
osap_termination_restart_m_r_2_0001:
  property:
    sc: 
      - SC3
      - SC4

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      osap: NT_OSAP_SELF_CORE
    TASK5:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_HIGH
      osap: TR_OSAP_OTHER_OTHER_CORE
      accosap:
        - NT_OSAP_SELF_CORE
    TASK7:
      type: TASK
      tstat: SUSPENDED
      inipri: TSK_PRI_HIGH
      var:
        vname1:
          type: ApplicationStateType
      osap: TR_OSAP_SELF_CORE
      accosap:
        - NT_OSAP_SELF_CORE
    RESTART_TASK1:
      type: RESTART_TASK
      tstat: SUSPENDED
      inipri: TSK_PRI_MID
      osap: NT_OSAP_SELF_CORE
    ERROR_HOOK1:
      type: ERROR_HOOK
      hookstat: AK_STOP
      target_error_hook_cfg:
        - AK_ONLY_SYSTEM
      coreid: CORE_SELF
    C2ISR1:
      type: C2ISR
      intno: INTNO_OTHER_ISR2_C
      iniintpri: INT_PRI_MID
      rtnstat: AK_ACTIVATE
      osap: TR_OSAP_OTHER_OTHER_CORE
    ALARM1:
      type: ALARM
      almact: AK_ALM_ATSK
      counter: COUNTER1
      astat: AK_SET
      almval: ANY_CURVAL_NOT_0_A
      cycle: ANY_ALMCYCLE_A
      task: TASK1
      osap: NT_OSAP_SELF_CORE
    ALARM2:
      type: ALARM
      almact: AK_ALM_ATSK
      counter: COUNTER1
      astat: AK_UNSET
      task: TASK1
      osap: NT_OSAP_SELF_CORE
    COUNTER1:
      type: COUNTER
      ctype: AK_SOFTWARE
      mincyc: ANY_MINCYC_A
      maxval: ANY_MAXVAL_A
      curval: 0
      cstat: AK_CS_NULL
      osap: TR_OSAP_SELF_CORE
      accosap:
        - NT_OSAP_SELF_CORE
    NT_OSAP_SELF_CORE:
      type: OSAP
      osapstat: APPLICATION_ACCESSIBLE

  do_0:
    id: C2ISR1
    syssrv: TerminateApplication(NT_OSAP_SELF_CORE,RESTART)
    rettype: StatusType
    retval: E_OK

  post_condition_0:
    NT_OSAP_SELF_CORE:
      osapstat: APPLICATION_RESTARTING
    TASK1:
      tstat: SUSPENDED
    ALARM1:
      astat: AK_UNSET
    RESTART_TASK1:
      tstat: RUNNING
      actcnt: 1
      curpri: TSK_PRI_MID

  do_1:
    id: RESTART_TASK1
    syssrv: ActivateTask(TASK7)
    rettype: StatusType
    retval: E_OK

  post_condition_1:
    RESTART_TASK1:
      tstat: READY
    TASK7:
      tstat: RUNNING
      curpri: TSK_PRI_HIGH
      actcnt: 1

  do_2:
    id: TASK7
    syssrv: GetApplicationState(NT_OSAP_SELF_CORE,&vname1)
    rettype: StatusType
    retval: E_OK

  post_condition_2:
    TASK7:
      var:
        vname1:
          value: APPLICATION_RESTARTING

  do_3:
    id: TASK7
    syssrv: AktspCheckAlarmTerminated(ALARM1)
    rettype: StatusType
    retval: E_OS_ACCESS

  post_condition_3:

  do_4:
    id: TASK7
    syssrv: AktspCheckAlarmTerminated(ALARM2)
    rettype: StatusType
    retval: E_OS_ACCESS

  post_condition_4:

  do_5:
    id: TASK7
    syssrv: IncrementCounter(COUNTER1)
    repeat: ANY_SCDLTBL_INIT_OFFSET_B
    rettype: StatusType
    retval: E_OK

  post_condition_5:
    COUNTER1:
      curval: ANY_SCDLTBL_INIT_OFFSET_B
