    id: TASK7
    syssrv: AktspCheckScheduleTableTerminated(SCHEDULE_TABLE1,SCHEDULE_TABLE2,AK_FALSE)
    rettype: StatusType
    retval: E_OS_ACCESS

  post_condition_3:

  do_4:
    id: TASK7
    syssrv: AktspCheckScheduleTableTerminated(SCHEDULE_TABLE2,SCHEDULE_TABLE1,AK_FALSE)
    rettype: StatusType
    retval: E_OS_ACCESS

  post_condition_4:

  do_5:
    id: TASK7
    syssrv: AktspCheckScheduleTableTerminated(SCHEDULE_TABLE3,SCHEDULE_TABLE4,AK_TRUE)
    rettype: StatusType
    retval: E_OS_ACCESS

  post_condition_5:

  do_6:
    id: TASK7
    syssrv: AktspCheckScheduleTableTerminated(SCHEDULE_TABLE4,SCHEDULE_TABLE3,AK_TRUE)
    rettype: StatusType
    retval: E_OS_ACCESS

  post_condition_6:

  do_7:
    id: TASK7
    syssrv: AktspCheckScheduleTableTerminated(SCHEDULE_TABLE5,SCHEDULE_TABLE6,AK_FALSE)
    rettype: StatusType
    retval: E_OS_ACCESS

  post_condition_7:

  do_8:
    id: TASK7
    syssrv: AktspCheckScheduleTableTerminated(SCHEDULE_TABLE6,SCHEDULE_TABLE5,AK_FALSE)
    rettype: StatusType
    retval: E_OS_ACCESS

  post_condition_8:

  do_9:
    id: TASK7
    syssrv: AktspCheckScheduleTableTerminated(SCHEDULE_TABLE7,SCHEDULE_TABLE5,AK_FALSE)
    rettype: StatusType
    retval: E_OS_ACCESS

  post_condition_9:

  do_10:
    id: TASK7
    syssrv: AktspCheckScheduleTableTerminated(SCHEDULE_TABLE10,SCHEDULE_TABLE5,AK_FALSE)
    rettype: StatusType
    retval: E_OS_ACCESS

  post_condition_10:

  do_11:
    id: TASK7
    syssrv: IncrementCounter(COUNTER1)
    repeat: ANY_SCDLTBL_INIT_OFFSET_B
    rettype: StatusType
    retval: E_OK

  post_condition_11:
    COUNTER1:
      curval: ANY_SCDLTBL_INIT_OFFSET_B

  do_12:
    id: TASK7
    syssrv: IncrementCounter(COUNTER2)
    repeat: ANY_SCDLTBL_INIT_OFFSET_NOT_0_B
    rettype: StatusType
    retval: E_OK

  post_condition_12:
    COUNTER2:
      curval: ANY_SCDLTBL_INIT_OFFSET_NOT_0_B
    SCHEDULE_TABLE9:
      curval: ANY_SCDLTBL_INIT_OFFSET_NOT_0_B
    TASK3:
      tstat: READY
      curpri: TSK_PRI_LOW
      actcnt: 1
######################################################################
# osap_termination_restart_m_r_2_0004.yaml
######################################################################
osap_termination_restart_m_r_2_0004:
  property:
    sc: 
      - SC3
      - SC4

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      osap: NT_OSAP_SELF_CORE
    TASK2:
      type: TASK
      tstat: READY
      curpri: TSK_PRI_MID
      osap: NT_OSAP_SELF_CORE
    TASK3:
      type: TASK
      tstat: WAITING
      curpri: TSK_PRI_MID
      ttype: AK_EXTENDED
      curevt: 0
      waievt: EVENT1
      relevt:
        - EVENT1
      osap: NT_OSAP_SELF_CORE
    TASK4:
      type: TASK
      tstat: SUSPENDED
      inipri: TSK_PRI_HIGH
      osap: NT_OSAP_SELF_CORE
    TASK5:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_HIGH
      osap: TR_OSAP_OTHER_OTHER_CORE
      accosap:
        - NT_OSAP_SELF_CORE
    TASK7:
      type: TASK
      tstat: SUSPENDED
      inipri: TSK_PRI_HIGH
      var:
        vname1:
          type: ApplicationStateType
      osap: TR_OSAP_SELF_CORE
      accosap:
        - NT_OSAP_SELF_CORE
    RESTART_TASK1:
      type: RESTART_TASK
      tstat: SUSPENDED
      inipri: TSK_PRI_MID
      osap: NT_OSAP_SELF_CORE
    EVENT1:
      type: EVENT
      mask: EVENTMASK_A
    ERROR_HOOK1:
      type: ERROR_HOOK
      hookstat: AK_STOP
      target_error_hook_cfg:
        - AK_ONLY_SYSTEM
      coreid: CORE_SELF
    C2ISR1:
      type: C2ISR
      intno: INTNO_OTHER_ISR2_C
      iniintpri: INT_PRI_MID
      rtnstat: AK_ACTIVATE
      osap: TR_OSAP_OTHER_OTHER_CORE
    NT_OSAP_SELF_CORE:
      type: OSAP
      osapstat: APPLICATION_ACCESSIBLE

  do_0:
    id: C2ISR1
    syssrv: TerminateApplication(NT_OSAP_SELF_CORE,RESTART)
    rettype: StatusType
    retval: E_OK

  post_condition_0:
    NT_OSAP_SELF_CORE:
      osapstat: APPLICATION_RESTARTING
    TASK1:
      tstat: SUSPENDED
    TASK2:
      tstat: SUSPENDED
    TASK3:
      tstat: SUSPENDED
    TASK4:
      tstat: SUSPENDED
    RESTART_TASK1:
      tstat: RUNNING
      actcnt: 1
      curpri: TSK_PRI_MID

  do_1:
    id: RESTART_TASK1
    syssrv: ActivateTask(TASK7)
    rettype: StatusType
    retval: E_OK

  post_condition_1:
    RESTART_TASK1:
      tstat: READY
    TASK7:
      tstat: RUNNING
      curpri: TSK_PRI_HIGH
      actcnt: 1

  do_2:
    id: TASK7
    syssrv: GetApplicationState(NT_OSAP_SELF_CORE,&vname1)
    rettype: StatusType
    retval: E_OK

  post_condition_2:
    TASK7:
      var:
        vname1:
          value: APPLICATION_RESTARTING

  do_3:
    id: TASK7
    syssrv: AktspCheckTaskTerminated(TASK1,AK_FALSE)
    rettype: StatusType
    retval: E_OS_ACCESS

  post_condition_3:

  do_4:
    id: TASK7
    syssrv: AktspCheckTaskTerminated(TASK2,AK_FALSE)
    rettype: StatusType
    retval: E_OS_ACCESS

  post_condition_4:

  do_5:
    id: TASK7
    syssrv: AktspCheckTaskTerminated(TASK3,AK_FALSE)
    rettype: StatusType
    retval: E_OS_ACCESS

  post_condition_5:

  do_6:
    id: TASK7
    syssrv: AktspCheckTaskTerminated(TASK4,AK_FALSE)
    rettype: StatusType
    retval: E_OS_ACCESS

  post_condition_6:
