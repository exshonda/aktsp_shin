      waievt: EVENT1
      bootcnt: 1
    TASK1:
      tstat: RUNNING

  do_7:
    id: TASK1
    syssrv: GetResource(RESOURCE1)
    rettype: StatusType
    retval: E_OK

  post_condition_7:
    TASK1:
      curpri: TSK_PRI_HIGH
      getres:
        - RESOURCE1
    RESOURCE1:
      lockflg: AK_LOCK

  do_8:
    id: TASK1
    syssrv: ActivateTask(TASK2)
    rettype: StatusType
    retval: E_OK

  post_condition_8:
    TASK2:
      tstat: READY
      actcnt: 1
      curpri: TSK_PRI_MID
######################################################################
