######################################################################
# osap_termination_restart_m_a_2_0001.yaml
######################################################################
osap_termination_restart_m_a_2_0001:
  property:
    sc: 
      - SC3
      - SC4

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      osap: NT_OSAP_SELF_CORE
    TASK5:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      osap: TR_OSAP_OTHER_OTHER_CORE
    TASK7:
      type: TASK
      tstat: SUSPENDED
      inipri: TSK_PRI_HIGH
      var:
        vname1:
          type: ApplicationStateType
      osap: TR_OSAP_SELF_CORE
      accosap:
        - NT_OSAP_SELF_CORE
    RESTART_TASK1:
      type: RESTART_TASK
      tstat: SUSPENDED
      inipri: TSK_PRI_MID
      osap: NT_OSAP_SELF_CORE
    C2ISR1:
      type: C2ISR
      intno: INTNO_OTHER_ISR2_C
      iniintpri: INT_PRI_MID
      rtnstat: AK_ACTIVATE
      osap: TR_OSAP_OTHER_OTHER_CORE
    ALARM1:
      type: ALARM
      almact: AK_ALM_ATSK
      counter: COUNTER1
      astat: AK_SET
      almval: ANY_CURVAL_NOT_0_A
      cycle: ANY_ALMCYCLE_A
      task: TASK1
      osap: NT_OSAP_SELF_CORE
    ALARM2:
      type: ALARM
      almact: AK_ALM_ATSK
      counter: COUNTER1
      astat: AK_UNSET
      task: TASK1
      osap: NT_OSAP_SELF_CORE
    COUNTER1:
      type: COUNTER
      ctype: AK_SOFTWARE
      mincyc: ANY_MINCYC_A
      maxval: ANY_MAXVAL_A
      curval: 0
      cstat: AK_CS_NULL
      osap: TR_OSAP_SELF_CORE
    NT_OSAP_SELF_CORE:
      type: OSAP
      osapstat: APPLICATION_ACCESSIBLE

  do_0:
    id: C2ISR1
    syssrv: TerminateApplication(NT_OSAP_SELF_CORE,RESTART)
    rettype: StatusType
    retval: E_OK

  post_condition_0:
    NT_OSAP_SELF_CORE:
      osapstat: APPLICATION_RESTARTING
    TASK1:
      tstat: SUSPENDED
    ALARM1:
      astat: AK_UNSET
    RESTART_TASK1:
      tstat: RUNNING
      actcnt: 1
      curpri: TSK_PRI_MID

  do_1:
    id: RESTART_TASK1
    syssrv: AllowAccess()
    rettype: StatusType
    retval: E_OK

  post_condition_1:
    NT_OSAP_SELF_CORE:
      osapstat: APPLICATION_ACCESSIBLE

  do_2:
    id: RESTART_TASK1
    syssrv: ChainTask(TASK7)
    rettype: StatusType
    retval: E_OK

  post_condition_2:
    RESTART_TASK1:
      tstat: SUSPENDED
    TASK7:
      tstat: RUNNING
      curpri: TSK_PRI_HIGH
      actcnt: 1

  do_3:
    id: TASK7
    syssrv: GetApplicationState(NT_OSAP_SELF_CORE,&vname1)
    rettype: StatusType
    retval: E_OK

  post_condition_3:
    TASK7:
      var:
        vname1:
          value: APPLICATION_ACCESSIBLE

  do_4:
    id: TASK7
    syssrv: SetAbsAlarm(ALARM1,ANY_CURVAL_NOT_0_A,ANY_ALMCYCLE_A)
    rettype: StatusType
    retval: E_OK

  post_condition_4:
    ALARM1:
      astat: AK_SET
      almval: ANY_CURVAL_NOT_0_A
      cycle: ANY_ALMCYCLE_A

  do_5:
    id: TASK7
    syssrv: IncrementCounter(COUNTER1)
    repeat: ANY_CURVAL_NOT_0_A
    rettype: StatusType
    retval: E_OK

  post_condition_5:
    ALARM1:
      almval: (ANY_CURVAL_NOT_0_A+ANY_ALMCYCLE_A*1)%(ANY_MAXVAL_A+1)
    COUNTER1:
      curval: (ANY_CURVAL_NOT_0_A+ANY_ALMCYCLE_A*0)%(ANY_MAXVAL_A+1)
    TASK1:
      tstat: READY
      curpri: TSK_PRI_MID
      bootcnt: 1
      actcnt: 1
######################################################################
# osap_termination_restart_m_a_2_0002.yaml
######################################################################
osap_termination_restart_m_a_2_0002:
  property:
    sc: 
      - SC3
      - SC4

  pre_condition:
    TASK1:
      type: TASK
