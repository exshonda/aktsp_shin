        - NT_OSAP_SELF_CORE
    RESTART_TASK1:
      type: RESTART_TASK
      tstat: SUSPENDED
      inipri: TSK_PRI_MID
      osap: NT_OSAP_SELF_CORE
    C2ISR1:
      type: C2ISR
      intno: INTNO_OTHER_ISR2_C
      iniintpri: INT_PRI_MID
      rtnstat: AK_ACTIVATE
      osap: TR_OSAP_OTHER_OTHER_CORE
    COUNTER2:
      type: COUNTER
      ctype: AK_SOFTWARE
      mincyc: ANY_MINCYC_A
      maxval: ANY_MAXVAL_A
      curval: ANY_CURVAL_NOT_0_A
      cstat: AK_CS_NULL
      osap: NT_OSAP_SELF_CORE
    COUNTER3:
      type: COUNTER
      ctype: AK_SOFTWARE
      mincyc: ANY_MINCYC_A
      maxval: ANY_MAXVAL_A
      curval: 0
      cstat: AK_CS_NULL
      osap: NT_OSAP_SELF_CORE
    TASK6:
      type: TASK
      tstat: SUSPENDED
      inipri: TSK_PRI_HIGH
      osap: NON_TRUSTED_OSAP1
    ALARM1:
      type: ALARM
      almact: AK_ALM_ATSK
      counter: COUNTER3
      astat: AK_SET
      almval: 1
      cycle: 0
      task: TASK6
      osap: NT_OSAP_SELF_CORE
    NT_OSAP_SELF_CORE:
      type: OSAP
      osapstat: APPLICATION_ACCESSIBLE

  do_0:
    id: TASK1
    syssrv: IncrementCounter(COUNTER3)
    rettype: StatusType
    retval: E_OK

  post_condition_0:
    TASK1:
      tstat: READY
    TASK6:
      tstat: RUNNING
      curpri: TSK_PRI_HIGH
      actcnt: 1
    COUNTER3:
      curval: 1
      cstat: AK_CS_DOING
    ALARM1:
      astat: AK_UNSET

  do_1:
    id: C2ISR1
    syssrv: TerminateApplication(NT_OSAP_SELF_CORE,RESTART)
    rettype: StatusType
    retval: E_OK

  post_condition_1:
    NT_OSAP_SELF_CORE:
      osapstat: APPLICATION_RESTARTING
    TASK1:
      tstat: SUSPENDED
    TASK6:
      tstat: SUSPENDED
    COUNTER2:
      curval: 0
    COUNTER3:
      curval: 0
      cstat: AK_CS_NULL
    RESTART_TASK1:
      tstat: RUNNING
      actcnt: 1
      curpri: TSK_PRI_MID

  do_2:
    id: RESTART_TASK1
    syssrv: AllowAccess()
    rettype: StatusType
    retval: E_OK

  post_condition_2:
    NT_OSAP_SELF_CORE:
      osapstat: APPLICATION_ACCESSIBLE

  do_3:
    id: RESTART_TASK1
    syssrv: ChainTask(TASK7)
    rettype: StatusType
    retval: E_OK

  post_condition_3:
    RESTART_TASK1:
      tstat: SUSPENDED
    TASK7:
      tstat: RUNNING
      curpri: TSK_PRI_HIGH
      actcnt: 1

  do_4:
    id: TASK7
    syssrv: GetApplicationState(NT_OSAP_SELF_CORE,&vname1)
    rettype: StatusType
    retval: E_OK

  post_condition_4:
    TASK7:
      var:
        vname1:
          value: APPLICATION_ACCESSIBLE

  do_5:
    id: TASK7
    syssrv: IncrementCounter(COUNTER2)
    rettype: StatusType
    retval: E_OK

  post_condition_5:
    COUNTER2:
      curval: ANY_CURVAL_NOT_0_A
######################################################################
# osap_termination_restart_m_a_2_0003.yaml
######################################################################
osap_termination_restart_m_a_2_0003:
  property:
    sc: 
      - SC3
      - SC4

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      maxact: ANY_BASIC_MAXACT
      ttype: AK_BASIC
      osap: NT_OSAP_SELF_CORE
    TASK2:
      type: TASK
      tstat: SUSPENDED
      inipri: TSK_PRI_LOW
      maxact: ANY_BASIC_MAXACT
      ttype: AK_BASIC
      osap: NT_OSAP_SELF_CORE
      accosap:
        - NT_OSAP_SELF_CORE_2
    TASK3:
      type: TASK
      tstat: SUSPENDED
      inipri: TSK_PRI_LOW
      maxact: ANY_BASIC_MAXACT
      ttype: AK_BASIC
      osap: NT_OSAP_SELF_CORE
      accosap:
        - NT_OSAP_SELF_CORE_2
    TASK5:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      osap: TR_OSAP_OTHER_OTHER_CORE
    TASK7:
      type: TASK
      tstat: SUSPENDED
      inipri: TSK_PRI_HIGH
      var:
        vname1:
          type: ApplicationStateType
      maxact: ANY_BASIC_MAXACT
      ttype: AK_BASIC
      osap: TR_OSAP_SELF_CORE
      accosap:
        - NT_OSAP_SELF_CORE
    RESTART_TASK1:
      type: RESTART_TASK
      tstat: SUSPENDED
      inipri: TSK_PRI_MID
      osap: NT_OSAP_SELF_CORE
    C2ISR1:
      type: C2ISR
      intno: INTNO_OTHER_ISR2_C
      iniintpri: INT_PRI_MID
      rtnstat: AK_ACTIVATE
      osap: TR_OSAP_OTHER_OTHER_CORE
    COUNTER1:
      type: COUNTER
      ctype: AK_SOFTWARE
      mincyc: ANY_MINCYC_A
      maxval: ANY_MAXVAL_A
      curval: 0
      cstat: AK_CS_NULL
      osap: TR_OSAP_SELF_CORE
    COUNTER2:
      type: COUNTER
      ctype: AK_SOFTWARE
      mincyc: ANY_MINCYC_A
      maxval: ANY_MAXVAL_A
      curval: ANY_CURVAL_A
      cstat: AK_CS_NULL
      osap: TR_OSAP_SELF_CORE
      accosap:
        - NT_OSAP_SELF_CORE
    SCHEDULE_TABLE1:
      type: SCHEDULE_TABLE
      counter: COUNTER1
      syncstrategy: AK_NONE
      repeat: AK_FALSE
      ststat: SCHEDULETABLE_RUNNING
      curval: 0
      duration: ANY_SCDLTBL_DURATION_A
      expoint:
        ANY_SCDLTBL_INIT_OFFSET_A:
          acttsk:
            - TASK1
      osap: NT_OSAP_SELF_CORE
    SCHEDULE_TABLE2:
      type: SCHEDULE_TABLE
      counter: COUNTER1
      syncstrategy: AK_NONE
      repeat: AK_FALSE
      ststat: SCHEDULETABLE_STOPPED
      duration: ANY_SCDLTBL_DURATION_A
      expoint:
        ANY_SCDLTBL_INIT_OFFSET_A:
          acttsk:
            - TASK1
      osap: NT_OSAP_SELF_CORE
    SCHEDULE_TABLE3:
      type: SCHEDULE_TABLE
      counter: COUNTER1
      syncstrategy: AK_IMPLICIT
      repeat: AK_FALSE
      ststat: SCHEDULETABLE_RUNNING_AND_SYNCHRONOUS
      curval: 0
      duration: ANY_MAXVAL_A+1
      expoint:
        ANY_SCDLTBL_INIT_OFFSET_A+1:
          acttsk:
            - TASK7
      osap: NT_OSAP_SELF_CORE
    SCHEDULE_TABLE4:
      type: SCHEDULE_TABLE
      counter: COUNTER1
      syncstrategy: AK_IMPLICIT
      repeat: AK_FALSE
      ststat: SCHEDULETABLE_STOPPED
      duration: ANY_MAXVAL_A+1
      expoint:
        ANY_SCDLTBL_INIT_OFFSET_A+1:
          acttsk:
            - TASK7
      osap: NT_OSAP_SELF_CORE
    SCHEDULE_TABLE5:
      type: SCHEDULE_TABLE
      counter: COUNTER2
      syncstrategy: AK_NONE
      repeat: AK_FALSE
      ststat: SCHEDULETABLE_RUNNING
      curval: 0
      duration: ANY_SCDLTBL_DURATION_A
      expoint:
        ANY_SCDLTBL_INIT_OFFSET_NOT_0_MAX_A:
          acttsk:
            - TASK3
      osap: NT_OSAP_SELF_CORE
    SCHEDULE_TABLE6:
      type: SCHEDULE_TABLE
      counter: COUNTER2
      syncstrategy: AK_NONE
      repeat: AK_FALSE
      ststat: SCHEDULETABLE_NEXT
      stfrom: SCHEDULE_TABLE5
      duration: ANY_SCDLTBL_DURATION_B
      expoint:
        ANY_SCDLTBL_INIT_OFFSET_B:
          acttsk:
            - TASK2
      osap: NON_TRUSTED_OSAP1
    SCHEDULE_TABLE7:
      type: SCHEDULE_TABLE
      counter: COUNTER2
      syncstrategy: AK_NONE
      repeat: AK_FALSE
      ststat: SCHEDULETABLE_RUNNING
      curval: 0
      duration: ANY_SCDLTBL_DURATION_A
      expoint:
        ANY_SCDLTBL_INIT_OFFSET_NOT_0_MAX_A:
          acttsk:
            - TASK3
      osap: NT_OSAP_SELF_CORE
    SCHEDULE_TABLE8:
      type: SCHEDULE_TABLE
      counter: COUNTER2
      syncstrategy: AK_NONE
      repeat: AK_FALSE
      ststat: SCHEDULETABLE_NEXT
      stfrom: SCHEDULE_TABLE7
      duration: ANY_SCDLTBL_DURATION_B
      expoint:
        ANY_SCDLTBL_INIT_OFFSET_B:
          acttsk:
            - TASK2
      osap: NT_OSAP_SELF_CORE_2
      accosap:
        - NT_OSAP_SELF_CORE
    SCHEDULE_TABLE9:
      type: SCHEDULE_TABLE
      counter: COUNTER2
      syncstrategy: AK_NONE
      repeat: AK_FALSE
      ststat: SCHEDULETABLE_RUNNING
      curval: 0
      duration: ANY_SCDLTBL_DURATION_A
      expoint:
        ANY_SCDLTBL_INIT_OFFSET_NOT_0_MAX_A:
          acttsk:
            - TASK3
      osap: NT_OSAP_SELF_CORE_2
      accosap:
        - NT_OSAP_SELF_CORE
    SCHEDULE_TABLE10:
      type: SCHEDULE_TABLE
      counter: COUNTER2
      syncstrategy: AK_NONE
      repeat: AK_FALSE
      ststat: SCHEDULETABLE_NEXT
      stfrom: SCHEDULE_TABLE9
      duration: ANY_SCDLTBL_DURATION_B
      expoint:
        ANY_SCDLTBL_INIT_OFFSET_B:
          acttsk:
            - TASK2
      osap: NT_OSAP_SELF_CORE
    NT_OSAP_SELF_CORE:
      type: OSAP
      osapstat: APPLICATION_ACCESSIBLE

  do_0:
    id: C2ISR1
    syssrv: TerminateApplication(NT_OSAP_SELF_CORE,RESTART)
    rettype: StatusType
    retval: E_OK

  post_condition_0:
    NT_OSAP_SELF_CORE:
      osapstat: APPLICATION_RESTARTING
    TASK1:
      tstat: SUSPENDED
    SCHEDULE_TABLE1:
      ststat: SCHEDULETABLE_STOPPED
    SCHEDULE_TABLE3:
      ststat: SCHEDULETABLE_STOPPED
    SCHEDULE_TABLE5:
      ststat: SCHEDULETABLE_STOPPED
    SCHEDULE_TABLE6:
      ststat: SCHEDULETABLE_STOPPED
    SCHEDULE_TABLE7:
      ststat: SCHEDULETABLE_STOPPED
    SCHEDULE_TABLE8:
      ststat: SCHEDULETABLE_STOPPED
    SCHEDULE_TABLE10:
      ststat: SCHEDULETABLE_STOPPED
    RESTART_TASK1:
      tstat: RUNNING
      actcnt: 1
      curpri: TSK_PRI_MID

  do_1:
    id: RESTART_TASK1
    syssrv: AllowAccess()
    rettype: StatusType
    retval: E_OK

  post_condition_1:
    NT_OSAP_SELF_CORE:
      osapstat: APPLICATION_ACCESSIBLE

  do_2:
    id: RESTART_TASK1
    syssrv: ChainTask(TASK7)
    rettype: StatusType
    retval: E_OK

  post_condition_2:
    RESTART_TASK1:
      tstat: SUSPENDED
    TASK7:
      tstat: RUNNING
      curpri: TSK_PRI_HIGH
      actcnt: 1

  do_3:
    id: TASK7
    syssrv: GetApplicationState(NT_OSAP_SELF_CORE,&vname1)
    rettype: StatusType
    retval: E_OK

  post_condition_3:
    TASK7:
      var:
        vname1:
          value: APPLICATION_ACCESSIBLE

  do_4:
    id: TASK7
    syssrv: StartScheduleTableAbs(SCHEDULE_TABLE1,0)
    rettype: StatusType
    retval: E_OK

  post_condition_4:
    SCHEDULE_TABLE1:
      ststat: SCHEDULETABLE_RUNNING

  do_5:
    id: TASK7
    syssrv: StartScheduleTableAbs(SCHEDULE_TABLE3,0)
    rettype: StatusType
    retval: E_OK

  post_condition_5:
    SCHEDULE_TABLE3:
      ststat: SCHEDULETABLE_RUNNING_AND_SYNCHRONOUS

  do_6:
    id: TASK7
    syssrv: IncrementCounter(COUNTER1)
    repeat: ANY_MAXVAL_A+1
    rettype: StatusType
    retval: E_OK

  post_condition_6:
    SCHEDULE_TABLE3:
      ststat: SCHEDULETABLE_RUNNING_AND_SYNCHRONOUS
      curval: 0
    SCHEDULE_TABLE1:
      curval: 0

  do_7:
    id: TASK7
    syssrv: IncrementCounter(COUNTER1)
    repeat: ANY_SCDLTBL_INIT_OFFSET_A
    rettype: StatusType
    retval: E_OK

  post_condition_7:
    COUNTER1:
      curval: ANY_SCDLTBL_INIT_OFFSET_A
    SCHEDULE_TABLE1:
      curval: ANY_SCDLTBL_INIT_OFFSET_A
    SCHEDULE_TABLE3:
      curval: ANY_SCDLTBL_INIT_OFFSET_A
    TASK1:
      tstat: READY
      curpri: TSK_PRI_MID
      bootcnt: 1
      actcnt: 1

  do_8:
    id: TASK7
    syssrv: IncrementCounter(COUNTER1)
    rettype: StatusType
    retval: E_OK

  post_condition_8:
    COUNTER1:
      curval: ANY_SCDLTBL_INIT_OFFSET_A+1
    SCHEDULE_TABLE1:
      curval: ANY_SCDLTBL_INIT_OFFSET_A+1
    SCHEDULE_TABLE3:
      curval: ANY_SCDLTBL_INIT_OFFSET_A+1
    TASK7:
      tstat: RUNNING
      actcnt: 2

  do_9:
    id: TASK7
    syssrv: NextScheduleTable(SCHEDULE_TABLE9,SCHEDULE_TABLE10)
    rettype: StatusType
    retval: E_OK

  post_condition_9:
    SCHEDULE_TABLE10:
      ststat: SCHEDULETABLE_NEXT
      stfrom: SCHEDULE_TABLE9

  do_10:
    id: TASK7
    syssrv: IncrementCounter(COUNTER2)
    repeat: ANY_SCDLTBL_DURATION_A
    rettype: StatusType
    retval: E_OK

  post_condition_10:
    COUNTER2:
      curval: (ANY_CURVAL_A+ANY_SCDLTBL_DURATION_A)%(ANY_MAXVAL_A+1)
    SCHEDULE_TABLE9:
      ststat: SCHEDULETABLE_STOPPED
    SCHEDULE_TABLE10:
      ststat: SCHEDULETABLE_RUNNING
      curval: 0
    TASK3:
      tstat: READY
      curpri: TSK_PRI_LOW
      actcnt: 1

  do_11:
    id: TASK7
    syssrv: IncrementCounter(COUNTER2)
    repeat: ANY_SCDLTBL_DURATION_B
    rettype: StatusType
    retval: E_OK

  post_condition_11:
    COUNTER2:
      curval: (ANY_CURVAL_A+ANY_SCDLTBL_DURATION_A+ANY_SCDLTBL_DURATION_B*1)%(ANY_MAXVAL_A+1)
    SCHEDULE_TABLE10:
      ststat: SCHEDULETABLE_STOPPED
    TASK2:
      tstat: READY
      curpri: TSK_PRI_LOW
      actcnt: 1
      porder: 2
    TASK3:
      porder: 1

  do_12:
    id: TASK7
    syssrv: StartScheduleTableAbs(SCHEDULE_TABLE5,0)
    rettype: StatusType
    retval: E_OK

  post_condition_12:
    SCHEDULE_TABLE5:
      ststat: SCHEDULETABLE_RUNNING

  do_13:
    id: TASK7
    syssrv: StartScheduleTableAbs(SCHEDULE_TABLE7,0)
    rettype: StatusType
    retval: E_OK

  post_condition_13:
    SCHEDULE_TABLE7:
      ststat: SCHEDULETABLE_RUNNING

  do_14:
    id: TASK7
    syssrv: NextScheduleTable(SCHEDULE_TABLE5,SCHEDULE_TABLE6)
    rettype: StatusType
    retval: E_OK

  post_condition_14:
    SCHEDULE_TABLE6:
      ststat: SCHEDULETABLE_NEXT
      stfrom: SCHEDULE_TABLE5

  do_15:
    id: TASK7
    syssrv: NextScheduleTable(SCHEDULE_TABLE7,SCHEDULE_TABLE8)
    rettype: StatusType
    retval: E_OK

  post_condition_15:
    SCHEDULE_TABLE8:
      ststat: SCHEDULETABLE_NEXT
      stfrom: SCHEDULE_TABLE7

  do_16:
    id: TASK7
    syssrv: IncrementCounter(COUNTER2)
    repeat: (ANY_MAXVAL_A+1)-((ANY_CURVAL_A+ANY_SCDLTBL_DURATION_A+ANY_SCDLTBL_DURATION_B*1)%(ANY_MAXVAL_A+1))
    rettype: StatusType
    retval: E_OK

  post_condition_16:
    COUNTER2:
      curval: 0
    SCHEDULE_TABLE5:
      curval: 0
    SCHEDULE_TABLE7:
      curval: 0

  do_17:
    id: TASK7
    syssrv: IncrementCounter(COUNTER2)
    repeat: ANY_SCDLTBL_DURATION_A
    rettype: StatusType
    retval: E_OK

  post_condition_17:
    COUNTER2:
      curval: (ANY_CURVAL_A+ANY_SCDLTBL_DURATION_A)%(ANY_MAXVAL_A+1)
    SCHEDULE_TABLE5:
      ststat: SCHEDULETABLE_STOPPED
    SCHEDULE_TABLE7:
      ststat: SCHEDULETABLE_STOPPED
    SCHEDULE_TABLE6:
      ststat: SCHEDULETABLE_RUNNING
      curval: 0
    SCHEDULE_TABLE8:
      ststat: SCHEDULETABLE_RUNNING
      curval: 0
    TASK3:
      actcnt: 3

  do_18:
    id: TASK7
    syssrv: IncrementCounter(COUNTER2)
    repeat: ANY_SCDLTBL_DURATION_B
    rettype: StatusType
    retval: E_OK

  post_condition_18:
    COUNTER2:
      curval: (ANY_CURVAL_A+ANY_SCDLTBL_DURATION_A+ANY_SCDLTBL_DURATION_B*1)%(ANY_MAXVAL_A+1)
    SCHEDULE_TABLE6:
      ststat: SCHEDULETABLE_STOPPED
    SCHEDULE_TABLE8:
      ststat: SCHEDULETABLE_STOPPED
    TASK2:
      actcnt: 3
######################################################################
# osap_termination_restart_m_a_2_0004.yaml
######################################################################
osap_termination_restart_m_a_2_0004:
  property:
    sc: 
      - SC3
      - SC4

  pre_condition:
    TASK1:
