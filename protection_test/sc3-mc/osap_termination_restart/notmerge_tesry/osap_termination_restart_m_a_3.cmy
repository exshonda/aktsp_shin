######################################################################
# osap_termination_restart_m_a_3_0001.yaml
######################################################################
osap_termination_restart_m_a_3_0001:
  property:
    sc: 
      - SC3
      - SC4

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      getspn:
        - SPINLOCK1
      osap: NT_OSAP_SELF_CORE
    TASK2:
      type: TASK
      tstat: READY
      curpri: TSK_PRI_MID
      osap: NT_OSAP_SELF_CORE
    TASK3:
      type: TASK
      tstat: WAITING
      curpri: TSK_PRI_MID
      ttype: AK_EXTENDED
      curevt: 0
      waievt: EVENT1
      relevt:
        - EVENT1
      osap: NT_OSAP_SELF_CORE
    TASK4:
      type: TASK
      tstat: SUSPENDED
      inipri: TSK_PRI_HIGH
      osap: NT_OSAP_SELF_CORE
    TASK5:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      osap: TR_OSAP_OTHER_OTHER_CORE
    TASK7:
      type: TASK
      tstat: SUSPENDED
      inipri: TSK_PRI_HIGH
      var:
        vname1:
          type: ApplicationStateType
      osap: TR_OSAP_SELF_CORE
      accosap:
        - NT_OSAP_SELF_CORE
    RESTART_TASK1:
      type: RESTART_TASK
      tstat: SUSPENDED
      inipri: TSK_PRI_MID
      osap: NT_OSAP_SELF_CORE
    EVENT1:
      type: EVENT
      mask: EVENTMASK_A
    SPINLOCK1:
      type: SPINLOCK
      susint: AK_SUS_ALL_SPN
      lockflg: AK_LOCK
      accosap:
        - NT_OSAP_SELF_CORE
        - TR_OSAP_OTHER_OTHER_CORE
    C2ISR1:
      type: C2ISR
      intno: INTNO_OTHER_ISR2_C
      iniintpri: INT_PRI_MID
      rtnstat: AK_ACTIVATE
      osap: TR_OSAP_OTHER_OTHER_CORE
    NT_OSAP_SELF_CORE:
      type: OSAP
      osapstat: APPLICATION_ACCESSIBLE
    INT_STATE1:
      type: INT_STATE
      istat:
        - AK_SUS_ALL_INT: SPINLOCK1

  do_0:
    id: C2ISR1
    syssrv: TerminateApplication(NT_OSAP_SELF_CORE,RESTART)
    rettype: StatusType
    retval: E_OK

  post_condition_0:
    NT_OSAP_SELF_CORE:
      osapstat: APPLICATION_RESTARTING

  do_1:
    id: TASK1
    syssrv: ReleaseSpinlock(SPINLOCK1)
    rettype: StatusType
    retval: E_OK

  post_condition_1:
    TASK1:
      tstat: SUSPENDED
      getspn:
    TASK2:
      tstat: SUSPENDED
    TASK3:
      tstat: SUSPENDED
    TASK4:
      tstat: SUSPENDED
    SPINLOCK1:
      lockflg: AK_UNLOCK
    RESTART_TASK1:
      tstat: RUNNING
      actcnt: 1
      curpri: TSK_PRI_MID
    INT_STATE1:
      istat:

  do_2:
    id: RESTART_TASK1
    syssrv: AllowAccess()
    rettype: StatusType
    retval: E_OK

  post_condition_2:
    NT_OSAP_SELF_CORE:
      osapstat: APPLICATION_ACCESSIBLE

  do_3:
    id: RESTART_TASK1
    syssrv: ChainTask(TASK7)
    rettype: StatusType
    retval: E_OK

  post_condition_3:
    RESTART_TASK1:
      tstat: SUSPENDED
    TASK7:
      tstat: RUNNING
      curpri: TSK_PRI_HIGH
      actcnt: 1

  do_4:
    id: TASK7
    syssrv: GetApplicationState(NT_OSAP_SELF_CORE,&vname1)
    rettype: StatusType
    retval: E_OK

  post_condition_4:
    TASK7:
      var:
        vname1:
          value: APPLICATION_ACCESSIBLE

  do_5:
    id: TASK7
    syssrv: ChainTask(TASK3)
    rettype: StatusType
    retval: E_OK

  post_condition_5:
    TASK7:
      tstat: SUSPENDED
    TASK3:
      tstat: RUNNING
      curpri: TSK_PRI_MID
      actcnt: 1
      bootcnt: 1

  do_6:
    id: TASK3
    syssrv: ActivateTask(TASK1)
    rettype: StatusType
    retval: E_OK

  post_condition_6:
    TASK1:
      tstat: READY
      actcnt: 1
      curpri: TSK_PRI_MID
      bootcnt: 1

  do_7:
    id: TASK3
    syssrv: WaitEvent(EVENT1)
    rettype: StatusType
    retval: E_OK

  post_condition_7:
    TASK3:
      tstat: WAITING
      waievt: EVENT1
      bootcnt: 1
    TASK1:
      tstat: RUNNING

  do_8:
    id: TASK1
    syssrv: ActivateTask(TASK2)
    rettype: StatusType
    retval: E_OK

  post_condition_8:
    TASK2:
      tstat: READY
      actcnt: 1
      curpri: TSK_PRI_MID

  do_9:
    id: TASK1
    syssrv: GetSpinlock(SPINLOCK1)
    rettype: StatusType
    retval: E_OK

  post_condition_9:
    TASK1:
      getspn:
        - SPINLOCK1
    SPINLOCK1:
      lockflg: AK_LOCK
    INT_STATE1:
      istat:
        - AK_SUS_ALL_INT: SPINLOCK1
