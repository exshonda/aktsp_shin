  post_condition_1:
    PROTECTION_HOOK1:
      hookstat: AK_STOP
    NON_TRUSTED_OSAP1:
      osapstat: APPLICATION_TERMINATED
    TASK5:
      tstat: RUNNING
    TASK1:
      tstat: SUSPENDED
      getres:
    TASK2:
      tstat: SUSPENDED
    TASK3:
      tstat: SUSPENDED
    TASK4:
      tstat: SUSPENDED
    RESOURCE1:
      lockflg: AK_UNLOCK

  do_2:
    id: TASK5
    syssrv: GetApplicationState(NON_TRUSTED_OSAP1,&vname1)
    rettype: StatusType
    retval: E_OK

  post_condition_2:
    TASK5:
      var:
        vname1:
          value: APPLICATION_TERMINATED

  do_3:
    id: TASK5
    syssrv: AktspCheckTaskTerminated(TASK1,AK_TRUE)
    rettype: StatusType
    retval: E_OS_ACCESS

  post_condition_3:

  do_4:
    id: TASK5
    syssrv: AktspCheckTaskTerminated(TASK2,AK_TRUE)
    rettype: StatusType
    retval: E_OS_ACCESS

  post_condition_4:

  do_5:
    id: TASK5
    syssrv: AktspCheckTaskTerminated(TASK3,AK_TRUE)
    rettype: StatusType
    retval: E_OS_ACCESS

  post_condition_5:

  do_6:
    id: TASK5
    syssrv: AktspCheckTaskTerminated(TASK4,AK_TRUE)
    rettype: StatusType
    retval: E_OS_ACCESS

  post_condition_6:
