        vname1:
          type: ApplicationStateType
      porder: 1
      osap: TRUSTED_OSAP1
      accosap:
        - NON_TRUSTED_OSAP1
    RESOURCE1:
      type: RESOURCE
      resprop: AK_INTERNAL
