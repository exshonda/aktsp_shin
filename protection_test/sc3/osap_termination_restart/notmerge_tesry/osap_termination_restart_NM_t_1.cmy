  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      inipri: TSK_PRI_MID
      curpri: TSK_PRI_HIGH
      relres:
        - RESOURCE1
      getres:
        - RESOURCE2
      osap: NON_TRUSTED_OSAP1
    TASK2:
      type: TASK
      tstat: READY
      curpri: TSK_PRI_MID
      porder: 2
      osap: NON_TRUSTED_OSAP1
    TASK3:
      type: TASK
      tstat: WAITING
      curpri: TSK_PRI_MID
      ttype: AK_EXTENDED
      curevt: 0
      waievt: EVENT1
      relevt:
        - EVENT1
      osap: NON_TRUSTED_OSAP1
    TASK4:
      type: TASK
      tstat: SUSPENDED
      inipri: TSK_PRI_HIGH
      relres:
        - RESOURCE1
      osap: NON_TRUSTED_OSAP1
    TASK5:
      type: TASK
      tstat: READY
      curpri: TSK_PRI_MID
      var:
        vname1:
          type: ApplicationStateType
      porder: 1
      osap: TRUSTED_OSAP1
      accosap:
        - NON_TRUSTED_OSAP1
    RESOURCE1:
      type: RESOURCE
      resprop: AK_STANDARD
      lockflg: AK_UNLOCK
      accosap:
        - NON_TRUSTED_OSAP1
    RESOURCE2:
      type: RESOURCE
      resprop: AK_LINKED
      linkres: RESOURCE1
      lockflg: AK_LOCK
    EVENT1:
      type: EVENT
      mask: EVENTMASK_A
    PROTECTION_HOOK1:
      type: PROTECTION_HOOK
      hookstat: AK_STOP
    NON_TRUSTED_OSAP1:
      type: OSAP
      osapstat: APPLICATION_ACCESSIBLE

  do_0:
    id: TASK1
    syssrv: AktspRaiseProtectionHook()

  post_condition_0:
    PROTECTION_HOOK1:
      hookstat: AK_ACTIVATE

  do_1:
    id: PROTECTION_HOOK1
    syssrv: return(PRO_TERMINATEAPPL)

  post_condition_1:
    PROTECTION_HOOK1:
      hookstat: AK_STOP
    NON_TRUSTED_OSAP1:
      osapstat: APPLICATION_TERMINATED
    TASK5:
      tstat: RUNNING
    TASK1:
      tstat: SUSPENDED
      getres:
    TASK2:
      tstat: SUSPENDED
    TASK3:
      tstat: SUSPENDED
    TASK4:
      tstat: SUSPENDED
    RESOURCE2:
      lockflg: AK_UNLOCK

  do_2:
    id: TASK5
    syssrv: GetApplicationState(NON_TRUSTED_OSAP1,&vname1)
    rettype: StatusType
    retval: E_OK

  post_condition_2:
    TASK5:
      var:
        vname1:
          value: APPLICATION_TERMINATED

  do_3:
    id: TASK5
    syssrv: AktspCheckTaskTerminated(TASK1,AK_TRUE)
    rettype: StatusType
    retval: E_OS_ACCESS

  post_condition_3:

  do_4:
    id: TASK5
    syssrv: AktspCheckTaskTerminated(TASK2,AK_TRUE)
    rettype: StatusType
    retval: E_OS_ACCESS

  post_condition_4:

  do_5:
    id: TASK5
    syssrv: AktspCheckTaskTerminated(TASK3,AK_TRUE)
    rettype: StatusType
    retval: E_OS_ACCESS

  post_condition_5:

  do_6:
    id: TASK5
    syssrv: AktspCheckTaskTerminated(TASK4,AK_TRUE)
    rettype: StatusType
    retval: E_OS_ACCESS

  post_condition_6:
