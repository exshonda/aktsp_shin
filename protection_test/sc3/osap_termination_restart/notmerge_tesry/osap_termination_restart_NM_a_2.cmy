######################################################################
# osap_termination_restart_NM_a_2_0011.yaml
######################################################################
osap_termination_restart_NM_a_2_0011:
  property:
    sc: 
      - SC3
      - SC4

  pre_condition:
    TASK1:
      type: TASK
      tstat: READY
      curpri: TSK_PRI_LOW
      osap: NON_TRUSTED_OSAP2
    TASK3:
      type: TASK
      tstat: WAITING
      inipri: TSK_PRI_LOW
      curpri: TSK_PRI_LOW
      ttype: AK_EXTENDED
      curevt: 0
      waievt: EVENT1
      relevt:
        - EVENT1
      osap: NON_TRUSTED_OSAP2
    TASK4:
      type: TASK
      tstat: SUSPENDED
      inipri: TSK_PRI_MID
      osap: NON_TRUSTED_OSAP2
    TASK5:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_HIGH
      var:
        vname1:
          type: ApplicationStateType
      osap: TRUSTED_OSAP1
      accosap:
        - NON_TRUSTED_OSAP2
    RESTART_TASK1:
      type: RESTART_TASK
      tstat: SUSPENDED
      inipri: TSK_PRI_TOP
      osap: NON_TRUSTED_OSAP2
    EVENT1:
      type: EVENT
      mask: EVENTMASK_A
    NON_TRUSTED_OSAP2:
      type: OSAP
      osapstat: APPLICATION_ACCESSIBLE

  do_0:
    id: TASK5
    syssrv: TerminateApplication(NON_TRUSTED_OSAP2,RESTART)
    rettype: StatusType
    retval: E_OK

  post_condition_0:
    NON_TRUSTED_OSAP2:
      osapstat: APPLICATION_RESTARTING
    TASK1:
      tstat: SUSPENDED
    TASK3:
      tstat: SUSPENDED
    TASK4:
      tstat: SUSPENDED
    TASK5:
      tstat: READY
    RESTART_TASK1:
      tstat: RUNNING
      actcnt: 1
      curpri: TSK_PRI_TOP

  do_1:
    id: RESTART_TASK1
    syssrv: AllowAccess()
    rettype: StatusType
    retval: E_OK

  post_condition_1:
    NON_TRUSTED_OSAP2:
      osapstat: APPLICATION_ACCESSIBLE

  do_2:
    id: RESTART_TASK1
    syssrv: TerminateTask()
    rettype: StatusType
    retval: E_OK

  post_condition_2:
    RESTART_TASK1:
      tstat: SUSPENDED
    TASK5:
      tstat: RUNNING

  do_3:
    id: TASK5
    syssrv: GetApplicationState(NON_TRUSTED_OSAP2,&vname1)
    rettype: StatusType
    retval: E_OK

  post_condition_3:
    TASK5:
      var:
        vname1:
          value: APPLICATION_ACCESSIBLE

  do_4:
    id: TASK5
    syssrv: ChainTask(TASK3)
    rettype: StatusType
    retval: E_OK

  post_condition_4:
    TASK5:
      tstat: SUSPENDED
    TASK3:
      tstat: RUNNING
      curpri: TSK_PRI_LOW
      actcnt: 1
      bootcnt: 1

  do_5:
    id: TASK3
    syssrv: ActivateTask(TASK1)
    rettype: StatusType
    retval: E_OK

  post_condition_5:
    TASK1:
      tstat: READY
      actcnt: 1
      curpri: TSK_PRI_LOW
      bootcnt: 1

  do_6:
    id: TASK3
    syssrv: WaitEvent(EVENT1)
    rettype: StatusType
    retval: E_OK

  post_condition_6:
    TASK3:
      tstat: WAITING
      waievt: EVENT1
      bootcnt: 1
    TASK1:
      tstat: RUNNING

