######################################################################
# osap_termination_restart_NM_a_2_0001.yaml
######################################################################
osap_termination_restart_NM_a_2_0001:
  property:
    sc: 
      - SC3
      - SC4

  pre_condition:
    TASK1:
      type: TASK
      tstat: READY
      curpri: TSK_PRI_MID
      osap: NON_TRUSTED_OSAP2
    TASK5:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_HIGH
      var:
        vname1:
          type: ApplicationStateType
      osap: TRUSTED_OSAP1
      accosap:
        - NON_TRUSTED_OSAP2
    RESTART_TASK1:
      type: RESTART_TASK
      tstat: SUSPENDED
      inipri: TSK_PRI_TOP
      osap: NON_TRUSTED_OSAP2
    C2ISR1:
      type: C2ISR
      intno: INTNO_SELF_C2ISR_MID_A
      iniintpri: INT_PRI_MID
      rtnstat: AK_STOP
      accosap:
        - NON_TRUSTED_OSAP1
      osap: TRUSTED_OSAP1
    ALARM1:
      type: ALARM
      almact: AK_ALM_ATSK
      counter: COUNTER1
      astat: AK_SET
      almval: ANY_CURVAL_NOT_0_A
      cycle: ANY_ALMCYCLE_A
      task: TASK1
      osap: NON_TRUSTED_OSAP2
    ALARM2:
      type: ALARM
      almact: AK_ALM_ATSK
      counter: COUNTER1
      astat: AK_UNSET
      task: TASK1
      osap: NON_TRUSTED_OSAP2
    COUNTER1:
      type: COUNTER
      ctype: AK_SOFTWARE
      mincyc: ANY_MINCYC_A
      maxval: ANY_MAXVAL_A
      curval: 0
      cstat: AK_CS_NULL
      osap: TRUSTED_OSAP1
    NON_TRUSTED_OSAP2:
      type: OSAP
      osapstat: APPLICATION_ACCESSIBLE

  do_0:
    id: TASK5
    syssrv: AktspRaiseInterrupt(INTNO_SELF_C2ISR_MID_A)

  post_condition_0:
    C2ISR1:
      rtnstat: AK_ACTIVATE

  do_1:
    id: C2ISR1
    syssrv: TerminateApplication(NON_TRUSTED_OSAP2,RESTART)
    rettype: StatusType
    retval: E_OK

  post_condition_1:
    NON_TRUSTED_OSAP2:
      osapstat: APPLICATION_RESTARTING
    ALARM1:
      astat: AK_UNSET
    RESTART_TASK1:
      tstat: READY
      actcnt: 1
      curpri: TSK_PRI_MAX

  do_2:
    id: C2ISR1
    syssrv: return

  post_condition_2:
    C2ISR1:
      rtnstat: AK_STOP
    RESTART_TASK1:
      tstat: RUNNING
      actcnt: 1
      curpri: TSK_PRI_TOP
    TASK5:
      tstat: READY
    TASK1:
      tstat: SUSPENDED

  do_3:
    id: RESTART_TASK1
    syssrv: AllowAccess()
    rettype: StatusType
    retval: E_OK

  post_condition_3:
    NON_TRUSTED_OSAP2:
      osapstat: APPLICATION_ACCESSIBLE

  do_4:
    id: RESTART_TASK1
    syssrv: TerminateTask()
    rettype: StatusType
    retval: E_OK

  post_condition_4:
    RESTART_TASK1:
      tstat: SUSPENDED
    TASK5:
      tstat: RUNNING

  do_5:
    id: TASK5
    syssrv: GetApplicationState(NON_TRUSTED_OSAP2,&vname1)
    rettype: StatusType
    retval: E_OK

  post_condition_5:
    TASK5:
      var:
        vname1:
          value: APPLICATION_ACCESSIBLE

  do_6:
    id: TASK5
    syssrv: SetAbsAlarm(ALARM1,ANY_CURVAL_NOT_0_A,ANY_ALMCYCLE_A)
    rettype: StatusType
    retval: E_OK

  post_condition_6:
    ALARM1:
      astat: AK_SET
      almval: ANY_CURVAL_NOT_0_A
      cycle: ANY_ALMCYCLE_A

  do_7:
    id: TASK5
    syssrv: IncrementCounter(COUNTER1)
    repeat: ANY_CURVAL_NOT_0_A
    rettype: StatusType
    retval: E_OK

  post_condition_7:
    ALARM1:
      almval: (ANY_CURVAL_NOT_0_A+ANY_ALMCYCLE_A*1)%(ANY_MAXVAL_A+1)
    COUNTER1:
      curval: (ANY_CURVAL_NOT_0_A+ANY_ALMCYCLE_A*0)%(ANY_MAXVAL_A+1)
    TASK1:
      tstat: READY
      curpri: TSK_PRI_MID
      bootcnt: 1
      actcnt: 1
######################################################################
# osap_termination_restart_NM_a_2_0002.yaml
######################################################################
osap_termination_restart_NM_a_2_0002:
  property:
    sc: 
      - SC3
      - SC4

  pre_condition:
    TASK1:
      type: TASK
      tstat: SUSPENDED
      inipri: TSK_PRI_MID
      osap: NON_TRUSTED_OSAP2
    TASK5:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      osap: TRUSTED_OSAP1
      accosap:
        - NON_TRUSTED_OSAP2
    RESTART_TASK1:
      type: RESTART_TASK
      tstat: SUSPENDED
      inipri: TSK_PRI_TOP
      osap: NON_TRUSTED_OSAP2
    C2ISR1:
      type: C2ISR
      intno: INTNO_SELF_C2ISR_MID_A
      iniintpri: INT_PRI_MID
      rtnstat: AK_STOP
      accosap:
        - NON_TRUSTED_OSAP1
      osap: TRUSTED_OSAP1
    COUNTER2:
      type: COUNTER
      ctype: AK_SOFTWARE
      mincyc: ANY_MINCYC_A
      maxval: ANY_MAXVAL_A
      curval: ANY_CURVAL_NOT_0_A
      cstat: AK_CS_NULL
      osap: NON_TRUSTED_OSAP2
    COUNTER3:
      type: COUNTER
      ctype: AK_SOFTWARE
      mincyc: ANY_MINCYC_A
      maxval: ANY_MAXVAL_A
      curval: 0
      cstat: AK_CS_NULL
      osap: NON_TRUSTED_OSAP2
    TASK6:
      type: TASK
      tstat: SUSPENDED
      inipri: TSK_PRI_HIGH
      osap: TRUSTED_OSAP1
      accosap:
        - NON_TRUSTED_OSAP2
      var:
        vname1:
          type: ApplicationStateType
    ALARM1:
      type: ALARM
      almact: AK_ALM_ATSK
      counter: COUNTER3
      astat: AK_SET
      almval: 1
      cycle: 0
      task: TASK6
      osap: NON_TRUSTED_OSAP2
    NON_TRUSTED_OSAP2:
      type: OSAP
      osapstat: APPLICATION_ACCESSIBLE

  do_0:
    id: TASK5
    syssrv: IncrementCounter(COUNTER3)
    rettype: StatusType
    retval: E_OK

  post_condition_0:
    TASK5:
      tstat: READY
    TASK6:
      tstat: RUNNING
      curpri: TSK_PRI_HIGH
      actcnt: 1
    COUNTER3:
      curval: 1
      cstat: AK_CS_DOING
    ALARM1:
      astat: AK_UNSET

  do_1:
    id: TASK6
    syssrv: AktspRaiseInterrupt(INTNO_SELF_C2ISR_MID_A)

  post_condition_1:
    C2ISR1:
      rtnstat: AK_ACTIVATE

  do_2:
    id: C2ISR1
    syssrv: TerminateApplication(NON_TRUSTED_OSAP2,RESTART)
    rettype: StatusType
    retval: E_OK

  post_condition_2:
    NON_TRUSTED_OSAP2:
      osapstat: APPLICATION_RESTARTING
    RESTART_TASK1:
      tstat: READY
      actcnt: 1
      curpri: TSK_PRI_MAX

  do_3:
    id: C2ISR1
    syssrv: return

  post_condition_3:
    C2ISR1:
      rtnstat: AK_STOP
    RESTART_TASK1:
      tstat: RUNNING
      actcnt: 1
      curpri: TSK_PRI_TOP
    TASK6:
      tstat: READY
    TASK1:
      tstat: SUSPENDED
    COUNTER2:
      curval: 0
    COUNTER3:
      curval: 0
      cstat: AK_CS_NULL

  do_4:
    id: RESTART_TASK1
    syssrv: AllowAccess()
    rettype: StatusType
    retval: E_OK

  post_condition_4:
    NON_TRUSTED_OSAP2:
      osapstat: APPLICATION_ACCESSIBLE

  do_5:
    id: RESTART_TASK1
    syssrv: TerminateTask()
    rettype: StatusType
    retval: E_OK

  post_condition_5:
    RESTART_TASK1:
      tstat: SUSPENDED
    TASK6:
      tstat: RUNNING

  do_6:
    id: TASK6
    syssrv: GetApplicationState(NON_TRUSTED_OSAP2,&vname1)
    rettype: StatusType
    retval: E_OK

  post_condition_6:
    TASK6:
      var:
        vname1:
          value: APPLICATION_ACCESSIBLE

  do_7:
    id: TASK6
    syssrv: IncrementCounter(COUNTER2)
    rettype: StatusType
    retval: E_OK

  post_condition_7:
    COUNTER2:
      curval: ANY_CURVAL_NOT_0_A
######################################################################
# osap_termination_restart_NM_a_2_0003.yaml
######################################################################
osap_termination_restart_NM_a_2_0003:
  property:
    sc: 
      - SC3
      - SC4

  pre_condition:
    TASK1:
      type: TASK
      tstat: READY
      curpri: TSK_PRI_LOW
      maxact: ANY_BASIC_MAXACT
      ttype: AK_BASIC
      osap: NON_TRUSTED_OSAP2
    TASK2:
      type: TASK
      tstat: SUSPENDED
      inipri: TSK_PRI_LOW
      maxact: ANY_BASIC_MAXACT
      ttype: AK_BASIC
      accosap:
        - NON_TRUSTED_OSAP3
      osap: NON_TRUSTED_OSAP2
    TASK3:
      type: TASK
      tstat: SUSPENDED
      inipri: TSK_PRI_LOW
      maxact: ANY_BASIC_MAXACT
      ttype: AK_BASIC
      osap: NON_TRUSTED_OSAP3
      accosap:
        - NON_TRUSTED_OSAP2
    TASK5:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_HIGH
      maxact: ANY_BASIC_MAXACT
      ttype: AK_BASIC
      var:
        vname1:
          type: ApplicationStateType
      osap: TRUSTED_OSAP1
      accosap:
        - NON_TRUSTED_OSAP2
        - NON_TRUSTED_OSAP3
    RESTART_TASK1:
      type: RESTART_TASK
      tstat: SUSPENDED
      inipri: TSK_PRI_TOP
      osap: NON_TRUSTED_OSAP2
    C2ISR1:
      type: C2ISR
      intno: INTNO_SELF_C2ISR_MID_A
      iniintpri: INT_PRI_MID
      rtnstat: AK_STOP
      accosap:
        - NON_TRUSTED_OSAP1
      osap: TRUSTED_OSAP1
    COUNTER1:
      type: COUNTER
      ctype: AK_SOFTWARE
      mincyc: ANY_MINCYC_A
      maxval: ANY_MAXVAL_A
      curval: 0
      cstat: AK_CS_NULL
      osap: TRUSTED_OSAP1
    COUNTER2:
      type: COUNTER
      ctype: AK_SOFTWARE
      mincyc: ANY_MINCYC_A
      maxval: ANY_MAXVAL_A
      curval: 0
      cstat: AK_CS_NULL
      osap: TRUSTED_OSAP1
      accosap:
        - NON_TRUSTED_OSAP2
    SCHEDULE_TABLE1:
      type: SCHEDULE_TABLE
      counter: COUNTER1
      syncstrategy: AK_NONE
      repeat: AK_FALSE
      ststat: SCHEDULETABLE_RUNNING
      curval: 0
      duration: ANY_SCDLTBL_DURATION_A
      expoint:
        ANY_SCDLTBL_INIT_OFFSET_A:
          acttsk:
            - TASK1
      osap: NON_TRUSTED_OSAP2
    SCHEDULE_TABLE2:
      type: SCHEDULE_TABLE
      counter: COUNTER1
      syncstrategy: AK_NONE
      repeat: AK_FALSE
      ststat: SCHEDULETABLE_STOPPED
      duration: ANY_SCDLTBL_DURATION_A
      expoint:
        ANY_SCDLTBL_INIT_OFFSET_A:
          acttsk:
            - TASK1
      osap: NON_TRUSTED_OSAP2
    SCHEDULE_TABLE3:
      type: SCHEDULE_TABLE
      counter: COUNTER1
      syncstrategy: AK_IMPLICIT
      repeat: AK_FALSE
      ststat: SCHEDULETABLE_RUNNING_AND_SYNCHRONOUS
      curval: 0
      duration: ANY_MAXVAL_A+1
      expoint:
        ANY_SCDLTBL_INIT_OFFSET_A+1:
          acttsk:
            - TASK5
      osap: NON_TRUSTED_OSAP2
    SCHEDULE_TABLE4:
      type: SCHEDULE_TABLE
      counter: COUNTER1
      syncstrategy: AK_IMPLICIT
      repeat: AK_FALSE
      ststat: SCHEDULETABLE_STOPPED
      duration: ANY_MAXVAL_A+1
      expoint:
        ANY_SCDLTBL_INIT_OFFSET_A+1:
          acttsk:
            - TASK5
      osap: NON_TRUSTED_OSAP2
    SCHEDULE_TABLE5:
      type: SCHEDULE_TABLE
      counter: COUNTER2
      syncstrategy: AK_NONE
      repeat: AK_FALSE
      ststat: SCHEDULETABLE_RUNNING
      curval: 0
      duration: ANY_SCDLTBL_DURATION_A
      expoint:
        ANY_SCDLTBL_INIT_OFFSET_NOT_0_MAX_A:
          acttsk:
            - TASK3
      osap: NON_TRUSTED_OSAP2
    SCHEDULE_TABLE6:
      type: SCHEDULE_TABLE
      counter: COUNTER2
      syncstrategy: AK_NONE
      repeat: AK_FALSE
      ststat: SCHEDULETABLE_NEXT
      stfrom: SCHEDULE_TABLE5
      duration: ANY_SCDLTBL_DURATION_B
      expoint:
        ANY_SCDLTBL_INIT_OFFSET_B:
          acttsk:
            - TASK2
      osap: NON_TRUSTED_OSAP2
    SCHEDULE_TABLE7:
      type: SCHEDULE_TABLE
      counter: COUNTER2
      syncstrategy: AK_NONE
      repeat: AK_FALSE
      ststat: SCHEDULETABLE_RUNNING
      curval: 0
      duration: ANY_SCDLTBL_DURATION_A
      expoint:
        ANY_SCDLTBL_INIT_OFFSET_NOT_0_MAX_A:
          acttsk:
            - TASK3
      osap: NON_TRUSTED_OSAP2
    SCHEDULE_TABLE8:
      type: SCHEDULE_TABLE
      counter: COUNTER2
      syncstrategy: AK_NONE
      repeat: AK_FALSE
      ststat: SCHEDULETABLE_NEXT
      stfrom: SCHEDULE_TABLE7
      duration: ANY_SCDLTBL_DURATION_B
      expoint:
        ANY_SCDLTBL_INIT_OFFSET_B:
          acttsk:
            - TASK2
      osap: NON_TRUSTED_OSAP3
    SCHEDULE_TABLE9:
      type: SCHEDULE_TABLE
      counter: COUNTER2
      syncstrategy: AK_NONE
      repeat: AK_FALSE
      ststat: SCHEDULETABLE_RUNNING
      curval: 0
      duration: ANY_SCDLTBL_DURATION_A
      expoint:
        ANY_SCDLTBL_INIT_OFFSET_NOT_0_MAX_A:
          acttsk:
            - TASK3
      osap: NON_TRUSTED_OSAP3
    SCHEDULE_TABLE10:
      type: SCHEDULE_TABLE
      counter: COUNTER2
      syncstrategy: AK_NONE
      repeat: AK_FALSE
      ststat: SCHEDULETABLE_NEXT
      stfrom: SCHEDULE_TABLE9
      duration: ANY_SCDLTBL_DURATION_B
      expoint:
        ANY_SCDLTBL_INIT_OFFSET_B:
          acttsk:
            - TASK2
      osap: NON_TRUSTED_OSAP2
    NON_TRUSTED_OSAP2:
      type: OSAP
      osapstat: APPLICATION_ACCESSIBLE

  do_0:
    id: TASK5
    syssrv: AktspRaiseInterrupt(INTNO_SELF_C2ISR_MID_A)

  post_condition_0:
    C2ISR1:
      rtnstat: AK_ACTIVATE

  do_1:
    id: C2ISR1
    syssrv: TerminateApplication(NON_TRUSTED_OSAP2,RESTART)
    rettype: StatusType
    retval: E_OK

  post_condition_1:
    NON_TRUSTED_OSAP2:
      osapstat: APPLICATION_RESTARTING
    SCHEDULE_TABLE1:
      ststat: SCHEDULETABLE_STOPPED
    SCHEDULE_TABLE3:
      ststat: SCHEDULETABLE_STOPPED
    SCHEDULE_TABLE5:
      ststat: SCHEDULETABLE_STOPPED
    SCHEDULE_TABLE6:
      ststat: SCHEDULETABLE_STOPPED
    SCHEDULE_TABLE7:
      ststat: SCHEDULETABLE_STOPPED
    SCHEDULE_TABLE8:
      ststat: SCHEDULETABLE_STOPPED
    SCHEDULE_TABLE10:
      ststat: SCHEDULETABLE_STOPPED
    RESTART_TASK1:
      tstat: READY
      actcnt: 1
      curpri: TSK_PRI_MAX

  do_2:
    id: C2ISR1
    syssrv: return

  post_condition_2:
    C2ISR1:
      rtnstat: AK_STOP
    RESTART_TASK1:
      tstat: RUNNING
      actcnt: 1
      curpri: TSK_PRI_TOP
    TASK5:
      tstat: READY
    TASK1:
      tstat: SUSPENDED

  do_3:
    id: RESTART_TASK1
    syssrv: AllowAccess()
    rettype: StatusType
    retval: E_OK

  post_condition_3:
    NON_TRUSTED_OSAP2:
      osapstat: APPLICATION_ACCESSIBLE

  do_4:
    id: RESTART_TASK1
    syssrv: TerminateTask()
    rettype: StatusType
    retval: E_OK

  post_condition_4:
    RESTART_TASK1:
      tstat: SUSPENDED
    TASK5:
      tstat: RUNNING

  do_5:
    id: TASK5
    syssrv: GetApplicationState(NON_TRUSTED_OSAP2,&vname1)
    rettype: StatusType
    retval: E_OK

  post_condition_5:
    TASK5:
      var:
        vname1:
          value: APPLICATION_ACCESSIBLE

  do_6:
    id: TASK5
    syssrv: StartScheduleTableAbs(SCHEDULE_TABLE1,0)
    rettype: StatusType
    retval: E_OK

  post_condition_6:
    SCHEDULE_TABLE1:
      ststat: SCHEDULETABLE_RUNNING

  do_7:
    id: TASK5
    syssrv: StartScheduleTableAbs(SCHEDULE_TABLE3,0)
    rettype: StatusType
    retval: E_OK

  post_condition_7:
    SCHEDULE_TABLE3:
      ststat: SCHEDULETABLE_RUNNING_AND_SYNCHRONOUS

  do_8:
    id: TASK5
    syssrv: IncrementCounter(COUNTER1)
    repeat: ANY_MAXVAL_A+1
    rettype: StatusType
    retval: E_OK

  post_condition_8:
    SCHEDULE_TABLE3:
      ststat: SCHEDULETABLE_RUNNING_AND_SYNCHRONOUS
      curval: 0
    SCHEDULE_TABLE1:
      curval: 0

  do_9:
    id: TASK5
    syssrv: IncrementCounter(COUNTER1)
    repeat: ANY_SCDLTBL_INIT_OFFSET_A
    rettype: StatusType
    retval: E_OK

  post_condition_9:
    COUNTER1:
      curval: ANY_SCDLTBL_INIT_OFFSET_A
    SCHEDULE_TABLE1:
      curval: ANY_SCDLTBL_INIT_OFFSET_A
    SCHEDULE_TABLE3:
      curval: ANY_SCDLTBL_INIT_OFFSET_A
    TASK1:
      tstat: READY
      curpri: TSK_PRI_LOW
      bootcnt: 1
      actcnt: 1

  do_10:
    id: TASK5
    syssrv: IncrementCounter(COUNTER1)
    rettype: StatusType
    retval: E_OK

  post_condition_10:
    COUNTER1:
      curval: ANY_SCDLTBL_INIT_OFFSET_A+1
    SCHEDULE_TABLE1:
      curval: ANY_SCDLTBL_INIT_OFFSET_A+1
    SCHEDULE_TABLE3:
      curval: ANY_SCDLTBL_INIT_OFFSET_A+1
    TASK5:
      tstat: RUNNING
      actcnt: 2

  do_11:
    id: TASK5
    syssrv: NextScheduleTable(SCHEDULE_TABLE9,SCHEDULE_TABLE10)
    rettype: StatusType
    retval: E_OK

  post_condition_11:
    SCHEDULE_TABLE10:
      ststat: SCHEDULETABLE_NEXT
      stfrom: SCHEDULE_TABLE9

  do_12:
    id: TASK5
    syssrv: IncrementCounter(COUNTER2)
    repeat: ANY_SCDLTBL_DURATION_A
    rettype: StatusType
    retval: E_OK

  post_condition_12:
    COUNTER2:
      curval: (ANY_CURVAL_A+ANY_SCDLTBL_DURATION_A)%(ANY_MAXVAL_A+1)
    SCHEDULE_TABLE9:
      ststat: SCHEDULETABLE_STOPPED
    SCHEDULE_TABLE10:
      ststat: SCHEDULETABLE_RUNNING
      curval: 0
    TASK3:
      tstat: READY
      curpri: TSK_PRI_LOW
      actcnt: 1
      porder: 2
    TASK1:
      porder: 1

  do_13:
    id: TASK5
    syssrv: IncrementCounter(COUNTER2)
    repeat: ANY_SCDLTBL_DURATION_B
    rettype: StatusType
    retval: E_OK

  post_condition_13:
    COUNTER2:
      curval: (ANY_CURVAL_A+ANY_SCDLTBL_DURATION_A+ANY_SCDLTBL_DURATION_B*1)%(ANY_MAXVAL_A+1)
    SCHEDULE_TABLE10:
      ststat: SCHEDULETABLE_STOPPED
    TASK2:
      tstat: READY
      curpri: TSK_PRI_LOW
      actcnt: 1
      porder: 3
    TASK1:
      porder: 1
    TASK3:
      porder: 2

  do_14:
    id: TASK5
    syssrv: StartScheduleTableAbs(SCHEDULE_TABLE5,0)
    rettype: StatusType
    retval: E_OK

  post_condition_14:
    SCHEDULE_TABLE5:
      ststat: SCHEDULETABLE_RUNNING

  do_15:
    id: TASK5
    syssrv: StartScheduleTableAbs(SCHEDULE_TABLE7,0)
    rettype: StatusType
    retval: E_OK

  post_condition_15:
    SCHEDULE_TABLE7:
      ststat: SCHEDULETABLE_RUNNING

  do_16:
    id: TASK5
    syssrv: NextScheduleTable(SCHEDULE_TABLE5,SCHEDULE_TABLE6)
    rettype: StatusType
    retval: E_OK

  post_condition_16:
    SCHEDULE_TABLE6:
      ststat: SCHEDULETABLE_NEXT
      stfrom: SCHEDULE_TABLE5

  do_17:
    id: TASK5
    syssrv: NextScheduleTable(SCHEDULE_TABLE7,SCHEDULE_TABLE8)
    rettype: StatusType
    retval: E_OK

  post_condition_17:
    SCHEDULE_TABLE8:
      ststat: SCHEDULETABLE_NEXT
      stfrom: SCHEDULE_TABLE7

  do_18:
    id: TASK5
    syssrv: IncrementCounter(COUNTER2)
    repeat: (ANY_MAXVAL_A+1)-((ANY_CURVAL_A+ANY_SCDLTBL_DURATION_A+ANY_SCDLTBL_DURATION_B*1)%(ANY_MAXVAL_A+1))
    rettype: StatusType
    retval: E_OK

  post_condition_18:
    COUNTER2:
      curval: 0
    SCHEDULE_TABLE5:
      curval: 0
    SCHEDULE_TABLE7:
      curval: 0

  do_19:
    id: TASK5
    syssrv: IncrementCounter(COUNTER2)
    repeat: ANY_SCDLTBL_DURATION_A
    rettype: StatusType
    retval: E_OK

  post_condition_19:
    COUNTER2:
      curval: (ANY_CURVAL_A+ANY_SCDLTBL_DURATION_A)%(ANY_MAXVAL_A+1)
    SCHEDULE_TABLE5:
      ststat: SCHEDULETABLE_STOPPED
    SCHEDULE_TABLE7:
      ststat: SCHEDULETABLE_STOPPED
    SCHEDULE_TABLE6:
      ststat: SCHEDULETABLE_RUNNING
      curval: 0
