    TASK4:
      tstat: SUSPENDED
    RESOURCE2:
      lockflg: AK_UNLOCK
    RESTART_TASK1:
      tstat: RUNNING
      actcnt: 1
      curpri: TSK_PRI_MID

  do_1:
    id: RESTART_TASK1
    syssrv: AllowAccess()
    rettype: StatusType
    retval: E_OK

  post_condition_1:
    NON_TRUSTED_OSAP1:
      osapstat: APPLICATION_ACCESSIBLE

  do_2:
    id: RESTART_TASK1
    syssrv: ChainTask(TASK5)
    rettype: StatusType
    retval: E_OK

  post_condition_2:
    RESTART_TASK1:
      tstat: SUSPENDED
    TASK5:
      tstat: RUNNING
      curpri: TSK_PRI_HIGH
      actcnt: 1

  do_3:
    id: TASK5
    syssrv: GetApplicationState(NON_TRUSTED_OSAP1,&vname1)
    rettype: StatusType
    retval: E_OK

  post_condition_3:
    TASK5:
      var:
        vname1:
          value: APPLICATION_ACCESSIBLE

  do_4:
    id: TASK5
    syssrv: ChainTask(TASK3)
    rettype: StatusType
    retval: E_OK

  post_condition_4:
    TASK5:
      tstat: SUSPENDED
    TASK3:
      tstat: RUNNING
      curpri: TSK_PRI_MID
      actcnt: 1
      bootcnt: 1

  do_5:
    id: TASK3
    syssrv: ActivateTask(TASK1)
    rettype: StatusType
    retval: E_OK

  post_condition_5:
    TASK1:
      tstat: READY
      actcnt: 1
      curpri: TSK_PRI_MID
      bootcnt: 1

  do_6:
    id: TASK3
    syssrv: WaitEvent(EVENT1)
    rettype: StatusType
    retval: E_OK

  post_condition_6:
    TASK3:
      tstat: WAITING
      waievt: EVENT1
      bootcnt: 1
    TASK1:
      tstat: RUNNING

  do_7:
    id: TASK1
    syssrv: GetResource(RESOURCE2)
    rettype: StatusType
    retval: E_OK

  post_condition_7:
    TASK1:
      curpri: TSK_PRI_HIGH
      getres:
        - RESOURCE2
    RESOURCE2:
      lockflg: AK_LOCK

  do_8:
    id: TASK1
    syssrv: ActivateTask(TASK2)
    rettype: StatusType
    retval: E_OK

  post_condition_8:
    TASK2:
      tstat: READY
      actcnt: 1
      curpri: TSK_PRI_MID
