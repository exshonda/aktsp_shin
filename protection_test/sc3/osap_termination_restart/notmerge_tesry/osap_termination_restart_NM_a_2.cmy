######################################################################
# osap_termination_restart_NM_a_2_0015.yaml
######################################################################
osap_termination_restart_NM_a_2_0015:
  property:
    sc: 
      - SC3
      - SC4

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      osap: NON_TRUSTED_OSAP1
    TASK5:
      type: TASK
      tstat: SUSPENDED
      inipri: TSK_PRI_HIGH
      var:
        vname1:
          type: ApplicationStateType
      osap: TRUSTED_OSAP1
      accosap:
        - NON_TRUSTED_OSAP1
    RESTART_TASK1:
      type: RESTART_TASK
      tstat: SUSPENDED
      inipri: TSK_PRI_MID
      osap: NON_TRUSTED_OSAP1
    ALARM1:
      type: ALARM
      almact: AK_ALM_ATSK
      counter: COUNTER1
      astat: AK_SET
      almval: ANY_CURVAL_NOT_0_A
      cycle: ANY_ALMCYCLE_A
      task: TASK1
      osap: NON_TRUSTED_OSAP1
    ALARM2:
      type: ALARM
      almact: AK_ALM_ATSK
      counter: COUNTER1
      astat: AK_UNSET
      task: TASK1
      osap: NON_TRUSTED_OSAP1
    COUNTER1:
      type: COUNTER
      ctype: AK_SOFTWARE
      mincyc: ANY_MINCYC_A
      maxval: ANY_MAXVAL_A
      curval: 0
      cstat: AK_CS_NULL
      osap: TRUSTED_OSAP1
    NON_TRUSTED_OSAP1:
      type: OSAP
      osapstat: APPLICATION_ACCESSIBLE

  do_0:
    id: TASK1
    syssrv: TerminateApplication(NON_TRUSTED_OSAP1,RESTART)
    rettype: StatusType
    retval: E_OK

  post_condition_0:
    NON_TRUSTED_OSAP1:
      osapstat: APPLICATION_RESTARTING
    TASK1:
      tstat: SUSPENDED
    ALARM1:
      astat: AK_UNSET
    RESTART_TASK1:
      tstat: RUNNING
      actcnt: 1
      curpri: TSK_PRI_MID

  do_1:
    id: RESTART_TASK1
    syssrv: AllowAccess()
    rettype: StatusType
    retval: E_OK

  post_condition_1:
    NON_TRUSTED_OSAP1:
      osapstat: APPLICATION_ACCESSIBLE

  do_2:
    id: RESTART_TASK1
    syssrv: ChainTask(TASK5)
    rettype: StatusType
    retval: E_OK

  post_condition_2:
    RESTART_TASK1:
      tstat: SUSPENDED
    TASK5:
      tstat: RUNNING
      curpri: TSK_PRI_HIGH
      actcnt: 1

  do_3:
    id: TASK5
    syssrv: GetApplicationState(NON_TRUSTED_OSAP1,&vname1)
    rettype: StatusType
    retval: E_OK

  post_condition_3:
    TASK5:
      var:
        vname1:
          value: APPLICATION_ACCESSIBLE

  do_4:
    id: TASK5
    syssrv: SetAbsAlarm(ALARM1,ANY_CURVAL_NOT_0_A,ANY_ALMCYCLE_A)
    rettype: StatusType
    retval: E_OK

  post_condition_4:
    ALARM1:
      astat: AK_SET
      almval: ANY_CURVAL_NOT_0_A
      cycle: ANY_ALMCYCLE_A

  do_5:
    id: TASK5
    syssrv: IncrementCounter(COUNTER1)
    repeat: ANY_CURVAL_NOT_0_A
    rettype: StatusType
    retval: E_OK

  post_condition_5:
    ALARM1:
      almval: (ANY_CURVAL_NOT_0_A+ANY_ALMCYCLE_A*1)%(ANY_MAXVAL_A+1)
    COUNTER1:
      curval: (ANY_CURVAL_NOT_0_A+ANY_ALMCYCLE_A*0)%(ANY_MAXVAL_A+1)
    TASK1:
      tstat: READY
      curpri: TSK_PRI_MID
      bootcnt: 1
      actcnt: 1
