    COUNTER3:
      curval: 1
      cstat: AK_CS_DOING
    ALARM1:
      astat: AK_UNSET

  do_1:
    id: TASK6
    syssrv: TerminateApplication(NON_TRUSTED_OSAP1,RESTART)
    rettype: StatusType
    retval: E_OK

  post_condition_1:
    NON_TRUSTED_OSAP1:
      osapstat: APPLICATION_RESTARTING
    TASK1:
      tstat: SUSPENDED
    TASK6:
      tstat: SUSPENDED
    COUNTER2:
      curval: 0
    COUNTER3:
      curval: 0
      cstat: AK_CS_NULL
