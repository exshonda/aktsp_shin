  do_1:
    id: ERROR_HOOK1
    syssrv: AktspAccessAllNtOsapInaccessibleArea(TRUE,0,FALSE,TASK1,TASK2,TASK3,C2ISR1)

  post_condition_1:

  do_2:
    id: ERROR_HOOK1
    syssrv: return

  post_condition_2:
