######################################################################
# TerminateApplication_normal_1_0001.yaml
######################################################################
TerminateApplication_normal_1_0001:
  property:
    sc: 
      - SC3
      - SC4

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      inipri: TSK_PRI_MID
      osap: NON_TRUSTED_OSAP1
    TASK2:
      type: TASK
      tstat: READY
      curpri: TSK_PRI_MID
      var:
        vname1:
          type: ApplicationStateType
      osap: NON_TRUSTED_OSAP2
      accosap:
        - NON_TRUSTED_OSAP1
    ERROR_HOOK1:
      type: ERROR_HOOK
      hookstat: AK_STOP
      target_error_hook_cfg:
        - AK_ONLY_SYSTEM
    NON_TRUSTED_OSAP1:
      type: OSAP
      osapstat: APPLICATION_ACCESSIBLE

  do_0:
    id: TASK1
    syssrv: ActivateTask(INVALID_TSK_ID)
    rettype: StatusType
    retval: E_OS_ID

  post_condition_0:
    ERROR_HOOK1:
      hookstat: AK_ACTIVATE

  do_1:
    id: ERROR_HOOK1
    syssrv: TerminateApplication(NON_TRUSTED_OSAP1,NO_RESTART)
    rettype: StatusType
    retval: E_OK

  post_condition_1:
    NON_TRUSTED_OSAP1:
      osapstat: APPLICATION_TERMINATED
    ERROR_HOOK1:
      hookstat: AK_STOP
    TASK1:
      tstat: SUSPENDED
    TASK2:
      tstat: RUNNING

  do_2:
    id: TASK2
    syssrv: GetApplicationState(NON_TRUSTED_OSAP1,&vname1)
    rettype: StatusType
    retval: E_OK

  post_condition_2:
    TASK2:
      var:
        vname1:
          value: APPLICATION_TERMINATED
######################################################################
