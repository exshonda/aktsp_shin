######################################################################
# TerminateApplication_normal_3_0001.yaml
######################################################################
TerminateApplication_normal_3_0001:
  property:
    sc: 
      - SC3
      - SC4

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      inipri: TSK_PRI_LOW
      curpri: TSK_PRI_LOW
      var:
        vname1:
          type: ApplicationStateType
      osap: TRUSTED_OSAP1
    TASK2:
      type: TASK
      tstat: SUSPENDED
      inipri: TSK_PRI_MID
      osap: NON_TRUSTED_OSAP1
    C2ISR1:
      type: C2ISR
      intno: INTNO_SELF_C2ISR_MID_A
      iniintpri: INT_PRI_MID
      rtnstat: AK_STOP
      osap: TRUSTED_OSAP1
    ERROR_HOOK1:
      type: ERROR_HOOK
      hookstat: AK_STOP
      target_error_hook_cfg:
        - AK_ONLY_SYSTEM
    NON_TRUSTED_OSAP1:
      type: OSAP
      osapstat: APPLICATION_ACCESSIBLE

  do_0:
    id: TASK1
    syssrv: ActivateTask(TASK2)
    rettype: StatusType
    retval: E_OK

  post_condition_0:
    TASK1:
      tstat: READY
    TASK2:
      tstat: RUNNING
      actcnt: 1

  do_1:
    id: TASK2
    syssrv: ActivateTask(INVALID_TSK_ID)
    rettype: StatusType
    retval: E_OS_ID

  post_condition_1:
    ERROR_HOOK1:
      hookstat: AK_ACTIVATE

  do_2:
    id: ERROR_HOOK1
    syssrv: TerminateApplication(NON_TRUSTED_OSAP1,NO_RESTART)
    rettype: StatusType
    retval: E_OK

  post_condition_2:
    NON_TRUSTED_OSAP1:
      osapstat: APPLICATION_TERMINATED
    ERROR_HOOK1:
      hookstat: AK_STOP
    TASK1:
      tstat: RUNNING
    TASK2:
      tstat: SUSPENDED

  do_3:
    id: TASK1
    syssrv: GetApplicationState(NON_TRUSTED_OSAP1,&vname1)
    rettype: StatusType
    retval: E_OK

  post_condition_3:
    TASK1:
      var:
        vname1:
          value: APPLICATION_TERMINATED

  do_4:
    id: TASK1
    syssrv: AktspRaiseInterrupt(INTNO_SELF_C2ISR_MID_A)

  post_condition_4:
    C2ISR1:
      rtnstat: AK_ACTIVATE
######################################################################
