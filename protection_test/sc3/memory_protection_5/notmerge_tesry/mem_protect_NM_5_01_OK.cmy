    MEMORY_MODULE5:
      type: MEMORY_MODULE
      file: nt_osap1.o
      export: AK_FALSE
      osap: NON_TRUSTED_OSAP1
    MEMORY_MODULE6:
      type: MEMORY_MODULE
      file: nt_osap2.o
      export: AK_FALSE
      osap: NON_TRUSTED_OSAP2
    MEMORY_MODULE7:
      type: MEMORY_MODULE
      file: common.o
      export: AK_TRUE

  do_0:
    id: STARTUP_HOOK1
    syssrv: return

  post_condition_0:
    STARTUP_HOOK1:
      hookstat: AK_STOP
    TASK2:
      tstat: RUNNING

  do_1:
    id: TASK2
    syssrv: AktspAccessNtOsap2InaccessibleArea(TRUE,0,TRUE,TASK1,TASK2,TASK3,C2ISR1)

  post_condition_1:

  do_2:
    id: TASK2
    syssrv: TerminateTask()
    rettype: StatusType
    retval: E_OK

  post_condition_2:
    TASK2:
      tstat: SUSPENDED
    TASK1:
      tstat: RUNNING

  do_3:
    id: TASK1
    syssrv: AKTSP_SHUTDOWN_OS(E_OK)
    finish: true

  post_condition_3:
