######################################################################
# mem_protect_NM_5_13_NG_P_NS_0001.yaml
######################################################################
mem_protect_NM_5_13_NG_P_NS_0001:
  property:
    need_stack_share: true
    sc: 
      - SC3
      - SC4

  pre_condition:
    TASK1:
      type: TASK
      tstat: SUSPENDED
      inipri: TSK_PRI_LOW
      osap: TRUSTED_OSAP1
    TASK2:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_HIGH
      osap: NON_TRUSTED_OSAP1
    TASK3:
      type: TASK
      tstat: SUSPENDED
      inipri: TSK_PRI_LOW
      osap: NON_TRUSTED_OSAP2
    TASK4:
      type: TASK
      tstat: SUSPENDED
      inipri: TSK_PRI_LOW
      osap: NON_TRUSTED_OSAP1
    C2ISR1:
      type: C2ISR
      intno: INTNO_SELF_C2ISR_MID_A
      iniintpri: INT_PRI_MID
      rtnstat: AK_STOP
      osap: TRUSTED_OSAP1
    PROTECTION_HOOK1:
      type: PROTECTION_HOOK
      hookstat: AK_ACTIVATE
    MEMORY_MODULE1:
      type: MEMORY_MODULE
      file: t_osap1_share.o
      export: AK_TRUE
      osap: TRUSTED_OSAP1
    MEMORY_MODULE2:
      type: MEMORY_MODULE
      file: t_osap1.o
      export: AK_FALSE
      osap: TRUSTED_OSAP1
    MEMORY_MODULE3:
      type: MEMORY_MODULE
      file: nt_osap1_share.o
      export: AK_TRUE
      osap: NON_TRUSTED_OSAP1
    MEMORY_MODULE4:
      type: MEMORY_MODULE
      file: nt_osap2_share.o
      export: AK_TRUE
      osap: NON_TRUSTED_OSAP2
    MEMORY_MODULE5:
      type: MEMORY_MODULE
      file: nt_osap1.o
      export: AK_FALSE
      osap: NON_TRUSTED_OSAP1
    MEMORY_MODULE6:
      type: MEMORY_MODULE
      file: nt_osap2.o
      export: AK_FALSE
      osap: NON_TRUSTED_OSAP2
    MEMORY_MODULE7:
      type: MEMORY_MODULE
      file: common.o
      export: AK_TRUE

  do_0:
    id: PROTECTION_HOOK1
    syssrv: return(PRO_IGNORE)

  post_condition_0:
    PROTECTION_HOOK1:
      hookstat: AK_STOP

  do_1:
    id: TASK2
    syssrv: AktspAccessAllNtOsapInaccessibleArea(FALSE,xxx,TRUE,TASK1,TASK2,TASK3,C2ISR1)

  post_condition_1:
    PROTECTION_HOOK1:
      hookstat: AK_ACTIVATE
      bootcnt: 1

  do_2:
    id: PROTECTION_HOOK1
    syssrv: CheckAssert(FatalError == E_OS_PROTECTION_MEMORY)

  post_condition_2:

  do_3:
    id: PROTECTION_HOOK1
    syssrv: return(PRO_IGNORE)
    finish: true

  post_condition_3:
