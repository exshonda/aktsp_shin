    TASK2:
      type: TASK
      tstat: READY
      inipri: TSK_PRI_LOW
      curpri: TSK_PRI_LOW
      osap: TRUSTED_OSAP1
    NON_TRUSTED_OSAP1:
      type: OSAP
      osapstat: APPLICATION_ACCESSIBLE
    PROTECTION_HOOK1:
      type: PROTECTION_HOOK
      hookstat: AK_STOP

  do_0:
    id: TASK1
