    id: PROTECTION_HOOK1
    syssrv: return(PRO_TERMINATEAPPL)

  post_condition_2:
    PROTECTION_HOOK1:
      hookstat: AK_STOP
    TASK1:
      tstat: SUSPENDED
    TASK2:
      tstat: RUNNING
    NON_TRUSTED_OSAP1:
      osapstat: APPLICATION_TERMINATED
######################################################################
# cpu_exception_NotMerge_P_NS_0013.yaml
######################################################################
cpu_exception_NotMerge_P_NS_0013:
  property:
    sc: 
      - SC3
      - SC4

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      osap: NON_TRUSTED_OSAP1
    TASK2:
      type: RESTART_TASK
      tstat: SUSPENDED
      inipri: TSK_PRI_HIGH
      osap: NON_TRUSTED_OSAP1
    NON_TRUSTED_OSAP1:
      type: OSAP
      osapstat: APPLICATION_ACCESSIBLE
    PROTECTION_HOOK1:
      type: PROTECTION_HOOK
      hookstat: AK_STOP

  do_0:
    id: TASK1
    syssrv: AktspRaiseCPUException()

  post_condition_0:
    PROTECTION_HOOK1:
      hookstat: AK_ACTIVATE

  do_1:
    id: PROTECTION_HOOK1
    syssrv: CheckAssert(FatalError == E_OS_PROTECTION_EXCEPTION)

  post_condition_1:

  do_2:
    id: PROTECTION_HOOK1
    syssrv: return(PRO_TERMINATEAPPL_RESTART)

  post_condition_2:
    PROTECTION_HOOK1:
      hookstat: AK_STOP
    TASK1:
      tstat: SUSPENDED
    TASK2:
      tstat: RUNNING
      curpri: TSK_PRI_HIGH
      actcnt: 1
    NON_TRUSTED_OSAP1:
      osapstat: APPLICATION_RESTARTING

  do_3:
    id: TASK2
    syssrv: AllowAccess()
    rettype: StatusType
    retval: E_OK

  post_condition_3:
    NON_TRUSTED_OSAP1:
      osapstat: APPLICATION_ACCESSIBLE

  do_4:
    id: TASK2
    syssrv: TerminateTask()

  post_condition_4:
    TASK2:
      tstat: SUSPENDED
