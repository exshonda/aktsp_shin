######################################################################
# cpu_exception_Merge_0001.yaml
######################################################################
cpu_exception_Merge_0001:
  property:
    sc: 
      - SC3
      - SC4

  pre_condition:
    PROTECTION_HOOK1:
      type: PROTECTION_HOOK
      hookstat: AK_STOP
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      osap: TRUSTED_OSAP1
    C1ISR1:
      type: C1ISR
      intno: INTNO_SELF_C1ISR_MID
      iniintpri: INT_PRI_ISR1_MID
      rtnstat: AK_ACTIVATE
      osap: TRUSTED_OSAP1

  do_0:
    id: C1ISR1
    syssrv: AktspRaiseCPUException()

  post_condition_0:
    PROTECTION_HOOK1:
      hookstat: AK_ACTIVATE
    C1ISR1:
      rtnstat: AK_STOP

  do_1:
    id: PROTECTION_HOOK1
    syssrv: CheckAssert(FatalError == E_OS_PROTECTION_EXCEPTION)

  post_condition_1:

  do_2:
    id: PROTECTION_HOOK1
    syssrv: return(PRO_IGNORE)

  post_condition_2:
    PROTECTION_HOOK1:
      hookstat: AK_STOP
    C1ISR1:
      rtnstat: AK_ACTIVATE
