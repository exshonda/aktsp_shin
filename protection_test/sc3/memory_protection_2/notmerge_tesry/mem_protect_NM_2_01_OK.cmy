######################################################################
# mem_protect_NM_2_01_OK_0001.yaml
######################################################################
mem_protect_NM_2_01_OK_0001:
  property:
    need_stack_share: true
    sc: 
      - SC3
      - SC4

  pre_condition:
    TASK1:
      type: TASK
      tstat: READY
      curpri: TSK_PRI_LOW
      actcnt: 1
      osap: TRUSTED_OSAP1
      accosap:
        - NON_TRUSTED_OSAP1
    TASK2:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_HIGH
      osap: NON_TRUSTED_OSAP1
    TASK3:
      type: TASK
      tstat: SUSPENDED
      inipri: TSK_PRI_LOW
      osap: NON_TRUSTED_OSAP2
    TASK4:
      type: TASK
      tstat: SUSPENDED
      inipri: TSK_PRI_LOW
      osap: NON_TRUSTED_OSAP1
    C2ISR1:
      type: C2ISR
      intno: INTNO_SELF_C2ISR_MID_A
      iniintpri: INT_PRI_MID
      rtnstat: AK_STOP
      osap: TRUSTED_OSAP1
    MEMORY_MODULE1:
      type: MEMORY_MODULE
      file: t_osap1_share.o
      export: AK_TRUE
      osap: TRUSTED_OSAP1
    MEMORY_MODULE2:
      type: MEMORY_MODULE
      file: t_osap1.o
      export: AK_FALSE
      osap: TRUSTED_OSAP1
    MEMORY_MODULE3:
      type: MEMORY_MODULE
      file: nt_osap1_share.o
      export: AK_TRUE
      osap: NON_TRUSTED_OSAP1
    MEMORY_MODULE4:
      type: MEMORY_MODULE
      file: nt_osap2_share.o
      export: AK_TRUE
      osap: NON_TRUSTED_OSAP2
    MEMORY_MODULE5:
      type: MEMORY_MODULE
      file: nt_osap1.o
      export: AK_FALSE
      osap: NON_TRUSTED_OSAP1
    MEMORY_MODULE6:
      type: MEMORY_MODULE
      file: nt_osap2.o
      export: AK_FALSE
      osap: NON_TRUSTED_OSAP2
    MEMORY_MODULE7:
      type: MEMORY_MODULE
      file: common.o
      export: AK_TRUE

  do_0:
    id: TASK2
    syssrv: TerminateTask()
    rettype: StatusType
    retval: E_OK

  post_condition_0:
    TASK2:
      tstat: SUSPENDED
    TASK1:
      tstat: RUNNING

  do_1:
    id: TASK1
    syssrv: AktspAccessAllAccessibleArea(TRUE,TASK1,TASK2,TASK3,C2ISR1)

  post_condition_1:
