######################################################################
# stack_monitoring_NM_5_NP_S_0001.yaml
######################################################################
stack_monitoring_NM_5_NP_S_0001:
  property:
    need_stack_share: true
    sc: 
      - SC3
      - SC4

  pre_condition:
    SHUTDOWN_HOOK1:
      type: SHUTDOWN_HOOK
      hookstat: AK_STOP
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      osap: TRUSTED_OSAP1
    C2ISR1:
      type: C2ISR
      intno: INTNO_SELF_C2ISR_MID_A
      iniintpri: INT_PRI_MID
      rtnstat: AK_ACTIVATE
      osap: TRUSTED_OSAP1
      var:
        local:
          type: AktspTfParam
    TRUSTED_FUNCTION1:
      type: TRUSTED_FUNCTION
      caller: C2ISR1
      arg: local
      osap: TRUSTED_OSAP2

  do_0:
    id: TRUSTED_FUNCTION1
    syssrv: AktspRaiseTfnStackOverflowByReturn(AKTSP_OS_STACK_ADDRESS,AKTSP_TASK_STACK_SIZE)

  post_condition_0:

  do_1:
    id: TRUSTED_FUNCTION1
    syssrv: return(E_OK)

  post_condition_1:
    C2ISR1:
      rtnstat: AK_STOP
    TRUSTED_FUNCTION1:
      caller: 
    SHUTDOWN_HOOK1:
      hookstat: AK_ACTIVATE

  do_2:
    id: SHUTDOWN_HOOK1
    syssrv: CheckAssert(Error == E_OS_STACKFAULT)

  post_condition_2:
######################################################################
# stack_monitoring_NM_5_NP_S_0002.yaml
######################################################################
stack_monitoring_NM_5_NP_S_0002:
  property:
    need_stack_share: true
    sc: 
      - SC3
      - SC4

  pre_condition:
    SHUTDOWN_HOOK1:
      type: SHUTDOWN_HOOK
      hookstat: AK_STOP
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      var:
        local:
          type: AktspTfParam
      osap: NON_TRUSTED_OSAP1
    TRUSTED_FUNCTION1:
      type: TRUSTED_FUNCTION
      caller: TASK1
      arg: local
      osap: TRUSTED_OSAP2

  do_0:
    id: TRUSTED_FUNCTION1
    syssrv: AktspRaiseTfnStackOverflowByReturn(AKTSP_TASK_SYSTEM_STACK_ADDRESS,AKTSP_TASK_STACK_SIZE)

  post_condition_0:

  do_1:
    id: TRUSTED_FUNCTION1
    syssrv: return(E_OK)

  post_condition_1:
    TRUSTED_FUNCTION1:
      caller: 
    SHUTDOWN_HOOK1:
      hookstat: AK_ACTIVATE

  do_2:
    id: SHUTDOWN_HOOK1
    syssrv: CheckAssert(Error == E_OS_STACKFAULT)

  post_condition_2:
