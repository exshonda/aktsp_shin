######################################################################
# stack_monitoring_NM_4_P_NS_0001.yaml
######################################################################
stack_monitoring_NM_4_P_NS_0001:
  property:
    need_stack_share: true
    sc: 
      - SC3
      - SC4

  pre_condition:
    PROTECTION_HOOK1:
      type: PROTECTION_HOOK
      hookstat: AK_STOP
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      osap: TRUSTED_OSAP1
    C2ISR1:
      type: C2ISR
      intno: INTNO_SELF_C2ISR_MID_A
      iniintpri: INT_PRI_MID
      rtnstat: AK_ACTIVATE
      osap: TRUSTED_OSAP1

  do_0:
    id: C2ISR1
    syssrv: AktspRaiseIsrStackOverflowByReturn(AKTSP_OS_STACK_ADDRESS,AKTSP_OS_STACK_SIZE)

  post_condition_0:
    C2ISR1:
      rtnstat: AK_STOP
    PROTECTION_HOOK1:
      hookstat: AK_ACTIVATE

  do_1:
    id: PROTECTION_HOOK1
    syssrv: CheckAssert(FatalError == E_OS_STACKFAULT)

  post_condition_1:

  do_2:
    id: PROTECTION_HOOK1
    syssrv: return(PRO_IGNORE)
    finish: true

  post_condition_2:
