    need_stack_share: true
    sc: 
      - SC3
      - SC4

  pre_condition:
    PROTECTION_HOOK1:
      type: PROTECTION_HOOK
      hookstat: AK_STOP
    SHUTDOWN_HOOK1:
      type: SHUTDOWN_HOOK
      hookstat: AK_STOP
    TASK1:
      type: TASK
      tstat: RUNNING
      inipri: TSK_PRI_MID
      curpri: TSK_PRI_MID
      spolicy: AK_SCHFULL
      var:
        vname1:
          type: AktspStackOverflowInfo
          stk_mode: AK_SMM_MAGIC_NUMBER
          stk_action: AK_SOA_SET_EVENT
          stk_task: TASK2
          stk_event: EVENT1
      osap: TRUSTED_OSAP1
    TASK2:
      type: TASK
      tstat: WAITING
      ttype: AK_EXTENDED
      inipri: TSK_PRI_HIGH
      curpri: TSK_PRI_HIGH
      curevt: 0
      waievt: EVENT1
      relevt:
        - EVENT1
      osap: TRUSTED_OSAP1
    EVENT1:
      type: EVENT
      mask: EVENTMASK_A

  do_0:
    id: TASK1
    syssrv: AktspRaiseTaskStackOverflowByDispatch(AKTSP_TASK_STACK_ADDRESS,AKTSP_TASK_STACK_SIZE,&vname1)

  post_condition_0:
    PROTECTION_HOOK1:
      hookstat: AK_ACTIVATE
    TASK2:
      tstat: READY
      curevt: EVENT1

  do_1:
    id: PROTECTION_HOOK1
    syssrv: CheckAssert(FatalError == E_OS_STACKFAULT)

  post_condition_1:

  do_2:
    id: PROTECTION_HOOK1
    syssrv: return(PRO_SHUTDOWN)

  post_condition_2:
    PROTECTION_HOOK1:
      hookstat: AK_STOP
    SHUTDOWN_HOOK1:
      hookstat: AK_ACTIVATE

  do_3:
    id: SHUTDOWN_HOOK1
    syssrv: CheckAssert(Error == E_OS_STACKFAULT)

  post_condition_3:
