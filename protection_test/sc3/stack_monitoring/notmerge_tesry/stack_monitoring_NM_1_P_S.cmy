# stack_monitoring_NM_1_P_S_0359.yaml
######################################################################
stack_monitoring_NM_1_P_S_0359:
  property:
    need_stack_share: true
    sc: 
      - SC3
      - SC4

  pre_condition:
    PROTECTION_HOOK1:
      type: PROTECTION_HOOK
      hookstat: AK_STOP
    SHUTDOWN_HOOK1:
      type: SHUTDOWN_HOOK
      hookstat: AK_STOP
    TASK1:
      type: TASK
      tstat: RUNNING
      inipri: TSK_PRI_MID
      curpri: TSK_PRI_MID
      spolicy: AK_SCHNON
      relevt:
        - EVENT1
      osap: NON_TRUSTED_OSAP1
      var:
        local:
          type: AktspTfParam
    TASK2:
      type: TASK
      tstat: READY
      ttype: AK_EXTENDED
      inipri: TSK_PRI_MID
      curpri: TSK_PRI_MID
      osap: NON_TRUSTED_OSAP1
    EVENT1:
      type: EVENT
      mask: EVENTMASK_A
    TRUSTED_FUNCTION1:
      type: TRUSTED_FUNCTION
      caller: TASK1
      arg: local
      osap: TRUSTED_OSAP2
      var:
        vname1:
          type: AktspStackOverflowInfo
          stk_mode: AK_SMM_STACK_POINTER
          stk_action: AK_SOA_WAIT_EVENT
          stk_event: EVENT1

  do_0:
    id: TRUSTED_FUNCTION1
    syssrv: AktspRaiseTaskStackOverflowByDispatch(AKTSP_TASK_SYSTEM_STACK_ADDRESS,AKTSP_TASK_STACK_SIZE,&vname1)

  post_condition_0:
    PROTECTION_HOOK1:
      hookstat: AK_ACTIVATE

  do_1:
    id: PROTECTION_HOOK1
    syssrv: CheckAssert(FatalError == E_OS_STACKFAULT)

  post_condition_1:

  do_2:
    id: PROTECTION_HOOK1
    syssrv: return(PRO_TERMINATETASKISR)

  post_condition_2:
    PROTECTION_HOOK1:
      hookstat: AK_STOP
    SHUTDOWN_HOOK1:
      hookstat: AK_ACTIVATE

  do_3:
    id: SHUTDOWN_HOOK1
    syssrv: CheckAssert(Error == E_OS_PROTECTION_FATAL)

  post_condition_3:
