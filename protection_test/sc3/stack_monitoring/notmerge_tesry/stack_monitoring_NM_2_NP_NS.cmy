######################################################################
# stack_monitoring_NM_2_NP_NS_0001.yaml
######################################################################
stack_monitoring_NM_2_NP_NS_0001:
  property:
    need_stack_share: true
    sc: 
      - SC3
      - SC4

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      osap: NON_TRUSTED_OSAP1
      var:
        local:
          type: AktspTfParam
    C2ISR1:
      type: C2ISR
      intno: INTNO_SELF_C2ISR_MID_A
      iniintpri: INT_PRI_MID
      rtnstat: AK_STOP
      osap: TRUSTED_OSAP1
    TRUSTED_FUNCTION1:
      type: TRUSTED_FUNCTION
      caller: TASK1
      arg: local
      osap: TRUSTED_OSAP2
      var:
        vname1:
          type: AktspStackOverflowInfo
          stk_mode: AK_SMM_MAGIC_NUMBER
          stk_intno: INTNO_SELF_C2ISR_MID_A

  do:
    id: TRUSTED_FUNCTION1
    syssrv: AktspRaiseTaskStackOverflowByInterrupt(AKTSP_TASK_SYSTEM_STACK_ADDRESS,AKTSP_TASK_STACK_SIZE,&vname1)
    finish: true

  post_condition:
######################################################################
