      rtnstat: AK_ACTIVATE
      osap: TRUSTED_OSAP1
      var:
        local:
          type: AktspTfParam
    C2ISR2:
      type: C2ISR
      intno: INTNO_SELF_C2ISR_HIGH
      iniintpri: INT_PRI_HIGH
      rtnstat: AK_STOP
      osap: TRUSTED_OSAP1
    TRUSTED_FUNCTION1:
      type: TRUSTED_FUNCTION
      caller: C2ISR1
      arg: local
      osap: TRUSTED_OSAP2
      var:
        vname1:
          type: AktspStackOverflowInfo
          stk_mode: AK_SMM_MAGIC_NUMBER
          stk_intno: INTNO_SELF_C2ISR_HIGH

  do:
    id: TRUSTED_FUNCTION1
    syssrv: AktspRaiseIsrStackOverflowByInterrupt(AKTSP_OS_STACK_ADDRESS,AKTSP_OS_STACK_SIZE,&vname1)
    finish: true

  post_condition:
