######################################################################
# stack_monitoring_NM_3_NP_NS_0001.yaml
######################################################################
stack_monitoring_NM_3_NP_NS_0001:
  property:
    need_stack_share: true
    sc: 
      - SC3
      - SC4

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      osap: TRUSTED_OSAP1
    C2ISR1:
      type: C2ISR
      intno: INTNO_SELF_C2ISR_MID_A
      iniintpri: INT_PRI_MID
      rtnstat: AK_ACTIVATE
      var:
        vname1:
          type: AktspStackOverflowInfo
          stk_mode: AK_SMM_MAGIC_NUMBER
          stk_intno: INTNO_SELF_C2ISR_HIGH
      osap: TRUSTED_OSAP1
    C2ISR2:
      type: C2ISR
      intno: INTNO_SELF_C2ISR_HIGH
      iniintpri: INT_PRI_HIGH
      rtnstat: AK_STOP
      osap: TRUSTED_OSAP1

  do:
    id: C2ISR1
    syssrv: AktspRaiseIsrStackOverflowByInterrupt(AKTSP_OS_STACK_ADDRESS,AKTSP_OS_STACK_SIZE,&vname1)
    finish: true

  post_condition:
######################################################################
# stack_monitoring_NM_3_NP_NS_0002.yaml
######################################################################
