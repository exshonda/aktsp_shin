######################################################################
# forced_task_termination_m_1_0001.yaml
######################################################################
forced_task_termination_m_1_0001:
  property:
    sc: 
      - SC3
      - SC4

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      inipri: TSK_PRI_MID
      curpri: TSK_PRI_MID
      ttype: AK_BASIC
      spolicy: AK_SCHFULL
      maxact: 1
      actcnt: 1
      osap: NON_TRUSTED_OSAP1
    TASK2:
      type: TASK
      tstat: READY
      inipri: TSK_PRI_LOW
      curpri: TSK_PRI_LOW
      osap: TRUSTED_OSAP1
    PROTECTION_HOOK1:
      type: PROTECTION_HOOK
      hookstat: AK_STOP
    POSTTASK_HOOK1:
      type: POSTTASK_HOOK
      hookstat: AK_STOP

  do_0:
    id: TASK1
    syssrv: AktspRaiseCPUException()

  post_condition_0:
    PROTECTION_HOOK1:
      hookstat: AK_ACTIVATE

  do_1:
    id: PROTECTION_HOOK1
    syssrv: CheckAssert(FatalError == E_OS_PROTECTION_EXCEPTION)

  post_condition_1:

  do_2:
    id: PROTECTION_HOOK1
    syssrv: return(PRO_TERMINATETASKISR)

  post_condition_2:
    PROTECTION_HOOK1:
      hookstat: AK_STOP
    TASK1:
      tstat: SUSPENDED
    TASK2:
      tstat: RUNNING

  do_3:
    id: TASK2
    syssrv: AKTSP_POSTTASKHOOK_NO_BOOT = FALSE

  post_condition_3:
######################################################################
