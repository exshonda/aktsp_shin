          - IOC0_DATA9: "DATA_UINT8_A,DATA_UINT16_A,DATA_UINT32_A"
        - 
          - IOC0_DATA0: DATA_UINT8_B
          - IOC0_DATA1: DATA_UINT16_B
          - IOC0_DATA2: DATA_UINT32_B
          - IOC0_DATA3: DATA_UINT8_B
          - IOC0_DATA4: DATA_UINT16_B
          - IOC0_DATA5: DATA_UINT32_B
          - IOC0_DATA6: DATA_INT_B
          - IOC0_DATA7: DATA_INT_B
          - IOC0_DATA8: "DATA_UINT8_B,DATA_UINT16_B,DATA_UINT32_B"
          - IOC0_DATA9: "DATA_UINT8_B,DATA_UINT16_B,DATA_UINT32_B"
        - 
          - IOC0_DATA0: DATA_UINT8_C
          - IOC0_DATA1: DATA_UINT16_C
          - IOC0_DATA2: DATA_UINT32_C
          - IOC0_DATA3: DATA_UINT8_C
          - IOC0_DATA4: DATA_UINT16_C
          - IOC0_DATA5: DATA_UINT32_C
          - IOC0_DATA6: DATA_INT_C
          - IOC0_DATA7: DATA_INT_C
          - IOC0_DATA8: "DATA_UINT8_C,DATA_UINT16_C,DATA_UINT32_C"
          - IOC0_DATA9: "DATA_UINT8_C,DATA_UINT16_C,DATA_UINT32_C"

  do_1:
    id: ERROR_HOOK1
    syssrv: CheckAssert(Error==IOC_E_LIMIT)

  post_condition_1:

  do_2:
    id: ERROR_HOOK1
    syssrv: CheckAssert(OSError_IocSend_IocId()==IOC0)

  post_condition_2:

  do_3:
    id: ERROR_HOOK1
    syssrv: return

  post_condition_3:
    ERROR_HOOK1:
      hookstat: AK_STOP

  do_4:
    id: TASK2
    syssrv: CallTrustedFunction(TRUSTED_FUNCTION1,&local)
    rettype: StatusType
    retval: E_OK

  post_condition_4:
    TRUSTED_FUNCTION1:
      caller: TASK2

  do_5:
    id: TRUSTED_FUNCTION1
    syssrv: IocEmptyQueue_IOC0()
    rettype: Std_ReturnType
    retval: IOC_E_OK

  post_condition_5:
    IOC0:
      datalist:
      lostflg: AK_FALSE
######################################################################
