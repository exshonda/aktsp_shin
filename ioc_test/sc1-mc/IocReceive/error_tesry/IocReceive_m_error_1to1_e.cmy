      osap: OSAP_OTHER_OTHER_CORE
      var:
        vname1:
          type: AktspIocDataIntegerTypeNoPrim
    ERROR_HOOK1:
      type: ERROR_HOOK
      hookstat: AK_STOP
      target_error_hook_cfg:
        - AK_ONLY_SYSTEM
        - AK_BOTH
      coreid: CORE_OTHER
    IOC0:
      type: IOC
      sender:
        - SENDER0
      receiver: RECEIVER
      iocdata:
        - IOC0_DATA0
      maxque: 3
      datalist:
    SENDER0:
      type: IOC_SENDER
      osap: OSAP_SELF_CORE
      kind: AK_FUNCTION
    RECEIVER:
      type: IOC_RECEIVER
      osap: OSAP_OTHER_OTHER_CORE
      kind: AK_FUNCTION
    IOC0_DATA0:
      type: IOC_DATA
      datatype: uint8

  do_0:
    id: C2ISR2
    syssrv: ioc_receive_generic(-1,&vname1)
    rettype: Std_ReturnType
    retval: IOC_E_ID

  post_condition_0:
