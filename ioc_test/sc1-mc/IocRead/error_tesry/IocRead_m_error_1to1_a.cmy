# IocRead_m_error_1to1_a_0012.yaml
######################################################################
IocRead_m_error_1to1_a_0012:
  property:
    sc: 
      - SC1
      - SC2

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      osap: OSAP_SELF_CORE
    TASK2:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      osap: OSAP_OTHER_OTHER_CORE
    PROTECTION_HOOK1:
      type: PROTECTION_HOOK
      hookstat: AK_ACTIVATE
      coreid: CORE_OTHER
      var:
        vname1:
          type: uint8
    ERROR_HOOK1:
      type: ERROR_HOOK
      hookstat: AK_STOP
      target_error_hook_cfg:
        - AK_ONLY_SYSTEM
        - AK_BOTH
      coreid: CORE_OTHER
    IOC0:
      type: IOC
      sender:
        - SENDER0
      receiver: RECEIVER
      iocdata:
        - IOC0_DATA0
      maxque: 0
      data:
        - IOC0_DATA0: DATA_UINT8_A
    SENDER0:
      type: IOC_SENDER
      osap: OSAP_SELF_CORE
      kind: AK_MACRO
    RECEIVER:
      type: IOC_RECEIVER
      osap: OSAP_OTHER_OTHER_CORE
      kind: AK_MACRO
    IOC0_DATA0:
      type: IOC_DATA
      datatype: uint8
      initval: DATA_UINT8_A

  do_0:
    id: PROTECTION_HOOK1
    syssrv: IocRead_IOC0(&vname1)
    rettype: Std_ReturnType
    retval: IOC_E_NOK

  post_condition_0:
    PROTECTION_HOOK1:
      hookstat: AK_STOP
    ERROR_HOOK1:
      hookstat: AK_ACTIVATE

  do_1:
    id: ERROR_HOOK1
    syssrv: CheckAssert(Error==IOC_E_NOK)

  post_condition_1:

  do_2:
    id: ERROR_HOOK1
    syssrv: CheckAssert(OSError_IocRead_IocId()==IOC0)

  post_condition_2:

  do_3:
    id: ERROR_HOOK1
    syssrv: return

  post_condition_3:
    ERROR_HOOK1:
      hookstat: AK_STOP
    PROTECTION_HOOK1:
      hookstat: AK_ACTIVATE
