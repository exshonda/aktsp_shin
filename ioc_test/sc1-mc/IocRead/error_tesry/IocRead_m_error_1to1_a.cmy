######################################################################
# IocRead_m_error_1to1_a_0001.yaml
######################################################################
IocRead_m_error_1to1_a_0001:
  property:
    sc: 
      - SC1

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      osap: OSAP_SELF_CORE
    TASK2:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      osap: OSAP_OTHER_OTHER_CORE
    ALARM1:
      type: ALARM
      almact: AK_ALM_CBACK
      counter: COUNTER1
      astat: AK_SET
      almval: 1
      cycle: 0
      callback: ALARM_CBACK1
      osap: OSAP_OTHER_OTHER_CORE
    ALARM_CBACK1:
      type: ALARM_CBACK
      cbstat: AK_STOP
      var:
        vname1:
          type: uint8
    COUNTER1:
      type: COUNTER
      ctype: AK_SOFTWARE
      mincyc: ANY_MINCYC_A
      maxval: ANY_MAXVAL_A
      curval: 0
      cstat: AK_CS_NULL
      osap: OSAP_OTHER_OTHER_CORE
    ERROR_HOOK1:
      type: ERROR_HOOK
      hookstat: AK_STOP
      target_error_hook_cfg:
        - AK_ONLY_SYSTEM
        - AK_BOTH
      coreid: CORE_OTHER
    IOC0:
      type: IOC
      sender:
        - SENDER0
      receiver: RECEIVER
      iocdata:
        - IOC0_DATA0
      maxque: 0
      data:
        - IOC0_DATA0: DATA_UINT8_A
    SENDER0:
      type: IOC_SENDER
      osap: OSAP_SELF_CORE
      kind: AK_FUNCTION
    RECEIVER:
      type: IOC_RECEIVER
      osap: OSAP_OTHER_OTHER_CORE
      kind: AK_FUNCTION
    IOC0_DATA0:
      type: IOC_DATA
      datatype: uint8
      initval: DATA_UINT8_A

  do_0:
    id: TASK2
    syssrv: IncrementCounter(COUNTER1)
    rettype: StatusType
    retval: E_OK

  post_condition_0:
    ALARM1:
      astat: AK_UNSET
    ALARM_CBACK1:
      cbstat: AK_ACTIVATE
    COUNTER1:
      curval: 1
      cstat: AK_CS_DOING

  do_1:
    id: ALARM_CBACK1
    syssrv: IocRead_IOC0(&vname1)
    rettype: Std_ReturnType
    retval: IOC_E_NOK

  post_condition_1:
    ALARM_CBACK1:
      cbstat: AK_STOP
    ERROR_HOOK1:
      hookstat: AK_ACTIVATE

  do_2:
    id: ERROR_HOOK1
    syssrv: CheckAssert(Error==IOC_E_NOK)

  post_condition_2:

  do_3:
    id: ERROR_HOOK1
    syssrv: CheckAssert(OSError_IocRead_IocId()==IOC0)

  post_condition_3:

  do_4:
    id: ERROR_HOOK1
    syssrv: return

  post_condition_4:
    ERROR_HOOK1:
      hookstat: AK_STOP
    ALARM_CBACK1:
      cbstat: AK_ACTIVATE
