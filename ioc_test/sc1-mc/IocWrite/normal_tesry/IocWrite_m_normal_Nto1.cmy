      sender:
        - SENDER0
        - SENDER1
      receiver: RECEIVER
      iocdata:
        - IOC0_DATA0
      maxque: 0
      data:
        - IOC0_DATA0: DATA_UINT8_A
    SENDER0:
      type: IOC_SENDER
      senderid: 0
      osap: OSAP_SELF_CORE
      kind: AK_MACRO
    SENDER1:
      type: IOC_SENDER
      senderid: 1
      osap: OSAP_SELF_CORE
      kind: AK_MACRO
    RECEIVER:
      type: IOC_RECEIVER
      kind: AK_MACRO
      osap: OSAP_SELF_CORE
    IOC0_DATA0:
      type: IOC_DATA
      datatype: AktspUint8Pointer
      initval: (AktspUint8Pointer)DATA_UINT8_A

  do_0:
    id: TASK1
    syssrv: IocWrite_IOC0_0(vname1)
    rettype: Std_ReturnType
    retval: IOC_E_OK

  post_condition_0:
    IOC0:
      data:
        - IOC0_DATA0: DATA_UINT8_A

  do_1:
    id: TASK1
    syssrv: TerminateTask()

  post_condition_1:
    TASK1:
      tstat: SUSPENDED
    TASK2:
      tstat: RUNNING

  do_2:
    id: TASK2
    syssrv: IocWrite_IOC0_1(vname1)
    rettype: Std_ReturnType
    retval: IOC_E_OK

  post_condition_2:
    IOC0:
      data:
        - IOC0_DATA0: DATA_UINT8_B
######################################################################
