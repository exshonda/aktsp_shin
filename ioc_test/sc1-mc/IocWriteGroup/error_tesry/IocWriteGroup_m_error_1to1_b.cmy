######################################################################
# IocWriteGroup_m_error_1to1_b_0001.yaml
######################################################################
IocWriteGroup_m_error_1to1_b_0001:
  property:
    sc: 
      - SC1
      - SC2

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      osap: OSAP_SELF_CORE
    TASK2:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      osap: OSAP_OTHER_OTHER_CORE
    C2ISR1:
      type: C2ISR
      iniintpri: INT_PRI_MID
      intno: INTNO_OTHER_ISR2_A
      rtnstat: AK_ACTIVATE
      osap: OSAP_OTHER_OTHER_CORE
      var:
        vname1:
          type: uint8
          value: DATA_UINT8_A
        vname2:
          type: uint16
          value: DATA_UINT16_A
        vname3:
          type: uint32
          value: DATA_UINT32_A
    ERROR_HOOK1:
      type: ERROR_HOOK
      hookstat: AK_STOP
      target_error_hook_cfg:
        - AK_ONLY_SYSTEM
        - AK_BOTH
      coreid: CORE_OTHER
    IOC0:
      type: IOC
      sender:
        - SENDER0
      receiver: RECEIVER
      iocdata:
        - IOC0_DATA0
        - IOC0_DATA1
        - IOC0_DATA2
      maxque: 0
      data:
        - IOC0_DATA0: DATA_UINT8_A
        - IOC0_DATA1: DATA_UINT16_A
        - IOC0_DATA2: DATA_UINT32_A
    SENDER0:
      type: IOC_SENDER
      osap: OSAP_SELF_CORE
      kind: AK_FUNCTION
    RECEIVER:
      type: IOC_RECEIVER
      osap: OSAP_OTHER_OTHER_CORE
      kind: AK_FUNCTION
    IOC0_DATA0:
      type: IOC_DATA
      datatype: uint8
      initval: DATA_UINT8_A
    IOC0_DATA1:
      type: IOC_DATA
      datatype: uint16
      initval: DATA_UINT16_A
    IOC0_DATA2:
      type: IOC_DATA
      datatype: uint32
      initval: DATA_UINT32_A

  do_0:
    id: C2ISR1
    syssrv: IocWriteGroup_IOC0(vname1,vname2,vname3)
    rettype: Std_ReturnType
    retval: IOC_E_NOK

  post_condition_0:
    C2ISR1:
      rtnstat: AK_STOP
    ERROR_HOOK1:
      hookstat: AK_ACTIVATE

  do_1:
    id: ERROR_HOOK1
    syssrv: CheckAssert(Error==IOC_E_NOK)

  post_condition_1:

  do_2:
    id: ERROR_HOOK1
    syssrv: CheckAssert(OSError_IocWrite_IocId()==IOC0)

  post_condition_2:
