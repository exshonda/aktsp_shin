IocEmptyQueue_m_error_1to1_g_d_0001:
  property:
    sc: 
      - SC1
      - SC2

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      osap: OSAP_SELF_CORE
    TASK2:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      osap: OSAP_OTHER_OTHER_CORE
    C2ISR2:
      type: C2ISR
      iniintpri: INT_PRI_MID
      intno: INTNO_OTHER_ISR2_B
      rtnstat: AK_ACTIVATE
      osap: OSAP_OTHER_OTHER_CORE
    ERROR_HOOK1:
      type: ERROR_HOOK
      hookstat: AK_STOP
      target_error_hook_cfg:
        - AK_ONLY_SYSTEM
        - AK_BOTH
      coreid: CORE_OTHER
    IOC0:
      type: IOC
      sender:
        - SENDER0
      receiver: RECEIVER
      iocdata:
        - IOC0_DATA0
        - IOC0_DATA1
        - IOC0_DATA2
      maxque: 3
      datalist:
    SENDER0:
      type: IOC_SENDER
      osap: OSAP_SELF_CORE
      kind: AK_FUNCTION
    RECEIVER:
      type: IOC_RECEIVER
      osap: OSAP_OTHER_OTHER_CORE
      kind: AK_FUNCTION
    IOC0_DATA0:
      type: IOC_DATA
      datatype: uint8
    IOC0_DATA1:
      type: IOC_DATA
      datatype: uint16
    IOC0_DATA2:
      type: IOC_DATA
      datatype: uint32

  do_0:
    id: C2ISR2
    syssrv: ioc_empty_queue_generic(-1)
    rettype: Std_ReturnType
    retval: IOC_E_ID

  post_condition_0:
    C2ISR2:
      rtnstat: AK_STOP
    ERROR_HOOK1:
      hookstat: AK_ACTIVATE

  do_1:
    id: ERROR_HOOK1
    syssrv: CheckAssert(Error==IOC_E_ID)

  post_condition_1:

  do_2:
    id: ERROR_HOOK1
    syssrv: CheckAssert(OSError_IocEmptyQueue_IocId()==-1)

  post_condition_2:
