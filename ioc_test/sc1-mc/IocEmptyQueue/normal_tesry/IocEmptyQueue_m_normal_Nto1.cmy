IocEmptyQueue_m_normal_Nto1_0201:
  property:
    sc: 
      - SC1
      - SC2

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      osap: OSAP_SELF_CORE
      var:
        vname1:
          type: AktspIocDataIntegerTypeNoPrim
          value: DATA_INT_D
    TASK2:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      osap: OSAP_OTHER_OTHER_CORE
    C2ISR2:
      type: C2ISR
      iniintpri: INT_PRI_MID
      intno: INTNO_OTHER_ISR2_B
      rtnstat: AK_ACTIVATE
      osap: OSAP_OTHER_OTHER_CORE
    ERROR_HOOK1:
      type: ERROR_HOOK
      hookstat: AK_STOP
      target_error_hook_cfg:
        - AK_ONLY_SYSTEM
        - AK_BOTH
      coreid: CORE_SELF
    IOC0:
      type: IOC
      sender:
        - SENDER0
        - SENDER1
      receiver: RECEIVER
      iocdata:
        - IOC0_DATA0
      maxque: 3
      datalist:
        - 
          - IOC0_DATA0: DATA_INT_A
        - 
          - IOC0_DATA0: DATA_INT_B
        - 
          - IOC0_DATA0: DATA_INT_C
    SENDER0:
      type: IOC_SENDER
      senderid: 0
      osap: OSAP_SELF_CORE
      kind: AK_MACRO
    SENDER1:
      type: IOC_SENDER
      senderid: 1
      osap: OSAP_OTHER_SAME_CORE
      kind: AK_MACRO
    RECEIVER:
      type: IOC_RECEIVER
      kind: AK_MACRO
      osap: OSAP_OTHER_OTHER_CORE
    IOC0_DATA0:
      type: IOC_DATA
      datatype: AktspIocDataIntegerTypeNoPrim

  do_0:
    id: TASK1
    syssrv: IocSend_IOC0_0(&vname1)
    rettype: Std_ReturnType
    retval: IOC_E_LIMIT

  post_condition_0:
    ERROR_HOOK1:
      hookstat: AK_ACTIVATE
    IOC0:
      lostflg: AK_TRUE
      datalist:
        - 
          - IOC0_DATA0: DATA_INT_A
        - 
          - IOC0_DATA0: DATA_INT_B
        - 
          - IOC0_DATA0: DATA_INT_C

  do_1:
    id: ERROR_HOOK1
    syssrv: CheckAssert(Error==IOC_E_LIMIT)

  post_condition_1:

  do_2:
    id: ERROR_HOOK1
    syssrv: CheckAssert(OSError_IocSend_IocId()==IOC0)

  post_condition_2:

  do_3:
    id: ERROR_HOOK1
    syssrv: CheckAssert(OSError_IocSend_SenderId()==0)

  post_condition_3:

  do_4:
    id: ERROR_HOOK1
    syssrv: return

  post_condition_4:
    ERROR_HOOK1:
