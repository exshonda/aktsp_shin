    id: TASK1
    syssrv: IocSend_IOC0_0(&vname1)
    rettype: Std_ReturnType
    retval: IOC_E_LIMIT

  post_condition_0:
    ERROR_HOOK1:
      hookstat: AK_ACTIVATE
    IOC0:
      lostflg: AK_TRUE
      datalist:
        - 
          - IOC0_DATA0: DATA_INT_A
        - 
          - IOC0_DATA0: DATA_INT_B
        - 
          - IOC0_DATA0: DATA_INT_C

  do_1:
    id: ERROR_HOOK1
    syssrv: CheckAssert(Error==IOC_E_LIMIT)

  post_condition_1:

  do_2:
    id: ERROR_HOOK1
    syssrv: CheckAssert(OSError_IocSend_IocId()==IOC0)

  post_condition_2:

  do_3:
    id: ERROR_HOOK1
    syssrv: CheckAssert(OSError_IocSend_SenderId()==0)

  post_condition_3:

  do_4:
    id: ERROR_HOOK1
    syssrv: return

  post_condition_4:
    ERROR_HOOK1:
      hookstat: AK_STOP

  do_5:
    id: TASK1
    syssrv: AktspRaiseInterrupt(INTNO_SELF_C2ISR_MID_D)

  post_condition_5:
    C2ISR2:
      rtnstat: AK_ACTIVATE

