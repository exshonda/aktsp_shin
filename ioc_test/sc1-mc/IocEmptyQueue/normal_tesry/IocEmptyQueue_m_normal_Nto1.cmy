      osap: OSAP_OTHER_SAME_CORE
    C2ISR2:
      type: C2ISR
      iniintpri: INT_PRI_HIGH
      intno: INTNO_SELF_C2ISR_MID_D
      rtnstat: AK_STOP
      osap: OSAP_OTHER_SAME_CORE
    ERROR_HOOK1:
      type: ERROR_HOOK
      hookstat: AK_STOP
      target_error_hook_cfg:
        - AK_ONLY_SYSTEM
        - AK_BOTH
      coreid: CORE_SELF
    IOC0:
      type: IOC
      sender:
        - SENDER0
        - SENDER1
      receiver: RECEIVER
      iocdata:
        - IOC0_DATA0
      maxque: 3
      datalist:
