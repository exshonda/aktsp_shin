    ERROR_HOOK1:
      type: ERROR_HOOK
      hookstat: AK_STOP
      target_error_hook_cfg:
        - AK_ONLY_SYSTEM
    IOC0:
      type: IOC
      sender:
        - SENDER0
        - SENDER1
      receiver: RECEIVER
      iocdata:
        - IOC0_DATA0
      maxque: 3
      datalist:
    SENDER0:
      type: IOC_SENDER
      senderid: 0
      osap: TRUSTED_OSAP1
      kind: AK_MACRO
    SENDER1:
      type: IOC_SENDER
      senderid: 1
      osap: TRUSTED_OSAP1
      kind: AK_MACRO
    RECEIVER:
      type: IOC_RECEIVER
      osap: TRUSTED_OSAP2
      kind: AK_MACRO
    IOC0_DATA0:
      type: IOC_DATA
      datatype: uint8

  do_0:
    id: TASK3
    syssrv: ioc_empty_queue_generic(0xFFFF)
    rettype: Std_ReturnType
    retval: IOC_E_ID
    gcov: true

  post_condition_0:
    ERROR_HOOK1:
      hookstat: AK_ACTIVATE

  do_1:
    id: ERROR_HOOK1
    syssrv: CheckAssert(Error==IOC_E_ID)

  post_condition_1:

  do_2:
    id: ERROR_HOOK1
    syssrv: CheckAssert(OSError_IocEmptyQueue_IocId()==0xFFFF)

  post_condition_2:
######################################################################
