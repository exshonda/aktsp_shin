IocEmptyQueue_error_1to1_g_d_0036:
  property:
    sc: 
      - SC3
      - SC4

  pre_condition:
    TASK1:
      type: TASK
      tstat: SUSPENDED
      osap: TRUSTED_OSAP1
    TASK2:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      osap: TRUSTED_OSAP2
    ERROR_HOOK1:
      type: ERROR_HOOK
      hookstat: AK_STOP
      target_error_hook_cfg:
        - AK_ONLY_SYSTEM
    IOC0:
      type: IOC
      sender:
        - SENDER0
      receiver: RECEIVER
      iocdata:
        - IOC0_DATA0
        - IOC0_DATA1
        - IOC0_DATA2
      maxque: 3
      datalist:
    SENDER0:
      type: IOC_SENDER
      osap: TRUSTED_OSAP1
      kind: AK_MACRO
    RECEIVER:
      type: IOC_RECEIVER
      osap: TRUSTED_OSAP2
      kind: AK_MACRO
    IOC0_DATA0:
      type: IOC_DATA
      datatype: uint8
    IOC0_DATA1:
      type: IOC_DATA
      datatype: uint16
    IOC0_DATA2:
      type: IOC_DATA
      datatype: uint32

  do_0:
    id: TASK2
    syssrv: ioc_empty_queue_generic(0xFFFF)
    rettype: Std_ReturnType
    retval: IOC_E_ID
    gcov: true

  post_condition_0:
    ERROR_HOOK1:
      hookstat: AK_ACTIVATE

  do_1:
    id: ERROR_HOOK1
    syssrv: CheckAssert(Error==IOC_E_ID)

  post_condition_1:

  do_2:
    id: ERROR_HOOK1
