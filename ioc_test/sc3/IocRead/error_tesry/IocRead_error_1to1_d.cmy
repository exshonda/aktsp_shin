######################################################################
# IocRead_error_1to1_d_0001.yaml
######################################################################
IocRead_error_1to1_d_0001:
  property:
    sc: 
      - SC3
      - SC4

  pre_condition:
    TASK1:
      type: TASK
      tstat: SUSPENDED
      osap: TRUSTED_OSAP1
    TASK2:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      osap: TRUSTED_OSAP2
    C2ISR2:
      type: C2ISR
      iniintpri: INT_PRI_MID
      intno: INTNO_SELF_C2ISR_MID_C
      rtnstat: AK_ACTIVATE
      osap: TRUSTED_OSAP2
      var:
        vname1:
          type: AktspIocDataIntegerTypeNoPrim
          value: DATA_UINT8_A
    ERROR_HOOK1:
      type: ERROR_HOOK
      hookstat: AK_STOP
      target_error_hook_cfg:
        - AK_ONLY_SYSTEM
    IOC0:
      type: IOC
      sender:
        - SENDER0
      receiver: RECEIVER
      iocdata:
        - IOC0_DATA0
      maxque: 0
      data:
        - IOC0_DATA0: DATA_UINT8_A
    SENDER0:
      type: IOC_SENDER
      osap: TRUSTED_OSAP1
      kind: AK_FUNCTION
    RECEIVER:
      type: IOC_RECEIVER
      osap: TRUSTED_OSAP2
      kind: AK_FUNCTION
    IOC0_DATA0:
      type: IOC_DATA
      datatype: uint8
      initval: DATA_UINT8_A

  do_0:
    id: C2ISR2
    syssrv: ioc_read_generic(-1,&vname1)
    rettype: Std_ReturnType
    retval: IOC_E_ID
    gcov: true

  post_condition_0:
    C2ISR2:
      rtnstat: AK_STOP
    ERROR_HOOK1:
      hookstat: AK_ACTIVATE

  do_1:
    id: ERROR_HOOK1
    syssrv: CheckAssert(Error==IOC_E_ID)

  post_condition_1:

  do_2:
    id: ERROR_HOOK1
    syssrv: CheckAssert(OSError_IocRead_IocId()==-1)

  post_condition_2:
