      tstat: SUSPENDED
      osap: TRUSTED_OSAP1
    STARTUP_HOOK1:
      type: STARTUP_HOOK
      hookstat: AK_ACTIVATE
      var:
        vname1:
          type: uint8
          value: DATA_UINT8_A
    TASK2:
      type: TASK
      tstat: SUSPENDED
      osap: TRUSTED_OSAP2
    ERROR_HOOK1:
      type: ERROR_HOOK
      hookstat: AK_STOP
      target_error_hook_cfg:
        - AK_ONLY_SYSTEM
    IOC0:
      type: IOC
      sender:
        - SENDER0
      receiver: RECEIVER
      iocdata:
        - IOC0_DATA0
      maxque: 3
      datalist:
    SENDER0:
      type: IOC_SENDER
      osap: TRUSTED_OSAP1
      kind: AK_MACRO
    RECEIVER:
      type: IOC_RECEIVER
      osap: TRUSTED_OSAP2
      kind: AK_MACRO
    IOC0_DATA0:
      type: IOC_DATA
      datatype: uint8

  do_0:
    id: STARTUP_HOOK1
    syssrv: IocSend_IOC0(vname1)
    rettype: Std_ReturnType
    retval: IOC_E_NOK
    gcov: true

  post_condition_0:
    STARTUP_HOOK1:
      hookstat: AK_STOP
    ERROR_HOOK1:
      hookstat: AK_ACTIVATE

  do_1:
    id: ERROR_HOOK1
    syssrv: CheckAssert(Error==IOC_E_NOK)

  post_condition_1:

  do_2:
    id: ERROR_HOOK1
    syssrv: CheckAssert(OSError_IocSend_IocId()==IOC0)

  post_condition_2:
######################################################################
