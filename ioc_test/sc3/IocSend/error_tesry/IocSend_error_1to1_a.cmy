      type: IOC_RECEIVER
      osap: TRUSTED_OSAP2
      kind: AK_FUNCTION
    IOC0_DATA0:
      type: IOC_DATA
      datatype: uint8

  do:
    id: C1ISR1
    syssrv: IocSend_IOC0(vname1)
    rettype: Std_ReturnType
    retval: IOC_E_NOK
    gcov: true

  post_condition:
