######################################################################
# IocSend_error_Nto1_e_0001.yaml
######################################################################
IocSend_error_Nto1_e_0001:
  property:
    sc: 
      - SC3
      - SC4

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      osap: TRUSTED_OSAP1
    C2ISR1:
      type: C2ISR
      iniintpri: INT_PRI_MID
      intno: INTNO_SELF_C2ISR_MID_A
      rtnstat: AK_ACTIVATE
      osap: TRUSTED_OSAP1
      var:
        vname1:
          type: AktspIocDataIntegerTypeNoPrim
          value: DATA_UINT8_A
    TASK2:
      type: TASK
      tstat: READY
      curpri: TSK_PRI_LOW
      osap: TRUSTED_OSAP1
    C2ISR2:
      type: C2ISR
      iniintpri: INT_PRI_HIGH
      intno: INTNO_SELF_C2ISR_HIGH
      rtnstat: AK_STOP
      osap: TRUSTED_OSAP1
    TASK3:
      type: TASK
      tstat: SUSPENDED
      osap: TRUSTED_OSAP2
    ERROR_HOOK1:
      type: ERROR_HOOK
      hookstat: AK_STOP
      target_error_hook_cfg:
        - AK_ONLY_SYSTEM
    IOC0:
      type: IOC
      sender:
        - SENDER0
        - SENDER1
      receiver: RECEIVER
      iocdata:
        - IOC0_DATA0
      maxque: 3
      datalist:
    SENDER0:
      type: IOC_SENDER
      senderid: 0
      osap: TRUSTED_OSAP1
      kind: AK_FUNCTION
    SENDER1:
      type: IOC_SENDER
      senderid: 1
      osap: TRUSTED_OSAP1
      kind: AK_FUNCTION
    RECEIVER:
      type: IOC_RECEIVER
      osap: TRUSTED_OSAP2
      kind: AK_FUNCTION
    IOC0_DATA0:
      type: IOC_DATA
      datatype: uint8

  do_0:
    id: C2ISR1
    syssrv: ioc_send_generic(-1,&vname1)
    rettype: Std_ReturnType
    retval: IOC_E_ID
    gcov: true

  post_condition_0:
    C2ISR1:
      rtnstat: AK_STOP
    ERROR_HOOK1:
      hookstat: AK_ACTIVATE

  do_1:
    id: ERROR_HOOK1
    syssrv: CheckAssert(Error==IOC_E_ID)

  post_condition_1:

  do_2:
    id: ERROR_HOOK1
    syssrv: CheckAssert(OSError_ioc_send_generic_WrapperId()==-1)

  post_condition_2:
