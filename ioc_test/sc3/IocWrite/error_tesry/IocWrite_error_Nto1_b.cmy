######################################################################
# IocWrite_error_Nto1_b_0001.yaml
######################################################################
IocWrite_error_Nto1_b_0001:
  property:
    sc: 
      - SC3
      - SC4

  pre_condition:
    TASK1:
      type: TASK
      tstat: SUSPENDED
      osap: TRUSTED_OSAP1
    TASK2:
      type: TASK
      tstat: SUSPENDED
      osap: TRUSTED_OSAP1
    TASK3:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      osap: TRUSTED_OSAP2
    C2ISR1:
      type: C2ISR
      iniintpri: INT_PRI_MID
      intno: INTNO_SELF_C2ISR_MID_C
      rtnstat: AK_ACTIVATE
      osap: TRUSTED_OSAP2
      var:
        vname1:
          type: uint8
          value: DATA_UINT8_A
    ERROR_HOOK1:
      type: ERROR_HOOK
      hookstat: AK_STOP
      target_error_hook_cfg:
        - AK_ONLY_SYSTEM
    IOC0:
      type: IOC
      sender:
        - SENDER0
        - SENDER1
      receiver: RECEIVER
      iocdata:
        - IOC0_DATA0
      maxque: 0
      data:
        - IOC0_DATA0: DATA_UINT8_A
    SENDER0:
      type: IOC_SENDER
      senderid: 0
      osap: TRUSTED_OSAP1
      kind: AK_FUNCTION
    SENDER1:
      type: IOC_SENDER
      senderid: 1
      osap: TRUSTED_OSAP1
      kind: AK_FUNCTION
    RECEIVER:
      type: IOC_RECEIVER
      osap: TRUSTED_OSAP2
      kind: AK_FUNCTION
    IOC0_DATA0:
      type: IOC_DATA
      datatype: uint8
      initval: DATA_UINT8_A

  do_0:
    id: C2ISR1
    syssrv: IocWrite_IOC0_0(vname1)
    rettype: Std_ReturnType
    retval: IOC_E_NOK
    gcov: true

  post_condition_0:
    C2ISR1:
      rtnstat: AK_STOP
    ERROR_HOOK1:
      hookstat: AK_ACTIVATE

  do_1:
    id: ERROR_HOOK1
    syssrv: CheckAssert(Error==IOC_E_NOK)

  post_condition_1:

  do_2:
    id: ERROR_HOOK1
    syssrv: CheckAssert(OSError_IocWrite_IocId()==IOC0)

  post_condition_2:

  do_3:
    id: ERROR_HOOK1
    syssrv: CheckAssert(OSError_IocWrite_SenderId()==0)

  post_condition_3:

  do_4:
    id: ERROR_HOOK1
    syssrv: return

  post_condition_4:
    ERROR_HOOK1:
      hookstat: AK_STOP

  do_5:
    id: TASK3
    syssrv: AktspRaiseInterrupt(INTNO_SELF_C2ISR_MID_C)

  post_condition_5:
    C2ISR1:
      bootcnt: 1
      rtnstat: AK_ACTIVATE

  do_6:
    id: C2ISR1
    syssrv: IocWrite_IOC0_1(vname1)
    rettype: Std_ReturnType
    retval: IOC_E_NOK
    gcov: true

  post_condition_6:
    C2ISR1:
      rtnstat: AK_STOP
    ERROR_HOOK1:
      hookstat: AK_ACTIVATE
      bootcnt: 1

  do_7:
    id: ERROR_HOOK1
    syssrv: CheckAssert(Error==IOC_E_NOK)

  post_condition_7:

  do_8:
    id: ERROR_HOOK1
    syssrv: CheckAssert(OSError_IocWrite_IocId()==IOC0)

  post_condition_8:

  do_9:
    id: ERROR_HOOK1
    syssrv: CheckAssert(OSError_IocWrite_SenderId()==1)

  post_condition_9:
