IocEmptyQueue_ex_normal_1to1_s_0118:
  property:
    sc: 
      - SC3
      - SC4

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      var:
        vname1:
          type: uint8
          value: DATA_UINT8_D
      osap: TRUSTED_OSAP1
    TASK2:
      type: TASK
      tstat: READY
      curpri: TSK_PRI_MID
      var:
        local:
          type: AktspTfParam
      osap: NON_TRUSTED_OSAP3
    TRUSTED_FUNCTION1:
      type: TRUSTED_FUNCTION
      osap: TRUSTED_OSAP2
    ERROR_HOOK1:
      type: ERROR_HOOK
      hookstat: AK_STOP
      target_error_hook_cfg:
        - AK_ONLY_SYSTEM
    IOC0:
      type: IOC
      sender:
        - SENDER0
      receiver: RECEIVER
      iocdata:
        - IOC0_DATA0
      maxque: 3
      datalist:
        - 
          - IOC0_DATA0: DATA_UINT8_A
        - 
          - IOC0_DATA0: DATA_UINT8_B
        - 
          - IOC0_DATA0: DATA_UINT8_C
    SENDER0:
      type: IOC_SENDER
      kind: AK_MACRO
      osap: TRUSTED_OSAP1
    RECEIVER:
      type: IOC_RECEIVER
      kind: AK_MACRO
      osap: TRUSTED_OSAP2
    IOC0_DATA0:
      type: IOC_DATA
      datatype: uint8

  do_0:
    id: TASK1
    syssrv: IocSend_IOC0(vname1)
    rettype: Std_ReturnType
    retval: IOC_E_LIMIT

  post_condition_0:
    ERROR_HOOK1:
      hookstat: AK_ACTIVATE
    IOC0:
      lostflg: AK_TRUE
      datalist:
        - 
          - IOC0_DATA0: DATA_UINT8_A
        - 
          - IOC0_DATA0: DATA_UINT8_B
        - 
          - IOC0_DATA0: DATA_UINT8_C

  do_1:
    id: ERROR_HOOK1
    syssrv: CheckAssert(Error==IOC_E_LIMIT)

  post_condition_1:

  do_2:
    id: ERROR_HOOK1
    syssrv: CheckAssert(OSError_IocSend_IocId()==IOC0)

  post_condition_2:

  do_3:
    id: ERROR_HOOK1
    syssrv: return

  post_condition_3:
    ERROR_HOOK1:
      hookstat: AK_STOP

  do_4:
    id: TASK1
    syssrv: TerminateTask()

  post_condition_4:
    TASK1:
      tstat: SUSPENDED
    TASK2:
      tstat: RUNNING

  do_5:
    id: TASK2
    syssrv: CallTrustedFunction(TRUSTED_FUNCTION1,&local)
    rettype: StatusType
    retval: E_OK

  post_condition_5:
    TRUSTED_FUNCTION1:
      caller: TASK2

  do_6:
    id: TRUSTED_FUNCTION1
    syssrv: IocEmptyQueue_IOC0()
    rettype: Std_ReturnType
    retval: IOC_E_OK
    gcov: true

  post_condition_6:
    IOC0:
      datalist:
      lostflg: AK_FALSE
