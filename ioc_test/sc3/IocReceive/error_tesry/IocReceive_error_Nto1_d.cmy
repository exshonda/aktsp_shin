        vname1:
          type: uint8
          value: (uint8)NULL
    ERROR_HOOK1:
      type: ERROR_HOOK
      hookstat: AK_STOP
      target_error_hook_cfg:
        - AK_ONLY_SYSTEM
    IOC0:
      type: IOC
      sender:
        - SENDER0
        - SENDER1
      receiver: RECEIVER
      iocdata:
        - IOC0_DATA0
      maxque: 1
      datalist:
    SENDER0:
      type: IOC_SENDER
      senderid: 0
      osap: TRUSTED_OSAP1
      kind: AK_FUNCTION
    SENDER1:
      type: IOC_SENDER
      senderid: 1
      osap: TRUSTED_OSAP1
      kind: AK_FUNCTION
    RECEIVER:
      type: IOC_RECEIVER
      osap: TRUSTED_OSAP2
      kind: AK_FUNCTION
    IOC0_DATA0:
      type: IOC_DATA
      datatype: uint8

  do_0:
    id: C2ISR2
    syssrv: IocReceive_IOC0(&vname1)
