    syssrv: return

  post_condition_3:
    ERROR_HOOK1:
      hookstat: AK_STOP

  do_4:
    id: TASK3
    syssrv: AktspRaiseInterrupt(INTNO_SELF_C2ISR_MID_C)

  post_condition_4:
    C2ISR2:
      rtnstat: AK_ACTIVATE
      bootcnt: 1

  do_5:
    id: C2ISR2
    syssrv: IocReceive_IOC0(&vname1)
