  do_0:
    id: TASK1
    syssrv: IocSend_IOC0_0(vname1)
    rettype: Std_ReturnType
    retval: IOC_E_LIMIT

  post_condition_0:
    ERROR_HOOK1:
      hookstat: AK_ACTIVATE
    IOC0:
      lostflg: AK_TRUE
      datalist:
        - 
          - IOC0_DATA0: DATA_UINT8_A
