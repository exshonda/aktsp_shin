IocReceive_error_1to1_e_0001:
  property:
    sc: 
      - SC3
      - SC4

  pre_condition:
    TASK1:
      type: TASK
      tstat: SUSPENDED
      osap: TRUSTED_OSAP1
    TASK2:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      osap: TRUSTED_OSAP2
    C2ISR2:
      type: C2ISR
      iniintpri: INT_PRI_MID
      intno: INTNO_SELF_C2ISR_MID_C
      rtnstat: AK_ACTIVATE
      osap: TRUSTED_OSAP2
      var:
        vname1:
          type: AktspIocDataIntegerTypeNoPrim
          value: DATA_UINT8_A
    ERROR_HOOK1:
      type: ERROR_HOOK
      hookstat: AK_STOP
      target_error_hook_cfg:
        - AK_ONLY_SYSTEM
    IOC0:
      type: IOC
      sender:
        - SENDER0
      receiver: RECEIVER
      iocdata:
        - IOC0_DATA0
      maxque: 3
      datalist:
    SENDER0:
      type: IOC_SENDER
      osap: TRUSTED_OSAP1
      kind: AK_FUNCTION
    RECEIVER:
      type: IOC_RECEIVER
      osap: TRUSTED_OSAP2
      kind: AK_FUNCTION
    IOC0_DATA0:
      type: IOC_DATA
      datatype: uint8

  do_0:
    id: C2ISR2
    syssrv: ioc_receive_generic(-1,&vname1)
