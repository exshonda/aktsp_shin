######################################################################
# IocReceive_error_1to1_d_0001.yaml
######################################################################
IocReceive_error_1to1_d_0001:
  property:
    sc: 
      - SC3
      - SC4

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      osap: TRUSTED_OSAP1
      var:
        vname1:
          type: uint8
          value: DATA_UINT8_D
    TASK2:
      type: TASK
      tstat: READY
      curpri: TSK_PRI_MID
      osap: TRUSTED_OSAP2
    C2ISR2:
      type: C2ISR
      iniintpri: INT_PRI_MID
      intno: INTNO_SELF_C2ISR_MID_C
      rtnstat: AK_STOP
      osap: TRUSTED_OSAP2
      var:
        vname1:
          type: uint8
    ERROR_HOOK2:
      type: ERROR_HOOK
      hookstat: AK_STOP
      target_error_hook_cfg:
        - AK_ONLY_SYSTEM
    IOC0:
      type: IOC
      sender:
        - SENDER0
      receiver: RECEIVER
      iocdata:
        - IOC0_DATA0
      maxque: 1
      datalist:
        - 
          - IOC0_DATA0: DATA_UINT8_A
    SENDER0:
      type: IOC_SENDER
      osap: TRUSTED_OSAP1
      kind: AK_FUNCTION
    RECEIVER:
      type: IOC_RECEIVER
      osap: TRUSTED_OSAP2
      kind: AK_FUNCTION
    IOC0_DATA0:
      type: IOC_DATA
      datatype: uint8

  do_0:
    id: TASK1
    syssrv: IocSend_IOC0(vname1)
    rettype: Std_ReturnType
    retval: IOC_E_LIMIT

  post_condition_0:
    ERROR_HOOK2:
      hookstat: AK_ACTIVATE
    IOC0:
      lostflg: AK_TRUE
      datalist:
        - 
          - IOC0_DATA0: DATA_UINT8_A

  do_1:
    id: ERROR_HOOK2
    syssrv: CheckAssert(Error==IOC_E_LIMIT)

  post_condition_1:

  do_2:
    id: ERROR_HOOK2
    syssrv: CheckAssert(OSError_IocSend_IocId()==IOC0)

  post_condition_2:

  do_3:
    id: ERROR_HOOK2
    syssrv: return

  post_condition_3:
    ERROR_HOOK2:
      hookstat: AK_STOP

  do_4:
    id: TASK1
    syssrv: AktspRaiseInterrupt(INTNO_SELF_C2ISR_MID_C)

  post_condition_4:
    C2ISR2:
      rtnstat: AK_ACTIVATE

  do_5:
    id: C2ISR2
    syssrv: IocReceive_IOC0(&vname1)
    rettype: Std_ReturnType
    retval: IOC_E_LOST_DATA
    gcov: true

  post_condition_5:
    C2ISR2:
      rtnstat: AK_STOP
      var:
        vname1:
          value: DATA_UINT8_A
    ERROR_HOOK2:
      hookstat: AK_ACTIVATE
      bootcnt: 1
    IOC0:
      lostflg: AK_FALSE
      datalist:

  do_6:
    id: ERROR_HOOK2
    syssrv: CheckAssert(Error==IOC_E_LOST_DATA)

  post_condition_6:

  do_7:
    id: ERROR_HOOK2
    syssrv: CheckAssert(OSError_IocReceive_IocId()==IOC0)

  post_condition_7:
