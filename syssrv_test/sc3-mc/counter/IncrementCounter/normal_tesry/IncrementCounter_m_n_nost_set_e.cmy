  do:
    id: TASK3
    syssrv: AktspIncrementHardwareCounter(COUNTER1)

  post_condition:
    TASK1:
      tstat: RUNNING
    TASK2:
      tstat: READY
      curevt: EVENT1
    COUNTER1:
      curval: 0
    SCHEDULE_TABLE1:
      curval: ANY_SCDLTBL_INIT_OFFSET_A
