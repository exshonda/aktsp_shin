      - SC4

  pre_condition:
    TASK3:
      type: TASK
      tstat: RUNNING
      inipri: TSK_PRI_MID
      osap: NT_OSAP_SELF_CORE
    TASK1:
      type: TASK
      tstat: RUNNING
      ttype: ANY_TTYPE
