      mask: EVENTMASK_A
    COUNTER1:
      type: COUNTER
      ctype: AK_HARDWARE
      curval: ANY_MAXVAL_A
      accosap:
        - NT_OSAP_SELF_CORE
        - NT_OSAP_OTHER_OTHER_CORE
    SCHEDULE_TABLE1:
      type: SCHEDULE_TABLE
