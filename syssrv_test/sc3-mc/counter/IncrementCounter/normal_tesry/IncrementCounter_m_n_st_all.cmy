IncrementCounter_m_n_st_all_0136:
  property:
    sc: 
      - SC3
      - SC4

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      osap: NT_OSAP_SELF_CORE
    TASK2:
      type: TASK
      tstat: WAITING
      curpri: TSK_PRI_LOW
      relevt:
        - EVENT1
      waievt: EVENT1
      osap: NT_OSAP_OTHER_OTHER_CORE
      accosap:
        - NT_OSAP_SELF_CORE
    TASK3:
      type: TASK
      tstat: WAITING
      curpri: TSK_PRI_BOTTOM
      relevt:
        - EVENT1
      waievt: EVENT1
      osap: NT_OSAP_OTHER_OTHER_CORE
      accosap:
        - NT_OSAP_SELF_CORE
    SCHEDULE_TABLE1:
      type: SCHEDULE_TABLE
      counter: COUNTER1
      syncstrategy: AK_IMPLICIT
      repeat: ANY_SCDLTBLREL_REPEAT
      ststat: SCHEDULETABLE_RUNNING_AND_SYNCHRONOUS
      duration: ANY_MAXVAL_A+1
      curval: ANY_SCDLTBL_INIT_OFFSET_A-1
      expoint:
        ANY_SCDLTBL_INIT_OFFSET_A:
          setevt:
            - TASK2: EVENT1
            - TASK3: EVENT1
      osap: NT_OSAP_SELF_CORE
      accosap:
        - NT_OSAP_SELF_CORE
    EVENT1:
      type: EVENT
    COUNTER1:
      type: COUNTER
      ctype: AK_SOFTWARE
      mincyc: ANY_MINCYC_A
      maxval: ANY_MAXVAL_A
      curval: 0
      cstat: AK_CS_NULL
      osap: NT_OSAP_SELF_CORE
      accosap:
        - NT_OSAP_SELF_CORE
        - NT_OSAP_OTHER_OTHER_CORE

  do:
    id: TASK1
    syssrv: IncrementCounter(COUNTER1)
    rettype: StatusType
    retval: E_OK

  post_condition:
    COUNTER1:
      curval: 1
    SCHEDULE_TABLE1:
      curval: ANY_SCDLTBL_INIT_OFFSET_A
    TASK2:
      tstat: RUNNING
      curevt: EVENT1
    TASK3:
      tstat: READY
      curevt: EVENT1
