    sc: 
      - SC3
      - SC4

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      osap: NT_OSAP_SELF_CORE
      var:
        local:
          type: AktspTfParam
    TASK2:
      type: TASK
      tstat: WAITING
      curpri: TSK_PRI_LOW
      relevt:
        - EVENT1
      waievt: EVENT1
      osap: TR_OSAP_OTHER_OTHER_CORE
      accosap:
        - NT_OSAP_SELF_CORE
    TASK3:
      type: TASK
      tstat: WAITING
      curpri: TSK_PRI_BOTTOM
      relevt:
        - EVENT1
      waievt: EVENT1
      osap: TR_OSAP_OTHER_OTHER_CORE
      accosap:
        - NT_OSAP_SELF_CORE
    SCHEDULE_TABLE1:
      type: SCHEDULE_TABLE
      counter: COUNTER1
      syncstrategy: AK_IMPLICIT
      repeat: ANY_SCDLTBLREL_REPEAT
      ststat: SCHEDULETABLE_RUNNING_AND_SYNCHRONOUS
      duration: ANY_MAXVAL_A+1
      curval: ANY_SCDLTBL_INIT_OFFSET_A-1
      expoint:
        ANY_SCDLTBL_INIT_OFFSET_A:
          setevt:
            - TASK2: EVENT1
            - TASK3: EVENT1
      osap: NT_OSAP_SELF_CORE
    TRUSTED_FUNCTION1:
      type: TRUSTED_FUNCTION
      arg: local
      osap: TR_OSAP_SELF_CORE
      caller: TASK1
    EVENT1:
      type: EVENT
    COUNTER1:
      type: COUNTER
      ctype: AK_HARDWARE
      curval: 0
      accosap:
        - NT_OSAP_SELF_CORE

  do:
    id: TRUSTED_FUNCTION1
    syssrv: AktspIncrementHardwareCounter(COUNTER1)

  post_condition:
    COUNTER1:
      curval: 1
    SCHEDULE_TABLE1:
      curval: ANY_SCDLTBL_INIT_OFFSET_A
    TASK2:
      tstat: RUNNING
      curevt: EVENT1
    TASK3:
      tstat: READY
      curevt: EVENT1
