IncrementCounter_m_n_nost_act_t_0882:
  property:
    sc: 
      - SC3
      - SC4

  pre_condition:
    TASK3:
      type: TASK
      tstat: RUNNING
      inipri: TSK_PRI_MID
      osap: NT_OSAP_SELF_CORE
    TASK1:
      type: TASK
      tstat: RUNNING
      inipri: TSK_PRI_MID
      curpri: TSK_PRI_MID
      ttype: ANY_TTYPE
      spolicy: AK_SCHFULL
      osap: NT_OSAP_OTHER_OTHER_CORE
    TASK2:
      type: TASK
      tstat: READY
      spolicy: AK_SCHFULL
      curpri: TSK_PRI_MID
      ttype: AK_BASIC
      maxact: ANY_BASIC_MAXACT
      actcnt: ANY_ACTCNT_NOT_MAX_1
      osap: NT_OSAP_OTHER_OTHER_CORE
      accosap:
        - NT_OSAP_SELF_CORE
    COUNTER1:
      type: COUNTER
      ctype: AK_HARDWARE
      curval: ANY_CURVAL_NOT_MAX_A
      accosap:
        - NT_OSAP_SELF_CORE
        - NT_OSAP_OTHER_OTHER_CORE
    SCHEDULE_TABLE1:
      type: SCHEDULE_TABLE
      counter: COUNTER1
      syncstrategy: AK_NONE
      repeat: ANY_SCDLTBLREL_REPEAT
      ststat: SCHEDULETABLE_RUNNING
      duration: ANY_SCDLTBL_DURATION_A
      curval: ANY_SCDLTBL_INIT_OFFSET_A-1
      expoint:
        ANY_SCDLTBL_INIT_OFFSET_A:
          acttsk:
            - TASK2
      osap: NT_OSAP_SELF_CORE
      accosap:
        - NT_OSAP_SELF_CORE

  do:
    id: TASK3
    syssrv: AktspIncrementHardwareCounter(COUNTER1)

  post_condition:
    TASK1:
      tstat: RUNNING
    TASK2:
      tstat: READY
      actcnt: ANY_ACTCNT_NOT_MAX_1+1
    COUNTER1:
      curval: ANY_CURVAL_NOT_MAX_A+1
    SCHEDULE_TABLE1:
      curval: ANY_SCDLTBL_INIT_OFFSET_A
