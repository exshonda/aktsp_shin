IncrementCounter_m_n_nost_act_t_0600:
  property:
    sc: 
      - SC3
      - SC4

  pre_condition:
    TASK3:
      type: TASK
      tstat: RUNNING
      inipri: TSK_PRI_MID
      osap: NT_OSAP_SELF_CORE
    TASK1:
      type: TASK
      tstat: RUNNING
      inipri: TSK_PRI_MID
      curpri: TSK_PRI_MID
      ttype: ANY_TTYPE
      spolicy: AK_SCHFULL
      osap: NT_OSAP_OTHER_OTHER_CORE
    TASK2:
      type: TASK
      tstat: READY
      spolicy: AK_SCHFULL
      curpri: TSK_PRI_LOW
      ttype: AK_BASIC
      maxact: ANY_BASIC_MAXACT
      actcnt: 1
      osap: NT_OSAP_OTHER_OTHER_CORE
      accosap:
        - NT_OSAP_SELF_CORE
    COUNTER1:
      type: COUNTER
      ctype: AK_SOFTWARE
      mincyc: ANY_MINCYC_A
      maxval: ANY_MAXVAL_A
      curval: ANY_CURVAL_NOT_MAX_A
      cstat: AK_CS_NULL
      osap: NT_OSAP_SELF_CORE
      accosap:
        - NT_OSAP_SELF_CORE
        - NT_OSAP_OTHER_OTHER_CORE
    SCHEDULE_TABLE1:
      type: SCHEDULE_TABLE
      counter: COUNTER1
      syncstrategy: AK_NONE
      repeat: ANY_SCDLTBLREL_REPEAT
      ststat: SCHEDULETABLE_RUNNING
      duration: ANY_SCDLTBL_DURATION_A
      curval: ANY_SCDLTBL_INIT_OFFSET_A-1
      expoint:
        ANY_SCDLTBL_INIT_OFFSET_A:
          acttsk:
            - TASK2
      osap: NT_OSAP_SELF_CORE
      accosap:
        - NT_OSAP_SELF_CORE

  do:
    id: TASK3
    syssrv: IncrementCounter(COUNTER1)
    rettype: StatusType
    retval: E_OK

  post_condition:
    TASK1:
      tstat: RUNNING
    TASK2:
      tstat: READY
      actcnt: 2
    COUNTER1:
      curval: ANY_CURVAL_NOT_MAX_A+1
    SCHEDULE_TABLE1:
      curval: ANY_SCDLTBL_INIT_OFFSET_A
