######################################################################
# GetAlarmBase_m_normal_1_0001.yaml
######################################################################
GetAlarmBase_m_normal_1_0001:
  property:
    sc: 
      - SC3
      - SC4

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      osap: TR_OSAP_OTHER_OTHER_CORE
    C2ISR1:
      type: C2ISR
      intno: INTNO_OTHER_ISR2_C
      iniintpri: INT_PRI_MID
      var:
        vname1:
          type: AlarmBaseType
      rtnstat: AK_ACTIVATE
      osap: TR_OSAP_OTHER_OTHER_CORE
    ALARM1:
      type: ALARM
      almact: AK_ALM_INCNT
      counter: COUNTER1
      astat: AK_SET
      almval: 0
      cycle: ANY_ALMCYCLE_A
      incounter: COUNTER2
      osap: TR_OSAP_SELF_CORE
    COUNTER1:
      type: COUNTER
      ctype: AK_HARDWARE
      curval: ANY_MAXVAL_A
    COUNTER2:
      type: COUNTER
      ctype: AK_SOFTWARE
      mincyc: 1
      maxval: ANY_MAXVAL_B
      curval: 0
      cstat: AK_CS_NULL
      osap: TR_OSAP_SELF_CORE

  do:
    id: C2ISR1
    syssrv: GetAlarmBase(ALARM1,&vname1)
    rettype: StatusType
    retval: E_OK

  post_condition:
    C2ISR1:
      var:
        vname1:
          maxallowedvalue: ANY_MAXVAL_A
          mincycle: ANY_MINCYC_A
          ticksperbase: ANY_TICKSPERBASE
