######################################################################
# GetAlarm_m_normal_1_0001.yaml
######################################################################
GetAlarm_m_normal_1_0001:
  property:
    sc: 
      - SC3
      - SC4

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      osap: TR_OSAP_OTHER_OTHER_CORE
    C2ISR1:
      type: C2ISR 
      iniintpri: INT_PRI_MID
      var:
        vname1:
          type: TickType
      intno: INTNO_OTHER_ISR2_C
      rtnstat: AK_ACTIVATE
      osap: TR_OSAP_OTHER_OTHER_CORE
    ALARM1:
      type: ALARM
      almact: AK_ALM_INCNT
      counter: COUNTER1
      astat: AK_SET
      almval: ANY_CURVAL_NOT_0_A
      cycle: ANY_ALMCYCLE_A
      incounter: COUNTER2
      osap: TR_OSAP_SELF_CORE
    COUNTER1:
      type: COUNTER
      ctype: AK_HARDWARE
      curval: 0
    COUNTER2:
      type: COUNTER
      ctype: AK_SOFTWARE
      mincyc: 1
      maxval: ANY_MAXVAL_B
      curval: 0
      cstat: AK_CS_NULL
      osap: TR_OSAP_SELF_CORE

  do:
    id: C2ISR1
    syssrv: GetAlarm(ALARM1,&vname1)
    rettype: StatusType
    retval: E_OK

  post_condition:
    C2ISR1:
      var:
        vname1:
          value: ANY_CURVAL_NOT_0_A
