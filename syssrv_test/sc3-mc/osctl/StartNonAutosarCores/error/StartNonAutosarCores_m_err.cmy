######################################################################
# StartNonAutosarCores_m_err_0001.yaml
######################################################################
StartNonAutosarCores_m_err_0001:
  property:
    sc: 
      - SC3

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      osap: TR_OSAP_SELF_CORE
    C1ISR1:
      type: C1ISR
      intno: INTNO_SELF_C1ISR_MID
      iniintpri: INT_PRI_ISR1_MID
      rtnstat: AK_ACTIVATE
      osap: TR_OSAP_SELF_CORE

  do_0:
    id: C1ISR1
    syssrv: StartNonAutosarCore(0,&ercd)

  post_condition_0:
######################################################################
# StartNonAutosarCores_m_err_0002.yaml
######################################################################
StartNonAutosarCores_m_err_0002:
  property:
    sc: 
      - SC3

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      osap: TR_OSAP_SELF_CORE
    C2ISR1:
      type: C2ISR
      intno: INTNO_SELF_C2ISR_MID_A
      iniintpri: INT_PRI_MID
      rtnstat: AK_ACTIVATE
      osap: TR_OSAP_SELF_CORE
    ERROR_HOOK1:
      type: ERROR_HOOK
      hookstat: AK_STOP
      target_error_hook_cfg:
        - AK_ONLY_SYSTEM
      coreid: CORE_SELF

  do_0:
    id: C2ISR1
    syssrv: StartNonAutosarCore(0,&ercd)

  post_condition_0:
    C2ISR1:
      rtnstat: AK_STOP
    ERROR_HOOK1:
      hookstat: AK_ACTIVATE

  do_1:
    id: ERROR_HOOK1
    syssrv: CheckAssert(Error==E_OS_ACCESS)

  post_condition_1:

  do_2:
    id: ERROR_HOOK1
    syssrv: return
    gcov: false

  post_condition_2:
    C2ISR1:
      rtnstat: AK_ACTIVATE
      target_error_hook_cfg:
        - AK_ONLY_SYSTEM
    ERROR_HOOK1:
      hookstat: AK_STOP
