SetEvent_m_normal_2_NT_3204:
  property:
    sc: 
      - SC3
      - SC4

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      inipri: TSK_PRI_MID
      curpri: TSK_PRI_HIGH
      spolicy: AK_SCHFULL
      relres:
        - RESOURCE1
      getres:
        - RESOURCE1
      osap: NT_OSAP_SELF_CORE
    TASK2:
      type: TASK
      tstat: WAITING
      curpri: TSK_PRI_HIGH
      ttype: AK_EXTENDED
      curevt: EVENT1
      waievt: EVENT2
      relevt:
        - EVENT1
        - EVENT2
      relres:
        - RESOURCE1
      spolicy: AK_SCHFULL
      osap: NT_OSAP_SELF_CORE
    TASK4:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      osap: TR_OSAP_OTHER_OTHER_CORE
    EVENT1:
      type: EVENT
      mask: EVENTMASK_A
    EVENT2:
      type: EVENT
      mask: EVENTMASK_B
    RESOURCE1:
      type: RESOURCE
      resprop: AK_INTERNAL
      lockflg: AK_LOCK
      accosap:
        - NT_OSAP_SELF_CORE
    INT_STATE1:
      type: INT_STATE
      istat:
        - AK_SUS_OS_INT: TASK1
      coreid: CORE_SELF

  do:
    id: TASK4
    syssrv: SetEvent(TASK2,EVENT2)
    rettype: StatusType
    retval: E_OK

  post_condition:
    TASK1:
      tstat: RUNNING
    TASK2:
      tstat: READY
      curevt: EVENT1|EVENT2
