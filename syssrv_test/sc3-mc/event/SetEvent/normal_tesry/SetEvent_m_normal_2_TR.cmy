######################################################################
# SetEvent_m_normal_2_TR_0001.yaml
######################################################################
SetEvent_m_normal_2_TR_0001:
  property:
    sc: 
      - SC3
      - SC4

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      inipri: TSK_PRI_MID
      curpri: TSK_PRI_HIGH
      spolicy: AK_SCHFULL
      relres:
        - RESOURCE1
      getres:
        - RESOURCE1
      osap: TR_OSAP_SELF_CORE
    TASK2:
      type: TASK
      tstat: READY
      curpri: TSK_PRI_HIGH
      ttype: AK_EXTENDED
      curevt: 0
      relevt:
        - EVENT1
        - EVENT2
      relres:
        - RESOURCE1
      spolicy: AK_SCHFULL
      osap: TR_OSAP_SELF_CORE
    TASK4:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      osap: TR_OSAP_OTHER_OTHER_CORE
    C2ISR1:
      type: C2ISR
      intno: INTNO_OTHER_ISR2_C
      iniintpri: INT_PRI_MID
      rtnstat: AK_ACTIVATE
      osap: TR_OSAP_OTHER_OTHER_CORE
    EVENT1:
      type: EVENT
      mask: EVENTMASK_A
    EVENT2:
      type: EVENT
      mask: EVENTMASK_B
    RESOURCE1:
      type: RESOURCE
      resprop: AK_INTERNAL
      lockflg: AK_LOCK
      accosap:
        - NT_OSAP_SELF_CORE
    INT_STATE1:
      type: INT_STATE
      istat:
        - AK_DIS_ALL_INT: TASK1
      coreid: CORE_SELF

  do_0:
    id: C2ISR1
    syssrv: SetEvent(TASK2,EVENT1)
    rettype: StatusType
    retval: E_OK
    gcov: true

  post_condition_0:
    TASK1:
      tstat: RUNNING
    TASK2:
      tstat: READY
      curevt: EVENT1

  do_1:
    id: C2ISR1
    syssrv: return
    gcov: false

  post_condition_1:
    TASK1:
      tstat: RUNNING
    TASK2:
      tstat: READY
      curevt: EVENT1
    C2ISR1:
      rtnstat: AK_STOP
