SetEvent_m_normal_1_1820:
  property:
    sc: 
      - SC3
      - SC4

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      spolicy: AK_SCHFULL
      curpri: TSK_PRI_MID
      osap: NT_OSAP_SELF_CORE
    TASK2:
      type: TASK
      tstat: WAITING
      curpri: TSK_PRI_HIGH
      ttype: AK_EXTENDED
      curevt: EVENT1
      waievt: EVENT2
      relevt:
        - EVENT1
        - EVENT2
      spolicy: AK_SCHFULL
      osap: NT_OSAP_SELF_CORE
      accosap:
        - NT_OSAP_OTHER_OTHER_CORE
    TASK4:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      osap: NT_OSAP_OTHER_OTHER_CORE
    EVENT1:
      type: EVENT
      mask: EVENTMASK_A
    EVENT2:
      type: EVENT
      mask: EVENTMASK_B

  do:
    id: TASK4
    syssrv: SetEvent(TASK2,EVENT1|EVENT2)
    rettype: StatusType
    retval: E_OK

  post_condition:
    TASK1:
      tstat: READY
    TASK2:
      tstat: RUNNING
      curevt: EVENT1|EVENT2
