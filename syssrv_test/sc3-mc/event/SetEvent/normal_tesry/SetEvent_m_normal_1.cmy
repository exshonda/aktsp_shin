SetEvent_m_normal_1_2385:
  property:
    sc: 
      - SC3
      - SC4

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      spolicy: AK_SCHFULL
      inipri: TSK_PRI_MID
      curpri: TSK_PRI_MID
      relres:
        - RESOURCE1
      getres:
        - RESOURCE1
      osap: TR_OSAP_SELF_CORE
    TASK2:
      type: TASK
      tstat: WAITING
      curpri: TSK_PRI_LOW
      ttype: AK_EXTENDED
      curevt: EVENT1
      waievt: EVENT2
      relevt:
        - EVENT1
        - EVENT2
      relres:
        - RESOURCE1
      spolicy: AK_SCHFULL
      osap: TR_OSAP_SELF_CORE
    TASK4:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      osap: NT_OSAP_OTHER_OTHER_CORE
      var:
        local:
          type: AktspTfParam
    EVENT1:
      type: EVENT
      mask: EVENTMASK_A
    EVENT2:
      type: EVENT
      mask: EVENTMASK_B
    RESOURCE1:
      type: RESOURCE
      resprop: AK_INTERNAL
      lockflg: AK_LOCK
      accosap:
        - NT_OSAP_SELF_CORE
    TRUSTED_FUNCTION1:
      type: TRUSTED_FUNCTION
      arg: local
      osap: TR_OSAP_OTHER_OTHER_CORE
      caller: TASK4

  do:
    id: TRUSTED_FUNCTION1
    syssrv: SetEvent(TASK2,EVENT1)
    rettype: StatusType
    retval: E_OK

  post_condition:
    TASK1:
      tstat: RUNNING
    TASK2:
      tstat: WAITING
      curevt: EVENT1
