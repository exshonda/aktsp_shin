  property:
    sc: 
      - SC3
      - SC4

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      spolicy: AK_SCHNON
      curpri: TSK_PRI_MID
      osap: TR_OSAP_SELF_CORE
    TASK2:
      type: TASK
      tstat: WAITING
      curpri: TSK_PRI_MID
      ttype: AK_EXTENDED
      curevt: 0
      waievt: EVENT1
      relevt:
        - EVENT1
        - EVENT2
      spolicy: AK_SCHNON
      osap: TR_OSAP_SELF_CORE
    TASK4:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      osap: NT_OSAP_OTHER_OTHER_CORE
      var:
        local:
          type: AktspTfParam
    EVENT1:
      type: EVENT
      mask: EVENTMASK_A
    EVENT2:
      type: EVENT
      mask: EVENTMASK_B
    TRUSTED_FUNCTION1:
      type: TRUSTED_FUNCTION
      arg: local
      osap: TR_OSAP_OTHER_OTHER_CORE
      caller: TASK4

  do:
    id: TRUSTED_FUNCTION1
    syssrv: SetEvent(TASK2,EVENT2)
    rettype: StatusType
    retval: E_OK

  post_condition:
    TASK1:
      tstat: RUNNING
    TASK2:
      tstat: WAITING
      curevt: EVENT2
