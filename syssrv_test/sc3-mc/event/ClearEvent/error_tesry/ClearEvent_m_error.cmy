    SPINLOCK1:
      type: SPINLOCK
      susint: AK_SUS_OS_SPN
      lockflg: AK_LOCK
      accosap:
        - TR_OSAP_SELF_CORE
        - TR_OSAP_OTHER_OTHER_CORE
    INT_STATE1:
      type: INT_STATE
      istat:
        - AK_SUS_OS_INT: SPINLOCK1
      coreid: CORE_SELF
    EVENT1:
      type: EVENT

  do_0:
    id: TASK1
    syssrv: ClearEvent(EVENT1)
    rettype: StatusType
    retval: E_OS_DISABLEDINT
    gcov: true

  post_condition_0:
    ERROR_HOOK1:
      hookstat: AK_ACTIVATE

  do_1:
    id: ERROR_HOOK1
