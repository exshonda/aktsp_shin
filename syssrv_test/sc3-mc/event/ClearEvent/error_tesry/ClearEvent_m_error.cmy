    gcov: false

  post_condition_1:

  do_2:
    id: ERROR_HOOK1
    syssrv: CheckAssert(OSError_ClearEvent_Mask()==EVENT1)
    gcov: false
    need_si:
      - IOS030

  post_condition_2:

  do_3:
    id: ERROR_HOOK1
    syssrv: CheckAssert(OSErrorGetServiceId()==OSServiceId_ClearEvent)
    gcov: false

  post_condition_3:

  do_4:
