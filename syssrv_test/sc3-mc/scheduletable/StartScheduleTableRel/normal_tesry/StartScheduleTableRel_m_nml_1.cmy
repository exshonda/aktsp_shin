      tstat: RUNNING
      curpri: TSK_PRI_MID
      osap: TR_OSAP_OTHER_OTHER_CORE
    TASK2:
      type: TASK
      tstat: SUSPENDED
      inipri: TSK_PRI_MID
      ttype: AK_BASIC
      maxact: 6
      osap: TR_OSAP_OTHER_OTHER_CORE
    TASK3:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      osap: TR_OSAP_SELF_CORE
    COUNTER1:
      type: COUNTER
      ctype: AK_SOFTWARE
      mincyc: ANY_MINCYC_A
      maxval: ANY_MAXVAL_A
      curval: ANY_CURVAL_STARTSCDLTBLREL
      cstat: AK_CS_NULL
      osap: TR_OSAP_SELF_CORE
    SCHEDULE_TABLE1:
      type: SCHEDULE_TABLE
      counter: COUNTER1
      syncstrategy: AK_NONE
      repeat: AK_TRUE
      ststat: SCHEDULETABLE_STOPPED
      duration: ANY_SCDLTBL_DURATION_A
      expoint:
        ANY_SCDLTBL_INIT_OFFSET_A:
          acttsk:
            - TASK2
      osap: TR_OSAP_SELF_CORE

  do_0:
    id: TASK1
    syssrv: StartScheduleTableRel(SCHEDULE_TABLE1,ANY_MAXVAL_A-ANY_CURVAL_STARTSCDLTBLREL+ANY_CURVAL_STARTSCDLTBLREL_WRAPAROUND+1)
    rettype: StatusType
    retval: E_OK
    gcov: true

  post_condition_0:
    SCHEDULE_TABLE1:
      ststat: SCHEDULETABLE_RUNNING

  do_1:
    id: TASK3
    syssrv: IncrementCounter(COUNTER1)
    repeat: ANY_MAXVAL_A-ANY_CURVAL_STARTSCDLTBLREL+ANY_CURVAL_STARTSCDLTBLREL_WRAPAROUND+1+ANY_SCDLTBL_INIT_OFFSET_A
    rettype: StatusType
    retval: E_OK
    gcov: false

  post_condition_1:
    COUNTER1:
      curval: (ANY_CURVAL_STARTSCDLTBLREL_WRAPAROUND+ANY_SCDLTBL_INIT_OFFSET_A)%(ANY_MAXVAL_A+1)
    SCHEDULE_TABLE1:
      curval: ANY_SCDLTBL_INIT_OFFSET_A
    TASK2:
      tstat: READY
      actcnt: 1
      curpri: TSK_PRI_MID

  do_2:
    id: TASK3
    syssrv: IncrementCounter(COUNTER1)
    repeat: ANY_SCDLTBL_DURATION_A
    rettype: StatusType
    retval: E_OK
    gcov: false

  post_condition_2:
    COUNTER1:
      curval: (ANY_CURVAL_STARTSCDLTBLREL_WRAPAROUND+ANY_SCDLTBL_INIT_OFFSET_A+ANY_SCDLTBL_DURATION_A*1)%(ANY_MAXVAL_A+1)
    SCHEDULE_TABLE1:
      curval: ANY_SCDLTBL_INIT_OFFSET_A
    TASK2:
      tstat: READY
      actcnt: 2

  do_3:
    id: TASK3
    syssrv: IncrementCounter(COUNTER1)
    repeat: ANY_SCDLTBL_DURATION_A
    rettype: StatusType
    retval: E_OK
    gcov: false

  post_condition_3:
    COUNTER1:
      curval: (ANY_CURVAL_STARTSCDLTBLREL_WRAPAROUND+ANY_SCDLTBL_INIT_OFFSET_A+ANY_SCDLTBL_DURATION_A*2)%(ANY_MAXVAL_A+1)
    SCHEDULE_TABLE1:
      curval: ANY_SCDLTBL_INIT_OFFSET_A
    TASK2:
      tstat: READY
      actcnt: 3

  do_4:
    id: TASK3
    syssrv: IncrementCounter(COUNTER1)
    repeat: ANY_SCDLTBL_DURATION_A
    rettype: StatusType
    retval: E_OK
    gcov: false

  post_condition_4:
    COUNTER1:
      curval: (ANY_CURVAL_STARTSCDLTBLREL_WRAPAROUND+ANY_SCDLTBL_INIT_OFFSET_A+ANY_SCDLTBL_DURATION_A*3)%(ANY_MAXVAL_A+1)
    SCHEDULE_TABLE1:
      curval: ANY_SCDLTBL_INIT_OFFSET_A
    TASK2:
      tstat: READY
      actcnt: 4

  do_5:
    id: TASK3
    syssrv: IncrementCounter(COUNTER1)
    repeat: ANY_SCDLTBL_DURATION_A
    rettype: StatusType
    retval: E_OK
    gcov: false

  post_condition_5:
    COUNTER1:
      curval: (ANY_CURVAL_STARTSCDLTBLREL_WRAPAROUND+ANY_SCDLTBL_INIT_OFFSET_A+ANY_SCDLTBL_DURATION_A*4)%(ANY_MAXVAL_A+1)
    SCHEDULE_TABLE1:
      curval: ANY_SCDLTBL_INIT_OFFSET_A
    TASK2:
      tstat: READY
      actcnt: 5

  do_6:
    id: TASK3
    syssrv: IncrementCounter(COUNTER1)
    repeat: ANY_SCDLTBL_DURATION_A
    rettype: StatusType
    retval: E_OK
    gcov: false

  post_condition_6:
    COUNTER1:
      curval: (ANY_CURVAL_STARTSCDLTBLREL_WRAPAROUND+ANY_SCDLTBL_INIT_OFFSET_A+ANY_SCDLTBL_DURATION_A*5)%(ANY_MAXVAL_A+1)
    SCHEDULE_TABLE1:
      curval: ANY_SCDLTBL_INIT_OFFSET_A
    TASK2:
      tstat: READY
      actcnt: 6
######################################################################
