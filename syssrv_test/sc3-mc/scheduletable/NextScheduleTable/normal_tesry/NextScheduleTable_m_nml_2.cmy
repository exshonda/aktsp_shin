NextScheduleTable_m_nml_2_1489:
  property:
    sc: 
      - SC3
      - SC4

  pre_condition:
    TASK4:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      osap: NT_OSAP_OTHER_OTHER_CORE
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      getspn:
        - SPINLOCK1
      osap: TR_OSAP_SELF_CORE
    TASK2:
      type: TASK
      tstat: SUSPENDED
      inipri: TSK_PRI_MID
      osap: TR_OSAP_SELF_CORE
    TASK3:
      type: TASK
      tstat: SUSPENDED
      inipri: TSK_PRI_MID
      osap: TR_OSAP_SELF_CORE
      ttype: AK_BASIC
      maxact: 6
    COUNTER1:
      type: COUNTER
      ctype: AK_SOFTWARE
      mincyc: ANY_MINCYC_A
      maxval: ANY_MAXVAL_A
      curval: ANY_CURVAL_A
      cstat: AK_CS_NULL
      osap: TR_OSAP_SELF_CORE
    SCHEDULE_TABLE1:
      type: SCHEDULE_TABLE
      counter: COUNTER1
      syncstrategy: AK_IMPLICIT
      repeat: AK_FALSE
      ststat: SCHEDULETABLE_RUNNING_AND_SYNCHRONOUS
      duration: ANY_MAXVAL_A+1
      curval: 0
      expoint:
        ANY_SCDLTBL_INIT_OFFSET_NOT_0_MAX_A:
          acttsk:
            - TASK2
      osap: TR_OSAP_SELF_CORE
      accosap:
        - NT_OSAP_OTHER_OTHER_CORE
    SCHEDULE_TABLE2:
      type: SCHEDULE_TABLE
      counter: COUNTER1
      syncstrategy: AK_IMPLICIT
      repeat: AK_TRUE
      ststat: SCHEDULETABLE_NEXT
      stfrom: SCHEDULE_TABLE1
      duration: ANY_MAXVAL_A+1
      expoint:
        ANY_SCDLTBL_INIT_OFFSET_B:
          acttsk:
            - TASK3
      osap: TR_OSAP_SELF_CORE
      accosap:
        - NT_OSAP_OTHER_OTHER_CORE
    SCHEDULE_TABLE3:
      type: SCHEDULE_TABLE
      counter: COUNTER1
      syncstrategy: AK_IMPLICIT
      repeat: AK_FALSE
      ststat: SCHEDULETABLE_STOPPED
      duration: ANY_MAXVAL_A+1
      expoint:
        ANY_SCDLTBL_INIT_OFFSET_B:
          acttsk:
            - TASK3
      osap: TR_OSAP_SELF_CORE
      accosap:
        - NT_OSAP_OTHER_OTHER_CORE
    SPINLOCK1:
      type: SPINLOCK
      susint: AK_SUS_ALL_SPN
      accosap:
        - NT_OSAP_SELF_CORE
        - NT_OSAP_OTHER_OTHER_CORE
      lockflg: AK_LOCK
    INT_STATE1:
      type: INT_STATE
      istat:
        - AK_SUS_ALL_INT: SPINLOCK1
      coreid: CORE_SELF

  do_0:
    id: TASK4
    syssrv: NextScheduleTable(SCHEDULE_TABLE1,SCHEDULE_TABLE3)
    rettype: StatusType
    retval: E_OK
    gcov: true

  post_condition_0:
    SCHEDULE_TABLE2:
      ststat: SCHEDULETABLE_STOPPED
    SCHEDULE_TABLE3:
      ststat: SCHEDULETABLE_NEXT
      stfrom: SCHEDULE_TABLE1
