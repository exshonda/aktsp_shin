          acttsk:
            - TASK3
      osap: TR_OSAP_SELF_CORE_2
    SPINLOCK1:
      type: SPINLOCK
      susint: AK_SUS_OS_SPN
      accosap:
        - NT_OSAP_SELF_CORE
        - NT_OSAP_OTHER_OTHER_CORE
      lockflg: AK_UNLOCK
    INT_STATE1:
      type: INT_STATE
      istat:
      coreid: CORE_SELF

  do_0:
