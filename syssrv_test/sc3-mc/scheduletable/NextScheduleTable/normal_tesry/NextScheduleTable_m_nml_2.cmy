        ANY_SCDLTBL_INIT_OFFSET_B:
          acttsk:
            - TASK3
      osap: NT_OSAP_SELF_CORE_2
    SPINLOCK1:
      type: SPINLOCK
      susint: AK_SUS_ALL_SPN
      accosap:
        - NT_OSAP_SELF_CORE
        - NT_OSAP_OTHER_OTHER_CORE
      lockflg: AK_UNLOCK
    INT_STATE1:
      type: INT_STATE
      istat:
      coreid: CORE_SELF

  do_0:
    id: C2ISR1
    syssrv: IncrementCounter(COUNTER1)
    repeat: ANY_SCDLTBL_INIT_OFFSET_NOT_0_MAX_A
    rettype: StatusType
    retval: E_OK
    gcov: false

  post_condition_0:
