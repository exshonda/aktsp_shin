    INT_STATE1:
      type: INT_STATE
      istat:
      coreid: CORE_SELF

  do_0:
    id: TASK1
    syssrv: IncrementCounter(COUNTER1)
    repeat: ANY_SCDLTBL_INIT_OFFSET_NOT_0_MAX_A
    rettype: StatusType
    retval: E_OK
    gcov: false

  post_condition_0:
