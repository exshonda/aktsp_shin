    COUNTER1:
      type: COUNTER
      ctype: AK_SOFTWARE
      mincyc: ANY_MINCYC_A
      maxval: ANY_MAXVAL_A
      curval: ANY_CURVAL_A
      cstat: AK_CS_NULL
      osap: TR_OSAP_SELF_CORE
      accosap:
        - NT_OSAP_SELF_CORE
    SCHEDULE_TABLE1:
      type: SCHEDULE_TABLE
      counter: COUNTER1
      syncstrategy: AK_NONE
      repeat: AK_FALSE
      ststat: SCHEDULETABLE_RUNNING
      duration: ANY_SCDLTBL_DURATION_A
      curval: 0
      expoint:
        ANY_SCDLTBL_INIT_OFFSET_NOT_0_MAX_A:
          acttsk:
            - TASK2
      osap: NT_OSAP_SELF_CORE
    SCHEDULE_TABLE2:
      type: SCHEDULE_TABLE
      counter: COUNTER1
      syncstrategy: AK_NONE
      repeat: AK_TRUE
