######################################################################
# ReleaseSpinlock_m_error_3_0001.yaml
######################################################################
ReleaseSpinlock_m_error_3_0001:
  property:
    sc: 
      - SC3
      - SC4

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      var:
        local:
          type: AktspTfParam
      osap: NT_OSAP_SELF_CORE
    TRUSTED_FUNCTION1:
      type: TRUSTED_FUNCTION
      arg: local
      caller: TASK1
      getspn:
        - SPINLOCK1
      osap: TR_OSAP_SELF_CORE_2
    ERROR_HOOK1:
      type: ERROR_HOOK
      hookstat: AK_STOP
      target_error_hook_cfg:
        - AK_ONLY_SYSTEM
      coreid: CORE_SELF
    SPINLOCK1:
      type: SPINLOCK
      lockflg: AK_LOCK
      accosap:
        - TR_OSAP_SELF_CORE
        - TR_OSAP_OTHER_OTHER_CORE

  do_0:
    id: TRUSTED_FUNCTION1
    syssrv: "return E_OK"
    gcov: false

  post_condition_0:
    TRUSTED_FUNCTION1:
      caller: 
      getspn:
    TASK1:
      getspn:
        - SPINLOCK1

  do_1:
    id: TASK1
    syssrv: ReleaseSpinlock(SPINLOCK1)
    rettype: StatusType
    retval: E_OS_ACCESS
    gcov: true

  post_condition_1:
    ERROR_HOOK1:
      hookstat: AK_ACTIVATE

  do_2:
    id: ERROR_HOOK1
    syssrv: CheckAssert(Error==E_OS_ACCESS)
    gcov: false

  post_condition_2:

  do_3:
    id: ERROR_HOOK1
    syssrv: CheckAssert(OSError_ReleaseSpinlock_SpinlockId()==SPINLOCK1)
    gcov: false

  post_condition_3:

  do_4:
    id: ERROR_HOOK1
    syssrv: CheckAssert(OSErrorGetServiceId()==OSServiceId_ReleaseSpinlock)
    gcov: false

  post_condition_4:

  do_5:
    id: ERROR_HOOK1
    syssrv: return
    gcov: false

  post_condition_5:
    ERROR_HOOK1:
      hookstat: AK_STOP

  do_6:
    id: TASK1
    syssrv: CallTrustedFunction(TRUSTED_FUNCTION1,&local)
    rettype: StatusType
    retval: E_OK
    gcov: false

  post_condition_6:
    TRUSTED_FUNCTION1:
      bootcnt: 1
      caller: TASK1
      getspn:
        - SPINLOCK1
    TASK1:
      getspn:

  do_7:
    id: TRUSTED_FUNCTION1
    syssrv: ReleaseSpinlock(SPINLOCK1)
    rettype: StatusType
    retval: E_OK
    gcov: false

  post_condition_7:
    TRUSTED_FUNCTION1:
      getspn:
    SPINLOCK1:
      lockflg: AK_UNLOCK
######################################################################
