      lockflg: AK_LOCK
    INT_STATE1:
      istat:
        - AK_SUS_OS_INT: SPINLOCK4
######################################################################
# GetSpinlock_m_normal_1_2_0180.yaml
######################################################################
GetSpinlock_m_normal_1_2_0180:
  property:
    sc: 
      - SC3
      - SC4

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      spolicy: AK_SCHFULL
      getspn:
        - SPINLOCK1
      osap: TR_OSAP_SELF_CORE
    SPINLOCK1:
      type: SPINLOCK
      successor: SPINLOCK2
      lockflg: AK_LOCK
      accosap:
        - NT_OSAP_SELF_CORE
        - TR_OSAP_OTHER_OTHER_CORE
    SPINLOCK2:
      type: SPINLOCK
      successor: SPINLOCK3
      accosap:
        - NT_OSAP_SELF_CORE
        - TR_OSAP_OTHER_OTHER_CORE
    SPINLOCK3:
      type: SPINLOCK
      successor: SPINLOCK4
      accosap:
        - NT_OSAP_SELF_CORE
        - TR_OSAP_OTHER_OTHER_CORE
    SPINLOCK4:
      type: SPINLOCK
      susint: AK_SUS_OS_SPN
      successor: SPINLOCK5
      accosap:
        - NT_OSAP_SELF_CORE
        - TR_OSAP_OTHER_OTHER_CORE
    SPINLOCK5:
      type: SPINLOCK
      accosap:
        - NT_OSAP_SELF_CORE
        - TR_OSAP_OTHER_OTHER_CORE
    INT_STATE1:
      type: INT_STATE
      istat:
      coreid: CORE_SELF

  do:
    id: TASK1
    syssrv: GetSpinlock(SPINLOCK4)
    rettype: StatusType
    retval: E_OK
    gcov: true

  post_condition:
    TASK1:
      getspn:
        - SPINLOCK1
        - SPINLOCK4
    SPINLOCK4:
      lockflg: AK_LOCK
    INT_STATE1:
      istat:
        - AK_SUS_OS_INT: SPINLOCK4
