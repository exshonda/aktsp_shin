      rtnstat: AK_STOP
      osap: TR_OSAP_SELF_CORE
    INT_STATE1:
      type: INT_STATE
      istat:
        - AK_SUS_OS_INT: SPINLOCK3
        - AK_SUS_OS_INT: SPINLOCK4
      coreid: CORE_SELF
    SPINLOCK3:
      type: SPINLOCK
      susint: AK_SUS_OS_SPN
      lockflg: AK_LOCK
      accosap:
        - NT_OSAP_SELF_CORE
        - NT_OSAP_OTHER_OTHER_CORE
      successor: SPINLOCK4
    SPINLOCK4:
      type: SPINLOCK
      susint: AK_SUS_OS_SPN
      lockflg: AK_LOCK
      accosap:
        - NT_OSAP_SELF_CORE
        - NT_OSAP_OTHER_OTHER_CORE

  do_0:
    id: TASK1
    syssrv: AktspRaiseInterrupt(INTNO_SELF_C2ISR_HIGH)
    gcov: false

  post_condition_0:
    INT_STATE1:
      istat:
        - AK_SUS_OS_INT: SPINLOCK3
        - AK_SUS_OS_INT: SPINLOCK4

  do_1:
    id: TASK1
    syssrv: ReleaseSpinlock(SPINLOCK4)
    rettype: StatusType
    retval: E_OK
    gcov: false

  post_condition_1:
    TASK1:
      getspn:
        - SPINLOCK3
    SPINLOCK4:
      lockflg: AK_UNLOCK
    INT_STATE1:
      istat:
        - AK_SUS_OS_INT: SPINLOCK3

  do_2:
    id: TASK1
    syssrv: ReleaseSpinlock(SPINLOCK3)
    rettype: StatusType
    retval: E_OK
    gcov: false

  post_condition_2:
    C2ISR2:
      rtnstat: AK_ACTIVATE
    TASK1:
      getspn:
    SPINLOCK3:
      lockflg: AK_UNLOCK
    INT_STATE1:
      istat:
######################################################################
