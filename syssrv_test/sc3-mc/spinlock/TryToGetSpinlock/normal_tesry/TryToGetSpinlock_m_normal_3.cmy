    syssrv: TryToGetSpinlock(SPINLOCK1,&vname1)
    rettype: StatusType
    retval: E_OK

  post_condition:
    C2ISR1:
      var:
        vname1:
          value: TRYTOGETSPINLOCK_NOSUCCESS
