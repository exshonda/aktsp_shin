      - SC3
      - SC4

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      spolicy: AK_SCHFULL
      osap: TR_OSAP_SELF_CORE
    TASK3:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      getspn:
        - SPINLOCK1
      osap: TR_OSAP_OTHER_OTHER_CORE
    C2ISR1:
      type: C2ISR
      intno: INTNO_SELF_C2ISR_MID_A
      iniintpri: INT_PRI_MID
      rtnstat: AK_ACTIVATE
      relres:
        - RESOURCE2
      getres:
        - RESOURCE1
      var:
        vname1:
          type: TryToGetSpinlockType
      osap: TR_OSAP_SELF_CORE
    RESOURCE1:
      type: RESOURCE
      resprop: AK_LINKED
      lockflg: AK_LOCK
      linkres: RESOURCE2
    RESOURCE2:
      type: RESOURCE
      resprop: AK_STANDARD
    SPINLOCK1:
      type: SPINLOCK
      lockflg: AK_LOCK
      accosap:
        - NT_OSAP_SELF_CORE
        - TR_OSAP_OTHER_OTHER_CORE

  do:
