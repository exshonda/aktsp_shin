######################################################################
# TryToGetSpinlock_m_error_2_0001.yaml
######################################################################
TryToGetSpinlock_m_error_2_0001:
  property:
    sc: 
      - SC3
      - SC4

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      spolicy: AK_SCHFULL
      osap: TR_OSAP_SELF_CORE
    C2ISR1:
      type: C2ISR
      intno: INTNO_SELF_C2ISR_LOW
      iniintpri: INT_PRI_LOW
      rtnstat: AK_ACTIVATE
      getspn:
        - SPINLOCK1
      osap: TR_OSAP_SELF_CORE
    C2ISR2:
      type: C2ISR
      intno: INTNO_SELF_C2ISR_MID_A
      iniintpri: INT_PRI_MID
      rtnstat: AK_STOP
      var:
        vname1:
          type: TryToGetSpinlockType
      osap: TR_OSAP_SELF_CORE
    ERROR_HOOK1:
      type: ERROR_HOOK
      hookstat: AK_STOP
      target_error_hook_cfg:
        - AK_ONLY_SYSTEM
      coreid: CORE_SELF
    SPINLOCK1:
      type: SPINLOCK
      lockflg: AK_LOCK
      accosap:
        - TR_OSAP_SELF_CORE
        - TR_OSAP_OTHER_OTHER_CORE
    SPINLOCK2:
      type: SPINLOCK
      accosap:
        - TR_OSAP_SELF_CORE
        - TR_OSAP_OTHER_OTHER_CORE

  do_0:
    id: C2ISR1
    syssrv: AktspRaiseInterrupt(INTNO_SELF_C2ISR_MID_A)
    gcov: false

  post_condition_0:
    C2ISR1:
      rtnstat: AK_STOP
    C2ISR2:
      rtnstat: AK_ACTIVATE

  do_1:
    id: C2ISR2
    syssrv: TryToGetSpinlock(SPINLOCK1,&vname1)
    rettype: StatusType
    retval: E_OS_INTERFERENCE_DEADLOCK
    gcov: true

  post_condition_1:
    C2ISR2:
      rtnstat: AK_STOP
      target_error_hook_cfg:
        - AK_ONLY_SYSTEM
    ERROR_HOOK1:
      hookstat: AK_ACTIVATE

  do_2:
    id: ERROR_HOOK1
    syssrv: CheckAssert(Error==E_OS_INTERFERENCE_DEADLOCK)
    gcov: false

  post_condition_2:

  do_3:
    id: ERROR_HOOK1
    syssrv: CheckAssert(OSError_TryToGetSpinlock_SpinlockId()==SPINLOCK1)
    gcov: false

  post_condition_3:

  do_4:
    id: ERROR_HOOK1
    syssrv: CheckAssert(OSErrorGetServiceId()==OSServiceId_TryToGetSpinlock)
    gcov: false

  post_condition_4:
