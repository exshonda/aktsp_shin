######################################################################
# GetTaskID_m_normal_1_0001.yaml
######################################################################
GetTaskID_m_normal_1_0001:
  property:
    sc: 
      - SC3
      - SC4

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      ttype: ANY_TTYPE
      spolicy: ANY_SPOLICY
      osap: NT_OSAP_SELF_CORE
    TASK3:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      osap: TR_OSAP_OTHER_OTHER_CORE
    C2ISR1:
      type: C2ISR
      intno: INTNO_SELF_C2ISR_MID_A
      iniintpri: INT_PRI_MID
      rtnstat: AK_ACTIVATE
      var:
        vname1:
          type: TaskType
      osap: TR_OSAP_SELF_CORE

  do:
    id: C2ISR1
    syssrv: GetTaskID(&vname1)
    rettype: StatusType
    retval: E_OK
    gcov: true

  post_condition:
    C2ISR1:
      var:
        vname1:
          value: TASK1
