######################################################################
# GetTaskID_m_normal_1_0007.yaml
######################################################################
GetTaskID_m_normal_1_0007:
  property:
    sc: 
      - SC3
      - SC4

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      ttype: ANY_TTYPE
      spolicy: ANY_SPOLICY
      osap: NT_OSAP_SELF_CORE
    TASK3:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      osap: TR_OSAP_OTHER_OTHER_CORE
    C2ISR1:
      type: C2ISR
      intno: INTNO_SELF_C2ISR_MID_A
      iniintpri: INT_PRI_MID
      rtnstat: AK_ACTIVATE
      getspn:
        - SPINLOCK1
      var:
        vname1:
          type: TaskType
      osap: TR_OSAP_SELF_CORE
    SPINLOCK1:
      type: SPINLOCK
      susint: AK_SUS_ALL_SPN
      lockflg: AK_LOCK
      accosap:
        - TR_OSAP_SELF_CORE
        - TR_OSAP_OTHER_OTHER_CORE
        - NT_OSAP_SELF_CORE
        - NT_OSAP_OTHER_OTHER_CORE
    INT_STATE1:
      type: INT_STATE
      istat:
        - AK_SUS_ALL_INT: SPINLOCK1
      coreid: CORE_SELF

  do:
    id: C2ISR1
    syssrv: GetTaskID(&vname1)
    rettype: StatusType
    retval: E_OK
    gcov: true

  post_condition:
    C2ISR1:
      var:
        vname1:
          value: TASK1
