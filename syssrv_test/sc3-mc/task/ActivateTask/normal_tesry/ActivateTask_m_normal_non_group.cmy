######################################################################
# ActivateTask_m_normal_non_group_0001.yaml
######################################################################
ActivateTask_m_normal_non_group_0001:
  property:
    sc: 
      - SC3
      - SC4

  pre_condition:
    TASK4:
      type: TASK
      tstat: RUNNING
      inipri: TSK_PRI_MID
      spolicy: ANY_SPOLICY
      osap: NT_OSAP_SELF_CORE
      var:
        local:
          type: AktspTfParam
    TASK1:
      type: TASK
      tstat: RUNNING
      inipri: TSK_PRI_MID
      curpri: TSK_PRI_HIGH
      spolicy: AK_SCHFULL
      relres:
        - RESOURCE1
      getres:
        - RESOURCE1
      osap: NT_OSAP_OTHER_OTHER_CORE
    TASK2:
      type: TASK
      tstat: READY
      spolicy: AK_SCHFULL
      curpri: TSK_PRI_HIGH
      relres:
        - RESOURCE1
      osap: NT_OSAP_OTHER_OTHER_CORE
    TASK3:
      type: TASK
      inipri: TSK_PRI_TOP
      tstat: SUSPENDED
      osap: NT_OSAP_OTHER_OTHER_CORE
    RESOURCE1:
      type: RESOURCE
      resprop: AK_INTERNAL
      lockflg: AK_LOCK
      accosap:
        - NT_OSAP_OTHER_OTHER_CORE
    TRUSTED_FUNCTION1:
      type: TRUSTED_FUNCTION
      arg: local
      osap: TR_OSAP_SELF_CORE
      caller: TASK4

  do:
    id: TRUSTED_FUNCTION1
    syssrv: ActivateTask(TASK3)
    rettype: StatusType
    retval: E_OK

  post_condition:
    TASK1:
      tstat: READY
      curpri: TSK_PRI_HIGH
      porder: 1
    TASK2:
      porder: 2
    TASK3:
      tstat: RUNNING
      curpri: TSK_PRI_TOP
      actcnt: 1
