  post_condition_0:
    TASK1:
      tstat: RUNNING
    TASK2:
      tstat: SUSPENDED
      bootcnt: 1

  do_1:
    id: TASK3
    syssrv: ActivateTask(TASK2)
    rettype: StatusType
    retval: E_OK
    gcov: true

  post_condition_1:
    TASK1:
      tstat: RUNNING
    TASK2:
      tstat: READY
      curpri: TSK_PRI_MID
      actcnt: 1
      curevt: 0
######################################################################
