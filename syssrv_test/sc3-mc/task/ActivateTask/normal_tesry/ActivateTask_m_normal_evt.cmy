######################################################################
# ActivateTask_m_normal_evt_0001.yaml
######################################################################
ActivateTask_m_normal_evt_0001:
  property:
    sc: 
      - SC3
      - SC4

  pre_condition:
    TASK3:
      type: TASK
      tstat: RUNNING
      inipri: TSK_PRI_MID
      spolicy: ANY_SPOLICY
      osap: TR_OSAP_SELF_CORE
    TASK1:
      type: TASK
      tstat: READY
      curpri: TSK_PRI_MID
      ttype: ANY_TTYPE
      spolicy: AK_SCHFULL
      osap: NT_OSAP_OTHER_OTHER_CORE
    TASK2:
      type: TASK
      tstat: RUNNING
      spolicy: AK_SCHFULL
      curpri: TSK_PRI_HIGH
      ttype: AK_EXTENDED
      bootcnt: 0
      actcnt: 1
      curevt: EVENT1
      relevt:
        - EVENT1
      osap: NT_OSAP_OTHER_OTHER_CORE
    C2ISR1:
      type: C2ISR
      intno: INTNO_SELF_C2ISR_MID_A
      iniintpri: INT_PRI_MID
      rtnstat: AK_STOP
      osap: TR_OSAP_SELF_CORE
    EVENT1:
      type: EVENT

  do_0:
    id: TASK2
    syssrv: TerminateTask()
    gcov: false

  post_condition_0:
    TASK1:
      tstat: RUNNING
    TASK2:
      tstat: SUSPENDED
      bootcnt: 1

  do_1:
    id: TASK3
    syssrv: AktspRaiseInterrupt(INTNO_SELF_C2ISR_MID_A)
    gcov: false

  post_condition_1:
    C2ISR1:
      rtnstat: AK_ACTIVATE

  do_2:
    id: C2ISR1
    syssrv: ActivateTask(TASK2)
    rettype: StatusType
    retval: E_OK
    gcov: true

  post_condition_2:
    TASK1:
      tstat: READY
    TASK2:
      tstat: RUNNING
      curpri: TSK_PRI_HIGH
      actcnt: 1
      curevt: 0

  do_3:
    id: C2ISR1
    syssrv: return
    gcov: false

  post_condition_3:
    C2ISR1:
      rtnstat: AK_STOP
