    sc: 
      - SC3
      - SC4

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      spolicy: ANY_SPOLICY
      getspn:
        - SPINLOCK1
      osap: NT_OSAP_OTHER_OTHER_CORE
    TASK2:
      type: TASK
      tstat: SUSPENDED
      inipri: TSK_PRI_LOW
      ttype: AK_EXTENDED
      spolicy: AK_SCHFULL
      osap: NT_OSAP_OTHER_OTHER_CORE
    TASK3:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      ttype: AK_BASIC
      spolicy: ANY_SPOLICY
      osap: TR_OSAP_SELF_CORE
      var:
        local:
          type: AktspTfParam
    SPINLOCK1:
      type: SPINLOCK
      susint: AK_SUS_ALL_SPN
      lockflg: AK_LOCK
      accosap:
        - TR_OSAP_SELF_CORE
        - NT_OSAP_SELF_CORE
        - TR_OSAP_OTHER_OTHER_CORE
        - NT_OSAP_OTHER_OTHER_CORE
    INT_STATE1:
      type: INT_STATE
      istat:
        - AK_SUS_ALL_INT: SPINLOCK1
      coreid: CORE_OTHER
    TRUSTED_FUNCTION1:
      type: TRUSTED_FUNCTION
      arg: local
      osap: TR_OSAP_SELF_CORE
      caller: TASK3
      var:
        vname1:
          type: TaskStateType

  do:
    id: TRUSTED_FUNCTION1
    syssrv: GetTaskState(TASK2,&vname1)
    rettype: StatusType
    retval: E_OK

  post_condition:
    TRUSTED_FUNCTION1:
      var:
        vname1:
          value: SUSPENDED
