######################################################################
# GetTaskState_m_normal_2_0001.yaml
######################################################################
GetTaskState_m_normal_2_0001:
  property:
    sc: 
      - SC3
      - SC4

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      spolicy: AK_SCHNON
      osap: TR_OSAP_OTHER_OTHER_CORE
    TASK2:
      type: TASK
      tstat: READY
      curpri: TSK_PRI_HIGH
      ttype: AK_BASIC
      spolicy: AK_SCHFULL
      maxact: ANY_BASIC_MAXACT
      actcnt: 1
      osap: TR_OSAP_OTHER_OTHER_CORE
    TASK3:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      ttype: AK_BASIC
      spolicy: ANY_SPOLICY
      osap: TR_OSAP_SELF_CORE
    C2ISR1:
      type: C2ISR
      intno: INTNO_SELF_C2ISR_MID_A
      iniintpri: INT_PRI_MID
      rtnstat: AK_ACTIVATE
      var:
        vname1:
          type: TaskStateType
      osap: TR_OSAP_SELF_CORE
    INT_STATE1:
      type: INT_STATE
      istat:
        - AK_DIS_ALL_INT: TASK1
      coreid: CORE_OTHER

  do_0:
    id: C2ISR1
    syssrv: GetTaskState(TASK2,&vname1)
    rettype: StatusType
    retval: E_OK
    gcov: true

  post_condition_0:
    C2ISR1:
      var:
        vname1:
          value: READY

  do_1:
    id: C2ISR1
    syssrv: return
    gcov: false

  post_condition_1:
    C2ISR1:
      rtnstat: AK_STOP
