    sc: 
      - SC3
      - SC4

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      osap: TR_OSAP_SELF_CORE
    TASK2:
      type: TASK
      tstat: SUSPENDED
      inipri: TSK_PRI_MID
      ttype: AK_BASIC
      osap: TR_OSAP_SELF_CORE
    INT_STATE1:
      type: INT_STATE
      istat:
        - AK_SUS_OS_INT: TASK1
      coreid: CORE_SELF
    SPINLOCK1:
      type: SPINLOCK
      lockflg: AK_UNLOCK
      accosap:
        - TR_OSAP_SELF_CORE
        - TR_OSAP_OTHER_OTHER_CORE
        - NT_OSAP_SELF_CORE
        - NT_OSAP_OTHER_OTHER_CORE
    ERROR_HOOK1:
      type: ERROR_HOOK
      hookstat: AK_STOP
      target_error_hook_cfg:
        - AK_ONLY_SYSTEM
      need_si:
        - NOS409
        - NOS412

  do_0:
    id: TASK1
    syssrv: CheckSpinlockAccess(TR_OSAP_SELF_CORE,SPINLOCK1)
    rettype: ObjectAccessType
    retval: NO_ACCESS
    gcov: true

  post_condition_0:
    ERROR_HOOK1:
      hookstat: AK_ACTIVATE

  do_1:
    id: ERROR_HOOK1
    syssrv: CheckAssert(Error==E_OS_DISABLEDINT)
    gcov: false

  post_condition_1:

  do_2:
    id: ERROR_HOOK1
    syssrv: CheckAssert(OSError_CheckSpinlockAccess_ApplID()==TR_OSAP_SELF_CORE)
    gcov: false

  post_condition_2:

  do_3:
    id: ERROR_HOOK1
    syssrv: CheckAssert(OSError_CheckSpinlockAccess_SpinlockId()==SPINLOCK1)
    gcov: false
    need_si:
      - IOS030

  post_condition_3:

  do_4:
    id: ERROR_HOOK1
    syssrv: CheckAssert(OSErrorGetServiceId()==OSServiceId_CheckSpinlockAccess)
    gcov: false

  post_condition_4:

  do_5:
    id: ERROR_HOOK1
    syssrv: return
    gcov: false

  post_condition_5:
    ERROR_HOOK1:
      hookstat: AK_STOP
