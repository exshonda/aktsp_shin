######################################################################
# CheckTaskMemoryAccess_m_normal_0001.yaml
######################################################################
CheckTaskMemoryAccess_m_normal_0001:
  property:
    sc: 
      - SC3
      - SC4
    need_stack_share: true

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      osap: TR_OSAP_SELF_CORE
    TASK2:
      type: TASK
      tstat: SUSPENDED
      inipri: TSK_PRI_MID
      osap: NT_OSAP_SELF_CORE
    TASK3:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      osap: NT_OSAP_OTHER_OTHER_CORE
    C2ISR1:
      type: C2ISR
      intno: INTNO_SELF_C2ISR_MID_A
      iniintpri: INT_PRI_MID
      rtnstat: AK_ACTIVATE
      osap: TR_OSAP_SELF_CORE

  do_0:
    id: C2ISR1
    syssrv: CheckAssert(OSMEMORY_IS_READABLE(CheckTaskMemoryAccess(TASK3,AKTSP_CHECK_NT_TASK_ADDRESS,AKTSP_TASK_STACK_SIZE)) == 0)
    gcov: true

  post_condition_0:

  do_1:
    id: C2ISR1
    syssrv: CheckAssert(OSMEMORY_IS_WRITEABLE(CheckTaskMemoryAccess(TASK3,AKTSP_CHECK_NT_TASK_ADDRESS,AKTSP_TASK_STACK_SIZE)) == 0)
    gcov: true

  post_condition_1:

  do_2:
    id: C2ISR1
    syssrv: CheckAssert(OSMEMORY_IS_EXECUTABLE(CheckTaskMemoryAccess(TASK3,AKTSP_CHECK_NT_TASK_ADDRESS,AKTSP_TASK_STACK_SIZE)) == 0)
    gcov: true

  post_condition_2:

  do_3:
    id: C2ISR1
    syssrv: CheckAssert(OSMEMORY_IS_STACKSPACE(CheckTaskMemoryAccess(TASK3,AKTSP_CHECK_NT_TASK_ADDRESS,AKTSP_TASK_STACK_SIZE)) == 0)
    gcov: true

  post_condition_3:
