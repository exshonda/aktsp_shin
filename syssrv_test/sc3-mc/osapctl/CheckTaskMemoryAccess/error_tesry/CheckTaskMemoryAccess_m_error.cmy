# CheckTaskMemoryAccess_m_error_0004.yaml
######################################################################
CheckTaskMemoryAccess_m_error_0004:
  property:
    sc: 
      - SC3
      - SC4
    need_stack_share: true

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      getspn:
        - SPINLOCK1
      osap: TR_OSAP_SELF_CORE
    TASK2:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      osap: NT_OSAP_OTHER_OTHER_CORE
    SPINLOCK1:
      type: SPINLOCK
      susint: AK_SUS_OS_SPN
      lockflg: AK_LOCK
      accosap:
        - TR_OSAP_SELF_CORE
        - TR_OSAP_OTHER_OTHER_CORE
    INT_STATE1:
      type: INT_STATE
      istat:
        - AK_SUS_OS_INT: SPINLOCK1
      coreid: CORE_SELF
    ERROR_HOOK1:
      type: ERROR_HOOK
      hookstat: AK_STOP
      bootcnt: 0
      target_error_hook_cfg:
        - AK_ONLY_SYSTEM
      coreid: CORE_SELF
      need_si:
        - NOS409
        - NOS412

  do_0:
    id: TASK1
    syssrv: CheckAssert(OSMEMORY_IS_READABLE(CheckTaskMemoryAccess(TASK2,AKTSP_CHECK_NT_TASK_ADDRESS_CORE_1,AKTSP_TASK_STACK_SIZE)) == 0)
    gcov: true

  post_condition_0:
    ERROR_HOOK1:
      hookstat: AK_ACTIVATE

  do_1:
    id: ERROR_HOOK1
    syssrv: CheckAssert(Error==E_OS_DISABLEDINT)
    gcov: false

  post_condition_1:

  do_2:
    id: ERROR_HOOK1
    syssrv: CheckAssert(OSError_CheckTaskMemoryAccess_TaskID()==TASK2)
    gcov: false

  post_condition_2:

  do_3:
    id: ERROR_HOOK1
