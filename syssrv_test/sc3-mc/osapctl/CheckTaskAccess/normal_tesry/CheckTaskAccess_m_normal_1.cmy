      osap: TR_OSAP_SELF_CORE
    TASK2:
      type: TASK
      tstat: SUSPENDED
      inipri: TSK_PRI_MID
      osap: TR_OSAP_OTHER_OTHER_CORE
    TASK3:
      type: TASK
      tstat: SUSPENDED
      inipri: TSK_PRI_MID
      osap: TR_OSAP_SELF_CORE_2

  do:
    id: TASK4
    syssrv: CheckTaskAccess(TR_OSAP_SELF_CORE_2,TASK2)
    rettype: ObjectAccessType
    retval: ACCESS

  post_condition:
