      getspn:
        - SPINLOCK1
    INT_STATE1:
      type: INT_STATE
      istat:
        - AK_SUS_ALL_INT: SPINLOCK1
      coreid: CORE_SELF
    SPINLOCK1:
      type: SPINLOCK
      susint: AK_SUS_ALL_SPN
      lockflg: AK_LOCK
      accosap:
        - NT_OSAP_SELF_CORE
        - NT_OSAP_OTHER_OTHER_CORE
    ERROR_HOOK1:
      type: ERROR_HOOK
      hookstat: AK_STOP
      target_error_hook_cfg:
        - AK_ONLY_SYSTEM
      need_si:
        - NOS409
        - NOS821
      coreid: CORE_SELF

  do_0:
    id: C2ISR1
    syssrv: ResumeAllInterrupts()
    gcov: true

  post_condition_0:
    INT_STATE1:
      istat:
        - AK_SUS_ALL_INT: SPINLOCK1
    C2ISR1:
      rtnstat: AK_STOP
      target_error_hook_cfg:
        - AK_ONLY_SYSTEM
      need_si:
        - NOS409
