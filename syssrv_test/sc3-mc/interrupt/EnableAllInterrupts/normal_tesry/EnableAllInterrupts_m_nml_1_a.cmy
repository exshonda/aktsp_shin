######################################################################
# EnableAllInterrupts_m_nml_1_a_0001.yaml
######################################################################
EnableAllInterrupts_m_nml_1_a_0001:
  property:
    sc: 
      - SC3
      - SC4

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      osap: TR_OSAP_SELF_CORE
    C1ISR1:
      type: C1ISR
      intno: INTNO_SELF_C1ISR_MID
      iniintpri: INT_PRI_ISR1_MID
      rtnstat: AK_ACTIVATE
      osap: TR_OSAP_SELF_CORE
    C1ISR2:
      type: C1ISR
      intno: INTNO_SELF_C1ISR_HIGH
      iniintpri: INT_PRI_ISR1_HIGH
      rtnstat: AK_STOP
      osap: TR_OSAP_SELF_CORE
    INT_STATE1:
      type: INT_STATE
      istat:
        - AK_DIS_ALL_INT: C1ISR1
      coreid: CORE_SELF
    TASK4:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      osap: TR_OSAP_OTHER_OTHER_CORE
    C1ISR3:
      type: C1ISR
      intno: INTNO_OTHER_ISR1_A 
      iniintpri: INT_PRI_ISR1_MID
      rtnstat: AK_ACTIVATE
      osap: TR_OSAP_OTHER_OTHER_CORE
    INT_STATE2:
      type: INT_STATE
      istat:
        - AK_DIS_ALL_INT: C1ISR3
      coreid: CORE_OTHER

  do_0:
    id: C1ISR1
    syssrv: EnableAllInterrupts()
    gcov: true

  post_condition_0:
    INT_STATE1:
      istat:
    INT_STATE2:
      istat:
        - AK_DIS_ALL_INT: C1ISR3

  do_1:
    id: C1ISR1
    syssrv: AktspRaiseInterrupt(INTNO_SELF_C1ISR_HIGH)
    gcov: false

  post_condition_1:
    C1ISR1:
      rtnstat: AK_STOP
    C1ISR2:
      rtnstat: AK_ACTIVATE
