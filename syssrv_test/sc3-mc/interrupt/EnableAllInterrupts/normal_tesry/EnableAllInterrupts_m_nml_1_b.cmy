    INT_STATE2:
      type: INT_STATE
      istat:
        - AK_DIS_ALL_INT: C2ISR3
      coreid: CORE_OTHER

  do_0:
    id: C2ISR1
    syssrv: EnableAllInterrupts()
    gcov: true

  post_condition_0:
    INT_STATE1:
      istat:
        - AK_SUS_OS_INT: C2ISR1
        - AK_SUS_OS_INT: SPINLOCK4

  do_1:
    id: C2ISR1
    syssrv: AktspRaiseInterrupt(INTNO_SELF_C1ISR_HIGH)
    gcov: false

  post_condition_1:
    C1ISR1:
      rtnstat: AK_ACTIVATE
    C2ISR1:
      rtnstat: AK_STOP
