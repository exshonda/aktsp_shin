    sc: 
      - SC3
      - SC4

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      osap: TR_OSAP_SELF_CORE
    C2ISR1:
      type: C2ISR
      intno: INTNO_SELF_C2ISR_MID_A
      iniintpri: INT_PRI_MID
      rtnstat: AK_ACTIVATE
      osap: TR_OSAP_SELF_CORE
      getspn:
        - SPINLOCK3
    C1ISR1:
      type: C1ISR
      intno: INTNO_SELF_C1ISR_HIGH
      iniintpri: INT_PRI_ISR1_HIGH
      rtnstat: AK_STOP
      osap: TR_OSAP_SELF_CORE
    INT_STATE1:
      type: INT_STATE
      istat:
        - AK_SUS_OS_INT: SPINLOCK3
        - AK_SUS_OS_INT: C2ISR1
      coreid: CORE_SELF
    SPINLOCK3:
      type: SPINLOCK
      susint: AK_SUS_OS_SPN
      lockflg: AK_LOCK
      accosap:
        - NT_OSAP_SELF_CORE
        - NT_OSAP_OTHER_OTHER_CORE
    TASK4:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      osap: TR_OSAP_OTHER_OTHER_CORE
    C2ISR3:
      type: C2ISR
      intno: INTNO_OTHER_ISR2_C
      iniintpri: INT_PRI_MID
      rtnstat: AK_ACTIVATE
      osap: TR_OSAP_OTHER_OTHER_CORE
    INT_STATE2:
      type: INT_STATE
      istat:
        - AK_DIS_ALL_INT: C2ISR3
      coreid: CORE_OTHER

  do_0:
    id: C2ISR1
    syssrv: EnableAllInterrupts()
    gcov: true

  post_condition_0:
    INT_STATE1:
      istat:
        - AK_SUS_OS_INT: SPINLOCK3
        - AK_SUS_OS_INT: C2ISR1

  do_1:
    id: C2ISR1
    syssrv: AktspRaiseInterrupt(INTNO_SELF_C1ISR_HIGH)
    gcov: false

  post_condition_1:
    C1ISR1:
      rtnstat: AK_ACTIVATE
    C2ISR1:
      rtnstat: AK_STOP
