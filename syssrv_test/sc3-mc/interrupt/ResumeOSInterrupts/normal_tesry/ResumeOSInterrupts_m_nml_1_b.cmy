      iniintpri: INT_PRI_MID
      rtnstat: AK_ACTIVATE
      osap: TR_OSAP_OTHER_OTHER_CORE
    INT_STATE2:
      type: INT_STATE
      istat:
        - AK_SUS_OS_INT: C2ISR3
      coreid: CORE_OTHER

  do_0:
    id: C2ISR1
    syssrv: ResumeOSInterrupts()
    gcov: true

  post_condition_0:
    INT_STATE1:
      istat:
        - AK_SUS_ALL_INT: SPINLOCK1
