######################################################################
# ResumeOSInterrupts_m_nml_2_0001.yaml
######################################################################
ResumeOSInterrupts_m_nml_2_0001:
  property:
    sc: 
      - SC3
      - SC4

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      osap: TR_OSAP_SELF_CORE
    C2ISR1:
      type: C2ISR
      intno: INTNO_SELF_C2ISR_MID_A
      iniintpri: INT_PRI_MID
      rtnstat: AK_ACTIVATE
      osap: TR_OSAP_SELF_CORE
      getspn:
        - SPINLOCK1
    C1ISR1:
      type: C1ISR
      intno: INTNO_SELF_C1ISR_HIGH
      iniintpri: INT_PRI_ISR1_HIGH
      rtnstat: AK_STOP
      osap: TR_OSAP_SELF_CORE
    INT_STATE1:
      type: INT_STATE
      istat:
        - AK_SUS_ALL_INT: SPINLOCK1
    SPINLOCK1:
      type: SPINLOCK
      susint: AK_SUS_ALL_SPN
      lockflg: AK_LOCK
      accosap:
        - NT_OSAP_SELF_CORE
        - NT_OSAP_OTHER_OTHER_CORE

  do_0:
    id: C2ISR1
    syssrv: AktspRaiseInterrupt(INTNO_SELF_C1ISR_HIGH)
    gcov: false

  post_condition_0:

  do_1:
    id: C2ISR1
    syssrv: SuspendOSInterrupts()
    gcov: false

  post_condition_1:
    INT_STATE1:
      istat:
        - AK_SUS_ALL_INT: SPINLOCK1
        - AK_SUS_OS_INT: C2ISR1

  do_2:
    id: C2ISR1
    syssrv: ResumeOSInterrupts()
    gcov: true

  post_condition_2:
    INT_STATE1:
      istat:
        - AK_SUS_ALL_INT: SPINLOCK1

  do_3:
    id: C2ISR1
    syssrv: ReleaseSpinlock(SPINLOCK1)
    rettype: StatusType
    retval: E_OK
    gcov: false

  post_condition_3:
    INT_STATE1:
      istat:
    C1ISR1:
      rtnstat: AK_ACTIVATE
    C2ISR1:
      rtnstat: AK_STOP
      getspn:
    SPINLOCK1:
      lockflg: AK_UNLOCK
