######################################################################
# DisableAllInterrupts_m_normal_a_0001.yaml
######################################################################
DisableAllInterrupts_m_normal_a_0001:
  property:
    sc: 
      - SC3
      - SC4

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      osap: TR_OSAP_SELF_CORE
    C1ISR1:
      type: C1ISR
      intno: INTNO_SELF_C1ISR_MID
      iniintpri: INT_PRI_ISR1_MID
      rtnstat: AK_ACTIVATE
      osap: TR_OSAP_SELF_CORE
    INT_STATE1:
      type: INT_STATE
      istat:
        - AK_DIS_ALL_INT: C1ISR1
      coreid: CORE_SELF
    TASK4:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      osap: TR_OSAP_OTHER_OTHER_CORE
    C1ISR3:
      type: C1ISR
      intno: INTNO_OTHER_ISR1_A 
      iniintpri: INT_PRI_ISR1_MID
      rtnstat: AK_STOP
      osap: TR_OSAP_OTHER_OTHER_CORE
    INT_STATE2:
      type: INT_STATE
      istat:
      coreid: CORE_OTHER

  do_0:
    id: C1ISR1
    syssrv: DisableAllInterrupts()
    gcov: true

  post_condition_0:
    INT_STATE1:
      istat:
        - AK_DIS_ALL_INT: C1ISR1
    INT_STATE2:
      istat:

  do_1:
    id: TASK4
    syssrv: AktspRaiseInterrupt(INTNO_OTHER_ISR1_A)
    gcov: false

  post_condition_1:
    C1ISR3:
      rtnstat: AK_ACTIVATE

  do_2:
    id: C1ISR1
    syssrv: EnableAllInterrupts()
    gcov: false

  post_condition_2:
    INT_STATE1:
      istat:
    INT_STATE2:
      istat:
