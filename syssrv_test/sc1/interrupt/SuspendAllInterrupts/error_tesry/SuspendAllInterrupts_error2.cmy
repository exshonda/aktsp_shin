    gcov: false

  post_condition_2:

  do_3:
    id: ERROR_HOOK1
    syssrv: return
    gcov: false

  post_condition_3:
    POSTTASK_HOOK1:
      hookstat: AK_ACTIVATE
    ERROR_HOOK1:
      hookstat: AK_STOP
