# SuspendAllInterrupts_error2_0004.yaml
######################################################################
SuspendAllInterrupts_error2_0004:
  property:
    sc: 
      - SC1
      - SC2

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
    POSTTASK_HOOK1:
      type: POSTTASK_HOOK
      hookstat: AK_ACTIVATE
    INT_STATE1:
      type: INT_STATE
      istat:
        - AK_DIS_ALL_INT: POSTTASK_HOOK1
    ERROR_HOOK1:
      type: ERROR_HOOK
      hookstat: AK_STOP
      need_si:
        - NOS409
        - NOS712
      target_error_hook_cfg:
        - AK_SC1_SINGLE

  do_0:
    id: POSTTASK_HOOK1
    syssrv: SuspendAllInterrupts()
    gcov: true

  post_condition_0:
    POSTTASK_HOOK1:
      hookstat: AK_STOP
      need_si:
        - NOS409
        - NOS712
      target_error_hook_cfg:
        - AK_SC1_SINGLE
    ERROR_HOOK1:
      hookstat: AK_ACTIVATE

  do_1:
    id: ERROR_HOOK1
    syssrv: CheckAssert(Error==E_OS_DISABLEDINT)
    gcov: false

  post_condition_1:

  do_2:
