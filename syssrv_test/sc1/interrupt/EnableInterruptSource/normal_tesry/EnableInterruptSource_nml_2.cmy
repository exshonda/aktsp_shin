######################################################################
# EnableInterruptSource_nml_2_0001.yaml
######################################################################
EnableInterruptSource_nml_2_0001:
  property:
    sc: 
      - SC1
    need_enadis_interrupt_source: true

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
    C2ISR1:
      type: C2ISR
      intno: INTNO_SELF_C2ISR_MID_A
      iniintpri: INT_PRI_MID
      rtnstat: AK_ACTIVATE
    C2ISR2:
      type: C2ISR
      intno: INTNO_SELF_C2ISR_HIGH
      iniintpri: INT_PRI_HIGH
      rtnstat: AK_STOP
    INT_STATE1:
      type: INT_STATE
      istat:
        - AK_DIS_ALL_INT: C2ISR1

  do_0:
    id: C2ISR1
    syssrv: AktspRaiseInterrupt(INTNO_SELF_C2ISR_HIGH)
    gcov: false

  post_condition_0:

  do_1:
    id: C2ISR1
    syssrv: DisableInterruptSource(C2ISR2)
    rettype: StatusType
    retval: E_OK
    gcov: false

  post_condition_1:
    C2ISR2:
      istat: AK_DISABLE

  do_2:
    id: C2ISR1
    syssrv: EnableInterruptSource(C2ISR2)
    rettype: StatusType
    retval: E_OK
    gcov: false

  post_condition_2:
    C2ISR2:
      istat: AK_ENABLE

  do_3:
    id: C2ISR1
    syssrv: EnableAllInterrupts()
    gcov: false

  post_condition_3:
    C2ISR1:
      rtnstat: AK_STOP
    C2ISR2:
      rtnstat: AK_ACTIVATE
      istat: AK_ENABLE
    INT_STATE1:
      istat:
