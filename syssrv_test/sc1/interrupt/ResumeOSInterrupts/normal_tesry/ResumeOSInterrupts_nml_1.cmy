######################################################################
# ResumeOSInterrupts_nml_1_0001.yaml
######################################################################
ResumeOSInterrupts_nml_1_0001:
  property:
    sc: 
      - SC1

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
    ALARM_CBACK1:
      type: ALARM_CBACK
      cbstat: AK_STOP
    ALARM1:
      type: ALARM
      almact: AK_ALM_CBACK
      counter: COUNTER1
      astat: AK_SET
      almval: 1
      cycle: 0
      callback: ALARM_CBACK1
    COUNTER1:
      type: COUNTER
      ctype: AK_SOFTWARE
      mincyc: ANY_MINCYC_A
      maxval: ANY_MAXVAL_A
      curval: 0
      cstat: AK_CS_NULL
    INT_STATE1:
      type: INT_STATE
      istat:

  do_0:
    id: TASK1
    syssrv: IncrementCounter(COUNTER1)
    rettype: StatusType
    retval: E_OK
    gcov: false

  post_condition_0:
    COUNTER1:
      curval: 1
      cstat: AK_CS_DOING
    ALARM1:
      astat: AK_UNSET
    ALARM_CBACK1:
      cbstat: AK_ACTIVATE

  do_1:
    id: ALARM_CBACK1
    syssrv: SuspendAllInterrupts()
    gcov: false

  post_condition_1:
    INT_STATE1:
      istat:
        - AK_SUS_ALL_INT: ALARM_CBACK1

  do_2:
    id: ALARM_CBACK1
    syssrv: SuspendOSInterrupts()
    gcov: false

  post_condition_2:
    INT_STATE1:
      istat:
