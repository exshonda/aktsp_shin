######################################################################
# ResumeOSInterrupts_err_1_0001.yaml
######################################################################
ResumeOSInterrupts_err_1_0001:
  property:
    sc: 
      - SC1
      - SC2

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
    C2ISR1:
      type: C2ISR
      intno: INTNO_SELF_C2ISR_MID_A
      iniintpri: INT_PRI_MID
      rtnstat: AK_ACTIVATE
    INT_STATE1:
      type: INT_STATE
      istat:
    ERROR_HOOK1:
      type: ERROR_HOOK
      hookstat: AK_STOP
      need_si:
        - NOS409
        - NOS822
      target_error_hook_cfg:
        - AK_SC1_SINGLE

  do_0:
    id: C2ISR1
    syssrv: ResumeOSInterrupts()
    gcov: true

  post_condition_0:
    C2ISR1:
      rtnstat: AK_STOP
      need_si:
        - NOS409
        - NOS822
      target_error_hook_cfg:
        - AK_SC1_SINGLE
    ERROR_HOOK1:
      hookstat: AK_ACTIVATE

  do_1:
    id: ERROR_HOOK1
    syssrv: CheckAssert(Error==E_OS_STATE)
    gcov: false

  post_condition_1:

  do_2:
    id: ERROR_HOOK1
    syssrv: CheckAssert(OSErrorGetServiceId()==OSServiceId_ResumeOSInterrupts)
    gcov: false

  post_condition_2:
