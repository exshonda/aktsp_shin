    C2ISR1:
      type: C2ISR
      intno: INTNO_SELF_C2ISR_MID_D
      iniintpri: INT_PRI_MID
      rtnstat: AK_STOP
    INT_STATE1:
      type: INT_STATE
      istat:
        - AK_SUS_OS_INT: TASK1

  do_0:
    id: TASK1
    syssrv: DisableInterruptSource(C2ISR1)
    rettype: StatusType
    retval: E_OK
    gcov: true

  post_condition_0:
    C2ISR1:
      istat: AK_DISABLE

  do_1:
    id: TASK1
    syssrv: AktspRaiseInterrupt(INTNO_SELF_C2ISR_MID_D)
    gcov: false

  post_condition_1:

  do_2:
    id: TASK1
    syssrv: EnableInterruptSource(C2ISR1)
    rettype: StatusType
    retval: E_OK
    gcov: false

  post_condition_2:
    C2ISR1:
      istat: AK_ENABLE

  do_3:
    id: TASK1
    syssrv: ResumeOSInterrupts()
    gcov: false

  post_condition_3:
    C2ISR1:
      rtnstat: AK_ACTIVATE
      istat: AK_ENABLE
    INT_STATE1:
      istat:
######################################################################
