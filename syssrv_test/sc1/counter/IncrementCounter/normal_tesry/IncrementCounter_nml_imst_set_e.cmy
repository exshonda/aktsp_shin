######################################################################
# IncrementCounter_nml_imst_set_e_0001.yaml
######################################################################
IncrementCounter_nml_imst_set_e_0001:
  property:
    sc: 
      - SC1
      - SC2

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      ttype: AK_EXTENDED
      curevt: 0
      relevt:
        - EVENT1
      spolicy: AK_SCHFULL
      curpri: TSK_PRI_MID
    C2ISR1:
      type: C2ISR
      intno: INTNO_SELF_C2ISR_MID_A
      iniintpri: INT_PRI_MID
      rtnstat: AK_ACTIVATE
    EVENT1:
      type: EVENT
      mask: EVENTMASK_A
    COUNTER1:
      type: COUNTER
      ctype: AK_HARDWARE
      curval: ANY_CURVAL_NOT_MAX_A
    SCHEDULE_TABLE1:
      type: SCHEDULE_TABLE
      counter: COUNTER1
      syncstrategy: AK_IMPLICIT
      repeat: ANY_SCDLTBLREL_REPEAT
      ststat: SCHEDULETABLE_RUNNING_AND_SYNCHRONOUS
      duration: ANY_MAXVAL_A+1
      curval: ANY_SCDLTBL_INIT_OFFSET_A-1
      expoint:
        ANY_SCDLTBL_INIT_OFFSET_A:
          setevt:
            - TASK1: EVENT1

  do_0:
    id: C2ISR1
    syssrv: AktspIncrementHardwareCounter(COUNTER1)
    gcov: true

  post_condition_0:
    TASK1:
      tstat: RUNNING
      curevt: EVENT1
    COUNTER1:
      curval: ANY_CURVAL_NOT_MAX_A+1
    SCHEDULE_TABLE1:
      curval: ANY_SCDLTBL_INIT_OFFSET_A

  do_1:
    id: C2ISR1
    syssrv: return
    gcov: false

  post_condition_1:
    TASK1:
      tstat: RUNNING
      curevt: EVENT1
    C2ISR1:
      rtnstat: AK_STOP
