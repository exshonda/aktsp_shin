      ttype: AK_BASIC
    COUNTER1:
      type: COUNTER
      ctype: AK_HARDWARE
      curval: ANY_CURVAL_NOT_MAX_A
    SCHEDULE_TABLE1:
      type: SCHEDULE_TABLE
      counter: COUNTER1
