######################################################################
# GetElapsedValue_error_0001.yaml
######################################################################
GetElapsedValue_error_0001:
  property:
    sc: 
      - SC1

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
    ALARM_CBACK1:
      type: ALARM_CBACK
      cbstat: AK_STOP
      var:
        vname1:
          type: TickType
          value: 0
          global: true
        vname2:
          type: TickType
          global: true
    ERROR_HOOK1:
      type: ERROR_HOOK
      hookstat: AK_STOP
      target_error_hook_cfg:
        - AK_SC1_SINGLE
    COUNTER1:
      type: COUNTER
      ctype: AK_SOFTWARE
      mincyc: ANY_MINCYC_A
      maxval: ANY_MAXVAL_A
      curval: ANY_CURVAL_A
      cstat: AK_CS_NULL
    ALARM1:
      type: ALARM
      almact: AK_ALM_CBACK
      counter: COUNTER1
      astat: AK_SET
      almval: (ANY_CURVAL_A+1)%(ANY_MAXVAL_A+1)
      cycle: 0
      callback: ALARM_CBACK1

  do_0:
    id: TASK1
    syssrv: IncrementCounter(COUNTER1)
    rettype: StatusType
    retval: E_OK
    gcov: false

  post_condition_0:
    COUNTER1:
      curval: (ANY_CURVAL_A+1)%(ANY_MAXVAL_A+1)
      cstat: AK_CS_DOING
    ALARM1:
      astat: AK_UNSET
    ALARM_CBACK1:
      cbstat: AK_ACTIVATE

  do_1:
    id: ALARM_CBACK1
    syssrv: GetElapsedValue(COUNTER1,&vname1,&vname2)
    rettype: StatusType
    retval: E_OS_CALLEVEL
    gcov: true

  post_condition_1:
    ALARM_CBACK1:
      cbstat: AK_STOP
      target_error_hook_cfg:
        - AK_SC1_SINGLE
    ERROR_HOOK1:
      hookstat: AK_ACTIVATE

  do_2:
    id: ERROR_HOOK1
    syssrv: CheckAssert(Error==E_OS_CALLEVEL)
    gcov: false

  post_condition_2:

  do_3:
    id: ERROR_HOOK1
    syssrv: CheckAssert(OSError_GetElapsedValue_CounterID()==COUNTER1)
    gcov: false

  post_condition_3:

  do_4:
    id: ERROR_HOOK1
    syssrv: CheckAssert(OSError_GetElapsedValue_Value()==&vname1)
    gcov: false
    need_si:
      - IOS030

  post_condition_4:

  do_5:
    id: ERROR_HOOK1
    syssrv: CheckAssert(OSError_GetElapsedValue_ElapsedValue()==&vname2)
    gcov: false
    need_si:
      - IOS030

  post_condition_5:

  do_6:
    id: ERROR_HOOK1
    syssrv: CheckAssert(OSErrorGetServiceId()==OSServiceId_GetElapsedValue)
    gcov: false

  post_condition_6:
