          value: ANY_MAXVAL_A
        vname2:
          type: TickType
    COUNTER1:
      type: COUNTER
      ctype: AK_SOFTWARE
      mincyc: ANY_MINCYC_A
      maxval: ANY_MAXVAL_A
      curval: ANY_MAXVAL_A
      cstat: AK_CS_NULL

  do:
    id: TASK1
    syssrv: GetElapsedValue(COUNTER1,&vname1,&vname2)
    rettype: StatusType
    retval: E_OK

  post_condition:
    TASK1:
      var:
        vname1:
          value: ANY_MAXVAL_A
        vname2:
          value: 0
######################################################################
