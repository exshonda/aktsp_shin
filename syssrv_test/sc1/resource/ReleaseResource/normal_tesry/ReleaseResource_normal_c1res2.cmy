    RESOURCE2:
      type: RESOURCE
      resprop: AK_STANDARD
      lockflg: AK_LOCK

  do:
    id: TASK1
    syssrv: ReleaseResource(RESOURCE2)
    rettype: StatusType
    retval: E_OK

  post_condition:
    TASK1:
      curpri: INT_PRI_MID
      getres:
        - RESOURCE1
    RESOURCE2:
      lockflg: AK_UNLOCK
######################################################################
