######################################################################
# ReleaseResource_normal_schedule_0001.yaml
######################################################################
ReleaseResource_normal_schedule_0001:
  property:
    sc: 
      - SC1
      - SC2

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      inipri: TSK_PRI_MID
      curpri: TSK_PRI_HIGH
      spolicy: AK_SCHFULL
      relres:
        - RESOURCE1
      getres:
        - RESOURCE1
    TASK2:
      type: TASK
      tstat: READY
      curpri: TSK_PRI_HIGH
      relres:
        - RESOURCE1
      porder: 1
    TASK3:
      type: TASK
      tstat: READY
      curpri: TSK_PRI_HIGH
      relres:
        - RESOURCE1
      porder: 2
    RESOURCE1:
      type: RESOURCE
      resprop: AK_STANDARD
      lockflg: AK_LOCK

  do:
    id: TASK1
    syssrv: ReleaseResource(RESOURCE1)
    rettype: StatusType
    retval: E_OK

  post_condition:
    TASK1:
      tstat: READY
      curpri: TSK_PRI_MID
      getres:
    TASK2:
      tstat: RUNNING
    TASK3:
      tstat: READY
      porder: 1
    RESOURCE1:
      lockflg: AK_UNLOCK
######################################################################
