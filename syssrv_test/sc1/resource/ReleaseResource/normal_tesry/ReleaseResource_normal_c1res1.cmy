######################################################################
# ReleaseResource_normal_c1res1_0001.yaml
######################################################################
ReleaseResource_normal_c1res1_0001:
  property:
    sc: 
      - SC1
      - SC2

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      inipri: TSK_PRI_MID
      curpri: TSK_PRI_MID
      spolicy: ANY_SPOLICY
    C2ISR1:
      type: C2ISR
      intno: INTNO_SELF_C2ISR_MID_A
      iniintpri: INT_PRI_MID
      rtnstat: AK_ACTIVATE
      curintpri: INT_PRI_HIGH
      relres:
        - RESOURCE1
      getres:
        - RESOURCE3
    C2ISR2:
      type: C2ISR
      intno: INTNO_SELF_C2ISR_HIGH
      iniintpri: INT_PRI_HIGH
      rtnstat: AK_STOP
      relres:
        - RESOURCE1
    RESOURCE1:
      type: RESOURCE
      resprop: AK_STANDARD
      lockflg: AK_UNLOCK
    RESOURCE3:
      type: RESOURCE
      resprop: AK_LINKED
      lockflg: AK_LOCK
      linkres: RESOURCE1

  do:
    id: C2ISR1
    syssrv: ReleaseResource(RESOURCE3)
    rettype: StatusType
    retval: E_OK

  post_condition:
    C2ISR1:
      curintpri: INT_PRI_MID
      getres:
    RESOURCE3:
      lockflg: AK_UNLOCK
