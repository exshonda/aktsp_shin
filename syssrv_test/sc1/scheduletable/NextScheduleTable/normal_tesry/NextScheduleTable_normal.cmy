######################################################################
# NextScheduleTable_normal_0001.yaml
######################################################################
NextScheduleTable_normal_0001:
  property:
    sc: 
      - SC1
      - SC2

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
    TASK2:
      type: TASK
      tstat: SUSPENDED
      inipri: TSK_PRI_MID
    TASK3:
      type: TASK
      tstat: SUSPENDED
      inipri: TSK_PRI_MID
    C2ISR1:
      type: C2ISR
      intno: INTNO_SELF_C2ISR_MID_A
      iniintpri: INT_PRI_MID
      rtnstat: AK_ACTIVATE
    COUNTER1:
      type: COUNTER
      ctype: AK_HARDWARE
      curval: ANY_CURVAL_A
    SCHEDULE_TABLE1:
      type: SCHEDULE_TABLE
      counter: COUNTER1
      syncstrategy: AK_IMPLICIT
      repeat: AK_FALSE
      ststat: SCHEDULETABLE_RUNNING_AND_SYNCHRONOUS
      duration: ANY_MAXVAL_A+1
      curval: 0
      expoint:
        ANY_SCDLTBL_INIT_OFFSET_NOT_0_MAX_A:
          acttsk:
            - TASK2
    SCHEDULE_TABLE2:
      type: SCHEDULE_TABLE
      counter: COUNTER1
      syncstrategy: AK_IMPLICIT
      repeat: AK_FALSE
      ststat: SCHEDULETABLE_NEXT
      stfrom: SCHEDULE_TABLE1
      duration: ANY_MAXVAL_A+1
      expoint:
        ANY_SCDLTBL_INIT_OFFSET_B:
          acttsk:
            - TASK3
    SCHEDULE_TABLE3:
      type: SCHEDULE_TABLE
      counter: COUNTER1
      syncstrategy: AK_IMPLICIT
      repeat: AK_FALSE
      ststat: SCHEDULETABLE_STOPPED
      duration: ANY_MAXVAL_A+1
      expoint:
        ANY_SCDLTBL_INIT_OFFSET_B:
          acttsk:
            - TASK3

  do_0:
    id: C2ISR1
    syssrv: NextScheduleTable(SCHEDULE_TABLE1,SCHEDULE_TABLE3)
    rettype: StatusType
    retval: E_OK
    gcov: true

  post_condition_0:
    SCHEDULE_TABLE2:
      ststat: SCHEDULETABLE_STOPPED
    SCHEDULE_TABLE3:
      ststat: SCHEDULETABLE_NEXT
      stfrom: SCHEDULE_TABLE1
