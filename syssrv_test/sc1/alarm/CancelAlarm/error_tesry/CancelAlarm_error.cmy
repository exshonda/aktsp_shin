      cstat: AK_CS_NULL
    ALARM1:
      type: ALARM
      almact: AK_ALM_INCNT
      counter: COUNTER1
      astat: AK_SET
      almval: ANY_ALMVAL_A
      cycle: ANY_ALMCYCLE_A
      incounter: COUNTER2
    C1ISR1:
      type: C1ISR
      intno: INTNO_SELF_C1ISR_MID
      iniintpri: INT_PRI_ISR1_MID
      rtnstat: AK_ACTIVATE

  do:
    id: C1ISR1
    syssrv: CancelAlarm(ALARM1)
    rettype: StatusType
    retval: E_OS_CALLEVEL

  post_condition:
######################################################################
# CancelAlarm_error_0003.yaml
######################################################################
CancelAlarm_error_0003:
  property:
    sc: 
      - SC1
      - SC2

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
    C2ISR1:
      type: C2ISR
      intno: INTNO_SELF_C2ISR_MID_A 
      iniintpri: INT_PRI_MID
      rtnstat: AK_ACTIVATE
    COUNTER1:
      type: COUNTER
      ctype: AK_SOFTWARE
      mincyc: ANY_MINCYC_A
      maxval: ANY_MAXVAL_A
      curval: ANY_CURVAL_A
      cstat: AK_CS_NULL
    COUNTER2:
      type: COUNTER
      ctype: AK_SOFTWARE
      mincyc: 1
      maxval: ANY_MAXVAL_B
      curval: 0
      cstat: AK_CS_NULL
    ALARM1:
      type: ALARM
      almact: AK_ALM_INCNT
      counter: COUNTER1
      astat: AK_SET
      almval: ANY_ALMVAL_A
      cycle: 0
      incounter: COUNTER2
    ERROR_HOOK1:
      type: ERROR_HOOK
      hookstat: AK_STOP
      target_error_hook_cfg:
        - AK_SC1_SINGLE

  do_0:
    id: C2ISR1
    syssrv: IncrementCounter(COUNTER1)
    rettype: StatusType
    retval: E_OK
    repeat: ANY_MAXVAL_A
    gcov: false

  post_condition_0:
    ALARM1:
      astat: AK_UNSET
    COUNTER1:
      curval: (ANY_CURVAL_A+ANY_MAXVAL_A)%(ANY_MAXVAL_A+1)
    COUNTER2:
      curval: 1

  do_1:
    id: C2ISR1
    syssrv: CancelAlarm(ALARM1)
    rettype: StatusType
    retval: E_OS_NOFUNC
    gcov: true

  post_condition_1:
    C2ISR1:
      rtnstat: AK_STOP
      target_error_hook_cfg:
        - AK_SC1_SINGLE
    ERROR_HOOK1:
      hookstat: AK_ACTIVATE

  do_2:
    id: ERROR_HOOK1
    syssrv: CheckAssert(Error==E_OS_NOFUNC)
    gcov: false

  post_condition_2:

  do_3:
    id: ERROR_HOOK1
    syssrv: CheckAssert(OSError_CancelAlarm_AlarmID()==ALARM1)
    gcov: false

  post_condition_3:

  do_4:
    id: ERROR_HOOK1
    syssrv: CheckAssert(OSErrorGetServiceId()==OSServiceId_CancelAlarm)
    gcov: false

  post_condition_4:
