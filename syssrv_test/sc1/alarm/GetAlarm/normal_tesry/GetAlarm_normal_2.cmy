######################################################################
# GetAlarm_normal_2_0001.yaml
######################################################################
GetAlarm_normal_2_0001:
  property:
    sc: 
      - SC1
      - SC2

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      spolicy: AK_SCHFULL
    TASK2:
      type: TASK
      tstat: SUSPENDED
      inipri: TSK_PRI_HIGH
    C2ISR1:
      type: C2ISR
      intno: INTNO_SELF_C2ISR_MID_A
      iniintpri: INT_PRI_MID
      rtnstat: AK_STOP
      var:
        vname1:
          type: TickType
    ALARM1:
      type: ALARM
      almact: AK_ALM_ATSK
      counter: COUNTER1
      astat: AK_SET
      almval: 0
      cycle: ANY_ALMCYCLE_A
      task: TASK2
    COUNTER1:
      type: COUNTER
      ctype: AK_SOFTWARE
      mincyc: ANY_MINCYC_A
      maxval: ANY_MAXVAL_A
      curval: ANY_MAXVAL_A
      cstat: AK_CS_NULL

  do_0:
    id: TASK1
    syssrv: IncrementCounter(COUNTER1)
    rettype: StatusType
    retval: E_OK
    gcov: false

  post_condition_0:
    TASK1:
      tstat: READY
    TASK2:
      tstat: RUNNING
      actcnt: 1
      curpri: TSK_PRI_HIGH
    COUNTER1:
      curval: 0
      cstat: AK_CS_DOING
    ALARM1:
      almval: ANY_ALMCYCLE_A

  do_1:
    id: TASK2
    syssrv: AktspRaiseInterrupt(INTNO_SELF_C2ISR_MID_A)
    gcov: false

  post_condition_1:
    C2ISR1:
      rtnstat: AK_ACTIVATE

  do_2:
    id: C2ISR1
    syssrv: GetAlarm(ALARM1,&vname1)
    rettype: StatusType
    retval: E_OK
    gcov: true

  post_condition_2:
    C2ISR1:
      var:
        vname1:
          value: ANY_ALMCYCLE_A
