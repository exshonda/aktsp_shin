      tstat: READY
    TASK2:
      tstat: RUNNING
      actcnt: 1
      curpri: TSK_PRI_HIGH
    COUNTER1:
      curval: 0
      cstat: AK_CS_DOING
    ALARM1:
      almval: ANY_ALMCYCLE_A

  do_1:
    id: TASK2
    syssrv: AktspRaiseErrorHook()
    gcov: false

  post_condition_1:
    ERROR_HOOK1:
      hookstat: AK_ACTIVATE

  do_2:
    id: ERROR_HOOK1
    syssrv: GetAlarm(ALARM1,&vname1)
    rettype: StatusType
    retval: E_OK
    gcov: true

  post_condition_2:
    ERROR_HOOK1:
      var:
        vname1:
          value: ANY_ALMCYCLE_A
