    TASK2:
      type: TASK
      tstat: SUSPENDED
      inipri: TSK_PRI_HIGH
    ERROR_HOOK1:
      type: ERROR_HOOK
      hookstat: AK_STOP
      var:
        vname1:
          type: TickType
    ALARM1:
      type: ALARM
      almact: AK_ALM_ATSK
      counter: COUNTER1
      astat: AK_SET
      almval: 0
      cycle: ANY_ALMCYCLE_A
      task: TASK2
    COUNTER1:
      type: COUNTER
      ctype: AK_SOFTWARE
