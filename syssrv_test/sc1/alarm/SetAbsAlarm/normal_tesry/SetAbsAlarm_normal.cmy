      almval: (0+ANY_ALMCYCLE_A*6)%(ANY_MAXVAL_A+1)
    COUNTER1:
      curval: (0+ANY_ALMCYCLE_A*5)%(ANY_MAXVAL_A+1)
    COUNTER2:
      curval: 6%(ANY_MAXVAL_B+1)
