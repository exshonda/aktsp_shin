      almval: (ANY_MAXVAL_A+ANY_ALMCYCLE_A*5)%(ANY_MAXVAL_A+1)
    COUNTER1:
      curval: (ANY_MAXVAL_A+ANY_ALMCYCLE_A*4)%(ANY_MAXVAL_A+1)
    COUNTER2:
