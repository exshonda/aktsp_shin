    COUNTER1:
      curval: (ANY_MAXVAL_A+ANY_ALMCYCLE_A*3)%(ANY_MAXVAL_A+1)
    COUNTER2:
      curval: 4%(ANY_MAXVAL_B+1)

  do_5:
    id: TASK1
    syssrv: IncrementCounter(COUNTER1)
    repeat: ANY_ALMCYCLE_A
    rettype: StatusType
    retval: E_OK
    gcov: false

  post_condition_5:
