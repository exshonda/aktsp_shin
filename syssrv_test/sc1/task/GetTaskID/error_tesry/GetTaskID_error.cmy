######################################################################
# GetTaskID_error_0005.yaml
######################################################################
GetTaskID_error_0005:
  property:
    sc: 
      - SC1
      - SC2

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      ttype: ANY_TTYPE
      spolicy: ANY_SPOLICY
    POSTTASK_HOOK1:
      type: POSTTASK_HOOK
      hookstat: AK_ACTIVATE
    ERROR_HOOK1:
      type: ERROR_HOOK
      hookstat: AK_STOP
      target_error_hook_cfg:
        - AK_SC1_SINGLE

  do_0:
    id: POSTTASK_HOOK1
    syssrv: GetTaskID(NULL)
    rettype: StatusType
    retval: OS_E_PARAM_POINTER
    gcov: true

  post_condition_0:
    POSTTASK_HOOK1:
      hookstat: AK_STOP
      target_error_hook_cfg:
        - AK_SC1_SINGLE
    ERROR_HOOK1:
      hookstat: AK_ACTIVATE

  do_1:
    id: ERROR_HOOK1
    syssrv: CheckAssert(Error==OS_E_PARAM_POINTER)
    gcov: false

  post_condition_1:

  do_2:
    id: ERROR_HOOK1
    syssrv: CheckAssert(OSError_GetTaskID_TaskID()==NULL)
    need_si:
      - IOS030
    gcov: false

  post_condition_2:

  do_3:
    id: ERROR_HOOK1
    syssrv: CheckAssert(OSErrorGetServiceId()==OSServiceId_GetTaskID)
    gcov: false

  post_condition_3:

  do_4:
    id: ERROR_HOOK1
    syssrv: return
    gcov: false

  post_condition_4:
    POSTTASK_HOOK1:
      hookstat: AK_ACTIVATE
    ERROR_HOOK1:
      hookstat: AK_STOP
