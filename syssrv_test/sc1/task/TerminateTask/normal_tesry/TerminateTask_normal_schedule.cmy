######################################################################
# TerminateTask_normal_schedule_0001.yaml
######################################################################
TerminateTask_normal_schedule_0001:
  property:
    sc: 
      - SC1
      - SC2

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      spolicy: AK_SCHNON
      ttype: ANY_TTYPE
    TASK2:
      type: TASK
      tstat: READY
      curpri: TSK_PRI_HIGH
      spolicy: AK_SCHFULL
      ttype: ANY_TTYPE
      porder: 1
    TASK3:
      type: TASK
      tstat: READY
      curpri: TSK_PRI_HIGH
      spolicy: AK_SCHFULL
      ttype: ANY_TTYPE
      porder: 2

  do:
    id: TASK1
    syssrv: TerminateTask()

  post_condition:
    TASK1:
      tstat: SUSPENDED
    TASK2:
      tstat: RUNNING
    TASK3:
      tstat: READY
      porder: 1
######################################################################
# TerminateTask_normal_schedule_0002.yaml
######################################################################
TerminateTask_normal_schedule_0002:
  property:
    sc: 
      - SC1
      - SC2

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      inipri: TSK_PRI_MID
      curpri: TSK_PRI_HIGH
      spolicy: AK_SCHFULL
      ttype: ANY_TTYPE
      relres:
        - RESOURCE1
      getres:
        - RESOURCE1
    TASK2:
      type: TASK
      tstat: READY
      curpri: TSK_PRI_HIGH
      spolicy: AK_SCHFULL
      ttype: ANY_TTYPE
      relres:
        - RESOURCE1
      porder: 1
    TASK3:
      type: TASK
      tstat: READY
      curpri: TSK_PRI_HIGH
      spolicy: AK_SCHFULL
      ttype: ANY_TTYPE
      relres:
        - RESOURCE1
      porder: 2
    RESOURCE1:
      type: RESOURCE
      resprop: AK_INTERNAL
      lockflg: AK_LOCK

  do:
    id: TASK1
    syssrv: TerminateTask()

  post_condition:
    TASK1:
      tstat: SUSPENDED
      getres:
    TASK2:
      tstat: RUNNING
      getres:
        - RESOURCE1
    TASK3:
      tstat: READY
      porder: 1
