    gcov: false

  post_condition_3:

  do_4:
    id: ERROR_HOOK1
    syssrv: return
    gcov: false

  post_condition_4:
    POSTTASK_HOOK1:
      hookstat: AK_ACTIVATE
    ERROR_HOOK1:
