      waievt: EVENT1
      actcnt: 1
    EVENT1:
      type: EVENT
    INT_STATE1:
      type: INT_STATE
      istat:
        - AK_SUS_OS_INT: TASK1

  do:
    id: TASK1
    syssrv: GetTaskState(TASK2,&vname1)
    rettype: StatusType
    retval: E_OK

  post_condition:
    TASK1:
      var:
        vname1:
          value: WAITING
######################################################################
