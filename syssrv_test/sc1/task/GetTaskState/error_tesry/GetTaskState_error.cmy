    C1ISR1:
      type: C1ISR
      intno: INTNO_SELF_C1ISR_MID
      iniintpri: INT_PRI_ISR1_MID
      rtnstat: AK_ACTIVATE
      var:
        vname1:
          type: TaskStateType
          global: true

  do:
    id: C1ISR1
    syssrv: GetTaskState(TASK1,&vname1)
    rettype: StatusType
    retval: E_OS_CALLEVEL

  post_condition:
