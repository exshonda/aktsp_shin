######################################################################
# StartOS_error_0001.yaml
######################################################################
StartOS_error_0001:
  property:
    sc: 
      - SC1
    extended_return_status: true

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
    ALARM_CBACK1:
      type: ALARM_CBACK
      cbstat: AK_STOP
    ALARM1:
      type: ALARM
      almact: AK_ALM_CBACK
      counter: COUNTER1
      astat: AK_SET
      almval: 1
      cycle: 0
      callback: ALARM_CBACK1
    COUNTER1:
      type: COUNTER
      ctype: AK_SOFTWARE
      mincyc: ANY_MINCYC_A
      maxval: ANY_MAXVAL_A
      curval: 0
      cstat: AK_CS_NULL
    ERROR_HOOK1:
      type: ERROR_HOOK
      hookstat: AK_STOP

  do_0:
    id: TASK1
    syssrv: IncrementCounter(COUNTER1)
    rettype: StatusType
    retval: E_OK
    gcov: false

  post_condition_0:
    COUNTER1:
      curval: 1
      cstat: AK_CS_DOING
    ALARM1:
      astat: AK_UNSET
    ALARM_CBACK1:
      cbstat: AK_ACTIVATE

  do_1:
    id: ALARM_CBACK1
    syssrv: StartOS(MainApp)

  post_condition_1:
    ALARM_CBACK1:
      cbstat: AK_STOP
    ERROR_HOOK1:
      hookstat: AK_ACTIVATE

  do_2:
    id: ERROR_HOOK1
    syssrv: CheckAssert(Error==E_OS_ACCESS)
    gcov: false

  post_condition_2:
