######################################################################
# GetFaultyContext_normal_0001.yaml
######################################################################
GetFaultyContext_normal_0001:
  property:
    sc: 
      - SC3
      - SC4

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      osap: TRUSTED_OSAP1
    C2ISR1:
      type: C2ISR
      intno: INTNO_SELF_C2ISR_MID_A
      iniintpri: INT_PRI_MID
      rtnstat: AK_ACTIVATE
      osap: TRUSTED_OSAP1
    PROTECTION_HOOK1:
      type: PROTECTION_HOOK
      hookstat: AK_STOP

  do_0:
    id: C2ISR1
    syssrv: AktspRaiseCPUException()
    gcov: false

  post_condition_0:
    PROTECTION_HOOK1:
      hookstat: AK_ACTIVATE
    C2ISR1:
      rtnstat: AK_STOP

  do_1:
    id: PROTECTION_HOOK1
    syssrv: GetFaultyContext()
    rettype: FaultyContextType
    retval: FC_C2ISR
    gcov: true

  post_condition_1:

  do_2:
    id: PROTECTION_HOOK1
    syssrv: return(PRO_IGNORE)
    gcov: false

  post_condition_2:
    PROTECTION_HOOK1:
      hookstat: AK_STOP
    C2ISR1:
      rtnstat: AK_ACTIVATE
