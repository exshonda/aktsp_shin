######################################################################
# GetAlarmBase_error_app_0001.yaml
######################################################################
GetAlarmBase_error_app_0001:
  property:
    sc: 
      - SC3
      - SC4

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      osap: TRUSTED_OSAP1
    C2ISR1:
      type: C2ISR
      intno: INTNO_SELF_C2ISR_MID_A
      iniintpri: INT_PRI_MID
      rtnstat: AK_ACTIVATE
      osap: TRUSTED_OSAP1
      var:
        vname1:
          type: AlarmBaseType
          global: true
    TASK2:
      type: TASK
      tstat: SUSPENDED
      inipri: TSK_PRI_MID
      osap: NT_OSAP_RESTARTING
    ALARM1:
      type: ALARM
      almact: AK_ALM_INCNT
      counter: COUNTER1
      astat: AK_UNSET
      incounter: COUNTER2
      osap: NT_OSAP_RESTARTING
    COUNTER1:
      type: COUNTER
      ctype: AK_SOFTWARE
      mincyc: ANY_MINCYC_A
      maxval: ANY_MAXVAL_A
      curval: 0
      cstat: AK_CS_NULL
      osap: NT_OSAP_RESTARTING
    COUNTER2:
      type: COUNTER
      ctype: AK_SOFTWARE
      mincyc: ANY_MINCYC_B
      maxval: ANY_MAXVAL_B
      curval: 0
      cstat: AK_CS_NULL
      osap: NT_OSAP_RESTARTING
    ERROR_HOOK1:
      type: ERROR_HOOK
      hookstat: AK_STOP
      target_error_hook_cfg:
        - AK_ONLY_SYSTEM

  do_0:
    id: C2ISR1
    syssrv: GetAlarmBase(ALARM1,&vname1)
    rettype: StatusType
    retval: E_OS_ACCESS
    gcov: true

  post_condition_0:
    C2ISR1:
      rtnstat: AK_STOP
      target_error_hook_cfg:
        - AK_ONLY_SYSTEM
    ERROR_HOOK1:
      hookstat: AK_ACTIVATE

  do_1:
    id: ERROR_HOOK1
    syssrv: CheckAssert(Error==E_OS_ACCESS)
    gcov: false

  post_condition_1:

  do_2:
    id: ERROR_HOOK1
    syssrv: CheckAssert(OSError_GetAlarmBase_AlarmID()==ALARM1)
    gcov: false

  post_condition_2:

  do_3:
    id: ERROR_HOOK1
    syssrv: CheckAssert(OSError_GetAlarmBase_Info()==&vname1)
    gcov: false
    need_si:
      - IOS030

  post_condition_3:

  do_4:
    id: ERROR_HOOK1
    syssrv: CheckAssert(OSErrorGetServiceId()==OSServiceId_GetAlarmBase)
    gcov: false

  post_condition_4:

  do_5:
    id: ERROR_HOOK1
    syssrv: return
