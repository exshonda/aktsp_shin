######################################################################
# GetAlarmBase_normal_sys_0001.yaml
######################################################################
GetAlarmBase_normal_sys_0001:
  property:
    sc: 
      - SC3
      - SC4

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      osap: TRUSTED_OSAP1
    ERROR_HOOK1:
      type: ERROR_HOOK
      hookstat: AK_ACTIVATE
      var:
        vname1:
          type: AlarmBaseType
    ALARM1:
      type: ALARM
      almact: AK_ALM_INCNT
      counter: COUNTER1
      astat: AK_SET
      almval: 0
      cycle: ANY_MAXVAL_A
      incounter: COUNTER2
      osap: TRUSTED_OSAP1
    COUNTER1:
      type: COUNTER
      ctype: AK_HARDWARE
      curval: ANY_MAXVAL_A
      accosap:
        - NON_TRUSTED_OSAP1
    TASK3:
      type: TASK
      tstat: SUSPENDED
      inipri: TSK_PRI_HIGH
      osap: NON_TRUSTED_OSAP1
    COUNTER2:
      type: COUNTER
      ctype: AK_SOFTWARE
      mincyc: 1
      maxval: ANY_MAXVAL_B
      curval: 0
      cstat: AK_CS_NULL
      osap: TRUSTED_OSAP1

  do:
    id: ERROR_HOOK1
    syssrv: GetAlarmBase(ALARM1,&vname1)
    rettype: StatusType
    retval: E_OK

  post_condition:
    ERROR_HOOK1:
      var:
        vname1:
          maxallowedvalue: ANY_MAXVAL_A
          mincycle: ANY_MINCYC_A
          ticksperbase: ANY_TICKSPERBASE
