######################################################################
# SetRelAlarm_error_sys_0001.yaml
######################################################################
SetRelAlarm_error_sys_0001:
  property:
    sc: 
      - SC3
      - SC4

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      osap: TRUSTED_OSAP1
    COUNTER1:
      type: COUNTER
      ctype: AK_SOFTWARE
      mincyc: ANY_MINCYC_A
      maxval: ANY_MAXVAL_A
      curval: 0
      cstat: AK_CS_NULL
      osap: TRUSTED_OSAP1
    COUNTER2:
      type: COUNTER
      ctype: AK_SOFTWARE
      mincyc: 1
      maxval: ANY_MAXVAL_B
      curval: 0
      cstat: AK_CS_NULL
      osap: TRUSTED_OSAP1
    ALARM1:
      type: ALARM
      almact: AK_ALM_INCNT
      counter: COUNTER1
      astat: AK_UNSET
      incounter: COUNTER2
      osap: TRUSTED_OSAP1
    ERROR_HOOK1:
      type: ERROR_HOOK
      hookstat: AK_ACTIVATE

  do:
    id: ERROR_HOOK1
    syssrv: SetRelAlarm(ALARM1,ANY_CURVAL_NOT_0_A,ANY_ALMCYCLE_A)
    rettype: StatusType
    retval: E_OS_CALLEVEL

  post_condition:
######################################################################
# SetRelAlarm_error_sys_0002.yaml
######################################################################
SetRelAlarm_error_sys_0002:
  property:
    sc: 
      - SC3
      - SC4

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      osap: TRUSTED_OSAP1
    COUNTER1:
      type: COUNTER
      ctype: AK_SOFTWARE
      mincyc: ANY_MINCYC_A
      maxval: ANY_MAXVAL_A
      curval: 0
      cstat: AK_CS_NULL
      osap: TRUSTED_OSAP1
    COUNTER2:
      type: COUNTER
      ctype: AK_SOFTWARE
      mincyc: 1
      maxval: ANY_MAXVAL_B
      curval: 0
      cstat: AK_CS_NULL
      osap: TRUSTED_OSAP1
    ALARM1:
      type: ALARM
      almact: AK_ALM_INCNT
      counter: COUNTER1
      astat: AK_UNSET
      incounter: COUNTER2
      osap: TRUSTED_OSAP1
    POSTTASK_HOOK1:
      type: POSTTASK_HOOK
      hookstat: AK_ACTIVATE
    ERROR_HOOK1:
      type: ERROR_HOOK
      hookstat: AK_STOP
      target_error_hook_cfg:
        - AK_ONLY_SYSTEM

  do_0:
    id: POSTTASK_HOOK1
    syssrv: SetRelAlarm(ALARM1,ANY_CURVAL_NOT_0_A,ANY_ALMCYCLE_A)
    rettype: StatusType
    retval: E_OS_CALLEVEL
    gcov: true

  post_condition_0:
    POSTTASK_HOOK1:
      hookstat: AK_STOP
      target_error_hook_cfg:
        - AK_ONLY_SYSTEM
    ERROR_HOOK1:
      hookstat: AK_ACTIVATE

  do_1:
    id: ERROR_HOOK1
    syssrv: CheckAssert(Error==E_OS_CALLEVEL)
    gcov: false

  post_condition_1:

  do_2:
    id: ERROR_HOOK1
    syssrv: CheckAssert(OSError_SetRelAlarm_AlarmID()==ALARM1)
    gcov: false

  post_condition_2:

  do_3:
    id: ERROR_HOOK1
    syssrv: CheckAssert(OSError_SetRelAlarm_increment()==ANY_CURVAL_NOT_0_A)
    gcov: false
    need_si:
      - IOS030

  post_condition_3:

  do_4:
    id: ERROR_HOOK1
    syssrv: CheckAssert(OSError_SetRelAlarm_cycle()==ANY_ALMCYCLE_A)
    gcov: false
    need_si:
      - IOS030

  post_condition_4:

  do_5:
    id: ERROR_HOOK1
    syssrv: CheckAssert(OSErrorGetServiceId()==OSServiceId_SetRelAlarm)
    gcov: false

  post_condition_5:

  do_6:
    id: ERROR_HOOK1
    syssrv: return
    gcov: false

  post_condition_6:
    POSTTASK_HOOK1:
      hookstat: AK_ACTIVATE
      target_error_hook_cfg:
        - AK_ONLY_SYSTEM
    ERROR_HOOK1:
      hookstat: AK_STOP
