      hookstat: AK_ACTIVATE
      var:
        vname1:
          type: TickType
          global: true
    ALARM1:
      type: ALARM
      almact: AK_ALM_INCNT
      counter: COUNTER1
      astat: AK_SET
      almval: ANY_CURVAL_NOT_0_A
      cycle: 0
      incounter: COUNTER2
      osap: TRUSTED_OSAP1
    COUNTER1:
      type: COUNTER
      ctype: AK_SOFTWARE
      mincyc: ANY_MINCYC_A
      maxval: ANY_MAXVAL_A
      curval: 0
      cstat: AK_CS_NULL
      osap: TRUSTED_OSAP1
    COUNTER2:
      type: COUNTER
      ctype: AK_SOFTWARE
      mincyc: ANY_MINCYC_B
      maxval: ANY_MAXVAL_B
      curval: 0
      cstat: AK_CS_NULL
      osap: TRUSTED_OSAP1
    INT_STATE1:
      type: INT_STATE
      istat:
        - AK_DIS_ALL_INT: ERROR_HOOK1

  do:
    id: ERROR_HOOK1
    syssrv: GetAlarm(ALARM1,&vname1)
    rettype: StatusType
    retval: E_OS_DISABLEDINT

  post_condition:
