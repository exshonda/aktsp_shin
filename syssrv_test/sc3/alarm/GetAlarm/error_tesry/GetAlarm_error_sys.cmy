######################################################################
# GetAlarm_error_sys_0001.yaml
######################################################################
GetAlarm_error_sys_0001:
  property:
    sc: 
      - SC3
      - SC4

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      osap: TRUSTED_OSAP1
    ERROR_HOOK1:
      type: ERROR_HOOK
      hookstat: AK_ACTIVATE
      var:
        vname1:
          type: TickType
          global: true

  do:
    id: ERROR_HOOK1
    syssrv: GetAlarm(INVALID_ALM_ID,&vname1)
    rettype: StatusType
    retval: E_OS_ID

  post_condition:
######################################################################
# GetAlarm_error_sys_0002.yaml
######################################################################
GetAlarm_error_sys_0002:
