######################################################################
# GetAlarm_normal_osap_0001.yaml
######################################################################
GetAlarm_normal_osap_0001:
  property:
    sc: 
      - SC3
      - SC4

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      osap: TRUSTED_OSAP1
    C2ISR1:
      type: C2ISR
      intno: INTNO_SELF_C2ISR_MID_A 
      iniintpri: INT_PRI_MID
      var:
        vname1:
          type: TickType
      rtnstat: AK_ACTIVATE
      osap: TRUSTED_OSAP1
    ALARM1:
      type: ALARM
      almact: AK_ALM_INCNT
      counter: COUNTER1
      astat: AK_SET
      almval: ANY_CURVAL_NOT_0_A
      cycle: 0
      incounter: COUNTER2
      osap: NON_TRUSTED_OSAP1
    COUNTER1:
      type: COUNTER
      ctype: AK_HARDWARE
      curval: 0
      accosap:
        - NON_TRUSTED_OSAP1
    TASK3:
      type: TASK
      tstat: SUSPENDED
      inipri: TSK_PRI_HIGH
      osap: NON_TRUSTED_OSAP1
    COUNTER2:
      type: COUNTER
      ctype: AK_SOFTWARE
      mincyc: 1
      maxval: ANY_MAXVAL_B
      curval: 0
      cstat: AK_CS_NULL
      osap: NON_TRUSTED_OSAP1

  do:
    id: C2ISR1
    syssrv: GetAlarm(ALARM1,&vname1)
    rettype: StatusType
    retval: E_OK

  post_condition:
    C2ISR1:
      var:
        vname1:
          value: ANY_CURVAL_NOT_0_A
