WaitEvent_normal_3319:
  property:
    sc: 
      - SC3
      - SC4

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      ttype: AK_EXTENDED
      curevt: EVENT1|EVENT2
      relevt:
        - EVENT1
        - EVENT2
      spolicy: AK_SCHFULL
      curpri: TSK_PRI_MID
      osap: TRUSTED_OSAP1
    TASK2:
      type: TASK
      tstat: SUSPENDED
      inipri: TSK_PRI_MID
      ttype: AK_BASIC
      osap: NON_TRUSTED_OSAP1
    EVENT1:
      type: EVENT
      mask: EVENTMASK_A
    EVENT2:
      type: EVENT
      mask: EVENTMASK_B

  do:
    id: TASK1
    syssrv: WaitEvent(EVENT1)
    rettype: StatusType
    retval: E_OK

  post_condition:
    TASK1:
      tstat: RUNNING
    TASK2:
      tstat: SUSPENDED
