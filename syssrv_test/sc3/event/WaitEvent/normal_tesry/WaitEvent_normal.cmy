######################################################################
WaitEvent_normal_1495:
  property:
    sc: 
      - SC3
      - SC4

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      ttype: AK_EXTENDED
      curevt: 0
      relevt:
        - EVENT1
        - EVENT2
      spolicy: AK_SCHFULL
      curpri: TSK_PRI_MID
      osap: NON_TRUSTED_OSAP1
    TASK2:
      type: TASK
      tstat: READY
      porder: 1
      curpri: TSK_PRI_LOW
      ttype: AK_BASIC
      osap: NON_TRUSTED_OSAP2
    EVENT1:
      type: EVENT
      mask: EVENTMASK_A
    EVENT2:
      type: EVENT
      mask: EVENTMASK_B

  do:
    id: TASK1
    syssrv: WaitEvent(EVENT2)
    rettype: StatusType
    retval: E_OK

  post_condition:
    TASK1:
      tstat: WAITING
      waievt: EVENT2
    TASK2:
      tstat: RUNNING
