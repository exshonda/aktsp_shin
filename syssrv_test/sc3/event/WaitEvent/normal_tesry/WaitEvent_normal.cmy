######################################################################
WaitEvent_normal_0271:
  property:
    sc: 
      - SC3
      - SC4

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      ttype: AK_EXTENDED
      curevt: EVENT2
      relevt:
        - EVENT1
        - EVENT2
      spolicy: AK_SCHFULL
      curpri: TSK_PRI_MID
      osap: NON_TRUSTED_OSAP1
    TASK2:
      type: TASK
      tstat: SUSPENDED
      inipri: TSK_PRI_HIGH
      ttype: AK_BASIC
      osap: NON_TRUSTED_OSAP2
    EVENT1:
      type: EVENT
      mask: EVENTMASK_A
    EVENT2:
      type: EVENT
      mask: EVENTMASK_B

  do:
    id: TASK1
    syssrv: WaitEvent(EVENT1|EVENT2)
    rettype: StatusType
    retval: E_OK

  post_condition:
    TASK1:
      tstat: RUNNING
    TASK2:
      tstat: SUSPENDED
