######################################################################
# WaitEvent_normal_schedule_0001.yaml
######################################################################
WaitEvent_normal_schedule_0001:
  property:
    sc: 
      - SC3
      - SC4

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      inipri: TSK_PRI_MID
      curpri: TSK_PRI_HIGH
      spolicy: AK_SCHFULL
      ttype: AK_EXTENDED
      curevt: 0
      relevt:
        - EVENT1
      relres:
        - RESOURCE1
      getres:
        - RESOURCE1
      osap: NON_TRUSTED_OSAP1
    TASK2:
      type: TASK
      tstat: READY
      ttype: AK_BASIC
      spolicy: AK_SCHFULL
      porder: 1
      curpri: TSK_PRI_HIGH
      relres:
        - RESOURCE1
      osap: NON_TRUSTED_OSAP2
    TASK3:
      type: TASK
      tstat: READY
      spolicy: AK_SCHFULL
      curpri: TSK_PRI_HIGH
      porder: 2
      relres:
        - RESOURCE1
      osap: NON_TRUSTED_OSAP2
    EVENT1:
      type: EVENT
    RESOURCE1:
      type: RESOURCE
      resprop: AK_INTERNAL
      lockflg: AK_LOCK
      accosap:
        - NON_TRUSTED_OSAP1
        - NON_TRUSTED_OSAP2

  do:
    id: TASK1
    syssrv: WaitEvent(EVENT1)
    rettype: StatusType
    retval: E_OK

  post_condition:
    TASK1:
      tstat: WAITING
      waievt: EVENT1
      curpri: TSK_PRI_MID
      getres:
    TASK2:
      tstat: RUNNING
      getres:
        - RESOURCE1
    TASK3:
      porder: 1
