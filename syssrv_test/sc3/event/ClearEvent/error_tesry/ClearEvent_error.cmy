######################################################################
# ClearEvent_error_0001.yaml
######################################################################
ClearEvent_error_0001:
  property:
    sc: 
      - SC3
      - SC4

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      ttype: AK_EXTENDED
      relevt:
        - EVENT1
      osap: ANY_OSAP_1
    C1ISR1:
      type: C1ISR
      intno: INTNO_SELF_C1ISR_MID
      iniintpri: INT_PRI_ISR1_MID
      rtnstat: AK_ACTIVATE
      osap: TRUSTED_OSAP1
    EVENT1:
      type: EVENT

  do:
    id: C1ISR1
    syssrv: ClearEvent(EVENT1)
    rettype: StatusType
    retval: E_OS_CALLEVEL

  post_condition:
