######################################################################
# SetEvent_normal_other_non_0001.yaml
######################################################################
SetEvent_normal_other_non_0001:
  property:
    sc: 
      - SC3
      - SC4

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      spolicy: AK_SCHFULL
      inipri: TSK_PRI_MID
      curpri: TSK_PRI_HIGH
      relres:
        - RESOURCE1
      getres:
        - RESOURCE1
      osap: NON_TRUSTED_OSAP1
      var:
        local:
          type: AktspTfParam
    TASK2:
      type: TASK
      tstat: READY
      curpri: TSK_PRI_HIGH
      ttype: AK_EXTENDED
      curevt: 0
      relevt:
        - EVENT1
        - EVENT2
      relres:
        - RESOURCE1
      spolicy: AK_SCHFULL
      osap: NON_TRUSTED_OSAP1
    TASK3:
      type: TASK
      tstat: WAITING
      curpri: TSK_PRI_TOP
      ttype: AK_EXTENDED
      waievt: EVENT1
      relevt:
        - EVENT1
      osap: NON_TRUSTED_OSAP2
    EVENT1:
      type: EVENT
      mask: EVENTMASK_A
    EVENT2:
      type: EVENT
      mask: EVENTMASK_B
    RESOURCE1:
      type: RESOURCE
      resprop: AK_INTERNAL
      lockflg: AK_LOCK
      accosap:
        - NON_TRUSTED_OSAP1
        - NON_TRUSTED_OSAP2
    TRUSTED_FUNCTION1:
      type: TRUSTED_FUNCTION
      arg: local
      osap: TRUSTED_OSAP2
      caller: TASK1

  do:
    id: TRUSTED_FUNCTION1
    syssrv: SetEvent(TASK3,EVENT1)
    rettype: StatusType
    retval: E_OK

  post_condition:
    TASK1:
      tstat: READY
      porder: 1
    TASK2:
      tstat: READY
      porder: 2
    TASK3:
      tstat: RUNNING
      curevt: EVENT1
