SetEvent_normal_other_1062:
  property:
    sc: 
      - SC3
      - SC4

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      spolicy: AK_SCHNON
      curpri: TSK_PRI_MID
      osap: TRUSTED_OSAP1
    TASK2:
      type: TASK
      tstat: WAITING
      curpri: TSK_PRI_MID
      ttype: AK_EXTENDED
      curevt: 0
      waievt: EVENT1
      relevt:
        - EVENT1
        - EVENT2
      spolicy: AK_SCHFULL
      osap: TRUSTED_OSAP1
    C2ISR1:
      type: C2ISR
      intno: INTNO_SELF_C2ISR_MID_A
      iniintpri: INT_PRI_MID
      rtnstat: AK_ACTIVATE
      osap: TRUSTED_OSAP1
    EVENT1:
      type: EVENT
      mask: EVENTMASK_A
    EVENT2:
      type: EVENT
      mask: EVENTMASK_B

  do_0:
    id: C2ISR1
    syssrv: SetEvent(TASK2,EVENT1|EVENT2)
    rettype: StatusType
    retval: E_OK
    gcov: true

  post_condition_0:
    TASK1:
      tstat: RUNNING
    TASK2:
      tstat: READY
      curevt: EVENT1|EVENT2

  do_1:
    id: C2ISR1
    syssrv: return
    gcov: false

  post_condition_1:
    TASK1:
      tstat: RUNNING
    TASK2:
      tstat: READY
      curevt: EVENT1|EVENT2
    C2ISR1:
      rtnstat: AK_STOP
