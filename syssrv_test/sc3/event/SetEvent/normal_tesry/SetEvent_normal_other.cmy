      mask: EVENTMASK_A
    EVENT2:
      type: EVENT
      mask: EVENTMASK_B
    RESOURCE1:
      type: RESOURCE
      resprop: AK_INTERNAL
      lockflg: AK_LOCK
      accosap:
        - NON_TRUSTED_OSAP1

  do_0:
    id: C2ISR1
    syssrv: SetEvent(TASK2,EVENT1)
    rettype: StatusType
    retval: E_OK
    gcov: true

  post_condition_0:
