######################################################################
# StopScheduleTable_err_sys_0001.yaml
######################################################################
StopScheduleTable_err_sys_0001:
  property:
    sc: 
      - SC3
      - SC4

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      osap: TRUSTED_OSAP1
    TASK2:
      type: TASK
      tstat: SUSPENDED
      inipri: TSK_PRI_MID
      osap: TRUSTED_OSAP1
    ERROR_HOOK1:
      type: ERROR_HOOK
      hookstat: AK_ACTIVATE
    COUNTER1:
      type: COUNTER
      ctype: AK_SOFTWARE
      mincyc: ANY_MINCYC_A
      maxval: ANY_MAXVAL_A
      curval: ANY_CURVAL_A
      cstat: AK_CS_NULL
      osap: TRUSTED_OSAP1
    SCHEDULE_TABLE1:
      type: SCHEDULE_TABLE
      counter: COUNTER1
      syncstrategy: AK_NONE
      repeat: AK_TRUE
      ststat: SCHEDULETABLE_RUNNING
      duration: ANY_SCDLTBL_DURATION_A
      curval: 0
      expoint:
        ANY_SCDLTBL_INIT_OFFSET_A:
          acttsk:
            - TASK2
      osap: TRUSTED_OSAP1

  do:
    id: ERROR_HOOK1
    syssrv: StopScheduleTable(SCHEDULE_TABLE1)
    rettype: StatusType
    retval: E_OS_CALLEVEL

  post_condition:
######################################################################
# StopScheduleTable_err_sys_0002.yaml
######################################################################
StopScheduleTable_err_sys_0002:
  property:
    sc: 
      - SC3
      - SC4

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      osap: TRUSTED_OSAP1
    TASK2:
      type: TASK
      tstat: SUSPENDED
      inipri: TSK_PRI_MID
      osap: TRUSTED_OSAP1
    POSTTASK_HOOK1:
      type: POSTTASK_HOOK
      hookstat: AK_ACTIVATE
    COUNTER1:
      type: COUNTER
      ctype: AK_SOFTWARE
      mincyc: ANY_MINCYC_A
      maxval: ANY_MAXVAL_A
      curval: ANY_CURVAL_A
      cstat: AK_CS_NULL
      osap: TRUSTED_OSAP1
    SCHEDULE_TABLE1:
      type: SCHEDULE_TABLE
      counter: COUNTER1
      syncstrategy: AK_NONE
      repeat: AK_TRUE
      ststat: SCHEDULETABLE_RUNNING
      duration: ANY_SCDLTBL_DURATION_A
      curval: 0
      expoint:
        ANY_SCDLTBL_INIT_OFFSET_A:
          acttsk:
            - TASK2
      osap: TRUSTED_OSAP1
    ERROR_HOOK1:
      type: ERROR_HOOK
      hookstat: AK_STOP
      target_error_hook_cfg:
        - AK_ONLY_SYSTEM

  do_0:
    id: POSTTASK_HOOK1
    syssrv: StopScheduleTable(SCHEDULE_TABLE1)
    rettype: StatusType
    retval: E_OS_CALLEVEL
    gcov: true

  post_condition_0:
    POSTTASK_HOOK1:
      hookstat: AK_STOP
      target_error_hook_cfg:
        - AK_ONLY_SYSTEM
    ERROR_HOOK1:
      hookstat: AK_ACTIVATE

  do_1:
    id: ERROR_HOOK1
    syssrv: CheckAssert(Error==E_OS_CALLEVEL)
    gcov: false

  post_condition_1:

  do_2:
    id: ERROR_HOOK1
    syssrv: CheckAssert(OSError_StopScheduleTable_ScheduleTableID()==SCHEDULE_TABLE1)
    gcov: false

  post_condition_2:

  do_3:
    id: ERROR_HOOK1
    syssrv: CheckAssert(OSErrorGetServiceId()==OSServiceId_StopScheduleTable)
    gcov: false

  post_condition_3:

  do_4:
    id: ERROR_HOOK1
    syssrv: return
    gcov: false

  post_condition_4:
    POSTTASK_HOOK1:
      hookstat: AK_ACTIVATE
      target_error_hook_cfg:
        - AK_ONLY_SYSTEM
    ERROR_HOOK1:
      hookstat: AK_STOP
