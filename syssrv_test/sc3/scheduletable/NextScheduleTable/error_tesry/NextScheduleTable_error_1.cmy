######################################################################
# NextScheduleTable_error_1_0001.yaml
######################################################################
NextScheduleTable_error_1_0001:
  property:
    sc: 
      - SC3
      - SC4

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      osap: TRUSTED_OSAP1
    TASK2:
      type: TASK
      tstat: SUSPENDED
      inipri: TSK_PRI_MID
      osap: TRUSTED_OSAP1
    COUNTER1:
      type: COUNTER
      ctype: AK_SOFTWARE
      mincyc: ANY_MINCYC_A
      maxval: ANY_MAXVAL_A
      curval: ANY_CURVAL_A
      cstat: AK_CS_NULL
      osap: TRUSTED_OSAP1
    SCHEDULE_TABLE1:
      type: SCHEDULE_TABLE
      counter: COUNTER1
      syncstrategy: AK_NONE
      repeat: AK_TRUE
      ststat: SCHEDULETABLE_RUNNING
      duration: ANY_SCDLTBL_DURATION_A
      curval: 0
      expoint:
        ANY_SCDLTBL_INIT_OFFSET_A:
          acttsk:
            - TASK2
      osap: TRUSTED_OSAP1
    SCHEDULE_TABLE2:
      type: SCHEDULE_TABLE
      counter: COUNTER1
      syncstrategy: AK_NONE
      repeat: AK_TRUE
      ststat: SCHEDULETABLE_STOPPED
      duration: ANY_SCDLTBL_DURATION_A
      expoint:
        ANY_SCDLTBL_INIT_OFFSET_A:
          acttsk:
            - TASK2
      osap: TRUSTED_OSAP1
    C1ISR1:
      type: C1ISR
      intno: INTNO_SELF_C1ISR_MID
      iniintpri: INT_PRI_ISR1_MID
      rtnstat: AK_ACTIVATE
      osap: TRUSTED_OSAP1

  do:
    id: C1ISR1
    syssrv: NextScheduleTable(SCHEDULE_TABLE1,SCHEDULE_TABLE2)
    rettype: StatusType
    retval: E_OS_CALLEVEL

  post_condition:
######################################################################
# NextScheduleTable_error_1_0002.yaml
######################################################################
NextScheduleTable_error_1_0002:
  property:
    sc: 
      - SC3
      - SC4

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      osap: TRUSTED_OSAP1
    TASK2:
      type: TASK
      tstat: SUSPENDED
      inipri: TSK_PRI_MID
      osap: TRUSTED_OSAP1
    C2ISR1:
      type: C2ISR
      intno: INTNO_SELF_C2ISR_MID_A
      iniintpri: INT_PRI_MID
      rtnstat: AK_ACTIVATE
      osap: TRUSTED_OSAP1
    COUNTER1:
      type: COUNTER
      ctype: AK_SOFTWARE
      mincyc: ANY_MINCYC_A
      maxval: ANY_MAXVAL_A
      curval: ANY_CURVAL_A
      cstat: AK_CS_NULL
      osap: TRUSTED_OSAP1
    SCHEDULE_TABLE1:
      type: SCHEDULE_TABLE
      counter: COUNTER1
      syncstrategy: AK_IMPLICIT
      repeat: AK_TRUE
      ststat: SCHEDULETABLE_NEXT
      stfrom: SCHEDULE_TABLE3
      duration: ANY_MAXVAL_A+1
      expoint:
        ANY_SCDLTBL_INIT_OFFSET_A:
          acttsk:
            - TASK2
      osap: TRUSTED_OSAP1
    SCHEDULE_TABLE2:
      type: SCHEDULE_TABLE
      counter: COUNTER1
      syncstrategy: AK_IMPLICIT
      repeat: AK_TRUE
      ststat: SCHEDULETABLE_STOPPED
      duration: ANY_MAXVAL_A+1
      expoint:
        ANY_SCDLTBL_INIT_OFFSET_A:
          acttsk:
            - TASK2
      osap: TRUSTED_OSAP1
    SCHEDULE_TABLE3:
      type: SCHEDULE_TABLE
      counter: COUNTER1
      syncstrategy: AK_IMPLICIT
      repeat: AK_TRUE
      ststat: SCHEDULETABLE_RUNNING_AND_SYNCHRONOUS
      curval: 0
      duration: ANY_MAXVAL_A+1
      expoint:
        ANY_SCDLTBL_INIT_OFFSET_A:
          acttsk:
            - TASK2
      osap: TRUSTED_OSAP1
    ERROR_HOOK1:
      type: ERROR_HOOK
      hookstat: AK_STOP
      target_error_hook_cfg:
        - AK_ONLY_SYSTEM

  do_0:
    id: C2ISR1
    syssrv: NextScheduleTable(SCHEDULE_TABLE1,SCHEDULE_TABLE2)
    rettype: StatusType
    retval: E_OS_NOFUNC
    gcov: true

  post_condition_0:
    C2ISR1:
      rtnstat: AK_STOP
      target_error_hook_cfg:
        - AK_ONLY_SYSTEM
    ERROR_HOOK1:
      hookstat: AK_ACTIVATE

  do_1:
    id: ERROR_HOOK1
    syssrv: CheckAssert(Error==E_OS_NOFUNC)
    gcov: false

  post_condition_1:

  do_2:
    id: ERROR_HOOK1
    syssrv: CheckAssert(OSError_NextScheduleTable_ScheduleTableID_From()==SCHEDULE_TABLE1)
    gcov: false

  post_condition_2:

  do_3:
    id: ERROR_HOOK1
    syssrv: CheckAssert(OSError_NextScheduleTable_ScheduleTableID_To()==SCHEDULE_TABLE2)
    gcov: false
    need_si:
      - IOS030

  post_condition_3:

  do_4:
    id: ERROR_HOOK1
    syssrv: CheckAssert(OSErrorGetServiceId()==OSServiceId_NextScheduleTable)
    gcov: false

  post_condition_4:

  do_5:
    id: ERROR_HOOK1
    syssrv: return
    gcov: false

  post_condition_5:
    C2ISR1:
      rtnstat: AK_ACTIVATE
      target_error_hook_cfg:
        - AK_ONLY_SYSTEM
    ERROR_HOOK1:
      hookstat: AK_STOP
