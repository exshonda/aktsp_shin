      tstat: SUSPENDED
      inipri: TSK_PRI_MID
      ttype: AK_BASIC
      osap: NON_TRUSTED_OSAP2
    COUNTER1:
      type: COUNTER
      ctype: AK_SOFTWARE
      mincyc: ANY_MINCYC_A
      maxval: ANY_MAXVAL_A
      curval: ANY_CURVAL_A
      cstat: AK_CS_NULL
      osap: TRUSTED_OSAP1
    SCHEDULE_TABLE1:
      type: SCHEDULE_TABLE
      counter: COUNTER1
      syncstrategy: AK_IMPLICIT
      repeat: AK_FALSE
      ststat: SCHEDULETABLE_RUNNING_AND_SYNCHRONOUS
      duration: ANY_MAXVAL_A+1
      curval: 0
      expoint:
        ANY_SCDLTBL_INIT_OFFSET_NOT_0_MAX_A:
          acttsk:
            - TASK2
      osap: NON_TRUSTED_OSAP1
    SCHEDULE_TABLE2:
      type: SCHEDULE_TABLE
      counter: COUNTER1
      syncstrategy: AK_IMPLICIT
      repeat: AK_FALSE
      ststat: SCHEDULETABLE_STOPPED
