NextScheduleTable_nml_to_stp1_0726:
  property:
    sc: 
      - SC3
      - SC4

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      osap: TRUSTED_OSAP1
    TASK2:
      type: TASK
      tstat: SUSPENDED
      inipri: TSK_PRI_MID
      osap: TRUSTED_OSAP2
    TASK3:
      type: TASK
      tstat: SUSPENDED
      inipri: TSK_PRI_MID
      ttype: AK_BASIC
      osap: TRUSTED_OSAP3
    COUNTER1:
      type: COUNTER
      ctype: AK_SOFTWARE
      mincyc: ANY_MINCYC_A
      maxval: ANY_MAXVAL_A
      curval: ANY_CURVAL_A
      cstat: AK_CS_NULL
      osap: TRUSTED_OSAP1
    SCHEDULE_TABLE1:
      type: SCHEDULE_TABLE
      counter: COUNTER1
      syncstrategy: AK_IMPLICIT
      repeat: AK_TRUE
      ststat: SCHEDULETABLE_RUNNING_AND_SYNCHRONOUS
      duration: ANY_MAXVAL_A+1
      curval: 0
      expoint:
        ANY_SCDLTBL_INIT_OFFSET_NOT_0_MAX_A:
          acttsk:
            - TASK2
      osap: TRUSTED_OSAP2
    SCHEDULE_TABLE2:
      type: SCHEDULE_TABLE
      counter: COUNTER1
      syncstrategy: AK_IMPLICIT
      repeat: AK_FALSE
      ststat: SCHEDULETABLE_STOPPED
      duration: ANY_MAXVAL_A+1
      expoint:
        ANY_SCDLTBL_INIT_OFFSET_B:
          acttsk:
            - TASK3
      osap: TRUSTED_OSAP3

  do_0:
    id: TASK1
    syssrv: IncrementCounter(COUNTER1)
    repeat: ANY_SCDLTBL_INIT_OFFSET_NOT_0_MAX_A
    rettype: StatusType
    retval: E_OK
    gcov: false

  post_condition_0:
    COUNTER1:
      curval: (ANY_CURVAL_A+ANY_SCDLTBL_INIT_OFFSET_NOT_0_MAX_A)%(ANY_MAXVAL_A+1)
    SCHEDULE_TABLE1:
      curval: ANY_SCDLTBL_INIT_OFFSET_NOT_0_MAX_A
    TASK2:
      tstat: READY
      actcnt: 1
      curpri: TSK_PRI_MID
      porder: 1

  do_1:
    id: TASK1
    syssrv: NextScheduleTable(SCHEDULE_TABLE1,SCHEDULE_TABLE2)
    rettype: StatusType
    retval: E_OK
    gcov: true

  post_condition_1:
    SCHEDULE_TABLE2:
      ststat: SCHEDULETABLE_NEXT
      stfrom: SCHEDULE_TABLE1

  do_2:
    id: TASK1
    syssrv: IncrementCounter(COUNTER1)
    repeat: ANY_MAXVAL_A+1-ANY_SCDLTBL_INIT_OFFSET_NOT_0_MAX_A
    rettype: StatusType
    retval: E_OK
    gcov: false

  post_condition_2:
    COUNTER1:
      curval: (ANY_CURVAL_A+ANY_MAXVAL_A+1)%(ANY_MAXVAL_A+1)
    SCHEDULE_TABLE1:
      ststat: SCHEDULETABLE_STOPPED
    SCHEDULE_TABLE2:
      ststat: SCHEDULETABLE_RUNNING_AND_SYNCHRONOUS
      curval: 0

  do_3:
    id: TASK1
    syssrv: IncrementCounter(COUNTER1)
    repeat: ANY_MAXVAL_A+1
    rettype: StatusType
    retval: E_OK
    gcov: false

  post_condition_3:
    TASK3:
      tstat: READY
      actcnt: 1
      curpri: TSK_PRI_MID
      porder: 2
    SCHEDULE_TABLE2:
      ststat: SCHEDULETABLE_STOPPED
