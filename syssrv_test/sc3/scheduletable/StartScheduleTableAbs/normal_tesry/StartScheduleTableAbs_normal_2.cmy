  property:
    sc: 
      - SC3
      - SC4

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      osap: TRUSTED_OSAP1
    TASK2:
      type: TASK
      tstat: SUSPENDED
      inipri: TSK_PRI_MID
      ttype: AK_BASIC
      maxact: 6
      osap: TRUSTED_OSAP1
    C2ISR1:
      type: C2ISR
      intno: INTNO_SELF_C2ISR_MID_A
      iniintpri: INT_PRI_MID
      rtnstat: AK_ACTIVATE
      osap: TRUSTED_OSAP1
    COUNTER1:
      type: COUNTER
      ctype: AK_SOFTWARE
      mincyc: ANY_MINCYC_A
      maxval: ANY_MAXVAL_A
      curval: ANY_CURVAL_NOT_0_MAX_A
      cstat: AK_CS_NULL
      osap: TRUSTED_OSAP1
    SCHEDULE_TABLE1:
      type: SCHEDULE_TABLE
      counter: COUNTER1
      syncstrategy: AK_IMPLICIT
      repeat: AK_TRUE
      ststat: SCHEDULETABLE_STOPPED
      duration: ANY_MAXVAL_A+1
      expoint:
        ANY_SCDLTBL_INIT_OFFSET_A:
          acttsk:
            - TASK2
      osap: TRUSTED_OSAP1

  do_0:
    id: C2ISR1
    syssrv: StartScheduleTableAbs(SCHEDULE_TABLE1,ANY_CURVAL_WRAPAROUND_A)
    rettype: StatusType
    retval: E_OK
    gcov: true

  post_condition_0:
    SCHEDULE_TABLE1:
      ststat: SCHEDULETABLE_RUNNING_AND_SYNCHRONOUS

  do_1:
    id: C2ISR1
    syssrv: IncrementCounter(COUNTER1)
    repeat: ANY_MAXVAL_A-ANY_CURVAL_NOT_0_MAX_A+ANY_CURVAL_WRAPAROUND_A+ANY_SCDLTBL_INIT_OFFSET_A+1
    rettype: StatusType
    retval: E_OK
    gcov: false

  post_condition_1:
    COUNTER1:
      curval: (ANY_CURVAL_WRAPAROUND_A+ANY_SCDLTBL_INIT_OFFSET_A)%(ANY_MAXVAL_A+1)
    SCHEDULE_TABLE1:
      curval: ANY_SCDLTBL_INIT_OFFSET_A
    TASK2:
      tstat: READY
      actcnt: 1
      curpri: TSK_PRI_MID

  do_2:
    id: C2ISR1
    syssrv: IncrementCounter(COUNTER1)
    repeat: ANY_MAXVAL_A+1
    rettype: StatusType
    retval: E_OK
    gcov: false

  post_condition_2:
    SCHEDULE_TABLE1:
      curval: ANY_SCDLTBL_INIT_OFFSET_A
    TASK2:
      tstat: READY
      actcnt: 2

  do_3:
