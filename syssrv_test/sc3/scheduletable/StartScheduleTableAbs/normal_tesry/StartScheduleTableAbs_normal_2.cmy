    syssrv: IncrementCounter(COUNTER1)
    repeat: ANY_MAXVAL_A+1
    rettype: StatusType
    retval: E_OK
    gcov: false

  post_condition_3:
    SCHEDULE_TABLE1:
      curval: ANY_SCDLTBL_INIT_OFFSET_A
    TASK2:
      tstat: READY
      actcnt: 3

  do_4:
    id: C2ISR1
    syssrv: IncrementCounter(COUNTER1)
    repeat: ANY_MAXVAL_A+1
    rettype: StatusType
    retval: E_OK
    gcov: false

  post_condition_4:
    SCHEDULE_TABLE1:
      curval: ANY_SCDLTBL_INIT_OFFSET_A
    TASK2:
      tstat: READY
      actcnt: 4

  do_5:
