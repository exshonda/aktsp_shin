  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      inipri: TSK_PRI_MID
      curpri: INT_PRI_MID
      spolicy: ANY_SPOLICY
      relres:
        - RESOURCE1
        - RESOURCE2
      getres:
        - RESOURCE3
        - RESOURCE4
      osap: TRUSTED_OSAP1
    C2ISR2:
      type: C2ISR
      intno: INTNO_SELF_C2ISR_MID_B
      iniintpri: INT_PRI_MID
      rtnstat: AK_STOP
      relres:
        - RESOURCE1
        - RESOURCE2
      osap: TRUSTED_OSAP1
    RESOURCE1:
      type: RESOURCE
      resprop: AK_STANDARD
      lockflg: AK_UNLOCK
    RESOURCE2:
      type: RESOURCE
      resprop: AK_STANDARD
      lockflg: AK_UNLOCK
    RESOURCE3:
      type: RESOURCE
      resprop: AK_LINKED
      lockflg: AK_LOCK
      linkres: RESOURCE1
    RESOURCE4:
      type: RESOURCE
      resprop: AK_LINKED
      lockflg: AK_LOCK
      linkres: RESOURCE2

  do:
    id: TASK1
    syssrv: ReleaseResource(RESOURCE4)
    rettype: StatusType
    retval: E_OK

  post_condition:
    TASK1:
      curpri: INT_PRI_MID
      getres:
        - RESOURCE3
