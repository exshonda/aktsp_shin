######################################################################
# ReleaseResource_error_2_0001.yaml
######################################################################
ReleaseResource_error_2_0001:
  property:
    sc: 
      - SC3
      - SC4

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      spolicy: ANY_SPOLICY
      relres:
        - RESOURCE1
      osap: NON_TRUSTED_OSAP1
      var:
        local:
          type: AktspTfParam
    TASK2:
      type: TASK
      tstat: SUSPENDED
      inipri: TSK_PRI_MID
      relres:
        - RESOURCE1
      osap: TRUSTED_OSAP1
    RESOURCE1:
      type: RESOURCE
      resprop: AK_STANDARD
      lockflg: AK_LOCK
    ERROR_HOOK1:
      type: ERROR_HOOK
      hookstat: AK_STOP
      target_error_hook_cfg:
        - AK_ONLY_SYSTEM
    TRUSTED_FUNCTION1:
      type: TRUSTED_FUNCTION
      arg: local
      osap: TRUSTED_OSAP2
      caller: TASK1
      getres:
        - RESOURCE1

  do_0:
    id: TRUSTED_FUNCTION1
    syssrv: "return E_OK"

  post_condition_0:
    TRUSTED_FUNCTION1:
      caller: 
      getres:
    TASK1:
      getres:
        - RESOURCE1

  do_1:
    id: TASK1
    syssrv: ReleaseResource(RESOURCE1)
    rettype: StatusType
    retval: E_OS_ACCESS
    gcov: true

  post_condition_1:
    ERROR_HOOK1:
      hookstat: AK_ACTIVATE

  do_2:
    id: ERROR_HOOK1
    syssrv: CheckAssert(Error==E_OS_ACCESS)
    gcov: false

  post_condition_2:

  do_3:
    id: ERROR_HOOK1
    syssrv: CheckAssert(OSError_ReleaseResource_ResID()==RESOURCE1)
    gcov: false

  post_condition_3:

  do_4:
    id: ERROR_HOOK1
    syssrv: CheckAssert(OSErrorGetServiceId()==OSServiceId_ReleaseResource)
    gcov: false

  post_condition_4:

  do_5:
    id: ERROR_HOOK1
    syssrv: return
    gcov: false

  post_condition_5:
    ERROR_HOOK1:
      hookstat: AK_STOP

  do_9:
    id: TASK1
    syssrv: CallTrustedFunction(TRUSTED_FUNCTION1,&local)
    rettype: StatusType
    retval: E_OK
    gcov: false

  post_condition_9:
    TRUSTED_FUNCTION1:
      caller: TASK1
      getres:
        - RESOURCE1
      bootcnt: 1
    TASK1:
      getres:

  do_10:
    id: TRUSTED_FUNCTION1
    syssrv: ReleaseResource(RESOURCE1)
    rettype: StatusType
    retval: E_OK
    gcov: false

  post_condition_10:
    TRUSTED_FUNCTION1:
      getres:
    RESOURCE1:
      lockflg: AK_UNLOCK

  do_11:
    id: TRUSTED_FUNCTION1
    syssrv: "return E_OK"
    gcov: false

  post_condition_11:
    TRUSTED_FUNCTION1:
      caller: 
######################################################################
