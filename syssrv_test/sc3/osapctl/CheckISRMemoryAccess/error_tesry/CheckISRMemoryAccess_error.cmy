      rtnstat: AK_STOP
      target_error_hook_cfg:
        - AK_ONLY_SYSTEM
      need_si:
        - NOS409
    ERROR_HOOK1:
      hookstat: AK_ACTIVATE
      bootcnt: 2

  do_15:
