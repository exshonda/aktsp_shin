    gcov: false

  post_condition_12:

  do_13:
    id: ERROR_HOOK1
    syssrv: return
    gcov: false

  post_condition_13:
    C2ISR1:
      rtnstat: AK_ACTIVATE
      need_si:
        - NOS409
    ERROR_HOOK1:
      hookstat: AK_STOP

  do_14:
    id: C2ISR1
    syssrv: CheckAssert(OSMEMORY_IS_EXECUTABLE(CheckISRMemoryAccess(C2ISR1,AKTSP_CHECK_NT_TASK_ADDRESS,AKTSP_TASK_STACK_SIZE)) == 0)

  post_condition_14:
