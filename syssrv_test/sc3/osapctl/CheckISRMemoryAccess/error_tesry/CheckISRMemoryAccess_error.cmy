CheckISRMemoryAccess_error_0004:
  property:
    sc: 
      - SC3
      - SC4
    need_stack_share: true

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      osap: TRUSTED_OSAP1
    TASK2:
      type: TASK
      tstat: SUSPENDED
      inipri: TSK_PRI_MID
      osap: NON_TRUSTED_OSAP1
    C2ISR1:
      type: C2ISR
      intno: INTNO_SELF_C2ISR_MID_A
      iniintpri: INT_PRI_MID
      rtnstat: AK_ACTIVATE
      osap: TRUSTED_OSAP1
    INT_STATE1:
      type: INT_STATE
      istat:
        - AK_SUS_ALL_INT: C2ISR1
    ERROR_HOOK1:
      type: ERROR_HOOK
      hookstat: AK_STOP
      bootcnt: 0
      target_error_hook_cfg:
        - AK_ONLY_SYSTEM
      need_si:
        - NOS409
        - NOS412

  do_0:
    id: C2ISR1
    syssrv: CheckAssert(OSMEMORY_IS_READABLE(CheckISRMemoryAccess(C2ISR1,AKTSP_CHECK_NT_TASK_ADDRESS,AKTSP_TASK_STACK_SIZE)) == 0)
    gcov: true

  post_condition_0:
    C2ISR1:
      rtnstat: AK_STOP
      target_error_hook_cfg:
        - AK_ONLY_SYSTEM
      need_si:
        - NOS409
    ERROR_HOOK1:
      hookstat: AK_ACTIVATE

  do_1:
    id: ERROR_HOOK1
    syssrv: CheckAssert(Error==E_OS_DISABLEDINT)
    gcov: false

  post_condition_1:

  do_2:
    id: ERROR_HOOK1
    syssrv: CheckAssert(OSError_CheckISRMemoryAccess_ISRID()==C2ISR1)
    gcov: false

  post_condition_2:

  do_3:
    id: ERROR_HOOK1
    syssrv: CheckAssert(OSError_CheckISRMemoryAccess_Address()==AKTSP_CHECK_NT_TASK_ADDRESS)
    gcov: false
    need_si:
      - IOS030

  post_condition_3:

  do_4:
    id: ERROR_HOOK1
    syssrv: CheckAssert(OSError_CheckISRMemoryAccess_Size()==AKTSP_TASK_STACK_SIZE)
    gcov: false
    need_si:
      - IOS030

  post_condition_4:

  do_5:
    id: ERROR_HOOK1
    syssrv: CheckAssert(OSErrorGetServiceId()==OSServiceId_CheckISRMemoryAccess)
    gcov: false

  post_condition_5:

  do_6:
    id: ERROR_HOOK1
    syssrv: return
    gcov: false

  post_condition_6:
    C2ISR1:
      rtnstat: AK_ACTIVATE
      need_si:
        - NOS409
    ERROR_HOOK1:
      hookstat: AK_STOP

  do_7:
    id: C2ISR1
    syssrv: CheckAssert(OSMEMORY_IS_WRITEABLE(CheckISRMemoryAccess(C2ISR1,AKTSP_CHECK_NT_TASK_ADDRESS,AKTSP_TASK_STACK_SIZE)) == 0)

  post_condition_7:
    C2ISR1:
      rtnstat: AK_STOP
      target_error_hook_cfg:
        - AK_ONLY_SYSTEM
      need_si:
        - NOS409
    ERROR_HOOK1:
      hookstat: AK_ACTIVATE
      bootcnt: 1

  do_8:
    id: ERROR_HOOK1
    syssrv: CheckAssert(Error==E_OS_DISABLEDINT)
    gcov: false

  post_condition_8:

  do_9:
    id: ERROR_HOOK1
