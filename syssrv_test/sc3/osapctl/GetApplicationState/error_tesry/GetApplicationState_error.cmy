      target_error_hook_cfg:
        - AK_ONLY_SYSTEM

  do_0:
    id: STARTUP_HOOK1
    syssrv: GetApplicationState(TRUSTED_OSAP1,NULL)
    rettype: StatusType
    retval: OS_E_PARAM_POINTER
    gcov: true

  post_condition_0:
    STARTUP_HOOK1:
      hookstat: AK_STOP
      target_error_hook_cfg:
        - AK_ONLY_SYSTEM
    ERROR_HOOK1:
      hookstat: AK_ACTIVATE

  do_1:
    id: ERROR_HOOK1
    syssrv: CheckAssert(Error==OS_E_PARAM_POINTER)
    gcov: false

  post_condition_1:

  do_2:
    id: ERROR_HOOK1
    syssrv: CheckAssert(OSError_GetApplicationState_Application()==TRUSTED_OSAP1)
    gcov: false

  post_condition_2:

  do_3:
    id: ERROR_HOOK1
    syssrv: CheckAssert(OSError_GetApplicationState_Value()==NULL)
    gcov: false
    need_si:
      - IOS030

  post_condition_3:

  do_4:
    id: ERROR_HOOK1
    syssrv: CheckAssert(OSErrorGetServiceId()==OSServiceId_GetApplicationState)
    gcov: false

  post_condition_4:
