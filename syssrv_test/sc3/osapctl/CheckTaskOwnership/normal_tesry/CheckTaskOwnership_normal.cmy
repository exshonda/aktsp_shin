      tstat: SUSPENDED
      inipri: TSK_PRI_MID
      osap: TRUSTED_OSAP2

  do:
    id: TASK1
    syssrv: CheckObjectOwnership(OBJECT_TASK,TASK2)
    rettype: ApplicationType
    retval: TRUSTED_OSAP2

  post_condition:
