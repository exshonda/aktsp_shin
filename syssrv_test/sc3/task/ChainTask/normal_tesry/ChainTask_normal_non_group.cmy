        - RESOURCE1
      getres:
        - RESOURCE1
      osap: TRUSTED_OSAP1
    TASK2:
      type: TASK
      tstat: SUSPENDED
      inipri: TSK_PRI_MID
      spolicy: AK_SCHFULL
      relres:
        - RESOURCE1
      osap: TRUSTED_OSAP1
    TASK3:
      type: TASK
      tstat: SUSPENDED
      inipri: TSK_PRI_TOP
      ttype: AK_BASIC
      spolicy: AK_SCHFULL
      osap: TRUSTED_OSAP1
    RESOURCE1:
      type: RESOURCE
      resprop: AK_INTERNAL
      lockflg: AK_LOCK

  do:
    id: TASK1
    syssrv: ChainTask(TASK3)
    rettype: StatusType
    retval: E_OK

  post_condition:
    TASK1:
      tstat: READY
      actcnt: ANY_BASIC_MAXACT-1
      bootcnt: 1
      getres:
    TASK3:
      tstat: RUNNING
      curpri: TSK_PRI_TOP
      actcnt: 1
    RESOURCE1:
      lockflg: AK_UNLOCK
######################################################################
