######################################################################
# ChainTask_normal_non_group_0001.yaml
######################################################################
ChainTask_normal_non_group_0001:
  property:
    sc: 
      - SC3
      - SC4

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      inipri: TSK_PRI_MID
      curpri: TSK_PRI_HIGH
      ttype: AK_BASIC
      spolicy: AK_SCHFULL
      relres:
        - RESOURCE1
      getres:
        - RESOURCE1
      osap: NON_TRUSTED_OSAP1
      var:
        local:
          type: AktspTfParam
    TASK2:
      type: TASK
      tstat: READY
      curpri: TSK_PRI_HIGH
      spolicy: AK_SCHFULL
      relres:
        - RESOURCE1
      osap: NON_TRUSTED_OSAP1
    TASK3:
      type: TASK
      tstat: SUSPENDED
      inipri: TSK_PRI_TOP
      ttype: AK_BASIC
      spolicy: AK_SCHFULL
      osap: NON_TRUSTED_OSAP2
    RESOURCE1:
      type: RESOURCE
      resprop: AK_INTERNAL
      lockflg: AK_LOCK
      accosap:
        - NON_TRUSTED_OSAP1
        - NON_TRUSTED_OSAP2
    TRUSTED_FUNCTION1:
      type: TRUSTED_FUNCTION
      arg: local
      osap: TRUSTED_OSAP2
      caller: TASK1

  do:
    id: TRUSTED_FUNCTION1
    syssrv: ChainTask(TASK3)
    rettype: StatusType
    retval: E_OK

  post_condition:
    TASK1:
      tstat: SUSPENDED
      getres:
    TASK3:
      tstat: RUNNING
      curpri: TSK_PRI_TOP
      actcnt: 1
    RESOURCE1:
      lockflg: AK_UNLOCK
