######################################################################
ChainTask_normal_1329:
  property:
    sc: 
      - SC3
      - SC4

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      inipri: TSK_PRI_MID
      curpri: TSK_PRI_MID
      spolicy: AK_SCHNON
      ttype: AK_BASIC
      osap: NON_TRUSTED_OSAP1
      var:
        local:
          type: AktspTfParam
    TASK2:
      type: TASK
      tstat: SUSPENDED
      inipri: TSK_PRI_HIGH
      ttype: AK_EXTENDED
      spolicy: AK_SCHNON
      osap: NON_TRUSTED_OSAP2
      accosap:
        - NON_TRUSTED_OSAP1
    TRUSTED_FUNCTION1:
      type: TRUSTED_FUNCTION
      arg: local
      osap: TRUSTED_OSAP2
      caller: TASK1

  do:
    id: TRUSTED_FUNCTION1
    syssrv: ChainTask(TASK2)
    rettype: StatusType
    retval: E_OK

  post_condition:
    TASK1:
      tstat: SUSPENDED
    TASK2:
      tstat: RUNNING
      actcnt: 1
      curpri: TSK_PRI_HIGH
