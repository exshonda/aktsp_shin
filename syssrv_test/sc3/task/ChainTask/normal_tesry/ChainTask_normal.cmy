######################################################################
# ChainTask_normal_0001.yaml
######################################################################
ChainTask_normal_0001:
  property:
    sc: 
      - SC3
      - SC4

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      inipri: TSK_PRI_MID
      curpri: TSK_PRI_MID
      bootcnt: 0
      spolicy: AK_SCHNON
      ttype: AK_BASIC
      osap: NON_TRUSTED_OSAP1
    TASK2:
      type: TASK
      tstat: READY
      curpri: TSK_PRI_HIGH
      maxact: ANY_BASIC_MAXACT
      actcnt: 1
      ttype: AK_BASIC
      spolicy: AK_SCHFULL
      osap: NON_TRUSTED_OSAP1

  do:
    id: TASK1
    syssrv: ChainTask(TASK1)
    rettype: StatusType
    retval: E_OK

  post_condition:
    TASK1:
      tstat: READY
      actcnt: 1
      bootcnt: 1
    TASK2:
      tstat: RUNNING
      actcnt: 1
