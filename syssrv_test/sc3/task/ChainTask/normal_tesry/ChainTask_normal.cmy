        - NON_TRUSTED_OSAP1
    RESOURCE1:
      type: RESOURCE
      resprop: AK_INTERNAL
      lockflg: AK_LOCK
      accosap:
        - NON_TRUSTED_OSAP2
        - NON_TRUSTED_OSAP1
    TRUSTED_FUNCTION1:
      type: TRUSTED_FUNCTION
      arg: local
      osap: TRUSTED_OSAP2
      caller: TASK1

  do:
    id: TRUSTED_FUNCTION1
    syssrv: ChainTask(TASK2)
    rettype: StatusType
    retval: E_OK

  post_condition:
    TASK1:
      tstat: SUSPENDED
      getres:
