######################################################################
# ChainTask_normal_evt_0001.yaml
######################################################################
ChainTask_normal_evt_0001:
  property:
    sc: 
      - SC3
      - SC4

  pre_condition:
    TASK1:
      type: TASK
      tstat: READY
      inipri: TSK_PRI_MID
      curpri: TSK_PRI_MID
      bootcnt: 0
      spolicy: AK_SCHFULL
      ttype: AK_BASIC
      osap: NON_TRUSTED_OSAP1
      var:
        local:
          type: AktspTfParam
    TASK2:
      type: TASK
      tstat: RUNNING
      inipri: TSK_PRI_HIGH
      curpri: TSK_PRI_HIGH
      bootcnt: 0
      ttype: AK_EXTENDED
      spolicy: AK_SCHFULL
      osap: NON_TRUSTED_OSAP2
      accosap:
        - NON_TRUSTED_OSAP1
    TRUSTED_FUNCTION1:
      type: TRUSTED_FUNCTION
      osap: TRUSTED_OSAP2

  do_0:
    id: TASK2
    syssrv: TerminateTask()
    gcov: false

  post_condition_0:
    TASK1:
      tstat: RUNNING
    TASK2:
      tstat: SUSPENDED
      bootcnt: 1

  do_1:
    id: TASK1
    syssrv:  CallTrustedFunction(TRUSTED_FUNCTION1, &local)
    rettype: StatusType
    retval: E_OK
    gcov: false

  post_condition_1:
    TRUSTED_FUNCTION1:
      caller: TASK1

  do_2:
    id: TRUSTED_FUNCTION1
    syssrv: ChainTask(TASK2)
    rettype: StatusType
    retval: E_OK
    gcov: true

  post_condition_2:
    TASK1:
      tstat: SUSPENDED
    TASK2:
      tstat: RUNNING
      actcnt: 1
      curevt: 0
