      porder: 2
      osap: NON_TRUSTED_OSAP1
    RESOURCE1:
      type: RESOURCE
      resprop: AK_INTERNAL
      lockflg: AK_LOCK
      accosap:
        - NON_TRUSTED_OSAP1
        - NON_TRUSTED_OSAP2

  do:
    id: TASK1
    syssrv: Schedule()
