######################################################################
# Schedule_normal_schedule_0001.yaml
######################################################################
Schedule_normal_schedule_0001:
  property:
    sc: 
      - SC3
      - SC4

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      inipri: TSK_PRI_MID
      curpri: TSK_PRI_MID
      spolicy: AK_SCHNON
      ttype: AK_BASIC
      osap: NON_TRUSTED_OSAP1
    TASK2:
      type: TASK
      tstat: READY
      curpri: TSK_PRI_HIGH
      spolicy: AK_SCHFULL
      ttype: AK_BASIC
      porder: 1
      osap: NON_TRUSTED_OSAP2
    TASK3:
      type: TASK
      tstat: READY
      curpri: TSK_PRI_HIGH
      spolicy: AK_SCHFULL
      ttype: AK_BASIC
      porder: 2
      osap: NON_TRUSTED_OSAP1

  do:
    id: TASK1
    syssrv: Schedule()
    rettype: StatusType
    retval: E_OK

  post_condition:
    TASK1:
      tstat: READY
    TASK2:
      tstat: RUNNING
    TASK3:
      tstat: READY
      porder: 1
