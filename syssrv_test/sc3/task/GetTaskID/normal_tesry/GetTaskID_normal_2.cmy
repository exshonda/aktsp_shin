######################################################################
# GetTaskID_normal_2_0001.yaml
######################################################################
GetTaskID_normal_2_0001:
  property:
    maintask_wait: true
    sc: 
      - SC3
      - SC4

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: 0
      osap: TRUSTED_OSAP1
    C2ISR1:
      type: C2ISR
      intno: INTNO_SELF_C2ISR_MID_B
      iniintpri: INT_PRI_MID
      var:
        vname1:
          type: TaskType
      osap: TRUSTED_OSAP1
      rtnstat: AK_STOP
    POSTTASK_HOOK1:
      type: POSTTASK_HOOK
      hookstat: AK_STOP

  do_0:
    id: TASK1
    syssrv: TerminateTask()
    gcov: false

  post_condition_0:
    POSTTASK_HOOK1:
      hookstat: AK_ACTIVATE

  do_1:
    id: POSTTASK_HOOK1
    syssrv: AktspRaiseInterrupt(INTNO_SELF_C2ISR_MID_B)
    gcov: false

  post_condition_1:

  do_2:
    id: POSTTASK_HOOK1
    syssrv: return
    gcov: false

  post_condition_2:
    TASK1:
      tstat: SUSPENDED
    POSTTASK_HOOK1:
      hookstat: AK_STOP
    C2ISR1:
      rtnstat: AK_ACTIVATE

  do_3:
    id: C2ISR1
    syssrv: GetTaskID(&vname1)
    rettype: StatusType
    retval: E_OK
    gcov: true

  post_condition_3:
    C2ISR1:
      rtnstat: AK_ACTIVATE
      var:
        vname1:
          value: INVALID_TASK
######################################################################
# GetTaskID_normal_2_0002.yaml
######################################################################
GetTaskID_normal_2_0002:
  property:
    maintask_wait: true
    sc: 
      - SC3
      - SC4

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: 0
      osap: TRUSTED_OSAP1
    C2ISR1:
      type: C2ISR
      intno: INTNO_SELF_C2ISR_MID_B
      iniintpri: INT_PRI_MID
      osap: TRUSTED_OSAP1
      rtnstat: AK_STOP
    ERROR_HOOK1:
      type: ERROR_HOOK
      hookstat: AK_STOP
      var:
        vname1:
          type: TaskType
    POSTTASK_HOOK1:
      type: POSTTASK_HOOK
      hookstat: AK_STOP

  do_0:
    id: TASK1
    syssrv: TerminateTask()
    gcov: false

  post_condition_0:
    POSTTASK_HOOK1:
      hookstat: AK_ACTIVATE

  do_1:
    id: POSTTASK_HOOK1
    syssrv: AktspRaiseInterrupt(INTNO_SELF_C2ISR_MID_B)
    gcov: false

  post_condition_1:

  do_2:
    id: POSTTASK_HOOK1
    syssrv: return
    gcov: false

  post_condition_2:
    TASK1:
      tstat: SUSPENDED
    POSTTASK_HOOK1:
      hookstat: AK_STOP
    C2ISR1:
      rtnstat: AK_ACTIVATE

  do_3:
    id: C2ISR1
    syssrv: AktspRaiseErrorHook()
    gcov: false

  post_condition_3:
    C2ISR1:
      rtnstat: AK_STOP
    ERROR_HOOK1:
      hookstat: AK_ACTIVATE

  do_4:
    id: ERROR_HOOK1
    syssrv: GetTaskID(&vname1)
    rettype: StatusType
    retval: E_OK
    gcov: true

  post_condition_4:
    ERROR_HOOK1:
      var:
        vname1:
          value: INVALID_TASK

  do_5:
    id: ERROR_HOOK1
    syssrv: return
    gcov: false

  post_condition_5:
    C2ISR1:
      rtnstat: AK_ACTIVATE
    ERROR_HOOK1:
      hookstat: AK_STOP
######################################################################
# GetTaskID_normal_2_0003.yaml
######################################################################
GetTaskID_normal_2_0003:
  property:
    maintask_wait: true
    sc: 
      - SC3
      - SC4

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: 0
      osap: TRUSTED_OSAP1
    C2ISR1:
      type: C2ISR
      intno: INTNO_SELF_C2ISR_MID_B
      iniintpri: INT_PRI_MID
      osap: TRUSTED_OSAP1
      rtnstat: AK_STOP
    PROTECTION_HOOK1:
      type: PROTECTION_HOOK
      hookstat: AK_STOP
      var:
        vname1:
          type: TaskType
    POSTTASK_HOOK1:
      type: POSTTASK_HOOK
      hookstat: AK_STOP

  do_0:
    id: TASK1
    syssrv: TerminateTask()
    gcov: false

  post_condition_0:
    POSTTASK_HOOK1:
      hookstat: AK_ACTIVATE

  do_1:
    id: POSTTASK_HOOK1
    syssrv: AktspRaiseInterrupt(INTNO_SELF_C2ISR_MID_B)
    gcov: false

  post_condition_1:

  do_2:
    id: POSTTASK_HOOK1
    syssrv: return
    gcov: false

  post_condition_2:
    TASK1:
      tstat: SUSPENDED
    POSTTASK_HOOK1:
      hookstat: AK_STOP
    C2ISR1:
      rtnstat: AK_ACTIVATE

  do_3:
    id: C2ISR1
    syssrv: AktspRaiseProtectionHook()
    gcov: false

  post_condition_3:
    C2ISR1:
      rtnstat: AK_STOP
    PROTECTION_HOOK1:
      hookstat: AK_ACTIVATE

  do_4:
    id: PROTECTION_HOOK1
    syssrv: GetTaskID(&vname1)
    rettype: StatusType
    retval: E_OK
    gcov: true

  post_condition_4:
    PROTECTION_HOOK1:
      var:
        vname1:
          value: INVALID_TASK

  do_5:
    id: PROTECTION_HOOK1
    syssrv: return(PRO_IGNORE)
    gcov: false

  post_condition_5:
    C2ISR1:
      rtnstat: AK_ACTIVATE
    PROTECTION_HOOK1:
      hookstat: AK_STOP
######################################################################
