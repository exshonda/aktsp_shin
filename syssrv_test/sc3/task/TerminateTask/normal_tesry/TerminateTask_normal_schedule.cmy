TerminateTask_normal_schedule_0001:
  property:
    sc: 
      - SC3
      - SC4

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      osap: NON_TRUSTED_OSAP1
      spolicy: AK_SCHNON
      ttype: ANY_TTYPE
    TASK2:
      type: TASK
      osap: NON_TRUSTED_OSAP1
      tstat: READY
