      tstat: READY
      curpri: TSK_PRI_HIGH
      spolicy: AK_SCHFULL
      ttype: ANY_TTYPE
      porder: 2

  do:
    id: TASK1
    syssrv: TerminateTask()

  post_condition:
    TASK1:
      tstat: SUSPENDED
    TASK2:
      tstat: RUNNING
    TASK3:
      tstat: READY
      porder: 1
