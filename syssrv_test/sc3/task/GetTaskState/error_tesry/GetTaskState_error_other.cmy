######################################################################
# GetTaskState_error_other_0001.yaml
######################################################################
GetTaskState_error_other_0001:
  property:
    sc: 
      - SC3
      - SC4

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      osap: TRUSTED_OSAP1
    TASK2:
      type: TASK
      tstat: SUSPENDED
      osap: TRUSTED_OSAP1
    C1ISR1:
      type: C1ISR
      intno: INTNO_SELF_C1ISR_MID
      iniintpri: INT_PRI_ISR1_MID
      rtnstat: AK_ACTIVATE
      osap: TRUSTED_OSAP1
      var:
        vname1:
          type: TaskStateType

  do:
    id: C1ISR1
    syssrv: GetTaskState(TASK2,&vname1)
    rettype: StatusType
    retval: E_OS_CALLEVEL

  post_condition:
######################################################################
# GetTaskState_error_other_0002.yaml
######################################################################
GetTaskState_error_other_0002:
  property:
    sc: 
      - SC3
      - SC4

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      osap: TRUSTED_OSAP1
    TASK2:
      type: TASK
      tstat: SUSPENDED
      osap: TRUSTED_OSAP1
    C2ISR1:
      type: C2ISR
      intno: INTNO_SELF_C2ISR_MID_A
      iniintpri: INT_PRI_MID
      rtnstat: AK_ACTIVATE
      osap: TRUSTED_OSAP1
    ERROR_HOOK1:
      type: ERROR_HOOK
      hookstat: AK_STOP
      target_error_hook_cfg:
        - AK_ONLY_SYSTEM

  do_0:
    id: C2ISR1
    syssrv: GetTaskState(TASK2,NULL)
    rettype: StatusType
    retval: OS_E_PARAM_POINTER
    gcov: true

  post_condition_0:
    C2ISR1:
      rtnstat: AK_STOP
      target_error_hook_cfg:
        - AK_ONLY_SYSTEM
    ERROR_HOOK1:
      hookstat: AK_ACTIVATE

  do_1:
    id: ERROR_HOOK1
    syssrv: CheckAssert(Error==OS_E_PARAM_POINTER)
    gcov: false

  post_condition_1:

  do_2:
    id: ERROR_HOOK1
    syssrv: CheckAssert(OSError_GetTaskState_TaskID()==TASK2)
    gcov: false

  post_condition_2:

  do_3:
    id: ERROR_HOOK1
    syssrv: CheckAssert(OSError_GetTaskState_State()==NULL)
    gcov: false
    need_si:
      - IOS030

  post_condition_3:

  do_4:
    id: ERROR_HOOK1
    syssrv: CheckAssert(OSErrorGetServiceId()==OSServiceId_GetTaskState)
    gcov: false

  post_condition_4:

  do_5:
    id: ERROR_HOOK1
    syssrv: return
    gcov: false

  post_condition_5:
    C2ISR1:
      rtnstat: AK_ACTIVATE
      target_error_hook_cfg:
        - AK_ONLY_SYSTEM
    ERROR_HOOK1:
      hookstat: AK_STOP
