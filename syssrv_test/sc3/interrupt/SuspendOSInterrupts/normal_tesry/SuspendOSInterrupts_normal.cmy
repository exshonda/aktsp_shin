######################################################################
# SuspendOSInterrupts_normal_0001.yaml
######################################################################
SuspendOSInterrupts_normal_0001:
  property:
    sc: 
      - SC3
      - SC4

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      osap: TRUSTED_OSAP1
    C1ISR1:
      type: C1ISR
      intno: INTNO_SELF_C1ISR_MID
      iniintpri: INT_PRI_ISR1_MID
      rtnstat: AK_ACTIVATE
      osap: TRUSTED_OSAP1
    C1ISR2:
      type: C1ISR
      intno: INTNO_SELF_C1ISR_HIGH
      iniintpri: INT_PRI_ISR1_HIGH
      rtnstat: AK_STOP
      osap: TRUSTED_OSAP1
    INT_STATE1:
      type: INT_STATE
      istat:

  do_0:
    id: C1ISR1
    syssrv: SuspendOSInterrupts()
    gcov: true

  post_condition_0:
    INT_STATE1:
      istat:

  do_1:
    id: C1ISR1
    syssrv: AktspRaiseInterrupt(INTNO_SELF_C1ISR_HIGH)
    gcov: false

  post_condition_1:
    C1ISR1:
      rtnstat: AK_STOP
    C1ISR2:
      rtnstat: AK_ACTIVATE
