######################################################################
# SuspendAllInterrupts_error3_0001.yaml
######################################################################
SuspendAllInterrupts_error3_0001:
  property:
    sc: 
      - SC3
      - SC4

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      osap: NON_TRUSTED_OSAP1
    ERROR_HOOK1:
      type: ERROR_HOOK
      hookstat: AK_STOP
      target_error_hook_cfg:
        - AK_ONLY_SYSTEM
      need_si:
        - NOS1517

  do_0:
    id: TASK1
    syssrv: SuspendAllInterrupts()
    gcov: true

  post_condition_0:
    ERROR_HOOK1:
      hookstat: AK_ACTIVATE

  do_1:
    id: ERROR_HOOK1
    syssrv: CheckAssert(Error==E_OS_ACCESS)
    gcov: false

  post_condition_1:

  do_2:
    id: ERROR_HOOK1
    syssrv: CheckAssert(OSErrorGetServiceId()==OSServiceId_SuspendAllInterrupts)
    gcov: false

  post_condition_2:

  do_3:
    id: ERROR_HOOK1
    syssrv: return
    gcov: false

  post_condition_3:
    ERROR_HOOK1:
      hookstat: AK_STOP
######################################################################
