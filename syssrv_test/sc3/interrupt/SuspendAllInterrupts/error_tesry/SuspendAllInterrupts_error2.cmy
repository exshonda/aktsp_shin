######################################################################
# SuspendAllInterrupts_error2_0001.yaml
######################################################################
SuspendAllInterrupts_error2_0001:
  property:
    sc: 
      - SC3
      - SC4

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      osap: ANY_OSAP_1
    C2ISR1:
      type: C2ISR
      intno: INTNO_SELF_C2ISR_MID_A
      iniintpri: INT_PRI_MID
      rtnstat: AK_ACTIVATE
      osap: TRUSTED_OSAP1
    INT_STATE1:
      type: INT_STATE
      istat:
        - AK_DIS_ALL_INT: C2ISR1
    ERROR_HOOK1:
      type: ERROR_HOOK
      hookstat: AK_STOP
      target_error_hook_cfg:
        - AK_ONLY_SYSTEM
      need_si:
        - NOS409
        - NOS712

  do_0:
    id: C2ISR1
    syssrv: SuspendAllInterrupts()
    gcov: true

  post_condition_0:
    C2ISR1:
      rtnstat: AK_STOP
      target_error_hook_cfg:
        - AK_ONLY_SYSTEM
      need_si:
        - NOS409
        - NOS712
    ERROR_HOOK1:
      hookstat: AK_ACTIVATE

  do_1:
    id: ERROR_HOOK1
    syssrv: CheckAssert(Error==E_OS_DISABLEDINT)
    gcov: false

  post_condition_1:

  do_2:
    id: ERROR_HOOK1
    syssrv: CheckAssert(OSErrorGetServiceId()==OSServiceId_SuspendAllInterrupts)
    gcov: false

  post_condition_2:

  do_3:
    id: ERROR_HOOK1
    syssrv: return
    gcov: false

  post_condition_3:
    C2ISR1:
      rtnstat: AK_ACTIVATE
      target_error_hook_cfg:
        - AK_ONLY_SYSTEM
    ERROR_HOOK1:
      hookstat: AK_STOP
