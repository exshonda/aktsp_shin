######################################################################
# ResumeOSInterrupts_nml_1_0001.yaml
######################################################################
ResumeOSInterrupts_nml_1_0001:
  property:
    sc: 
      - SC3
      - SC4

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      osap: TRUSTED_OSAP1
    C1ISR1:
      type: C1ISR
      intno: INTNO_SELF_C1ISR_MID
      iniintpri: INT_PRI_ISR1_MID
      rtnstat: AK_ACTIVATE
      osap: TRUSTED_OSAP1
    INT_STATE1:
      type: INT_STATE
      istat:
        - AK_SUS_ALL_INT: C1ISR1

  do:
    id: C1ISR1
    syssrv: ResumeOSInterrupts()

  post_condition:
    INT_STATE1:
      istat:
        - AK_SUS_ALL_INT: C1ISR1
