# ResumeAllInterrupts_nml_2_0015.yaml
######################################################################
ResumeAllInterrupts_nml_2_0015:
  property:
    sc: 
      - SC3
      - SC4

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      osap: NON_TRUSTED_OSAP1
      var:
        local:
          type: AktspTfParam
    TRUSTED_FUNCTION1:
      type: TRUSTED_FUNCTION
      arg: local
      osap: TRUSTED_OSAP2
      caller: TASK1
    C2ISR1:
      type: C2ISR
      intno: INTNO_SELF_C2ISR_HIGH
      iniintpri: INT_PRI_HIGH
      rtnstat: AK_STOP
      osap: TRUSTED_OSAP1
    ERROR_HOOK1:
      type: ERROR_HOOK
      hookstat: AK_STOP
      target_error_hook_cfg:
        - AK_ONLY_SYSTEM
    INT_STATE1:
      type: INT_STATE
      istat:
        - AK_SUS_OS_INT: TRUSTED_FUNCTION1

  do_0:
    id: TRUSTED_FUNCTION1
    syssrv: AktspRaiseInterrupt(INTNO_SELF_C2ISR_HIGH)
    gcov: false

  post_condition_0:

  do_1:
    id: TRUSTED_FUNCTION1
    syssrv: SuspendAllInterrupts()
    gcov: false

  post_condition_1:
    INT_STATE1:
      istat:
        - AK_SUS_OS_INT: TRUSTED_FUNCTION1
        - AK_SUS_ALL_INT: TRUSTED_FUNCTION1

  do_2:
    id: TRUSTED_FUNCTION1
    syssrv: ResumeAllInterrupts()
    gcov: true

  post_condition_2:
    INT_STATE1:
      istat:
        - AK_SUS_OS_INT: TRUSTED_FUNCTION1

  do_3:
    id: TRUSTED_FUNCTION1
    syssrv: ResumeOSInterrupts()
    gcov: false

  post_condition_3:
    INT_STATE1:
      istat:
    C2ISR1:
      rtnstat: AK_ACTIVATE
