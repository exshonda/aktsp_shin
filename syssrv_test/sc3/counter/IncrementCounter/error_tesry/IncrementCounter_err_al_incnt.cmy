######################################################################
# IncrementCounter_err_al_incnt_0001.yaml
######################################################################
IncrementCounter_err_al_incnt_0001:
  property:
    sc: 
      - SC3
      - SC4

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      spolicy: AK_SCHFULL
      osap: TRUSTED_OSAP1
    TASK2:
      type: TASK
      tstat: SUSPENDED
      inipri: TSK_PRI_HIGH
      spolicy: AK_SCHFULL
      osap: TRUSTED_OSAP1
    C2ISR1:
      type: C2ISR
      intno: INTNO_SELF_C2ISR_MID_B
      iniintpri: INT_PRI_MID
      rtnstat: AK_STOP
      osap: TRUSTED_OSAP1
    ALARM1:
      type: ALARM
      almact: AK_ALM_ATSK
      counter: COUNTER1
      astat: AK_SET
      almval: ANY_ALMVAL_A
      cycle: 0
      task: TASK2
      osap: TRUSTED_OSAP1
    ALARM2:
      type: ALARM
      almact: AK_ALM_INCNT
      counter: COUNTER2
      astat: AK_SET
      almval: ANY_ALMVAL_A
      cycle: 0
      incounter: COUNTER1
      osap: TRUSTED_OSAP1
    COUNTER1:
      type: COUNTER
      ctype: AK_SOFTWARE
      mincyc: ANY_MINCYC_A
      maxval: ANY_MAXVAL_A
      curval: ANY_ALMVAL_A-1
      cstat: AK_CS_NULL
      osap: TRUSTED_OSAP1
    COUNTER2:
      type: COUNTER
      ctype: AK_SOFTWARE
      mincyc: ANY_MINCYC_A
      maxval: ANY_MAXVAL_A
      curval: ANY_ALMVAL_A-1
      cstat: AK_CS_NULL
      osap: TRUSTED_OSAP1
    ERROR_HOOK1:
      type: ERROR_HOOK
      hookstat: AK_STOP
      target_error_hook_cfg:
        - AK_ONLY_SYSTEM

  do_0:
    id: TASK1
    syssrv: IncrementCounter(COUNTER1)
    rettype: StatusType
    retval: E_OK
    gcov: false

  post_condition_0:
    TASK1:
      tstat: READY
    TASK2:
      tstat: RUNNING
      actcnt: 1
      curpri: TSK_PRI_HIGH
    COUNTER1:
      curval: ANY_ALMVAL_A
      cstat: AK_CS_DOING
    ALARM1:
      astat: AK_UNSET

  do_1:
    id: TASK2
    syssrv: AktspRaiseInterrupt(INTNO_SELF_C2ISR_MID_B)
    gcov: false

  post_condition_1:
    C2ISR1:
      rtnstat: AK_ACTIVATE

  do_2:
    id: C2ISR1
    syssrv: IncrementCounter(COUNTER2)
    rettype: StatusType
    retval: E_OK
    gcov: true

  post_condition_2:
    C2ISR1:
      rtnstat: AK_STOP
      target_error_hook_cfg:
        - AK_ONLY_SYSTEM
    ERROR_HOOK1:
      hookstat: AK_ACTIVATE
    COUNTER2:
      curval: ANY_ALMVAL_A
      cstat: AK_CS_ERROR
    ALARM2:
      astat: AK_UNSET

  do_3:
    id: ERROR_HOOK1
    syssrv: CheckAssert(Error==E_OS_STATE)
    gcov: false

  post_condition_3:

  do_4:
    id: ERROR_HOOK1
    syssrv: CheckAssert(OSError_GetCounterValue_CounterID()==COUNTER1)
    gcov: false

  post_condition_4:

  do_5:
    id: ERROR_HOOK1
    syssrv: CheckAssert(OSErrorGetServiceId()==OSServiceId_IncrementCounter)
    gcov: false

  post_condition_5:

  do_6:
    id: ERROR_HOOK1
    syssrv: return
    gcov: false

  post_condition_6:
    ERROR_HOOK1:
      hookstat: AK_STOP
######################################################################
# IncrementCounter_err_al_incnt_0002.yaml
######################################################################
IncrementCounter_err_al_incnt_0002:
  property:
    sc: 
      - SC3
      - SC4

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      spolicy: AK_SCHFULL
      osap: ANY_OSAP_1
    TASK2:
      type: TASK
      tstat: SUSPENDED
      inipri: TSK_PRI_HIGH
      spolicy: AK_SCHFULL
      osap: ANY_OSAP_1
    ALARM1:
      type: ALARM
      almact: AK_ALM_ATSK
      counter: COUNTER1
      astat: AK_SET
      almval: ANY_ALMVAL_A
      cycle: 0
      task: TASK2
      osap: ANY_OSAP_1
    ALARM2:
      type: ALARM
      almact: AK_ALM_INCNT
      counter: COUNTER2
      astat: AK_SET
      almval: ANY_ALMVAL_A
      cycle: 0
      incounter: COUNTER1
      osap: ANY_OSAP_1
    COUNTER1:
      type: COUNTER
      ctype: AK_SOFTWARE
      mincyc: ANY_MINCYC_A
      maxval: ANY_MAXVAL_A
      curval: ANY_ALMVAL_A-1
      cstat: AK_CS_NULL
      osap: ANY_OSAP_1
    COUNTER2:
      type: COUNTER
      ctype: AK_SOFTWARE
      mincyc: ANY_MINCYC_A
      maxval: ANY_MAXVAL_A
      curval: ANY_ALMVAL_A-1
      cstat: AK_CS_NULL
      osap: ANY_OSAP_1
    ERROR_HOOK1:
      type: ERROR_HOOK
      hookstat: AK_STOP
      target_error_hook_cfg:
        - AK_ONLY_SYSTEM

  do_0:
    id: TASK1
    syssrv: IncrementCounter(COUNTER1)
    rettype: StatusType
    retval: E_OK
    gcov: false

  post_condition_0:
    TASK1:
      tstat: READY
    TASK2:
      tstat: RUNNING
      actcnt: 1
      curpri: TSK_PRI_HIGH
    COUNTER1:
      curval: ANY_ALMVAL_A
      cstat: AK_CS_DOING
    ALARM1:
      astat: AK_UNSET

  do_1:
    id: TASK2
    syssrv: IncrementCounter(COUNTER2)
    rettype: StatusType
    retval: E_OK
    gcov: true

  post_condition_1:
    ERROR_HOOK1:
      hookstat: AK_ACTIVATE
    COUNTER2:
      curval: ANY_ALMVAL_A
      cstat: AK_CS_ERROR
    ALARM2:
      astat: AK_UNSET

  do_2:
    id: ERROR_HOOK1
    syssrv: CheckAssert(Error==E_OS_STATE)
    gcov: false

  post_condition_2:

  do_3:
    id: ERROR_HOOK1
    syssrv: CheckAssert(OSError_GetCounterValue_CounterID()==COUNTER1)
    gcov: false

  post_condition_3:

  do_4:
    id: ERROR_HOOK1
    syssrv: CheckAssert(OSErrorGetServiceId()==OSServiceId_IncrementCounter)
    gcov: false

  post_condition_4:

  do_5:
    id: ERROR_HOOK1
    syssrv: return
    gcov: false

  post_condition_5:
    ERROR_HOOK1:
      hookstat: AK_STOP
######################################################################
