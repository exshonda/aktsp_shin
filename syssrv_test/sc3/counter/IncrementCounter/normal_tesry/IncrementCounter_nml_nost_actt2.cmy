IncrementCounter_nml_nost_actt2_0115:
  property:
    sc: 
      - SC3
      - SC4

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      inipri: TSK_PRI_MID
      curpri: TSK_PRI_MID
      ttype: AK_BASIC
      spolicy: AK_SCHFULL
      osap: TRUSTED_OSAP1
    TASK2:
      type: TASK
      tstat: READY
      curpri: TSK_PRI_LOW
      ttype: AK_BASIC
      maxact: ANY_BASIC_MAXACT
      actcnt: ANY_ACTCNT_NOT_MAX_1
      osap: NON_TRUSTED_OSAP1
    C2ISR1:
      type: C2ISR
      intno: INTNO_SELF_C2ISR_MID_A
      iniintpri: INT_PRI_MID
      rtnstat: AK_ACTIVATE
      osap: TRUSTED_OSAP1
    COUNTER1:
      type: COUNTER
      ctype: AK_HARDWARE
      curval: ANY_MAXVAL_A
      accosap:
        - NON_TRUSTED_OSAP1
    TASK3:
      type: TASK
      tstat: SUSPENDED
      inipri: TSK_PRI_HIGH
      osap: NON_TRUSTED_OSAP1
    SCHEDULE_TABLE1:
      type: SCHEDULE_TABLE
      counter: COUNTER1
      syncstrategy: AK_NONE
      repeat: ANY_SCDLTBLREL_REPEAT
      ststat: SCHEDULETABLE_RUNNING
      duration: ANY_SCDLTBL_DURATION_A
      curval: ANY_SCDLTBL_INIT_OFFSET_A-1
      expoint:
        ANY_SCDLTBL_INIT_OFFSET_A:
          acttsk:
            - TASK2
      osap: TRUSTED_OSAP1

  do_0:
    id: C2ISR1
    syssrv: AktspIncrementHardwareCounter(COUNTER1)
    gcov: true

  post_condition_0:
    TASK1:
      tstat: RUNNING
    TASK2:
      tstat: READY
      actcnt: ANY_ACTCNT_NOT_MAX_1+1
    COUNTER1:
      curval: 0
    SCHEDULE_TABLE1:
      curval: ANY_SCDLTBL_INIT_OFFSET_A

  do_1:
    id: C2ISR1
    syssrv: return
    gcov: false

  post_condition_1:
    TASK1:
      tstat: RUNNING
    TASK2:
      tstat: READY
      actcnt: ANY_ACTCNT_NOT_MAX_1+1
    C2ISR1:
      rtnstat: AK_STOP
