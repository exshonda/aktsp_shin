IncrementCounter_nml_nost_actt2_0761:
  property:
    sc: 
      - SC3
      - SC4

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      inipri: TSK_PRI_MID
      curpri: TSK_PRI_MID
      ttype: AK_BASIC
      spolicy: AK_SCHNON
      osap: TRUSTED_OSAP1
    TASK2:
      type: TASK
      tstat: READY
      curpri: TSK_PRI_HIGH
      ttype: AK_BASIC
      maxact: ANY_BASIC_MAXACT
      actcnt: 1
      osap: TRUSTED_OSAP2
    COUNTER1:
      type: COUNTER
      ctype: AK_HARDWARE
      curval: ANY_MAXVAL_A
      accosap:
        - NON_TRUSTED_OSAP1
    TASK3:
      type: TASK
      tstat: SUSPENDED
      inipri: TSK_PRI_HIGH
      osap: NON_TRUSTED_OSAP1
    SCHEDULE_TABLE1:
      type: SCHEDULE_TABLE
      counter: COUNTER1
      syncstrategy: AK_NONE
      repeat: ANY_SCDLTBLREL_REPEAT
      ststat: SCHEDULETABLE_RUNNING
      duration: ANY_SCDLTBL_DURATION_A
      curval: ANY_SCDLTBL_INIT_OFFSET_A-1
      expoint:
        ANY_SCDLTBL_INIT_OFFSET_A:
          acttsk:
            - TASK2
      osap: TRUSTED_OSAP1

  do:
    id: TASK1
    syssrv: AktspIncrementHardwareCounter(COUNTER1)

  post_condition:
    TASK1:
      tstat: RUNNING
    TASK2:
      tstat: READY
      actcnt: 2
    COUNTER1:
      curval: 0
    SCHEDULE_TABLE1:
      curval: ANY_SCDLTBL_INIT_OFFSET_A
