######################################################################
# IncrementCounter_nml_al_actt1_0001.yaml
######################################################################
IncrementCounter_nml_al_actt1_0001:
  property:
    sc: 
      - SC3
      - SC4

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      inipri: TSK_PRI_MID
      ttype: AK_BASIC
      actcnt: 1
      maxact: ANY_BASIC_MAXACT
      osap: TRUSTED_OSAP1
    C2ISR1:
      type: C2ISR
      intno: INTNO_SELF_C2ISR_MID_A
      iniintpri: INT_PRI_MID
      rtnstat: AK_ACTIVATE
      osap: TRUSTED_OSAP1
    ALARM1:
      type: ALARM
      almact: AK_ALM_ATSK
      counter: COUNTER1
      astat: AK_SET
      almval: ANY_CURVAL_NOT_MAX_A+1
      cycle: 0
      task: TASK1
      osap: TRUSTED_OSAP1
    COUNTER1:
      type: COUNTER
      ctype: AK_HARDWARE
      curval: ANY_CURVAL_NOT_MAX_A
      accosap:
        - NON_TRUSTED_OSAP1
    TASK3:
      type: TASK
      tstat: SUSPENDED
      inipri: TSK_PRI_HIGH
      osap: NON_TRUSTED_OSAP1

  do_0:
    id: C2ISR1
    syssrv: AktspIncrementHardwareCounter(COUNTER1)
    gcov: true

  post_condition_0:
    TASK1:
      tstat: RUNNING
      actcnt: 2
    COUNTER1:
      curval: ANY_CURVAL_NOT_MAX_A+1
    ALARM1:
      astat: AK_UNSET

  do_1:
    id: C2ISR1
    syssrv: return
    gcov: false

  post_condition_1:
    TASK1:
      tstat: RUNNING
      actcnt: 2
    C2ISR1:
      rtnstat: AK_STOP
