######################################################################
# IncrementCounter_nml_al_no_act_0001.yaml
######################################################################
IncrementCounter_nml_al_no_act_0001:
  property:
    sc: 
      - SC3
      - SC4

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      osap: TRUSTED_OSAP1
    TASK2:
      type: TASK
      tstat: SUSPENDED
      inipri: TSK_PRI_MID
      osap: TRUSTED_OSAP1
    C2ISR1:
      type: C2ISR
      intno: INTNO_SELF_C2ISR_MID_A
      iniintpri: INT_PRI_MID
      rtnstat: AK_ACTIVATE
      osap: TRUSTED_OSAP1
    ALARM1:
      type: ALARM
      almact: AK_ALM_ATSK
      counter: COUNTER1
      astat: AK_SET
      almval: ANY_MAXVAL_A
      cycle: 0
      task: TASK2
      osap: TRUSTED_OSAP1
    COUNTER1:
      type: COUNTER
      ctype: AK_HARDWARE
      curval: 0
      accosap:
        - NON_TRUSTED_OSAP1
    TASK3:
      type: TASK
      tstat: SUSPENDED
      inipri: TSK_PRI_HIGH
      osap: NON_TRUSTED_OSAP1

  do:
    id: C2ISR1
    syssrv: AktspIncrementHardwareCounter(COUNTER1)

  post_condition:
    COUNTER1:
      curval: 1
