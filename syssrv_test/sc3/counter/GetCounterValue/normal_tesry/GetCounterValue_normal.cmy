######################################################################
# GetCounterValue_normal_0001.yaml
######################################################################
GetCounterValue_normal_0001:
  property:
    sc: 
      - SC3
      - SC4

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      osap: TRUSTED_OSAP2
    C2ISR1:
      type: C2ISR
      iniintpri: INT_PRI_MID
      intno: INTNO_SELF_C2ISR_MID_C
      var:
        vname1:
          type: TickType
          global: true
      rtnstat: AK_ACTIVATE
      osap: TRUSTED_OSAP2
    COUNTER1:
      type: COUNTER
      ctype: AK_HARDWARE
      curval: 0
      accosap:
        - NON_TRUSTED_OSAP1
    TASK3:
      type: TASK
      tstat: SUSPENDED
      inipri: TSK_PRI_HIGH
      osap: NON_TRUSTED_OSAP1

  do:
    id: C2ISR1
    syssrv: GetCounterValue(COUNTER1,&vname1)
    rettype: StatusType
    retval: E_OK

  post_condition:
    C2ISR1:
      var:
        vname1:
          value: 0
