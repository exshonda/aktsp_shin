######################################################################
# GetCounterValue_normal_0007.yaml
######################################################################
GetCounterValue_normal_0007:
  property:
    sc: 
      - SC3
      - SC4

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      spolicy: AK_SCHFULL
      osap: TRUSTED_OSAP2
    TASK2:
      type: TASK
      tstat: SUSPENDED
      inipri: TSK_PRI_HIGH
      osap: TRUSTED_OSAP1
      accosap:
        - NON_TRUSTED_OSAP1
    C2ISR1:
      type: C2ISR
      iniintpri: INT_PRI_MID
      intno: INTNO_SELF_C2ISR_MID_C
      var:
        vname1:
          type: TickType
          global: true
      rtnstat: AK_STOP
      osap: TRUSTED_OSAP2
    ALARM1:
      type: ALARM
      almact: AK_ALM_ATSK
      counter: COUNTER1
      astat: AK_SET
      almval: 1
      cycle: 0
      task: TASK2
      osap: NON_TRUSTED_OSAP1
    COUNTER1:
      type: COUNTER
      ctype: AK_SOFTWARE
      mincyc: ANY_MINCYC_A
      maxval: ANY_MAXVAL_A
      curval: 0
      cstat: AK_CS_NULL
      osap: NON_TRUSTED_OSAP1

  do_0:
    id: TASK1
    syssrv: IncrementCounter(COUNTER1)
    rettype: StatusType
    retval: E_OK
    gcov: false

  post_condition_0:
    TASK1:
      tstat: READY
    TASK2:
      tstat: RUNNING
      actcnt: 1
      curpri: TSK_PRI_HIGH
    COUNTER1:
      curval: 1
      cstat: AK_CS_DOING
    ALARM1:
      astat: AK_UNSET

  do_1:
    id: TASK2
    syssrv: AktspRaiseInterrupt(INTNO_SELF_C2ISR_MID_C)
    gcov: false

  post_condition_1:
    C2ISR1:
      rtnstat: AK_ACTIVATE

  do_2:
    id: C2ISR1
    syssrv: GetCounterValue(COUNTER1,&vname1)
    rettype: StatusType
    retval: E_OK
    gcov: true

  post_condition_2:
    C2ISR1:
      var:
        vname1:
          value: 1
