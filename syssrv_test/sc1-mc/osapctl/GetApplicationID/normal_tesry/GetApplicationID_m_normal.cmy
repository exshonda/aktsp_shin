        - OSAP_SELF_CORE
        - OSAP_OTHER_OTHER_CORE

  do:
    id: TASK1
    syssrv: GetApplicationID()
    rettype: ApplicationType
    retval: OSAP_SELF_CORE

  post_condition:
######################################################################
