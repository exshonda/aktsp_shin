######################################################################
# CheckCounterOwnership_m_error_1_0001.yaml
######################################################################
CheckCounterOwnership_m_error_1_0001:
  property:
    sc: 
      - SC1
    extended_return_status: true

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      osap: OSAP_SELF_CORE
    TASK2:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      osap: OSAP_OTHER_OTHER_CORE
    COUNTER1:
      type: COUNTER
      ctype: AK_SOFTWARE
      mincyc: ANY_MINCYC_A
      maxval: ANY_MAXVAL_A
      curval: 0
      cstat: AK_CS_NULL
      osap: OSAP_OTHER_OTHER_CORE
    ALARM_CBACK1:
      type: ALARM_CBACK
      cbstat: AK_STOP
    ALARM1:
      type: ALARM
      almact: AK_ALM_CBACK
      counter: COUNTER2
      astat: AK_SET
      almval: 1
      cycle: 0
      callback: ALARM_CBACK1
      osap: OSAP_SELF_CORE
    COUNTER2:
      type: COUNTER
      ctype: AK_SOFTWARE
      mincyc: ANY_MINCYC_A
      maxval: ANY_MAXVAL_A
      curval: 0
      cstat: AK_CS_NULL
      osap: OSAP_SELF_CORE
    ERROR_HOOK1:
      type: ERROR_HOOK
      hookstat: AK_STOP
      target_error_hook_cfg:
        - AK_ONLY_SYSTEM
        - AK_BOTH
      coreid: CORE_SELF
      need_si:
        - NOS409
        - NOS411

  do_0:
    id: TASK1
    syssrv: IncrementCounter(COUNTER2)
    rettype: StatusType
    retval: E_OK
    gcov: false

  post_condition_0:
    COUNTER2:
      curval: 1
      cstat: AK_CS_DOING
    ALARM1:
      astat: AK_UNSET
    ALARM_CBACK1:
      cbstat: AK_ACTIVATE

  do_1:
    id: ALARM_CBACK1
    syssrv: CheckCounterOwnership(COUNTER1)
    rettype: ApplicationType
    retval: INVALID_OSAPPLICATION
    gcov: true

  post_condition_1:
    ALARM_CBACK1:
      cbstat: AK_STOP
      target_error_hook_cfg:
        - AK_ONLY_SYSTEM
        - AK_ONLY_OSAP
        - AK_BOTH
      need_si:
        - NOS409
        - NOS411
    ERROR_HOOK1:
      hookstat: AK_ACTIVATE

  do_2:
    id: ERROR_HOOK1
    syssrv: CheckAssert(Error==E_OS_CALLEVEL)
    gcov: false

  post_condition_2:

  do_3:
    id: ERROR_HOOK1
    syssrv: CheckAssert(OSError_CheckCounterOwnership_CounterID()==COUNTER1)
    gcov: false

  post_condition_3:

  do_4:
    id: ERROR_HOOK1
    syssrv: CheckAssert(OSErrorGetServiceId()==OSServiceId_CheckCounterOwnership)
    gcov: false

  post_condition_4:

  do_5:
    id: ERROR_HOOK1
    syssrv: return
    gcov: false

  post_condition_5:
    ALARM_CBACK1:
      cbstat: AK_ACTIVATE
      target_error_hook_cfg:
        - AK_ONLY_SYSTEM
    ERROR_HOOK1:
      hookstat: AK_STOP
