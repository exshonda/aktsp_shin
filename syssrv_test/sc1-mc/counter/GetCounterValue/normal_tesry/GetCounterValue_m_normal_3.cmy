######################################################################
# GetCounterValue_m_normal_3_0001.yaml
######################################################################
GetCounterValue_m_normal_3_0001:
  property:
    sc: 
      - SC1
      - SC2

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      spolicy: AK_SCHFULL
      osap: OSAP_SELF_CORE
    TASK2:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      osap: OSAP_OTHER_OTHER_CORE
    C2ISR1:
      type: C2ISR
      intno: INTNO_OTHER_ISR2_C
      iniintpri: INT_PRI_MID
      var:
        vname1:
          type: TickType
      rtnstat: AK_ACTIVATE
      osap: OSAP_OTHER_OTHER_CORE
    COUNTER1:
      type: COUNTER
      ctype: AK_HARDWARE
      curval: 0
    INT_STATE1:
      type: INT_STATE
      istat:
        - AK_DIS_ALL_INT: TASK1
      coreid: CORE_SELF

  do:
    id: C2ISR1
    syssrv: GetCounterValue(COUNTER1,&vname1)
    rettype: StatusType
    retval: E_OK

  post_condition:
    C2ISR1:
      var:
        vname1:
          value: 0
