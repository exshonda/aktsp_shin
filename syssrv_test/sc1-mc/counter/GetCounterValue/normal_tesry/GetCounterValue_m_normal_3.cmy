######################################################################
# GetCounterValue_m_normal_3_0016.yaml
######################################################################
GetCounterValue_m_normal_3_0016:
  property:
    sc: 
      - SC1
      - SC2

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      spolicy: AK_SCHFULL
      osap: OSAP_SELF_CORE
    TASK2:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      osap: OSAP_OTHER_OTHER_CORE
    TASK3:
      type: TASK
      tstat: SUSPENDED
      inipri: TSK_PRI_HIGH
      osap: OSAP_SELF_CORE
    C2ISR1:
      type: C2ISR
      intno: INTNO_OTHER_ISR2_C
      iniintpri: INT_PRI_MID
      var:
        vname1:
          type: TickType
      rtnstat: AK_ACTIVATE
      osap: OSAP_OTHER_OTHER_CORE
    ALARM1:
      type: ALARM
      almact: AK_ALM_ATSK
      counter: COUNTER1
      astat: AK_SET
      almval: 1
      cycle: 0
      task: TASK3
      osap: OSAP_SELF_CORE
    COUNTER1:
      type: COUNTER
      ctype: AK_SOFTWARE
      mincyc: ANY_MINCYC_A
      maxval: ANY_MAXVAL_A
      curval: 0
      cstat: AK_CS_NULL
      osap: OSAP_SELF_CORE
    INT_STATE1:
      type: INT_STATE
      istat:
      coreid: CORE_SELF

  do_0:
    id: TASK1
    syssrv: IncrementCounter(COUNTER1)
    rettype: StatusType
    retval: E_OK
    gcov: false

  post_condition_0:
    TASK1:
      tstat: READY
    TASK3:
      tstat: RUNNING
      actcnt: 1
      curpri: TSK_PRI_HIGH
    COUNTER1:
      curval: 1
      cstat: AK_CS_DOING
    ALARM1:
      astat: AK_UNSET

  do_1:
    id: TASK3
    syssrv: DisableAllInterrupts()
    gcov: false

  post_condition_1:
    INT_STATE1:
      istat:
        - AK_DIS_ALL_INT: TASK3

  do_2:
    id: C2ISR1
    syssrv: GetCounterValue(COUNTER1,&vname1)
    rettype: StatusType
    retval: E_OK
    gcov: true

  post_condition_2:
    C2ISR1:
      var:
        vname1:
          value: 1
######################################################################
# GetCounterValue_m_normal_3_0017.yaml
######################################################################
GetCounterValue_m_normal_3_0017:
  property:
    sc: 
