    TASK3:
      type: TASK
      tstat: SUSPENDED
      inipri: TSK_PRI_HIGH
      osap: OSAP_SELF_CORE
    C2ISR1:
      type: C2ISR
      intno: INTNO_OTHER_ISR2_C
      iniintpri: INT_PRI_MID
      rtnstat: AK_ACTIVATE
      var:
        vname1:
          type: TickType
          value: 0
        vname2:
          type: TickType
      osap: OSAP_OTHER_OTHER_CORE
    COUNTER1:
      type: COUNTER
      ctype: AK_HARDWARE
      curval: 0
    INT_STATE1:
      type: INT_STATE
      istat:
        - AK_DIS_ALL_INT: TASK1
      coreid: CORE_SELF

  do:
    id: C2ISR1
    syssrv: GetElapsedValue(COUNTER1,&vname1,&vname2)
    rettype: StatusType
    retval: E_OK

  post_condition:
    C2ISR1:
      var:
        vname1:
          value: 0
        vname2:
