######################################################################
# IncrementCounter_m_n_al_set_e_0001.yaml
######################################################################
IncrementCounter_m_n_al_set_e_0001:
  property:
    sc: 
      - SC1
      - SC2

  pre_condition:
    TASK3:
      type: TASK
      tstat: RUNNING
      inipri: TSK_PRI_MID
      osap: OSAP_SELF_CORE
    TASK1:
      type: TASK
      tstat: RUNNING
      ttype: ANY_TTYPE
      spolicy: AK_SCHFULL
      inipri: TSK_PRI_MID
      curpri: TSK_PRI_HIGH
      relres:
        - RESOURCE1
      getres:
        - RESOURCE1
      osap: OSAP_OTHER_OTHER_CORE
    TASK2:
      type: TASK
      tstat: READY
      spolicy: AK_SCHFULL
      curpri: TSK_PRI_HIGH
      ttype: AK_EXTENDED
      curevt: 0
      relevt:
        - EVENT1
      relres:
        - RESOURCE1
      osap: OSAP_OTHER_OTHER_CORE
    C2ISR1:
      type: C2ISR
      intno: INTNO_SELF_C2ISR_MID_A
      iniintpri: INT_PRI_MID
      rtnstat: AK_ACTIVATE
      osap: OSAP_SELF_CORE
    EVENT1:
      type: EVENT
      mask: EVENTMASK_A
    RESOURCE1:
      type: RESOURCE
      resprop: AK_INTERNAL
      lockflg: AK_LOCK
    ALARM1:
      type: ALARM
      almact: AK_ALM_SEVT
      counter: COUNTER1
      astat: AK_SET
      almval: ANY_CURVAL_NOT_MAX_A+1
      cycle: 0
      event: EVENT1
      task: TASK2
      osap: OSAP_SELF_CORE
    COUNTER1:
      type: COUNTER
      ctype: AK_HARDWARE
      curval: ANY_CURVAL_NOT_MAX_A

  do_0:
    id: C2ISR1
    syssrv: AktspIncrementHardwareCounter(COUNTER1)
    gcov: true

  post_condition_0:
    TASK1:
      tstat: RUNNING
    TASK2:
      tstat: READY
      curevt: EVENT1
    COUNTER1:
      curval: ANY_CURVAL_NOT_MAX_A+1
    ALARM1:
      astat: AK_UNSET

  do_1:
    id: C2ISR1
    syssrv: return
    gcov: false

  post_condition_1:
    TASK1:
      tstat: RUNNING
    TASK2:
      tstat: READY
      curevt: EVENT1
    C2ISR1:
      rtnstat: AK_STOP
