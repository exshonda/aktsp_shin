IncrementCounter_m_n_al_set_e_0218:
  property:
    sc: 
      - SC1
      - SC2

  pre_condition:
    TASK3:
      type: TASK
      tstat: RUNNING
      inipri: TSK_PRI_MID
      osap: OSAP_SELF_CORE
    TASK1:
      type: TASK
      tstat: RUNNING
      ttype: ANY_TTYPE
      spolicy: AK_SCHNON
      curpri: TSK_PRI_MID
      osap: OSAP_OTHER_OTHER_CORE
    TASK2:
      type: TASK
      tstat: WAITING
      curpri: TSK_PRI_HIGH
      ttype: AK_EXTENDED
      curevt: 0
      waievt: EVENT1
      relevt:
        - EVENT1
      osap: OSAP_OTHER_OTHER_CORE
    EVENT1:
      type: EVENT
      mask: EVENTMASK_A
    ALARM1:
      type: ALARM
      almact: AK_ALM_SEVT
      counter: COUNTER1
      astat: AK_SET
      almval: ANY_CURVAL_NOT_MAX_A+1
      cycle: 0
      event: EVENT1
      task: TASK2
      osap: OSAP_SELF_CORE
    COUNTER1:
      type: COUNTER
      ctype: AK_SOFTWARE
      mincyc: ANY_MINCYC_A
      maxval: ANY_MAXVAL_A
      curval: ANY_CURVAL_NOT_MAX_A
      cstat: AK_CS_NULL
      osap: OSAP_SELF_CORE

  do:
    id: TASK3
    syssrv: IncrementCounter(COUNTER1)
    rettype: StatusType
    retval: E_OK

  post_condition:
    TASK1:
      tstat: RUNNING
    TASK2:
      tstat: READY
      curevt: EVENT1
    COUNTER1:
      curval: ANY_CURVAL_NOT_MAX_A+1
    ALARM1:
      astat: AK_UNSET
