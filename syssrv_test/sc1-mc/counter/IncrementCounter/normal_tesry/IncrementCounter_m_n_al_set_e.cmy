IncrementCounter_m_n_al_set_e_0149:
  property:
    sc: 
      - SC1
      - SC2

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      ttype: ANY_TTYPE
      spolicy: AK_SCHNON
      curpri: TSK_PRI_MID
      osap: OSAP_SELF_CORE
    TASK2:
      type: TASK
      tstat: READY
      curpri: TSK_PRI_HIGH
      ttype: AK_EXTENDED
      curevt: 0
      relevt:
        - EVENT1
      osap: OSAP_OTHER_SAME_CORE
    EVENT1:
      type: EVENT
      mask: EVENTMASK_A
    ALARM1:
      type: ALARM
      almact: AK_ALM_SEVT
      counter: COUNTER1
      astat: AK_SET
      almval: ANY_CURVAL_NOT_MAX_A+1
      cycle: 0
      event: EVENT1
      task: TASK2
      osap: OSAP_SELF_CORE
    COUNTER1:
      type: COUNTER
      ctype: AK_HARDWARE
      curval: ANY_CURVAL_NOT_MAX_A

  do:
    id: TASK1
    syssrv: AktspIncrementHardwareCounter(COUNTER1)

  post_condition:
    TASK1:
      tstat: RUNNING
    TASK2:
      tstat: READY
      curevt: EVENT1
    COUNTER1:
      curval: ANY_CURVAL_NOT_MAX_A+1
    ALARM1:
      astat: AK_UNSET
