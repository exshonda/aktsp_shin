######################################################################
# IncrementCounter_m_n_al_no_act_0001.yaml
######################################################################
IncrementCounter_m_n_al_no_act_0001:
  property:
    sc: 
      - SC1
      - SC2

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      osap: OSAP_OTHER_SAME_CORE
    TASK2:
      type: TASK
      tstat: SUSPENDED
      inipri: TSK_PRI_MID
      osap: OSAP_SELF_CORE
    C2ISR1:
      type: C2ISR
      iniintpri: INT_PRI_MID
      intno: INTNO_SELF_C2ISR_MID_C
      rtnstat: AK_ACTIVATE
      osap: OSAP_OTHER_SAME_CORE
    ALARM1:
      type: ALARM
      almact: AK_ALM_ATSK
      counter: COUNTER1
      astat: AK_SET
      almval: ANY_MAXVAL_A
      cycle: 0
      task: TASK2
      osap: OSAP_SELF_CORE
    COUNTER1:
      type: COUNTER
      ctype: AK_HARDWARE
      curval: 0

  do:
    id: C2ISR1
    syssrv: AktspIncrementHardwareCounter(COUNTER1)

  post_condition:
    COUNTER1:
      curval: 1
