######################################################################
# IncrementCounter_m_n_al_incnt_0001.yaml
######################################################################
IncrementCounter_m_n_al_incnt_0001:
  property:
    sc: 
      - SC1
      - SC2

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      osap: OSAP_OTHER_SAME_CORE
    C2ISR1:
      type: C2ISR
      iniintpri: INT_PRI_MID
      intno: INTNO_SELF_C2ISR_MID_C
      rtnstat: AK_ACTIVATE
      osap: OSAP_OTHER_SAME_CORE
    ALARM1:
      type: ALARM
      almact: AK_ALM_INCNT
      counter: COUNTER1
      astat: AK_SET
      almval: ANY_CURVAL_NOT_MAX_A+1
      cycle: 0
      incounter: COUNTER2
      osap: OSAP_SELF_CORE
    COUNTER1:
      type: COUNTER
      ctype: AK_HARDWARE
      curval: ANY_CURVAL_NOT_MAX_A
    COUNTER2:
      type: COUNTER
      ctype: AK_SOFTWARE
      mincyc: ANY_MINCYC_B
      maxval: ANY_MAXVAL_B
      curval: 0
      cstat: AK_CS_NULL
      osap: OSAP_SELF_CORE

  do:
    id: C2ISR1
    syssrv: AktspIncrementHardwareCounter(COUNTER1)

  post_condition:
    ALARM1:
      astat: AK_UNSET
    COUNTER1:
      curval: ANY_CURVAL_NOT_MAX_A+1
    COUNTER2:
      curval: 1
