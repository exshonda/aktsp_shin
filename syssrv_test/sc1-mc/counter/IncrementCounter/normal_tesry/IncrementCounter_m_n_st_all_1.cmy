######################################################################
# IncrementCounter_m_n_st_all_1_0001.yaml
######################################################################
IncrementCounter_m_n_st_all_1_0001:
  property:
    sc: 
      - SC1
      - SC2

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      osap: OSAP_SELF_CORE
    TASK2:
      type: TASK
      tstat: SUSPENDED
      inipri: TSK_PRI_LOW
      osap: OSAP_OTHER_SAME_CORE
    TASK3:
      type: TASK
      tstat: SUSPENDED
      inipri: TSK_PRI_BOTTOM
      osap: OSAP_OTHER_SAME_CORE
    C2ISR1:
      type: C2ISR
      iniintpri: INT_PRI_MID
      intno: INTNO_SELF_C2ISR_MID_A
      rtnstat: AK_ACTIVATE
      osap: OSAP_SELF_CORE
    SCHEDULE_TABLE1:
      type: SCHEDULE_TABLE
      counter: COUNTER1
      syncstrategy: AK_IMPLICIT
      repeat: ANY_SCDLTBLREL_REPEAT
      ststat: SCHEDULETABLE_RUNNING_AND_SYNCHRONOUS
      duration: ANY_MAXVAL_A+1
      curval: ANY_SCDLTBL_INIT_OFFSET_A-1
      expoint:
        ANY_SCDLTBL_INIT_OFFSET_A:
          acttsk:
            - TASK2
            - TASK3
      osap: OSAP_SELF_CORE
    COUNTER1:
      type: COUNTER
      ctype: AK_HARDWARE
      curval: 0

  do:
    id: C2ISR1
    syssrv: AktspIncrementHardwareCounter(COUNTER1)

  post_condition:
    COUNTER1:
      curval: 1
    SCHEDULE_TABLE1:
      curval: ANY_SCDLTBL_INIT_OFFSET_A
    TASK2:
      tstat: READY
      actcnt: 1
      curpri: TSK_PRI_LOW
    TASK3:
      tstat: READY
      actcnt: 1
      curpri: TSK_PRI_BOTTOM
