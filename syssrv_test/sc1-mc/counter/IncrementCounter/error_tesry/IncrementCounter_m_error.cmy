      osap: OSAP_SELF_CORE
    ERROR_HOOK1:
      type: ERROR_HOOK
      hookstat: AK_STOP
      target_error_hook_cfg:
        - AK_ONLY_SYSTEM
        - AK_BOTH
      coreid: CORE_SELF
    INT_STATE1:
      type: INT_STATE
      istat:
        - AK_SUS_ALL_INT: SPINLOCK1
      coreid: CORE_SELF
    SPINLOCK1:
      type: SPINLOCK
      susint: AK_SUS_ALL_SPN
      lockflg: AK_LOCK
      accosap:
        - OSAP_SELF_CORE
        - OSAP_OTHER_OTHER_CORE

  do_0:
    id: C2ISR1
    syssrv: IncrementCounter(COUNTER1)
    rettype: StatusType
    retval: E_OS_DISABLEDINT
    gcov: false

  post_condition_0:
    C2ISR1:
      rtnstat: AK_STOP
    ERROR_HOOK1:
      hookstat: AK_ACTIVATE

  do_1:
    id: ERROR_HOOK1
