    gcov: false

  post_condition_1:

  do_2:
    id: ERROR_HOOK1
    syssrv: CheckAssert(OSError_GetCounterValue_CounterID()==COUNTER1)
    gcov: false

  post_condition_2:

  do_3:
    id: ERROR_HOOK1
    syssrv: CheckAssert(OSErrorGetServiceId()==OSServiceId_IncrementCounter)
    gcov: false

  post_condition_3:

  do_4:
    id: ERROR_HOOK1
    syssrv: return
    gcov: false

  post_condition_4:
    C2ISR1:
      rtnstat: AK_ACTIVATE
    ERROR_HOOK1:
      hookstat: AK_STOP
