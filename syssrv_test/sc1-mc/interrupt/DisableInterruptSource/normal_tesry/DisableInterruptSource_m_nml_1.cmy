######################################################################
# DisableInterruptSource_m_nml_1_0001.yaml
######################################################################
DisableInterruptSource_m_nml_1_0001:
  property:
    sc: 
      - SC1
    need_enadis_interrupt_source: true

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
    C2ISR1:
      type: C2ISR
      intno: INTNO_SELF_C2ISR_MID_A
      iniintpri: INT_PRI_MID
      rtnstat: AK_ACTIVATE
      istat: AK_DISABLE
      getspn:
        - SPINLOCK1
    INT_STATE1:
      type: INT_STATE
      istat:
        - AK_SUS_ALL_INT: SPINLOCK1
    SPINLOCK1:
      type: SPINLOCK
      susint: AK_SUS_ALL_SPN
      lockflg: AK_LOCK
      accosap:
        - OSAP_SELF_CORE
        - OSAP_OTHER_OTHER_CORE

  do:
    id: C2ISR1
    syssrv: DisableInterruptSource(C2ISR1)
    rettype: StatusType
    retval: E_OK

  post_condition:
    C2ISR1:
      istat: AK_DISABLE
