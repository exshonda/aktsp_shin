        - OSAP_OTHER_OTHER_CORE

  do_0:
    id: TASK1
    syssrv: DisableInterruptSource(C2ISR1)
    rettype: StatusType
    retval: E_OK
    gcov: true

  post_condition_0:
    C2ISR1:
      istat: AK_DISABLE

  do_1:
    id: TASK1
    syssrv: GetSpinlock(SPINLOCK2)
    rettype: StatusType
    retval: E_OK
    gcov: false

  post_condition_1:
    TASK1:
      getspn:
        - SPINLOCK2
    INT_STATE1:
      istat:
        - AK_SUS_OS_INT: SPINLOCK2
    SPINLOCK2:
      lockflg: AK_LOCK

  do_2:
    id: TASK1
    syssrv: AktspRaiseInterrupt(INTNO_SELF_C2ISR_MID_D)
    gcov: false

  post_condition_2:

  do_3:
    id: TASK1
    syssrv: ReleaseSpinlock(SPINLOCK2)
    rettype: StatusType
    retval: E_OK
    gcov: false

  post_condition_3:
    TASK1:
      getspn:
    INT_STATE1:
      istat:
    SPINLOCK2:
      lockflg: AK_UNLOCK

  do_4:
    id: TASK1
    syssrv: EnableInterruptSource(C2ISR1)
    rettype: StatusType
    retval: E_OK
    gcov: false

  post_condition_4:
    C2ISR1:
      rtnstat: AK_ACTIVATE
      istat: AK_ENABLE
######################################################################
