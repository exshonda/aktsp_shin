######################################################################
# EnableInterruptSource_m_nml_1_0001.yaml
######################################################################
EnableInterruptSource_m_nml_1_0001:
  property:
    sc: 
      - SC1
    need_enadis_interrupt_source: true

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
    C2ISR1:
      type: C2ISR
      intno: INTNO_SELF_C2ISR_MID_A
      iniintpri: INT_PRI_MID
      rtnstat: AK_ACTIVATE
      osap: OSAP_SELF_CORE
      getspn:
        - SPINLOCK1
    C2ISR2:
      type: C2ISR
      intno: INTNO_SELF_C2ISR_HIGH
      iniintpri: INT_PRI_HIGH
      rtnstat: AK_STOP
      osap: OSAP_SELF_CORE
    INT_STATE1:
      type: INT_STATE
      istat:
        - AK_SUS_ALL_INT: SPINLOCK1
      coreid: CORE_SELF
    SPINLOCK1:
      type: SPINLOCK
      susint: AK_SUS_ALL_SPN
      lockflg: AK_LOCK
      accosap:
        - OSAP_SELF_CORE
        - OSAP_OTHER_OTHER_CORE

  do_0:
    id: C2ISR1
    syssrv: AktspRaiseInterrupt(INTNO_SELF_C2ISR_HIGH)
    gcov: false

  post_condition_0:

  do_1:
    id: C2ISR1
    syssrv: DisableInterruptSource(C2ISR2)
    rettype: StatusType
    retval: E_OK
    gcov: false

  post_condition_1:
    C2ISR2:
      istat: AK_DISABLE

  do_2:
    id: C2ISR1
    syssrv: EnableInterruptSource(C2ISR2)
    rettype: StatusType
    retval: E_OK
    gcov: false

  post_condition_2:
    C2ISR2:
      istat: AK_ENABLE

  do_3:
    id: C2ISR1
    syssrv: ReleaseSpinlock(SPINLOCK1)
    rettype: StatusType
    retval: E_OK
    gcov: false

  post_condition_3:
    C2ISR1:
      rtnstat: AK_STOP
      getspn:
    C2ISR2:
      rtnstat: AK_ACTIVATE
      istat: AK_ENABLE
    INT_STATE1:
      istat:
    SPINLOCK1:
      lockflg: AK_UNLOCK
