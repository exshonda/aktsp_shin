######################################################################
# GetISRID_m_normal_1_0001.yaml
######################################################################
GetISRID_m_normal_1_0001:
  property:
    sc: 
      - SC1
      - SC2

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      osap: OSAP_SELF_CORE
    C2ISR1:
      type: C2ISR
      intno: INTNO_SELF_C2ISR_MID_C
      iniintpri: INT_PRI_MID
      rtnstat: AK_STOP
      osap: OSAP_OTHER_SAME_CORE

  do:
    id: TASK1
    syssrv: GetISRID()
    rettype: ISRType
    retval: INVALID_ISR

  post_condition:
######################################################################
# GetISRID_m_normal_1_0002.yaml
######################################################################
GetISRID_m_normal_1_0002:
  property:
    sc: 
      - SC1
      - SC2

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      getspn:
        - SPINLOCK1
      osap: OSAP_SELF_CORE
    C2ISR1:
      type: C2ISR
      intno: INTNO_SELF_C2ISR_MID_C
      iniintpri: INT_PRI_MID
      rtnstat: AK_STOP
      osap: OSAP_OTHER_SAME_CORE
    SPINLOCK1:
      type: SPINLOCK
      susint: AK_SUS_ALL_SPN
      lockflg: AK_LOCK
      accosap:
        - OSAP_SELF_CORE
        - OSAP_OTHER_OTHER_CORE
    INT_STATE1:
      type: INT_STATE
      istat:
        - AK_SUS_ALL_INT: SPINLOCK1
      coreid: CORE_SELF

  do:
    id: TASK1
    syssrv: GetISRID()
    rettype: ISRType
    retval: INVALID_ISR

  post_condition:
######################################################################
# GetISRID_m_normal_1_0003.yaml
######################################################################
GetISRID_m_normal_1_0003:
  property:
    sc: 
      - SC1
      - SC2

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      getspn:
        - SPINLOCK1
      osap: OSAP_SELF_CORE
    C2ISR1:
      type: C2ISR
      intno: INTNO_SELF_C2ISR_MID_C
      iniintpri: INT_PRI_MID
      rtnstat: AK_STOP
      osap: OSAP_OTHER_SAME_CORE
    SPINLOCK1:
      type: SPINLOCK
      susint: AK_SUS_OS_SPN
      lockflg: AK_LOCK
      accosap:
        - OSAP_SELF_CORE
        - OSAP_OTHER_OTHER_CORE
    INT_STATE1:
      type: INT_STATE
      istat:
        - AK_SUS_OS_INT: SPINLOCK1
      coreid: CORE_SELF

  do:
    id: TASK1
    syssrv: GetISRID()
    rettype: ISRType
    retval: INVALID_ISR

  post_condition:
######################################################################
