######################################################################
# EnableAllInterrupts_m_nml_1_b_0001.yaml
######################################################################
EnableAllInterrupts_m_nml_1_b_0001:
  property:
    sc: 
      - SC1
      - SC2

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      osap: OSAP_SELF_CORE
    C2ISR1:
      type: C2ISR
      intno: INTNO_SELF_C2ISR_MID_A
      iniintpri: INT_PRI_MID
      rtnstat: AK_ACTIVATE
      osap: OSAP_SELF_CORE
      getspn:
        - SPINLOCK2
    INT_STATE1:
      type: INT_STATE
      istat:
        - AK_SUS_ALL_INT: C2ISR1
        - AK_SUS_ALL_INT: SPINLOCK2
      coreid: CORE_SELF
    SPINLOCK2:
      type: SPINLOCK
      susint: AK_SUS_ALL_SPN
      lockflg: AK_LOCK
      accosap:
        - OSAP_SELF_CORE
        - OSAP_OTHER_OTHER_CORE
    TASK4:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      osap: OSAP_OTHER_OTHER_CORE
    C2ISR3:
      type: C2ISR
      intno: INTNO_OTHER_ISR2_C
      iniintpri: INT_PRI_MID
      rtnstat: AK_ACTIVATE
      osap: OSAP_OTHER_OTHER_CORE
    INT_STATE2:
      type: INT_STATE
      istat:
        - AK_DIS_ALL_INT: C2ISR3
      coreid: CORE_OTHER

  do:
    id: C2ISR1
    syssrv: EnableAllInterrupts()

  post_condition:
    INT_STATE1:
      istat:
        - AK_SUS_ALL_INT: C2ISR1
        - AK_SUS_ALL_INT: SPINLOCK2
