######################################################################
# ResumeOSInterrupts_m_nml_1_c_0001.yaml
######################################################################
ResumeOSInterrupts_m_nml_1_c_0001:
  property:
    sc: 
      - SC1
      - SC2

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      osap: OSAP_SELF_CORE
    C2ISR1:
      type: C2ISR
      intno: INTNO_SELF_C2ISR_MID_A
      iniintpri: INT_PRI_MID
      rtnstat: AK_ACTIVATE
      osap: OSAP_SELF_CORE
      getspn:
        - SPINLOCK1
    INT_STATE1:
      type: INT_STATE
      istat:
        - AK_SUS_ALL_INT: SPINLOCK1
        - AK_SUS_OS_INT: C2ISR1
      coreid: CORE_SELF
    SPINLOCK1:
      type: SPINLOCK
      susint: AK_SUS_ALL_SPN
      lockflg: AK_LOCK
      accosap:
        - OSAP_SELF_CORE
        - OSAP_OTHER_OTHER_CORE

  do_0:
    id: C2ISR1
    syssrv: ResumeOSInterrupts()
    gcov: true

  post_condition_0:
    INT_STATE1:
      istat:
        - AK_SUS_ALL_INT: SPINLOCK1
