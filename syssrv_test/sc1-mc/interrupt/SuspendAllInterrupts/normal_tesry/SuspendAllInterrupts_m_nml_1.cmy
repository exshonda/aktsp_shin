      - SC2

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      osap: OSAP_SELF_CORE
    INT_STATE1:
      type: INT_STATE
      istat:
        - AK_SUS_OS_INT: TASK1
        - AK_SUS_OS_INT: TASK1
      coreid: CORE_SELF
    TASK4:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      osap: OSAP_OTHER_OTHER_CORE
    C2ISR3:
      type: C2ISR
      intno: INTNO_OTHER_ISR2_C
      iniintpri: INT_PRI_MID
      rtnstat: AK_STOP
      osap: OSAP_OTHER_OTHER_CORE
    INT_STATE2:
      type: INT_STATE
      istat:
      coreid: CORE_OTHER

  do_0:
    id: TASK1
    syssrv: SuspendAllInterrupts()
    gcov: true

  post_condition_0:
    INT_STATE1:
      istat:
        - AK_SUS_OS_INT: TASK1
        - AK_SUS_OS_INT: TASK1
        - AK_SUS_ALL_INT: TASK1
    INT_STATE2:
      istat:

  do_1:
    id: TASK4
    syssrv: AktspRaiseInterrupt(INTNO_OTHER_ISR2_C)
    gcov: false

  post_condition_1:
    C2ISR3:
      rtnstat: AK_ACTIVATE
######################################################################
