######################################################################
# SuspendAllInterrupts_m_nml_1_0001.yaml
######################################################################
SuspendAllInterrupts_m_nml_1_0001:
  property:
    sc: 
      - SC1

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      osap: OSAP_SELF_CORE
    ALARM_CBACK1:
      type: ALARM_CBACK
      cbstat: AK_STOP
    ALARM1:
      type: ALARM
      almact: AK_ALM_CBACK
      counter: COUNTER1
      astat: AK_SET
      almval: 1
      cycle: 0
      callback: ALARM_CBACK1
      osap: OSAP_SELF_CORE
    COUNTER1:
      type: COUNTER
      ctype: AK_SOFTWARE
      mincyc: ANY_MINCYC_A
      maxval: ANY_MAXVAL_A
      curval: 0
      cstat: AK_CS_NULL
      osap: OSAP_SELF_CORE
    INT_STATE1:
      type: INT_STATE
      istat:
      coreid: CORE_SELF
    TASK4:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      osap: OSAP_OTHER_OTHER_CORE
    C1ISR3:
      type: C1ISR
      intno: INTNO_OTHER_ISR1_A 
      iniintpri: INT_PRI_ISR1_MID
      rtnstat: AK_STOP
      osap: OSAP_OTHER_OTHER_CORE
    INT_STATE2:
      type: INT_STATE
      istat:
      coreid: CORE_OTHER

  do_0:
    id: TASK1
    syssrv: IncrementCounter(COUNTER1)
    rettype: StatusType
    retval: E_OK
    gcov: false

  post_condition_0:
    COUNTER1:
      curval: 1
      cstat: AK_CS_DOING
    ALARM1:
      astat: AK_UNSET
    ALARM_CBACK1:
      cbstat: AK_ACTIVATE

  do_1:
    id: ALARM_CBACK1
    syssrv: SuspendAllInterrupts()
    gcov: true

  post_condition_1:
    INT_STATE1:
      istat:
        - AK_SUS_ALL_INT: ALARM_CBACK1
    INT_STATE2:
      istat:

  do_2:
    id: TASK4
    syssrv: AktspRaiseInterrupt(INTNO_OTHER_ISR1_A)
    gcov: false

  post_condition_2:
    C1ISR3:
      rtnstat: AK_ACTIVATE

  do_3:
    id: ALARM_CBACK1
    syssrv: ResumeAllInterrupts()
    gcov: false

  post_condition_3:
    INT_STATE1:
      istat:
    INT_STATE2:
      istat:
