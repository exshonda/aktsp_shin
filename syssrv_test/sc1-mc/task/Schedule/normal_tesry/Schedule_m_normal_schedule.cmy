    TASK3:
      type: TASK
      tstat: READY
      curpri: TSK_PRI_HIGH
      spolicy: AK_SCHNON
      ttype: AK_BASIC
      porder: 2
      osap: OSAP_OTHER_SAME_CORE

  do:
    id: TASK1
    syssrv: Schedule()
    rettype: StatusType
