######################################################################
# GetTaskID_m_normal_1_0001.yaml
######################################################################
GetTaskID_m_normal_1_0001:
  property:
    sc: 
      - SC1
      - SC2

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      spolicy: ANY_SPOLICY
      osap: OSAP_OTHER_SAME_CORE
    C2ISR1:
      type: C2ISR
      intno: INTNO_SELF_C2ISR_MID_A
      iniintpri: INT_PRI_MID
      rtnstat: AK_ACTIVATE
      var:
        vname1:
          type: TaskType
      osap: OSAP_SELF_CORE
    INT_STATE1:
      type: INT_STATE
      istat:
      coreid: CORE_SELF

  do:
    id: C2ISR1
    syssrv: GetTaskID(&vname1)
    rettype: StatusType
    retval: E_OK
    gcov: true

  post_condition:
    C2ISR1:
      var:
        vname1:
          value: TASK1
