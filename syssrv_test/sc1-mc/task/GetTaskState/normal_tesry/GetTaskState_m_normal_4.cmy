######################################################################
# GetTaskState_m_normal_4_0001.yaml
######################################################################
GetTaskState_m_normal_4_0001:
  property:
    sc: 
      - SC1
      - SC2

  pre_condition:
    TASK1:
      type: TASK
      tstat: SUSPENDED
      inipri: TSK_PRI_MID
      spolicy: ANY_SPOLICY
      osap: OSAP_OTHER_OTHER_CORE
    TASK2:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      ttype: AK_BASIC
      spolicy: ANY_SPOLICY
      maxact: ANY_BASIC_MAXACT
      actcnt: ANY_ACTCNT_NOT_MAX_1
      osap: OSAP_OTHER_OTHER_CORE
    TASK3:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      ttype: AK_BASIC
      spolicy: ANY_SPOLICY
      osap: OSAP_SELF_CORE
    C2ISR1:
      type: C2ISR
      intno: INTNO_SELF_C2ISR_MID_A
      iniintpri: INT_PRI_MID
      rtnstat: AK_ACTIVATE
      var:
        vname1:
          type: TaskStateType
      osap: OSAP_SELF_CORE

  do_0:
    id: C2ISR1
    syssrv: GetTaskState(TASK2,&vname1)
    rettype: StatusType
    retval: E_OK
    gcov: true

  post_condition_0:
    C2ISR1:
      var:
        vname1:
          value: RUNNING

  do_1:
    id: C2ISR1
    syssrv: return
    gcov: false

  post_condition_1:
    C2ISR1:
      rtnstat: AK_STOP
