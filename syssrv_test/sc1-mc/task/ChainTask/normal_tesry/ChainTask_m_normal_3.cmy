######################################################################
# ChainTask_m_normal_3_0001.yaml
######################################################################
ChainTask_m_normal_3_0001:
  property:
    sc: 
      - SC1
      - SC2

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      inipri: TSK_PRI_MID
      curpri: TSK_PRI_MID
      spolicy: AK_SCHNON
      osap: OSAP_OTHER_OTHER_CORE
    TASK2:
      type: TASK
      tstat: READY
      curpri: TSK_PRI_HIGH
      maxact: ANY_BASIC_MAXACT
      actcnt: 1
      ttype: AK_BASIC
      spolicy: AK_SCHFULL
      osap: OSAP_OTHER_OTHER_CORE
    TASK3:
      type: TASK
      tstat: RUNNING
      inipri: TSK_PRI_MID
      osap: OSAP_SELF_CORE
    INT_STATE1:
      type: INT_STATE
      istat:
        - AK_DIS_ALL_INT: TASK1
      coreid: CORE_OTHER

  do:
    id: TASK3
    syssrv: ChainTask(TASK2)
    rettype: StatusType
    retval: E_OK

  post_condition:
    TASK1:
      tstat: RUNNING
    TASK2:
      tstat: READY
      actcnt: 2
    TASK3:
      tstat: SUSPENDED
