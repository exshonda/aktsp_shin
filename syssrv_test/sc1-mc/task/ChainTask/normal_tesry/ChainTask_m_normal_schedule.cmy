######################################################################
# ChainTask_m_normal_schedule_0001.yaml
######################################################################
ChainTask_m_normal_schedule_0001:
  property:
    sc: 
      - SC1
      - SC2

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      inipri: TSK_PRI_MID
      curpri: TSK_PRI_MID
      spolicy: AK_SCHNON
      osap: OSAP_SELF_CORE
    TASK2:
      type: TASK
      tstat: READY
      curpri: TSK_PRI_HIGH
      maxact: ANY_BASIC_MAXACT
      actcnt: 1
      ttype: AK_BASIC
      spolicy: AK_SCHFULL
      porder: 1
      osap: OSAP_OTHER_SAME_CORE
    TASK3:
      type: TASK
      tstat: READY
      curpri: TSK_PRI_HIGH
      maxact: ANY_BASIC_MAXACT
      actcnt: 1
      ttype: AK_BASIC
      spolicy: AK_SCHFULL
      porder: 2
      osap: OSAP_OTHER_SAME_CORE

  do:
    id: TASK1
    syssrv: ChainTask(TASK2)
    rettype: StatusType
    retval: E_OK

  post_condition:
    TASK1:
      tstat: SUSPENDED
    TASK2:
      tstat: RUNNING
      actcnt: 2
    TASK3:
      tstat: READY
      porder: 1
