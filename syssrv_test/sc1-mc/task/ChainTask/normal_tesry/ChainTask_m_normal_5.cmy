######################################################################
ChainTask_m_normal_5_2506:
  property:
    sc: 
      - SC1
      - SC2

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      inipri: TSK_PRI_MID
      curpri: TSK_PRI_MID
      spolicy: AK_SCHNON
      osap: OSAP_OTHER_OTHER_CORE
    TASK2:
      type: TASK
      tstat: SUSPENDED
      inipri: TSK_PRI_MID
      ttype: AK_EXTENDED
      spolicy: AK_SCHFULL
      osap: OSAP_OTHER_OTHER_CORE
    TASK3:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      spolicy: AK_SCHFULL
      ttype: AK_BASIC
      osap: OSAP_SELF_CORE
    TASK4:
      type: TASK
      tstat: READY
      curpri: TSK_PRI_LOW
      spolicy: AK_SCHFULL
      ttype: ANY_TTYPE
      osap: OSAP_SELF_CORE

  do:
    id: TASK3
    syssrv: ChainTask(TASK2)
    rettype: StatusType
    retval: E_OK

  post_condition:
    TASK1:
      tstat: RUNNING
    TASK2:
      tstat: READY
      actcnt: 1
      curpri: TSK_PRI_MID
    TASK3:
      tstat: SUSPENDED
    TASK4:
      tstat: RUNNING
