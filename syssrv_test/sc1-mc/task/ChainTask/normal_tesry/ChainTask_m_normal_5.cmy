ChainTask_m_normal_5_2079:
  property:
    sc: 
      - SC1
      - SC2

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      inipri: TSK_PRI_MID
      curpri: TSK_PRI_MID
      spolicy: AK_SCHFULL
      relres:
        - RESOURCE1
      getres:
        - RESOURCE1
      osap: OSAP_OTHER_OTHER_CORE
    TASK2:
      type: TASK
      tstat: SUSPENDED
      inipri: TSK_PRI_LOW
      ttype: AK_EXTENDED
      spolicy: AK_SCHFULL
      relres:
        - RESOURCE1
      osap: OSAP_OTHER_OTHER_CORE
    TASK3:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      spolicy: AK_SCHFULL
      ttype: AK_EXTENDED
      osap: OSAP_SELF_CORE
    TASK4:
      type: TASK
      tstat: READY
      curpri: TSK_PRI_MID
      spolicy: AK_SCHNON
      ttype: ANY_TTYPE
      osap: OSAP_SELF_CORE
    RESOURCE1:
      type: RESOURCE
      resprop: AK_INTERNAL
      lockflg: AK_LOCK

  do:
    id: TASK3
    syssrv: ChainTask(TASK2)
    rettype: StatusType
    retval: E_OK

  post_condition:
    TASK1:
      tstat: RUNNING
    TASK2:
      tstat: READY
      actcnt: 1
      curpri: TSK_PRI_LOW
    TASK3:
      tstat: SUSPENDED
    TASK4:
      tstat: RUNNING
