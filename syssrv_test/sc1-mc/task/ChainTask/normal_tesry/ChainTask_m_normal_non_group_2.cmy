######################################################################
# ChainTask_m_normal_non_group_2_0001.yaml
######################################################################
ChainTask_m_normal_non_group_2_0001:
  property:
    sc: 
      - SC1
      - SC2

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      inipri: TSK_PRI_MID
      curpri: TSK_PRI_HIGH
      spolicy: AK_SCHFULL
      ttype: AK_BASIC
      relres:
        - RESOURCE1
      getres:
        - RESOURCE1
      osap: OSAP_OTHER_OTHER_CORE
    TASK2:
      type: TASK
      tstat: READY
      curpri: TSK_PRI_HIGH
      spolicy: AK_SCHFULL
      relres:
        - RESOURCE1
      osap: OSAP_OTHER_OTHER_CORE
    TASK3:
      type: TASK
      tstat: SUSPENDED
      inipri: TSK_PRI_TOP
      ttype: AK_BASIC
      spolicy: AK_SCHFULL
      osap: OSAP_OTHER_OTHER_CORE
    TASK4:
      type: TASK
      tstat: RUNNING
      inipri: TSK_PRI_MID
      osap: OSAP_SELF_CORE
    RESOURCE1:
      type: RESOURCE
      resprop: AK_INTERNAL
      lockflg: AK_LOCK

  do:
    id: TASK4
    syssrv: ChainTask(TASK3)
    rettype: StatusType
    retval: E_OK

  post_condition:
    TASK1:
      tstat: READY
      porder: 1
    TASK3:
      tstat: RUNNING
      curpri: TSK_PRI_TOP
      actcnt: 1
    TASK4:
      tstat: SUSPENDED
