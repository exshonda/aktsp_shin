######################################################################
# ChainTask_m_normal_4_0001.yaml
######################################################################
ChainTask_m_normal_4_0001:
  property:
    sc: 
      - SC1
      - SC2

  pre_condition:
    TASK1:
      type: TASK
      tstat: SUSPENDED
      inipri: TSK_PRI_MID
      spolicy: ANY_SPOLICY
      osap: OSAP_OTHER_OTHER_CORE
    TASK2:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      maxact: ANY_BASIC_MAXACT
      actcnt: 1
      ttype: AK_BASIC
      spolicy: AK_SCHFULL
      osap: OSAP_OTHER_OTHER_CORE
    TASK3:
      type: TASK
      tstat: RUNNING
      inipri: TSK_PRI_MID
      spolicy: ANY_SPOLICY
      osap: OSAP_SELF_CORE

  do:
    id: TASK3
    syssrv: ChainTask(TASK2)
    rettype: StatusType
    retval: E_OK

  post_condition:
    TASK2:
      actcnt: 2
    TASK3:
      tstat: SUSPENDED
