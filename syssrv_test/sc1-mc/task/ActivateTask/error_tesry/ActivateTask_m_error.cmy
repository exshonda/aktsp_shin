######################################################################
# ActivateTask_m_error_0001.yaml
######################################################################
ActivateTask_m_error_0001:
  property:
    sc: 
      - SC1
      - SC2

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      spolicy: AK_SCHFULL
      ttype: ANY_TTYPE
      osap: OSAP_SELF_CORE
    TASK2:
      type: TASK
      tstat: SUSPENDED
      inipri: TSK_PRI_MID
      ttype: AK_BASIC
      osap: OSAP_SELF_CORE
    C2ISR1:
      type: C2ISR
      intno: INTNO_SELF_C2ISR_MID_A
      iniintpri: INT_PRI_MID
      rtnstat: AK_ACTIVATE
      getspn:
        - SPINLOCK1
      osap: OSAP_SELF_CORE
    SPINLOCK1:
      type: SPINLOCK
      susint: AK_SUS_ALL_SPN
      lockflg: AK_LOCK
      accosap:
        - OSAP_SELF_CORE
        - OSAP_OTHER_OTHER_CORE
    INT_STATE1:
      type: INT_STATE
      istat:
        - AK_SUS_ALL_INT: SPINLOCK1
      coreid: CORE_SELF
    ERROR_HOOK1:
      type: ERROR_HOOK
      hookstat: AK_STOP
      target_error_hook_cfg:
        - AK_ONLY_SYSTEM
        - AK_BOTH
      coreid: CORE_SELF

  do_0:
    id: C2ISR1
    syssrv: ActivateTask(TASK2)
    rettype: StatusType
    retval: E_OS_DISABLEDINT
    gcov: true

  post_condition_0:
    C2ISR1:
      rtnstat: AK_STOP
    ERROR_HOOK1:
      hookstat: AK_ACTIVATE

  do_1:
    id: ERROR_HOOK1
    syssrv: CheckAssert(Error==E_OS_DISABLEDINT)
    gcov: false

  post_condition_1:

  do_2:
    id: ERROR_HOOK1
    syssrv: CheckAssert(OSError_ActivateTask_TaskID()==TASK2)
    gcov: false

  post_condition_2:

  do_3:
    id: ERROR_HOOK1
    syssrv: CheckAssert(OSErrorGetServiceId()==OSServiceId_ActivateTask)
    gcov: false

  post_condition_3:

  do_4:
    id: ERROR_HOOK1
    syssrv: return
    gcov: false

  post_condition_4:
    C2ISR1:
      rtnstat: AK_ACTIVATE
    ERROR_HOOK1:
      hookstat: AK_STOP
