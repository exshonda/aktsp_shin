ActivateTask_m_normal_1_0110:
  property:
    sc: 
      - SC1
      - SC2

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      inipri: TSK_PRI_MID
      ttype: ANY_TTYPE
      curpri: TSK_PRI_MID
      spolicy: AK_SCHFULL
      relres:
        - RESOURCE1
      getres:
        - RESOURCE1
      osap: OSAP_SELF_CORE
    TASK2:
      type: TASK
      tstat: SUSPENDED
      spolicy: AK_SCHFULL
      inipri: TSK_PRI_MID
      ttype: AK_EXTENDED
      relres:
        - RESOURCE1
      osap: OSAP_OTHER_SAME_CORE
    RESOURCE1:
      type: RESOURCE
      resprop: AK_INTERNAL
      lockflg: AK_LOCK

  do:
    id: TASK1
    syssrv: ActivateTask(TASK2)
    rettype: StatusType
    retval: E_OK

  post_condition:
    TASK1:
      tstat: RUNNING
    TASK2:
      tstat: READY
      curpri: TSK_PRI_MID
      actcnt: 1
######################################################################
