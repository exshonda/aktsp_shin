######################################################################
# ActivateTask_m_normal_1_0001.yaml
######################################################################
ActivateTask_m_normal_1_0001:
  property:
    sc: 
      - SC1
      - SC2

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      inipri: TSK_PRI_MID
      ttype: ANY_TTYPE
      curpri: TSK_PRI_HIGH
      spolicy: AK_SCHFULL
      relres:
        - RESOURCE1
      getres:
        - RESOURCE1
      osap: OSAP_SELF_CORE
    TASK2:
      type: TASK
      tstat: READY
      spolicy: AK_SCHFULL
      curpri: TSK_PRI_HIGH
      ttype: AK_BASIC
      maxact: ANY_BASIC_MAXACT
      actcnt: 1
      relres:
        - RESOURCE1
      osap: OSAP_OTHER_SAME_CORE
    C2ISR1:
      type: C2ISR
      intno: INTNO_SELF_C2ISR_MID_A
      iniintpri: INT_PRI_MID
      rtnstat: AK_ACTIVATE
      osap: OSAP_SELF_CORE
    RESOURCE1:
      type: RESOURCE
      resprop: AK_INTERNAL
      lockflg: AK_LOCK

  do_0:
    id: C2ISR1
    syssrv: ActivateTask(TASK2)
    rettype: StatusType
    retval: E_OK
    gcov: true

  post_condition_0:
    TASK1:
      tstat: RUNNING
    TASK2:
      tstat: READY
      actcnt: 2

  do_1:
    id: C2ISR1
    syssrv: return
    gcov: false

  post_condition_1:
    TASK1:
      tstat: RUNNING
    TASK2:
      tstat: READY
      actcnt: 2
    C2ISR1:
      rtnstat: AK_STOP
