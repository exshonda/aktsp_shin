######################################################################
# ActivateTask_m_normal_non_group_0001.yaml
######################################################################
ActivateTask_m_normal_non_group_0001:
  property:
    sc: 
      - SC1
      - SC2

  pre_condition:
    TASK4:
      type: TASK
      tstat: RUNNING
      inipri: TSK_PRI_MID
      spolicy: ANY_SPOLICY
      osap: OSAP_SELF_CORE
    TASK1:
      type: TASK
      tstat: RUNNING
      inipri: TSK_PRI_MID
      curpri: TSK_PRI_HIGH
      spolicy: AK_SCHFULL
      relres:
        - RESOURCE1
      getres:
        - RESOURCE1
      osap: OSAP_OTHER_OTHER_CORE
    TASK2:
      type: TASK
      tstat: READY
      spolicy: AK_SCHFULL
      curpri: TSK_PRI_HIGH
      relres:
        - RESOURCE1
      osap: OSAP_OTHER_OTHER_CORE
    TASK3:
      type: TASK
      inipri: TSK_PRI_TOP
      tstat: SUSPENDED
      osap: OSAP_OTHER_OTHER_CORE
    RESOURCE1:
      type: RESOURCE
      resprop: AK_INTERNAL
      lockflg: AK_LOCK

  do:
    id: TASK4
    syssrv: ActivateTask(TASK3)
    rettype: StatusType
    retval: E_OK

  post_condition:
    TASK1:
      tstat: READY
      curpri: TSK_PRI_HIGH
      porder: 1
    TASK2:
      porder: 2
    TASK3:
      tstat: RUNNING
      curpri: TSK_PRI_TOP
      actcnt: 1
