######################################################################
# GetResource_m_nml_tsk1res1_0001.yaml
######################################################################
GetResource_m_nml_tsk1res1_0001:
  property:
    sc: 
      - SC1
      - SC2

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      inipri: TSK_PRI_MID
      curpri: TSK_PRI_MID
      spolicy: ANY_SPOLICY
      osap: OSAP_SELF_CORE
    TASK2:
      type: TASK
      tstat: SUSPENDED
      inipri: TSK_PRI_MID
      spolicy: AK_SCHFULL
      relres:
        - RESOURCE1
      osap: OSAP_OTHER_SAME_CORE
    RESOURCE1:
      type: RESOURCE
      resprop: AK_STANDARD
      lockflg: AK_UNLOCK
    RESOURCE3:
      type: RESOURCE
      resprop: AK_LINKED
      lockflg: AK_UNLOCK
      linkres: RESOURCE1
    C2ISR1:
      type: C2ISR
      intno: INTNO_SELF_C2ISR_MID_A
      iniintpri: INT_PRI_MID
      rtnstat: AK_ACTIVATE
      relres:
        - RESOURCE1
      osap: OSAP_SELF_CORE

  do:
    id: C2ISR1
    syssrv: GetResource(RESOURCE3)
    rettype: StatusType
    retval: E_OK

  post_condition:
    C2ISR1:
      getres:
        - RESOURCE3
    RESOURCE3:
      lockflg: AK_LOCK
