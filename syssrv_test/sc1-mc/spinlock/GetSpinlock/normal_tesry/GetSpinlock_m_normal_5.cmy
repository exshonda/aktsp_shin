######################################################################
# GetSpinlock_m_normal_5_0001.yaml
######################################################################
GetSpinlock_m_normal_5_0001:
  property:
    sc: 
      - SC1
      - SC2

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      osap: OSAP_SELF_CORE
    C2ISR1:
      type: C2ISR
      intno: INTNO_SELF_C2ISR_MID_A
      iniintpri: INT_PRI_MID
      rtnstat: AK_ACTIVATE
      osap: OSAP_SELF_CORE
      getspn:
        - SPINLOCK3
    C2ISR2:
      type: C2ISR
      intno: INTNO_SELF_C2ISR_HIGH
      iniintpri: INT_PRI_HIGH
      rtnstat: AK_STOP
      osap: OSAP_SELF_CORE
    INT_STATE1:
      type: INT_STATE
      istat:
        - AK_SUS_OS_INT: SPINLOCK3
      coreid: CORE_SELF
    SPINLOCK3:
      type: SPINLOCK
      susint: AK_SUS_OS_SPN
      lockflg: AK_LOCK
      accosap:
        - OSAP_SELF_CORE
        - OSAP_OTHER_OTHER_CORE

  do_0:
    id: C2ISR1
    syssrv: AktspRaiseInterrupt(INTNO_SELF_C2ISR_HIGH)
    gcov: false

  post_condition_0:
    INT_STATE1:
      istat:
        - AK_SUS_OS_INT: SPINLOCK3

  do_1:
    id: C2ISR1
    syssrv: ReleaseSpinlock(SPINLOCK3)
    rettype: StatusType
    retval: E_OK
    gcov: false

  post_condition_1:
    C2ISR2:
      rtnstat: AK_ACTIVATE
    C2ISR1:
      rtnstat: AK_STOP
      getspn:
    SPINLOCK3:
      lockflg: AK_UNLOCK
    INT_STATE1:
      istat:
