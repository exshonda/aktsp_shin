      lockflg: AK_LOCK
    INT_STATE1:
      istat:
        - AK_SUS_OS_INT: SPINLOCK2
######################################################################
# GetSpinlock_m_normal_2_1_0144.yaml
######################################################################
GetSpinlock_m_normal_2_1_0144:
  property:
    sc: 
      - SC1
      - SC2

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      osap: OSAP_SELF_CORE
    C2ISR2:
      type: C2ISR
      intno: INTNO_SELF_C2ISR_MID_A
      iniintpri: INT_PRI_MID
      rtnstat: AK_STOP
      osap: OSAP_SELF_CORE
    SPINLOCK1:
      type: SPINLOCK
      successor: SPINLOCK2
      accosap:
        - OSAP_SELF_CORE
        - OSAP_OTHER_OTHER_CORE
    SPINLOCK2:
      type: SPINLOCK
      susint: AK_SUS_OS_SPN
      successor: SPINLOCK3
      accosap:
        - OSAP_SELF_CORE
        - OSAP_OTHER_OTHER_CORE
    SPINLOCK3:
      type: SPINLOCK
      accosap:
        - OSAP_SELF_CORE
        - OSAP_OTHER_OTHER_CORE
    INT_STATE1:
      type: INT_STATE
      istat:
      coreid: CORE_SELF

  do_0:
    id: TASK1
    syssrv: GetSpinlock(SPINLOCK1)
    rettype: StatusType
    retval: E_OK
    gcov: false

  post_condition_0:
    TASK1:
      getspn:
        - SPINLOCK1
    SPINLOCK1:
      lockflg: AK_LOCK

  do_1:
    id: TASK1
    syssrv: AktspRaiseInterrupt(INTNO_SELF_C2ISR_MID_A)
    gcov: false

  post_condition_1:
    C2ISR2:
      rtnstat: AK_ACTIVATE

  do_2:
    id: C2ISR2
    syssrv: GetSpinlock(SPINLOCK2)
    rettype: StatusType
    retval: E_OK
    gcov: true

  post_condition_2:
    C2ISR2:
      getspn:
        - SPINLOCK2
    SPINLOCK2:
      lockflg: AK_LOCK
    INT_STATE1:
      istat:
        - AK_SUS_OS_INT: SPINLOCK2
