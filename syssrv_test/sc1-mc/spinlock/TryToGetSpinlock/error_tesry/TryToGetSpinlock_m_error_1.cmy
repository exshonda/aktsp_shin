        - AK_BOTH
      coreid: CORE_SELF
    SPINLOCK1:
      type: SPINLOCK
      accosap:
        - OSAP_SELF_CORE
        - OSAP_OTHER_OTHER_CORE

  do_0:
    id: TASK1
    syssrv: TryToGetSpinlock(INVALID_SPN_ID,&vname1)
    rettype: StatusType
    retval: E_OS_ID
    gcov: true

  post_condition_0:
    ERROR_HOOK1:
      hookstat: AK_ACTIVATE

  do_1:
    id: ERROR_HOOK1
    syssrv: CheckAssert(Error==E_OS_ID)
    gcov: false

  post_condition_1:

  do_2:
    id: ERROR_HOOK1
    syssrv: CheckAssert(OSError_TryToGetSpinlock_SpinlockId()==INVALID_SPN_ID)
    gcov: false

  post_condition_2:

  do_3:
    id: ERROR_HOOK1
    syssrv: CheckAssert(OSErrorGetServiceId()==OSServiceId_TryToGetSpinlock)
    gcov: false

  post_condition_3:
######################################################################
