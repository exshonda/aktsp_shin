######################################################################
# ReleaseSpinlock_m_normal_0001.yaml
######################################################################
ReleaseSpinlock_m_normal_0001:
  property:
    sc: 
      - SC1
      - SC2

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      osap: OSAP_SELF_CORE
    C2ISR1:
      type: C2ISR
      intno: INTNO_SELF_C2ISR_MID_A
      iniintpri: INT_PRI_MID
      rtnstat: AK_ACTIVATE
      relres:
        - RESOURCE2
      getres:
        - RESOURCE1
      getspn:
        - SPINLOCK1
      osap: OSAP_SELF_CORE
    RESOURCE1:
      type: RESOURCE
      resprop: AK_LINKED
      lockflg: AK_LOCK
      linkres: RESOURCE2
    RESOURCE2:
      type: RESOURCE
      resprop: AK_STANDARD
    SPINLOCK1:
      type: SPINLOCK
      lockflg: AK_LOCK
      accosap:
        - OSAP_SELF_CORE
        - OSAP_OTHER_OTHER_CORE

  do:
    id: C2ISR1
    syssrv: ReleaseSpinlock(SPINLOCK1)
    rettype: StatusType
    retval: E_OK
    gcov: true

  post_condition:
    C2ISR1:
      getspn:
    SPINLOCK1:
      lockflg: AK_UNLOCK
