    gcov: true

  post_condition_0:
    ALARM1:
      astat: AK_SET
      almval: ANY_CURVAL_WRAPAROUND_A
      cycle: ANY_ALMCYCLE_A

  do_1:
    id: TASK2
    syssrv: AktspIncrementHardwareCounter(COUNTER1)
    repeat: ANY_MAXVAL_A-ANY_CURVAL_NOT_0_MAX_A+ANY_CURVAL_WRAPAROUND_A+1
    gcov: false

  post_condition_1:
    ALARM1:
      almval: (ANY_CURVAL_WRAPAROUND_A+ANY_ALMCYCLE_A*1)%(ANY_MAXVAL_A+1)
    COUNTER1:
      curval: (ANY_CURVAL_WRAPAROUND_A+ANY_ALMCYCLE_A*0)%(ANY_MAXVAL_A+1)
    COUNTER2:
