SetRelAlarm_m_normal_2_0028:
  property:
    sc: 
      - SC1
      - SC2

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      osap: OSAP_OTHER_OTHER_CORE
    TASK2:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      osap: OSAP_SELF_CORE
    ALARM1:
      type: ALARM
      almact: AK_ALM_INCNT
      counter: COUNTER1
      astat: AK_UNSET
      incounter: COUNTER2
    COUNTER1:
      type: COUNTER
      ctype: AK_SOFTWARE
      mincyc: ANY_MINCYC_A
      maxval: ANY_MAXVAL_A
      curval: ANY_CURVAL_NOT_0_MAX_A
      cstat: AK_CS_NULL
      osap: OSAP_SELF_CORE
    COUNTER2:
      type: COUNTER
      ctype: AK_SOFTWARE
      mincyc: 1
      maxval: ANY_MAXVAL_B
      curval: 0
      cstat: AK_CS_NULL
      osap: OSAP_SELF_CORE

  do_0:
    id: TASK1
    syssrv: SetRelAlarm(ALARM1,ANY_CURVAL_NOT_WRAPAROUND_A-ANY_CURVAL_NOT_0_MAX_A,0)
    rettype: StatusType
    retval: E_OK
    gcov: true

  post_condition_0:
    ALARM1:
      astat: AK_SET
      almval: ANY_CURVAL_NOT_WRAPAROUND_A
      cycle: 0

  do_1:
    id: TASK2
    syssrv: IncrementCounter(COUNTER1)
    repeat: ANY_CURVAL_NOT_WRAPAROUND_A-ANY_CURVAL_NOT_0_MAX_A
    rettype: StatusType
    retval: E_OK
    gcov: false

  post_condition_1:
    ALARM1:
      astat: AK_UNSET
    COUNTER1:
      curval: (ANY_CURVAL_NOT_WRAPAROUND_A+ANY_ALMCYCLE_A*0)%(ANY_MAXVAL_A+1)
    COUNTER2:
      curval: 1
