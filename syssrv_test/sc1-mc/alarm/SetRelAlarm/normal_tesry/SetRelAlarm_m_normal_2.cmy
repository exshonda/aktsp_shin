    repeat: ANY_ALMCYCLE_A
    gcov: false

  post_condition_6:
    ALARM1:
      almval: (ANY_CURVAL_WRAPAROUND_A+ANY_ALMCYCLE_A*6)%(ANY_MAXVAL_A+1)
    COUNTER1:
      curval: (ANY_CURVAL_WRAPAROUND_A+ANY_ALMCYCLE_A*5)%(ANY_MAXVAL_A+1)
    COUNTER2:
      curval: 6%(ANY_MAXVAL_B+1)
