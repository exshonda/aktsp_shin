    syssrv: AktspIncrementHardwareCounter(COUNTER1)
    repeat: ANY_ALMCYCLE_A
    gcov: false

  post_condition_4:
    ALARM1:
      almval: (ANY_CURVAL_WRAPAROUND_A+ANY_ALMCYCLE_A*4)%(ANY_MAXVAL_A+1)
    COUNTER1:
      curval: (ANY_CURVAL_WRAPAROUND_A+ANY_ALMCYCLE_A*3)%(ANY_MAXVAL_A+1)
    COUNTER2:
      curval: 4%(ANY_MAXVAL_B+1)

  do_5:
