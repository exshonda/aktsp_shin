    COUNTER1:
      curval: (ANY_CURVAL_WRAPAROUND_A+ANY_ALMCYCLE_A*1)%(ANY_MAXVAL_A+1)
    COUNTER2:
      curval: 2

  do_3:
    id: TASK2
    syssrv: AktspIncrementHardwareCounter(COUNTER1)
    repeat: ANY_ALMCYCLE_A
    gcov: false

  post_condition_3:
    ALARM1:
      almval: (ANY_CURVAL_WRAPAROUND_A+ANY_ALMCYCLE_A*3)%(ANY_MAXVAL_A+1)
    COUNTER1:
      curval: (ANY_CURVAL_WRAPAROUND_A+ANY_ALMCYCLE_A*2)%(ANY_MAXVAL_A+1)
    COUNTER2:
      curval: 3%(ANY_MAXVAL_B+1)

  do_4:
