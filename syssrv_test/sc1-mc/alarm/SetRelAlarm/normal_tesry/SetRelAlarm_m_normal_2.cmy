######################################################################
# SetRelAlarm_m_normal_2_0001.yaml
######################################################################
SetRelAlarm_m_normal_2_0001:
  property:
    sc: 
      - SC1
      - SC2

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      osap: OSAP_OTHER_OTHER_CORE
    TASK2:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      osap: OSAP_SELF_CORE
    C2ISR1:
      type: C2ISR
      intno: INTNO_OTHER_ISR2_C
      iniintpri: INT_PRI_MID
      rtnstat: AK_ACTIVATE
      osap: OSAP_OTHER_OTHER_CORE
    ALARM1:
      type: ALARM
      almact: AK_ALM_INCNT
      counter: COUNTER1
      astat: AK_UNSET
      incounter: COUNTER2
      osap: OSAP_SELF_CORE
    COUNTER1:
      type: COUNTER
      ctype: AK_HARDWARE
      curval: 0
    COUNTER2:
      type: COUNTER
      ctype: AK_SOFTWARE
      mincyc: 1
      maxval: ANY_MAXVAL_B
      curval: 0
      cstat: AK_CS_NULL
      osap: OSAP_SELF_CORE

  do_0:
    id: C2ISR1
    syssrv: SetRelAlarm(ALARM1,ANY_CURVAL_NOT_0_A,ANY_ALMCYCLE_A)
    rettype: StatusType
    retval: E_OK
    gcov: true

  post_condition_0:
    ALARM1:
      astat: AK_SET
      almval: ANY_CURVAL_NOT_0_A
      cycle: ANY_ALMCYCLE_A

  do_1:
    id: TASK2
    syssrv: AktspIncrementHardwareCounter(COUNTER1)
    repeat: ANY_CURVAL_NOT_0_A
    gcov: false

  post_condition_1:
    ALARM1:
      almval: (ANY_CURVAL_NOT_0_A+ANY_ALMCYCLE_A*1)%(ANY_MAXVAL_A+1)
    COUNTER1:
      curval: (ANY_CURVAL_NOT_0_A+ANY_ALMCYCLE_A*0)%(ANY_MAXVAL_A+1)
    COUNTER2:
      curval: 1

  do_2:
    id: TASK2
    syssrv: AktspIncrementHardwareCounter(COUNTER1)
    repeat: ANY_ALMCYCLE_A
    gcov: false

  post_condition_2:
    ALARM1:
      almval: (ANY_CURVAL_NOT_0_A+ANY_ALMCYCLE_A*2)%(ANY_MAXVAL_A+1)
    COUNTER1:
      curval: (ANY_CURVAL_NOT_0_A+ANY_ALMCYCLE_A*1)%(ANY_MAXVAL_A+1)
    COUNTER2:
      curval: 2

  do_3:
    id: TASK2
    syssrv: AktspIncrementHardwareCounter(COUNTER1)
    repeat: ANY_ALMCYCLE_A
    gcov: false

  post_condition_3:
    ALARM1:
      almval: (ANY_CURVAL_NOT_0_A+ANY_ALMCYCLE_A*3)%(ANY_MAXVAL_A+1)
    COUNTER1:
      curval: (ANY_CURVAL_NOT_0_A+ANY_ALMCYCLE_A*2)%(ANY_MAXVAL_A+1)
    COUNTER2:
      curval: 3%(ANY_MAXVAL_B+1)

  do_4:
    id: TASK2
    syssrv: AktspIncrementHardwareCounter(COUNTER1)
    repeat: ANY_ALMCYCLE_A
    gcov: false

  post_condition_4:
    ALARM1:
      almval: (ANY_CURVAL_NOT_0_A+ANY_ALMCYCLE_A*4)%(ANY_MAXVAL_A+1)
    COUNTER1:
      curval: (ANY_CURVAL_NOT_0_A+ANY_ALMCYCLE_A*3)%(ANY_MAXVAL_A+1)
    COUNTER2:
      curval: 4%(ANY_MAXVAL_B+1)

  do_5:
    id: TASK2
    syssrv: AktspIncrementHardwareCounter(COUNTER1)
    repeat: ANY_ALMCYCLE_A
    gcov: false

  post_condition_5:
    ALARM1:
      almval: (ANY_CURVAL_NOT_0_A+ANY_ALMCYCLE_A*5)%(ANY_MAXVAL_A+1)
    COUNTER1:
      curval: (ANY_CURVAL_NOT_0_A+ANY_ALMCYCLE_A*4)%(ANY_MAXVAL_A+1)
    COUNTER2:
      curval: 5%(ANY_MAXVAL_B+1)

  do_6:
    id: TASK2
    syssrv: AktspIncrementHardwareCounter(COUNTER1)
    repeat: ANY_ALMCYCLE_A
    gcov: false

  post_condition_6:
    ALARM1:
      almval: (ANY_CURVAL_NOT_0_A+ANY_ALMCYCLE_A*6)%(ANY_MAXVAL_A+1)
    COUNTER1:
      curval: (ANY_CURVAL_NOT_0_A+ANY_ALMCYCLE_A*5)%(ANY_MAXVAL_A+1)
    COUNTER2:
      curval: 6%(ANY_MAXVAL_B+1)
