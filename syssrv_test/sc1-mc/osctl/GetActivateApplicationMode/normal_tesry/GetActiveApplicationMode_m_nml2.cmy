######################################################################
# GetActiveApplicationMode_m_nml2_0001.yaml
######################################################################
GetActiveApplicationMode_m_nml2_0001:
  property:
    sc: 
      - SC1
      - SC2

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      osap: OSAP_OTHER_OTHER_CORE
    C2ISR1:
      type: C2ISR
      intno: INTNO_OTHER_ISR2_C
      iniintpri: INT_PRI_MID
      rtnstat: AK_ACTIVATE
      osap: OSAP_OTHER_OTHER_CORE

  do:
    id: C2ISR1
    syssrv: GetActiveApplicationMode()
    rettype: AppModeType
    retval: MainApp

  post_condition:
