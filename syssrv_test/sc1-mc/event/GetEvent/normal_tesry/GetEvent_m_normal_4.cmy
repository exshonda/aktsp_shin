  pre_condition:
    TASK1:
      type: TASK
      tstat: SUSPENDED
      inipri: TSK_PRI_MID
      osap: OSAP_OTHER_OTHER_CORE
    TASK2:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_LOW
      ttype: AK_EXTENDED
      curevt: EVENT1|EVENT2
      relevt:
        - EVENT1
        - EVENT2
      osap: OSAP_OTHER_OTHER_CORE
    TASK4:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      var:
        vname1:
          type: EventMaskType
      osap: OSAP_SELF_CORE
    EVENT1:
      type: EVENT
      mask: EVENTMASK_A
    EVENT2:
      type: EVENT
      mask: EVENTMASK_B

  do:
    id: TASK4
    syssrv: GetEvent(TASK2,&vname1)
    rettype: StatusType
    retval: E_OK

  post_condition:
    TASK4:
      var:
        vname1:
          value: (EVENT1|EVENT2)
