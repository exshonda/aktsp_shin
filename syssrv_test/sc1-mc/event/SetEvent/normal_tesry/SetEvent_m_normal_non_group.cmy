######################################################################
# SetEvent_m_normal_non_group_0001.yaml
######################################################################
SetEvent_m_normal_non_group_0001:
  property:
    sc: 
      - SC1
      - SC2

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      spolicy: AK_SCHFULL
      inipri: TSK_PRI_MID
      curpri: TSK_PRI_HIGH
      relres:
        - RESOURCE1
      getres:
        - RESOURCE1
      osap: OSAP_SELF_CORE
    TASK2:
      type: TASK
      tstat: READY
      curpri: TSK_PRI_HIGH
      curevt: 0
      relevt:
        - EVENT1
        - EVENT2
      relres:
        - RESOURCE1
      spolicy: AK_SCHFULL
      osap: OSAP_SELF_CORE
    TASK3:
      type: TASK
      tstat: WAITING
      ttype: AK_EXTENDED
      curpri: TSK_PRI_TOP
      spolicy: AK_SCHFULL
      waievt: EVENT1
      relevt:
        - EVENT1
      osap: OSAP_SELF_CORE
    TASK4:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      osap: OSAP_OTHER_OTHER_CORE
    EVENT1:
      type: EVENT
      mask: EVENTMASK_A
    EVENT2:
      type: EVENT
      mask: EVENTMASK_B
    RESOURCE1:
      type: RESOURCE
      resprop: AK_INTERNAL
      lockflg: AK_LOCK

  do:
    id: TASK4
    syssrv: SetEvent(TASK3,EVENT1)
    rettype: StatusType
    retval: E_OK

  post_condition:
    TASK1:
      tstat: READY
      porder: 1
    TASK2:
      tstat: READY
      porder: 2
    TASK3:
      tstat: RUNNING
      curevt: EVENT1
