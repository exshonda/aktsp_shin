SetEvent_m_normal_2_0465:
  property:
    sc: 
      - SC1
      - SC2

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      spolicy: AK_SCHNON
      curpri: TSK_PRI_MID
      osap: OSAP_SELF_CORE
    TASK2:
      type: TASK
      tstat: READY
      curpri: TSK_PRI_LOW
      ttype: AK_EXTENDED
      curevt: EVENT1
      relevt:
        - EVENT1
        - EVENT2
      spolicy: AK_SCHNON
      osap: OSAP_SELF_CORE
    TASK4:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      osap: OSAP_OTHER_OTHER_CORE
    EVENT1:
      type: EVENT
      mask: EVENTMASK_A
    EVENT2:
      type: EVENT
      mask: EVENTMASK_B

  do:
    id: TASK4
    syssrv: SetEvent(TASK2,EVENT2)
    rettype: StatusType
    retval: E_OK

  post_condition:
    TASK1:
      tstat: RUNNING
    TASK2:
      tstat: READY
      curevt: EVENT1|EVENT2
