      osap: OSAP_SELF_CORE
    TASK2:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      ttype: AK_EXTENDED
      curevt: 0
      relevt:
        - EVENT1
        - EVENT2
      spolicy: ANY_SPOLICY
      osap: OSAP_SELF_CORE
    TASK3:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      osap: OSAP_OTHER_OTHER_CORE
    C2ISR1:
      type: C2ISR
      intno: INTNO_OTHER_ISR2_C
      iniintpri: INT_PRI_MID
      rtnstat: AK_ACTIVATE
      osap: OSAP_OTHER_OTHER_CORE
    EVENT1:
      type: EVENT
      mask: EVENTMASK_A
    EVENT2:
      type: EVENT
      mask: EVENTMASK_B

  do_0:
    id: C2ISR1
    syssrv: SetEvent(TASK2,EVENT1)
    rettype: StatusType
    retval: E_OK
    gcov: true

  post_condition_0:
    TASK2:
      tstat: RUNNING
      curevt: EVENT1

  do_1:
    id: C2ISR1
    syssrv: return
    gcov: false

  post_condition_1:
    C2ISR1:
      rtnstat: AK_STOP
