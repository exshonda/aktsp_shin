      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      spolicy: AK_SCHNON
      osap: OSAP_SELF_CORE
    TASK2:
      type: TASK
      tstat: WAITING
      curpri: TSK_PRI_HIGH
      ttype: AK_EXTENDED
      curevt: EVENT1
      waievt: EVENT2
      relevt:
        - EVENT1
        - EVENT2
      spolicy: AK_SCHNON
      osap: OSAP_SELF_CORE
    TASK4:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      osap: OSAP_OTHER_OTHER_CORE
    EVENT1:
      type: EVENT
      mask: EVENTMASK_A
    EVENT2:
      type: EVENT
      mask: EVENTMASK_B
    INT_STATE1:
      type: INT_STATE
      istat:
        - AK_SUS_OS_INT: TASK1
      coreid: CORE_SELF

  do:
