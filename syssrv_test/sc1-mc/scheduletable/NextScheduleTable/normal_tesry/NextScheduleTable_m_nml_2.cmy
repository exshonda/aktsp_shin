NextScheduleTable_m_nml_2_0095:
  property:
    sc: 
      - SC1
      - SC2

  pre_condition:
    TASK4:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      osap: OSAP_OTHER_OTHER_CORE
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      osap: OSAP_SELF_CORE
    TASK2:
      type: TASK
      tstat: SUSPENDED
      inipri: TSK_PRI_MID
      osap: OSAP_SELF_CORE
    TASK3:
      type: TASK
      tstat: SUSPENDED
      inipri: TSK_PRI_MID
      osap: OSAP_SELF_CORE
      ttype: AK_BASIC
      maxact: 6
    C2ISR1:
      type: C2ISR
      intno: INTNO_SELF_C2ISR_MID_A
      iniintpri: INT_PRI_MID
      rtnstat: AK_ACTIVATE
      osap: OSAP_SELF_CORE
    C2ISR2:
      type: C2ISR
      intno: INTNO_OTHER_ISR2_C
      iniintpri: INT_PRI_MID
      rtnstat: AK_ACTIVATE
      osap: OSAP_OTHER_OTHER_CORE
    COUNTER1:
      type: COUNTER
      ctype: AK_HARDWARE
      curval: ANY_CURVAL_A
    SCHEDULE_TABLE1:
      type: SCHEDULE_TABLE
      counter: COUNTER1
      syncstrategy: AK_NONE
      repeat: AK_TRUE
      ststat: SCHEDULETABLE_RUNNING
      duration: ANY_SCDLTBL_DURATION_A
      curval: 0
      expoint:
        ANY_SCDLTBL_INIT_OFFSET_NOT_0_MAX_A:
          acttsk:
            - TASK2
      osap: OSAP_SELF_CORE
    SCHEDULE_TABLE2:
      type: SCHEDULE_TABLE
      counter: COUNTER1
      syncstrategy: AK_NONE
      repeat: AK_TRUE
      ststat: SCHEDULETABLE_STOPPED
      duration: ANY_SCDLTBL_DURATION_B
      expoint:
        ANY_SCDLTBL_INIT_OFFSET_B:
          acttsk:
            - TASK3
      osap: OSAP_SELF_CORE

  do_0:
    id: C2ISR1
    syssrv: AktspIncrementHardwareCounter(COUNTER1)
    repeat: ANY_SCDLTBL_INIT_OFFSET_NOT_0_MAX_A
    rettype: StatusType
    retval: E_OK
    gcov: false

  post_condition_0:
    COUNTER1:
      curval: (ANY_CURVAL_A+ANY_SCDLTBL_INIT_OFFSET_NOT_0_MAX_A)%(ANY_MAXVAL_A+1)
    SCHEDULE_TABLE1:
      curval: ANY_SCDLTBL_INIT_OFFSET_NOT_0_MAX_A
    TASK2:
      tstat: READY
      actcnt: 1
      curpri: TSK_PRI_MID
      porder: 1

  do_1:
    id: C2ISR2
    syssrv: NextScheduleTable(SCHEDULE_TABLE1,SCHEDULE_TABLE2)
    rettype: StatusType
    retval: E_OK
    gcov: false

  post_condition_1:
    SCHEDULE_TABLE2:
      ststat: SCHEDULETABLE_NEXT
      stfrom: SCHEDULE_TABLE1

  do_2:
    id: C2ISR1
    syssrv: AktspIncrementHardwareCounter(COUNTER1)
    repeat: ANY_SCDLTBL_DURATION_A-ANY_SCDLTBL_INIT_OFFSET_NOT_0_MAX_A
    gcov: false

  post_condition_2:
    COUNTER1:
      curval: (ANY_CURVAL_A+ANY_SCDLTBL_DURATION_A)%(ANY_MAXVAL_A+1)
    SCHEDULE_TABLE1:
      ststat: SCHEDULETABLE_STOPPED
    SCHEDULE_TABLE2:
      ststat: SCHEDULETABLE_RUNNING
      curval: 0

  do_3:
    id: C2ISR1
    syssrv: AktspIncrementHardwareCounter(COUNTER1)
    repeat: ANY_SCDLTBL_DURATION_B
    gcov: false

  post_condition_3:
    TASK3:
      tstat: READY
      actcnt: 1
      curpri: TSK_PRI_MID
      porder: 2
    COUNTER1:
      curval: (ANY_CURVAL_A+ANY_SCDLTBL_DURATION_A+ANY_SCDLTBL_DURATION_B*1)%(ANY_MAXVAL_A+1)

  do_4:
    id: C2ISR1
    syssrv: AktspIncrementHardwareCounter(COUNTER1)
    repeat: ANY_SCDLTBL_DURATION_B
    gcov: false

  post_condition_4:
    TASK3:
      actcnt: 2
    COUNTER1:
      curval: (ANY_CURVAL_A+ANY_SCDLTBL_DURATION_A+ANY_SCDLTBL_DURATION_B*2)%(ANY_MAXVAL_A+1)
