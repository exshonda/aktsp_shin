    sc: 
      - SC1
      - SC2

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      osap: OSAP_SELF_CORE
    TASK2:
      type: TASK
      tstat: SUSPENDED
      inipri: TSK_PRI_MID
      ttype: AK_BASIC
      osap: OSAP_SELF_CORE
    COUNTER1:
      type: COUNTER
      ctype: AK_SOFTWARE
      mincyc: ANY_MINCYC_A
      maxval: ANY_MAXVAL_A
      curval: ANY_CURVAL_A
      cstat: AK_CS_NULL
      osap: OSAP_OTHER_SAME_CORE
    SCHEDULE_TABLE1:
      type: SCHEDULE_TABLE
      counter: COUNTER1
      syncstrategy: AK_NONE
      repeat: AK_TRUE
      ststat: SCHEDULETABLE_STOPPED
      duration: ANY_SCDLTBL_DURATION_A
      expoint:
        ANY_SCDLTBL_INIT_OFFSET_A:
          acttsk:
            - TASK2
      osap: OSAP_OTHER_SAME_CORE

  do_0:
    id: TASK1
    syssrv: StartScheduleTableAbs(SCHEDULE_TABLE1,ANY_CURVAL_A)
    rettype: StatusType
    retval: E_OK
    gcov: false

  post_condition_0:
    SCHEDULE_TABLE1:
      ststat: SCHEDULETABLE_RUNNING

  do_1:
    id: TASK1
    syssrv: StopScheduleTable(SCHEDULE_TABLE1)
    rettype: StatusType
    retval: E_OK
    gcov: true

  post_condition_1:
    SCHEDULE_TABLE1:
      ststat: SCHEDULETABLE_STOPPED
