######################################################################
# StartScheduleTableRel_m_error_0001.yaml
######################################################################
StartScheduleTableRel_m_error_0001:
  property:
    sc: 
      - SC1
      - SC2

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      osap: OSAP_SELF_CORE
    TASK2:
      type: TASK
      tstat: SUSPENDED
      inipri: TSK_PRI_MID
      osap: OSAP_SELF_CORE
    C2ISR1:
      type: C2ISR
      intno: INTNO_SELF_C2ISR_MID_A
      iniintpri: INT_PRI_MID
      rtnstat: AK_ACTIVATE
      getspn:
        - SPINLOCK1
      osap: OSAP_SELF_CORE
    ERROR_HOOK1:
      type: ERROR_HOOK
      hookstat: AK_STOP
      target_error_hook_cfg:
        - AK_ONLY_SYSTEM
        - AK_BOTH
      coreid: CORE_SELF
    SPINLOCK1:
      type: SPINLOCK
      susint: AK_SUS_ALL_SPN
      lockflg: AK_LOCK
      accosap:
        - OSAP_SELF_CORE
        - OSAP_OTHER_OTHER_CORE
    INT_STATE1:
      type: INT_STATE
      istat:
        - AK_SUS_ALL_INT: SPINLOCK1
      coreid: CORE_SELF
    COUNTER1:
      type: COUNTER
      ctype: AK_SOFTWARE
      mincyc: ANY_MINCYC_A
      maxval: ANY_MAXVAL_A
      curval: ANY_CURVAL_A
      cstat: AK_CS_NULL
      osap: OSAP_SELF_CORE
    SCHEDULE_TABLE1:
      type: SCHEDULE_TABLE
      counter: COUNTER1
      syncstrategy: AK_NONE
      repeat: AK_TRUE
      ststat: SCHEDULETABLE_STOPPED
      duration: ANY_SCDLTBL_DURATION_A
      expoint:
        ANY_SCDLTBL_INIT_OFFSET_A:
          acttsk:
            - TASK2
      osap: OSAP_SELF_CORE

  do_0:
    id: C2ISR1
    syssrv: StartScheduleTableRel(SCHEDULE_TABLE1,ANY_PARAM_OFFSET_STARTSCDLTBLREL)
    rettype: StatusType
    retval: E_OS_DISABLEDINT
    gcov: true

  post_condition_0:
    C2ISR1:
      rtnstat: AK_STOP
      target_error_hook_cfg:
        - AK_ONLY_SYSTEM
        - AK_ONLY_OSAP
        - AK_BOTH
    ERROR_HOOK1:
      hookstat: AK_ACTIVATE

  do_1:
    id: ERROR_HOOK1
    syssrv: CheckAssert(Error==E_OS_DISABLEDINT)
    gcov: false

  post_condition_1:

  do_2:
    id: ERROR_HOOK1
    syssrv: CheckAssert(OSError_StartScheduleTableRel_ScheduleTableID()==SCHEDULE_TABLE1)
    gcov: false

  post_condition_2:

  do_3:
    id: ERROR_HOOK1
    syssrv: CheckAssert(OSError_StartScheduleTableRel_Offset()==ANY_PARAM_OFFSET_STARTSCDLTBLREL)
    gcov: false
    need_si:
      - IOS030

  post_condition_3:

  do_4:
    id: ERROR_HOOK1
    syssrv: CheckAssert(OSErrorGetServiceId()==OSServiceId_StartScheduleTableRel)
    gcov: false

  post_condition_4:

  do_5:
    id: ERROR_HOOK1
    syssrv: return
    gcov: false

  post_condition_5:
    C2ISR1:
      rtnstat: AK_ACTIVATE
    ERROR_HOOK1:
      hookstat: AK_STOP
