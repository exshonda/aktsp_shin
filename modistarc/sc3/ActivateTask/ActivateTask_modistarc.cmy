######################################################################
# ActivateTask_modistarc_0001.yaml
######################################################################
ActivateTask_modistarc_0001:
  property:
    sc: 
      - SC3
      - SC4

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      spolicy: AK_SCHFULL
      curpri: TSK_PRI_MID
      osap: TRUSTED_OSAP1
    TASK2:
      type: TASK
      tstat: WAITING
      curpri: TSK_PRI_MID
      ttype: AK_EXTENDED
      curevt: 0
      waievt: EVENT1|EVENT2
      relevt:
        - EVENT1
        - EVENT2
      osap: TRUSTED_OSAP1
    TASK3:
      type: TASK
      tstat: SUSPENDED
      inipri: TSK_PRI_MID
      osap: TRUSTED_OSAP1
    EVENT1:
      type: EVENT
      mask: EVENTMASK_A
    EVENT2:
      type: EVENT
      mask: EVENTMASK_B

  do_0:
    id: TASK1
    syssrv: ActivateTask(TASK3)
    rettype: StatusType
    retval: E_OK
    gcov: true

  post_condition_0:
    TASK3:
      tstat: READY
      curpri: TSK_PRI_MID
      actcnt: 1
      porder: 1

  do_1:
    id: TASK1
    syssrv: SetEvent(TASK2,EVENT2)
    rettype: StatusType
    retval: E_OK
    gcov: false

  post_condition_1:
    TASK1:
      tstat: RUNNING
    TASK2:
      tstat: READY
      curevt: EVENT2
      porder: 2

  do_2:
    id: TASK1
    syssrv: TerminateTask()
    rettype: StatusType
    retval: E_OK
    gcov: false

  post_condition_2:
    TASK1:
      tstat: SUSPENDED
    TASK2:
      porder: 1
    TASK3:
      tstat: RUNNING
