######################################################################
# ChainTask_modistarc_0001.yaml
######################################################################
Modistarc_test_02_normal_0001:
  property:
    sc: 
      - SC3
      - SC4

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      inipri: TSK_PRI_MID
      curpri: TSK_PRI_MID
      spolicy: AK_SCHNON
      ttype: AK_BASIC
      osap: TRUSTED_OSAP1
    TASK2:
      type: TASK
      tstat: SUSPENDED
      inipri: TSK_PRI_HIGH
      ttype: AK_BASIC
      spolicy: AK_SCHFULL
      osap: TRUSTED_OSAP1
    TASK3:
      type: TASK
      tstat: READY
      curpri: TSK_PRI_LOW
      ttype: AK_BASIC
      spolicy: AK_SCHFULL
      osap: TRUSTED_OSAP1

  do:
    id: TASK1
    syssrv: ChainTask(TASK2)
    rettype: StatusType
    retval: E_OK

  post_condition:
    TASK1:
      tstat: SUSPENDED
    TASK2:
      tstat: RUNNING
      curpri: TSK_PRI_HIGH
      actcnt: 1
    TASK3:
      tstat: READY
