######################################################################
# TerminateTask_modistarc_0001.yaml
######################################################################
TerminateTask_modistarc_0001:
  property:
    sc: 
      - SC3
      - SC4

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      inipri: TSK_PRI_HIGH
      curpri: TSK_PRI_HIGH
      spolicy: AK_SCHFULL
      maxact: 1
      osap: ANY_OSAP_1
    TASK2:
      type: TASK
      tstat: SUSPENDED
      inipri: TSK_PRI_MID
      spolicy: AK_SCHFULL
      maxact: 3
      ttype: AK_BASIC
      osap: ANY_OSAP_1
    TASK3:
      type: TASK
      tstat: SUSPENDED
      inipri: TSK_PRI_MID
      spolicy: AK_SCHFULL
      maxact: 3
      ttype: AK_BASIC
      osap: ANY_OSAP_1

  do_0:
    id: TASK1
    syssrv: ActivateTask(TASK2)
    rettype: StatusType
    retval: E_OK
    gcov: false

  post_condition_0:
    TASK1:
      tstat: RUNNING
    TASK2:
      tstat: READY
      actcnt: 1

  do_1:
    id: TASK1
    syssrv: ActivateTask(TASK3)
    rettype: StatusType
    retval: E_OK
    gcov: false

  post_condition_1:
    TASK1:
      tstat: RUNNING
    TASK2:
      tstat: READY
      actcnt: 1
      porder: 1
    TASK3:
      tstat: READY
      actcnt: 1
      porder: 2

  do_2:
    id: TASK1
    syssrv: ActivateTask(TASK2)
    rettype: StatusType
    retval: E_OK
    gcov: false

  post_condition_2:
    TASK1:
      tstat: RUNNING
    TASK2:
      tstat: READY
      actcnt: 2
    TASK3:
      tstat: READY
      actcnt: 1
  
  do_3:
    id: TASK1
    syssrv: ActivateTask(TASK2)
    rettype: StatusType
    retval: E_OK
    gcov: false

  post_condition_3:
    TASK1:
      tstat: RUNNING
    TASK2:
      tstat: READY
      actcnt: 3
    TASK3:
      tstat: READY
      actcnt: 1

  do_4:
    id: TASK1
    syssrv: ActivateTask(TASK3)
    rettype: StatusType
    retval: E_OK
    gcov: false

  post_condition_4:
    TASK1:
      tstat: RUNNING
    TASK2:
      tstat: READY
      actcnt: 3
    TASK3:
      tstat: READY
      actcnt: 2

  do_5:
    id: TASK1
    syssrv: ActivateTask(TASK3)
    rettype: StatusType
    retval: E_OK
    gcov: false

  post_condition_5:
    TASK1:
      tstat: RUNNING
    TASK2:
      tstat: READY
      actcnt: 3
    TASK3:
      tstat: READY
      actcnt: 3

  do_6:
    id: TASK1
    syssrv: TerminateTask()
    rettype: StatusType
    retval: E_OK
    gcov: true

  post_condition_6:
    TASK1:
      tstat: SUSPENDED
    TASK2:
      tstat: RUNNING
      actcnt: 3
    TASK3:
      tstat: READY
      actcnt: 3
      porder: 1

  do_7:
    id: TASK2
    syssrv: TerminateTask()
    rettype: StatusType
    retval: E_OK
    gcov: false

  post_condition_7:
    TASK1:
      tstat: SUSPENDED
    TASK2:
      tstat: READY
      actcnt: 2
      bootcnt: 1
    TASK3:
      tstat: RUNNING
      actcnt: 3

  do_8:
    id: TASK3
    syssrv: TerminateTask()
    rettype: StatusType
    retval: E_OK
    gcov: false

  post_condition_8:
    TASK1:
      tstat: SUSPENDED
    TASK2:
      tstat: RUNNING
      actcnt: 2
    TASK3:
      tstat: READY
      actcnt: 2
      bootcnt: 1

  do_9:
    id: TASK2
    syssrv: TerminateTask()
    rettype: StatusType
    retval: E_OK
    gcov: false

  post_condition_9:
    TASK1:
      tstat: SUSPENDED
    TASK2:
      tstat: READY
      actcnt: 1
      bootcnt: 2
    TASK3:
      tstat: RUNNING
      actcnt: 2

  do_10:
    id: TASK3
    syssrv: TerminateTask()
    rettype: StatusType
    retval: E_OK
    gcov: false

  post_condition_10:
    TASK1:
      tstat: SUSPENDED
    TASK2:
      tstat: RUNNING
      actcnt: 1
    TASK3:
      tstat: READY
      actcnt: 1
      bootcnt: 2

  do_11:
    id: TASK2
    syssrv: TerminateTask()
    rettype: StatusType
    retval: E_OK
    gcov: false

  post_condition_11:
    TASK1:
      tstat: SUSPENDED
    TASK2:
      tstat: SUSPENDED
    TASK3:
      actcnt: 1
      tstat: RUNNING

  do_12:
    id: TASK3
    syssrv: TerminateTask()
    rettype: StatusType
    retval: E_OK
    gcov: false

  post_condition_12:
    TASK1:
      tstat: SUSPENDED
    TASK2:
      tstat: SUSPENDED
    TASK3:
      tstat: SUSPENDED
