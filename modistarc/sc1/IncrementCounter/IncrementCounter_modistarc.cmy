######################################################################
# IncrementCounter_modistarc_0001.yaml
######################################################################
IncrementCounter_modistarc_0001:
  property:
    sc: 
      - SC1
      - SC2

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      ttype: AK_BASIC
      curpri: TSK_PRI_HIGH
      spolicy: AK_SCHFULL
    TASK2:
      type: TASK
      tstat: SUSPENDED
      inipri: TSK_PRI_LOW
      ttype: AK_BASIC
    C2ISR1:
      type: C2ISR
      intno: INTNO_SELF_C2ISR_MID_A 
      iniintpri: INT_PRI_MID
      rtnstat: AK_ACTIVATE
    ALARM1:
      type: ALARM
      almact: AK_ALM_INCNT
      counter: COUNTER1
      astat: AK_SET
      almval: 0
      cycle: 0
      incounter: COUNTER2
    ALARM2:
      type: ALARM
      almact: AK_ALM_ATSK
      counter: COUNTER2
      astat: AK_SET
      almval: 0
      cycle: 0
      task: TASK2
    COUNTER1:
      type: COUNTER
      ctype: AK_SOFTWARE
      mincyc: ANY_MINCYC_A
      maxval: ANY_MAXVAL_A
      curval: ANY_MAXVAL_A
      cstat: AK_CS_NULL
    COUNTER2:
      type: COUNTER
      ctype: AK_SOFTWARE
      mincyc: ANY_MINCYC_A
      maxval: ANY_MAXVAL_A
      curval: ANY_MAXVAL_A
      cstat: AK_CS_NULL

  do:
    id: C2ISR1
    syssrv: IncrementCounter(COUNTER1)
    rettype: StatusType
    retval: E_OK

  post_condition:
    TASK1:
      tstat: RUNNING
    TASK2:
      tstat: READY
      curpri: TSK_PRI_LOW
      actcnt: 1
    COUNTER1:
      curval: 0
    COUNTER2:
      curval: 0
    ALARM1:
      astat: AK_UNSET
    ALARM2:
      astat: AK_UNSET
    C2ISR1:
      rtnstat: AK_STOP
