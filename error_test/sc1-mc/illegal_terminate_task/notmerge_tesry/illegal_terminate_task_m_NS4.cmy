        - AK_SUS_OS_INT: SPINLOCK1
      coreid: CORE_SELF
    POSTTASK_HOOK1:
      type: POSTTASK_HOOK
      hookstat: AK_STOP
      coreid: CORE_SELF

  do_0:
    id: TASK1
    syssrv: return

  post_condition_0:
    POSTTASK_HOOK1:
      hookstat: AK_ACTIVATE
    TASK1:
      getspn:
    INT_STATE1:
      istat:
    SPINLOCK1:
      lockflg: AK_UNLOCK

  do_1:
    id: POSTTASK_HOOK1
    syssrv: return

  post_condition_1:
    POSTTASK_HOOK1:
      hookstat: AK_STOP
    TASK1:
      tstat: SUSPENDED
    TASK2:
      tstat: RUNNING
