illegal_terminate_task_NS2_0001:
  property:
    sc: 
      - SC3
      - SC4

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      spolicy: AK_SCHNON
      ttype: AK_BASIC
      relres:
        - RESOURCE2
      getres:
        - RESOURCE3
        - RESOURCE4
      osap: NON_TRUSTED_OSAP1
    TASK2:
      type: TASK
      tstat: READY
      curpri: TSK_PRI_HIGH
      spolicy: AK_SCHFULL
      ttype: ANY_TTYPE
      osap: NON_TRUSTED_OSAP1
    RESOURCE2:
      type: RESOURCE
      resprop: AK_STANDARD
      lockflg: AK_UNLOCK
      accosap:
        - NON_TRUSTED_OSAP1
    RESOURCE3:
      type: RESOURCE
      resprop: AK_LINKED
      lockflg: AK_LOCK
      linkres: RESOURCE2
    RESOURCE4:
      type: RESOURCE
      resprop: AK_LINKED
      lockflg: AK_LOCK
      linkres: RESOURCE2
    ERROR_HOOK1:
      type: ERROR_HOOK
      hookstat: AK_STOP

  do_0:
    id: TASK1
    syssrv: return

  post_condition_0:
    ERROR_HOOK1:
      hookstat: AK_ACTIVATE
    TASK1:
      getres:
    RESOURCE3:
      lockflg: AK_UNLOCK
    RESOURCE4:
      lockflg: AK_UNLOCK

  do_1:
