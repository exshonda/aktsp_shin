######################################################################
illegal_terminate_task_NS2_0236:
  property:
    sc: 
      - SC3
      - SC4

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      inipri: TSK_PRI_MID
      curpri: TSK_PRI_HIGH
      spolicy: AK_SCHFULL
      ttype: AK_BASIC
      relres:
        - RESOURCE1
        - RESOURCE2
        - RESOURCE3
      getres:
        - RESOURCE1
        - RESOURCE2
        - RESOURCE3
      osap: TRUSTED_OSAP1
    TASK2:
      type: TASK
      tstat: READY
      curpri: TSK_PRI_HIGH
      spolicy: AK_SCHFULL
      ttype: ANY_TTYPE
      relres:
        - RESOURCE1
      osap: TRUSTED_OSAP1
    RESOURCE1:
      type: RESOURCE
      resprop: AK_INTERNAL
      lockflg: AK_LOCK
    RESOURCE2:
      type: RESOURCE
      resprop: AK_STANDARD
      lockflg: AK_LOCK
    RESOURCE3:
      type: RESOURCE
      resprop: AK_STANDARD
      lockflg: AK_LOCK
    ERROR_HOOK1:
      type: ERROR_HOOK
      hookstat: AK_STOP

  do_0:
    id: TASK1
    syssrv: return

  post_condition_0:
    ERROR_HOOK1:
      hookstat: AK_ACTIVATE
    TASK1:
      getres:
        - RESOURCE1
    RESOURCE2:
      lockflg: AK_UNLOCK
    RESOURCE3:
      lockflg: AK_UNLOCK

  do_1:
    id: ERROR_HOOK1
    syssrv: CheckAssert(Error == E_OS_MISSINGEND)

  post_condition_1:

  do_2:
    id: ERROR_HOOK1
    syssrv: CheckAssert(OSErrorGetServiceId() == OSServiceId_TaskMissingEnd)

