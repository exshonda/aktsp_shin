illegal_terminate_task_NS7_1120:
  property:
    sc: 
      - SC3
      - SC4

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      inipri: TSK_PRI_MID
      curpri: TSK_PRI_MID
      maxact: ANY_ACTCNT_NOT_MAX_1
      actcnt: ANY_ACTCNT_NOT_MAX_1
      bootcnt: 0
      spolicy: AK_SCHFULL
      ttype: AK_BASIC
      relres:
        - RESOURCE1
      getres:
        - RESOURCE1
      osap: TRUSTED_OSAP1
    TASK2:
      type: TASK
      tstat: READY
      curpri: TSK_PRI_MID
      spolicy: AK_SCHFULL
      ttype: ANY_TTYPE
      relres:
        - RESOURCE1
      osap: TRUSTED_OSAP1
    RESOURCE1:
      type: RESOURCE
      resprop: AK_INTERNAL
      lockflg: AK_LOCK
    ERROR_HOOK1:
      type: ERROR_HOOK
      hookstat: AK_STOP
    POSTTASK_HOOK1:
      type: POSTTASK_HOOK
      hookstat: AK_STOP
    INT_STATE1:
      type: INT_STATE
      istat:
        - AK_SUS_ALL_INT: TASK1
        - AK_SUS_ALL_INT: TASK1

  do_0:
    id: TASK1
    syssrv: return

  post_condition_0:
    ERROR_HOOK1:
      hookstat: AK_ACTIVATE
    INT_STATE1:
      istat:

  do_1:
    id: ERROR_HOOK1
    syssrv: CheckAssert(Error == E_OS_MISSINGEND)

  post_condition_1:

  do_2:
    id: ERROR_HOOK1
    syssrv: CheckAssert(OSErrorGetServiceId() == OSServiceId_TaskMissingEnd)

  post_condition_2:
    ERROR_HOOK1:
      hookstat: AK_STOP
    POSTTASK_HOOK1:
      hookstat: AK_ACTIVATE
    TASK1:
      actcnt: ANY_ACTCNT_NOT_MAX_1-1

  do_3:
    id: POSTTASK_HOOK1
    syssrv: return

  post_condition_3:
    POSTTASK_HOOK1:
      hookstat: AK_STOP
    TASK1:
      tstat: READY
      actcnt: ANY_ACTCNT_NOT_MAX_1-1
      bootcnt: 1
      getres:
    TASK2:
      tstat: RUNNING
      getres:
        - RESOURCE1
