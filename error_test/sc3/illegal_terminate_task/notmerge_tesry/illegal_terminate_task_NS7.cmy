illegal_terminate_task_NS7_0605:
  property:
    sc: 
      - SC3
      - SC4

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      maxact: ANY_BASIC_MAXACT
      actcnt: ANY_BASIC_MAXACT
      bootcnt: 0
      spolicy: AK_SCHFULL
      ttype: AK_BASIC
      relres:
        - RESOURCE2
      getres:
        - RESOURCE3
      osap: NON_TRUSTED_OSAP1
    TASK2:
      type: TASK
      tstat: READY
      curpri: TSK_PRI_LOW
      spolicy: AK_SCHFULL
      ttype: ANY_TTYPE
      osap: NON_TRUSTED_OSAP1
    RESOURCE2:
      type: RESOURCE
      resprop: AK_STANDARD
      lockflg: AK_UNLOCK
      accosap:
        - NON_TRUSTED_OSAP1
    RESOURCE3:
      type: RESOURCE
      resprop: AK_LINKED
      lockflg: AK_LOCK
      linkres: RESOURCE2
    ERROR_HOOK1:
      type: ERROR_HOOK
      hookstat: AK_STOP
    POSTTASK_HOOK1:
      type: POSTTASK_HOOK
      hookstat: AK_STOP

  do_0:
    id: TASK1
    syssrv: return

  post_condition_0:
    ERROR_HOOK1:
      hookstat: AK_ACTIVATE
    TASK1:
      getres:
    RESOURCE3:
      lockflg: AK_UNLOCK

  do_1:
    id: ERROR_HOOK1
    syssrv: CheckAssert(Error == E_OS_MISSINGEND)

  post_condition_1:

  do_2:
    id: ERROR_HOOK1
    syssrv: CheckAssert(OSErrorGetServiceId() == OSServiceId_TaskMissingEnd)

  post_condition_2:
    ERROR_HOOK1:
      hookstat: AK_STOP
    POSTTASK_HOOK1:
      hookstat: AK_ACTIVATE
    TASK1:
      actcnt: ANY_BASIC_MAXACT-1

  do_3:
    id: POSTTASK_HOOK1
    syssrv: return

  post_condition_3:
    POSTTASK_HOOK1:
      hookstat: AK_STOP
    TASK1:
      tstat: RUNNING
      actcnt: ANY_BASIC_MAXACT-1
      bootcnt: 1
      getres:
    TASK2:
      tstat: READY
