illegal_terminate_task_NS7_1660:
  property:
    sc: 
      - SC3
      - SC4

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      spolicy: AK_SCHFULL
      ttype: AK_EXTENDED
      osap: TRUSTED_OSAP1
    TASK2:
      type: TASK
      tstat: READY
      curpri: TSK_PRI_MID
      spolicy: AK_SCHFULL
      ttype: ANY_TTYPE
      osap: TRUSTED_OSAP1
    ERROR_HOOK1:
      type: ERROR_HOOK
      hookstat: AK_STOP
    POSTTASK_HOOK1:
      type: POSTTASK_HOOK
      hookstat: AK_STOP

  do_0:
    id: TASK1
    syssrv: return

  post_condition_0:
    ERROR_HOOK1:
      hookstat: AK_ACTIVATE

  do_1:
