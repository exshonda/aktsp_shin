illegal_terminate_task_m_NS2_0599:
  property:
    sc: 
      - SC3
      - SC4

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      bootcnt: 0
      spolicy: AK_SCHNON
      ttype: AK_EXTENDED
      relres:
        - RESOURCE2
      getres:
        - RESOURCE2
      getspn:
        - SPINLOCK1
      osap: TR_OSAP_SELF_CORE
    TASK2:
      type: TASK
      tstat: READY
      curpri: TSK_PRI_HIGH
      spolicy: AK_SCHNON
      ttype: ANY_TTYPE
      osap: NT_OSAP_SELF_CORE
    RESOURCE2:
      type: RESOURCE
      resprop: AK_STANDARD
      lockflg: AK_LOCK
      accosap:
        - NT_OSAP_SELF_CORE
    SPINLOCK1:
      type: SPINLOCK
      susint: AK_SUS_OS_SPN
      lockflg: AK_LOCK
      accosap:
        - NT_OSAP_SELF_CORE
        - TR_OSAP_OTHER_OTHER_CORE
    INT_STATE1:
      type: INT_STATE
      istat:
        - AK_SUS_OS_INT: SPINLOCK1
      coreid: CORE_SELF
    ERROR_HOOK1:
      type: ERROR_HOOK
      hookstat: AK_STOP
      coreid: CORE_SELF

  do_0:
    id: TASK1
    syssrv: return

  post_condition_0:
    ERROR_HOOK1:
      hookstat: AK_ACTIVATE
    TASK1:
      getres:
      getspn:
    INT_STATE1:
      istat:
    RESOURCE2:
      lockflg: AK_UNLOCK
    SPINLOCK1:
      lockflg: AK_UNLOCK

  do_1:
    id: ERROR_HOOK1
    syssrv: CheckAssert(Error == E_OS_MISSINGEND)

  post_condition_1:

  do_2:
    id: ERROR_HOOK1
    syssrv: CheckAssert(OSErrorGetServiceId()==OSServiceId_TaskMissingEnd)

  post_condition_2:
    ERROR_HOOK1:
      hookstat: AK_STOP
    TASK1:
      tstat: SUSPENDED
    TASK2:
      tstat: RUNNING
