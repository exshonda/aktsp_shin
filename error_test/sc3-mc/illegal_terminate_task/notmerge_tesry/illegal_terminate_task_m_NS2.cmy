      tstat: RUNNING
      curpri: TSK_PRI_MID
      bootcnt: 0
      maxact: ANY_BASIC_MAXACT
      actcnt: ANY_BASIC_MAXACT
      spolicy: AK_SCHFULL
      ttype: AK_BASIC
      relres:
        - RESOURCE1
      getres:
