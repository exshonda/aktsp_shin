illegal_terminate_task_m_NS2_1713:
  property:
    sc: 
      - SC3
      - SC4

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      bootcnt: 0
      maxact: ANY_BASIC_MAXACT
      actcnt: ANY_BASIC_MAXACT
      spolicy: AK_SCHFULL
      ttype: AK_BASIC
      relres:
        - RESOURCE1
      getres:
        - RESOURCE1
      getspn:
        - SPINLOCK1
      osap: TR_OSAP_SELF_CORE
    TASK2:
      type: TASK
      tstat: READY
      curpri: TSK_PRI_MID
      spolicy: AK_SCHFULL
      ttype: ANY_TTYPE
      relres:
        - RESOURCE1
      osap: NT_OSAP_SELF_CORE
    RESOURCE1:
      type: RESOURCE
      resprop: AK_INTERNAL
      lockflg: AK_LOCK
      accosap:
        - NT_OSAP_SELF_CORE
    SPINLOCK1:
      type: SPINLOCK
      susint: AK_SUS_ALL_SPN
      lockflg: AK_LOCK
      accosap:
        - NT_OSAP_SELF_CORE
        - TR_OSAP_OTHER_OTHER_CORE
    INT_STATE1:
      type: INT_STATE
      istat:
        - AK_SUS_ALL_INT: TASK1
        - AK_SUS_ALL_INT: SPINLOCK1
      coreid: CORE_SELF
    ERROR_HOOK1:
      type: ERROR_HOOK
      hookstat: AK_STOP
      coreid: CORE_SELF

  do_0:
    id: TASK1
    syssrv: return

  post_condition_0:
    ERROR_HOOK1:
      hookstat: AK_ACTIVATE
    TASK1:
      getres:
        - RESOURCE1
      getspn:
    INT_STATE1:
      istat:
    SPINLOCK1:
      lockflg: AK_UNLOCK

  do_1:
    id: ERROR_HOOK1
    syssrv: CheckAssert(Error == E_OS_MISSINGEND)

  post_condition_1:

  do_2:
    id: ERROR_HOOK1
    syssrv: CheckAssert(OSErrorGetServiceId()==OSServiceId_TaskMissingEnd)

  post_condition_2:
    ERROR_HOOK1:
      hookstat: AK_STOP
    TASK1:
      tstat: READY
      actcnt: ANY_BASIC_MAXACT-1
      bootcnt: 1
      getres:
    TASK2:
      tstat: RUNNING
      getres:
        - RESOURCE1
