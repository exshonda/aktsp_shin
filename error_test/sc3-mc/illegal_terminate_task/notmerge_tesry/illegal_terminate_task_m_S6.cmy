######################################################################
# illegal_terminate_task_m_S6_0001.yaml
######################################################################
illegal_terminate_task_m_S6_0001:
  property:
    need_stack_share: true
    sc: 
      - SC3
      - SC4

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      relres:
        - RESOURCE1
      getres:
        - RESOURCE1
      getspn:
        - SPINLOCK1
      osap: TR_OSAP_SELF_CORE
    RESOURCE1:
      type: RESOURCE
      resprop: AK_STANDARD
      lockflg: AK_LOCK
    SPINLOCK1:
      type: SPINLOCK
      lockflg: AK_LOCK
      accosap:
        - TR_OSAP_SELF_CORE
        - TR_OSAP_OTHER_OTHER_CORE
    ERROR_HOOK1:
      type: ERROR_HOOK
      hookstat: AK_STOP
      coreid: CORE_SELF
    PROTECTION_HOOK1:
      type: PROTECTION_HOOK
      hookstat: AK_STOP
      coreid: CORE_SELF

  do_0:
    id: TASK1
    syssrv: AKTSP_RETURN_IN_STACK_OVERFLOW_M(AKTSP_TASK_STACK_ADDRESS,AKTSP_TASK_STACK_SIZE)

  post_condition_0:
    TASK1:
      getres:
      getspn:
    RESOURCE1:
      lockflg: AK_UNLOCK
    SPINLOCK1:
      lockflg: AK_UNLOCK
    ERROR_HOOK1:
      hookstat: AK_ACTIVATE

  do_1:
    id: ERROR_HOOK1
    syssrv: CheckAssert(Error == E_OS_MISSINGEND)

  post_condition_1:

  do_2:
    id: ERROR_HOOK1
    syssrv: CheckAssert(OSErrorGetServiceId() == OSServiceId_TaskMissingEnd)

  post_condition_2:

  do_3:
    id: ERROR_HOOK1
    syssrv: return

  post_condition_3:
    ERROR_HOOK1:
      hookstat: AK_STOP
    PROTECTION_HOOK1:
      hookstat: AK_ACTIVATE

  do_4:
    id: PROTECTION_HOOK1
    syssrv: return(PRO_SHUTDOWN)
    finish: true

  post_condition_4:
