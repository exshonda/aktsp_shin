######################################################################
# illegal_terminate_c2isr_m_NS2_0001.yaml
######################################################################
illegal_terminate_c2isr_m_NS2_0001:
  property:
    sc: 
      - SC3
      - SC4

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      osap: TR_OSAP_SELF_CORE
    C2ISR1:
      type: C2ISR
      intno: INTNO_SELF_C2ISR_MID_A
      iniintpri: INT_PRI_MID
      rtnstat: AK_ACTIVATE
      relres:
        - RESOURCE1
      getres:
        - RESOURCE1
      getspn:
        - SPINLOCK1
      osap: TR_OSAP_SELF_CORE
    RESOURCE1:
      type: RESOURCE
      resprop: AK_STANDARD
      lockflg: AK_LOCK
    SPINLOCK1:
      type: SPINLOCK
      lockflg: AK_LOCK
      accosap:
        - TR_OSAP_SELF_CORE
        - TR_OSAP_OTHER_OTHER_CORE
    ERROR_HOOK1:
      type: ERROR_HOOK
      hookstat: AK_STOP
      coreid: CORE_SELF

  do_0:
    id: C2ISR1
    syssrv: return

  post_condition_0:
    C2ISR1:
      rtnstat: AK_STOP
      getspn:
    SPINLOCK1:
      lockflg: AK_UNLOCK
    ERROR_HOOK1:
      hookstat: AK_ACTIVATE

  do_1:
    id: ERROR_HOOK1
    syssrv: CheckAssert(Error == E_OS_SPINLOCK)

  post_condition_1:

  do_2:
    id: ERROR_HOOK1
    syssrv: CheckAssert(OSErrorGetServiceId()==OSServiceId_ISRMissingEnd)

  post_condition_2:
    ERROR_HOOK1:
      bootcnt: 1
    C2ISR1:
      getres:
    RESOURCE1:
      lockflg: AK_UNLOCK

  do_3:
    id: ERROR_HOOK1
    syssrv: CheckAssert(Error == E_OS_RESOURCE)

  post_condition_3:
    ERROR_HOOK1:
      hookstat: AK_STOP
