######################################################################
# RaiseInterCoreInterrupt_m_n_2_0001.yaml
######################################################################
RaiseInterCoreInterrupt_m_n_2_0001:
  property:
    sc: 
      - SC1

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      osap: OSAP_SELF_CORE
    C2ISR1:
      type: C2ISR
      rtnstat: AK_ACTIVATE
      intno: INTNO_SELF_C2ISR_MID_A
      iniintpri: INT_PRI_MID
      osap: OSAP_SELF_CORE
    TASK2:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      osap: OSAP_OTHER_OTHER_CORE
    ICISR3:
      type: ICISR
      rtnstat: AK_STOP
      osap: OSAP_OTHER_OTHER_CORE
    ALARM_CBACK1:
      type: ALARM_CBACK
      cbstat: AK_STOP
    ALARM1:
      type: ALARM
      almact: AK_ALM_CBACK
      counter: COUNTER1
      astat: AK_SET
      almval: 1
      cycle: 0
      callback: ALARM_CBACK1
      osap: OSAP_OTHER_OTHER_CORE
    COUNTER1:
      type: COUNTER
      ctype: AK_SOFTWARE
      mincyc: ANY_MINCYC_A
      maxval: ANY_MAXVAL_A
      curval: 0
      cstat: AK_CS_NULL
      osap: OSAP_OTHER_OTHER_CORE
    INT_STATE1:
      type: INT_STATE
      istat:
      coreid: CORE_OTHER

  do_0:
    id: TASK2
    syssrv: IncrementCounter(COUNTER1)
    rettype: StatusType
    retval: E_OK
    gcov: false

  post_condition_0:
    COUNTER1:
      curval: 1
      cstat: AK_CS_DOING
    ALARM1:
      astat: AK_UNSET
    ALARM_CBACK1:
      cbstat: AK_ACTIVATE

  do_1:
    id: ALARM_CBACK1
    syssrv: DisableAllInterrupts()
    gcov: false

  post_condition_1:
    INT_STATE1:
      istat:
        - AK_DIS_ALL_INT: ALARM_CBACK1

  do_2:
    id: C2ISR1
    syssrv: RaiseInterCoreInterrupt(ICISR3)
    rettype: StatusType
    retval: E_OK
    gcov: true

  post_condition_2:

  do_3:
    id: ALARM_CBACK1
    syssrv: EnableAllInterrupts()
    gcov: false

  post_condition_3:
    INT_STATE1:
      istat:

  do_4:
    id: ALARM_CBACK1
    syssrv: return
    gcov: false

  post_condition_4:
    ICISR3:
      rtnstat: AK_ACTIVATE
    ALARM_CBACK1:
      cbstat: AK_STOP
