  property:
    sc: 
      - SC1
      - SC2

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      osap: OSAP_SELF_CORE
    C2ISR1:
      type: C2ISR
      rtnstat: AK_ACTIVATE
      intno: INTNO_SELF_C2ISR_HIGH
      iniintpri: INT_PRI_ICISR+1
