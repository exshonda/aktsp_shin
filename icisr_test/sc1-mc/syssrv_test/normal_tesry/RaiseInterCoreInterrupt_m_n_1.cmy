    ICISR1:
      type: ICISR
      rtnstat: AK_STOP
      osap: OSAP_OTHER_SAME_CORE
    INT_STATE1:
      type: INT_STATE
      istat:
        - AK_DIS_ALL_INT: C2ISR1
      coreid: CORE_SELF

  do_0:
    id: C2ISR1
    syssrv: RaiseInterCoreInterrupt(ICISR1)
    rettype: StatusType
    retval: E_OK
    gcov: true

  post_condition_0:

  do_1:
    id: C2ISR1
    syssrv: EnableAllInterrupts()
    gcov: false

  post_condition_1:
    INT_STATE1:
      istat:

  do_2:
    id: C2ISR1
    syssrv: return
    gcov: false

  post_condition_2:
    ICISR1:
      rtnstat: AK_ACTIVATE
    C2ISR1:
      rtnstat: AK_STOP
