######################################################################
# boot_only_master_core_m_err_1_0001.yaml
######################################################################
boot_only_master_core_m_err_1_0001:
  property:
    sc: 
      - SC1
      - SC2

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      osap: OSAP_SELF_CORE
    C2ISR1:
      type: C2ISR
      intno: INTNO_SELF_C2ISR_MID_A
      iniintpri: INT_PRI_MID
      rtnstat: AK_ACTIVATE
      osap: OSAP_SELF_CORE
    ERROR_HOOK1:
      type: ERROR_HOOK
      hookstat: AK_STOP
      target_error_hook_cfg:
        - AK_ONLY_SYSTEM
        - AK_BOTH
      coreid: CORE_SELF
    ICISR2:
      type: ICISR
      rtnstat: AK_STOP
      osap: OSAP_OTHER_OTHER_CORE

  do_0:
    id: C2ISR1
    syssrv: RaiseInterCoreInterrupt(ICISR2)
    rettype: StatusType
    retval: E_OS_CORE
    gcov: true

  post_condition_0:
    C2ISR1:
      rtnstat: AK_STOP
      target_error_hook_cfg:
        - AK_ONLY_SYSTEM
        - AK_ONLY_OSAP
        - AK_BOTH
    ERROR_HOOK1:
      hookstat: AK_ACTIVATE

  do_1:
    id: ERROR_HOOK1
    syssrv: CheckAssert(Error==E_OS_CORE)
    gcov: false

  post_condition_1:

  do_2:
    id: ERROR_HOOK1
    syssrv: CheckAssert(OSError_RaiseInterCoreInterrupt_ISRID()==ICISR2)
    gcov: false

  post_condition_2:

  do_3:
    id: ERROR_HOOK1
    syssrv: CheckAssert(OSErrorGetServiceId()==OSServiceId_RaiseInterCoreInterrupt)
    gcov: false

  post_condition_3:
