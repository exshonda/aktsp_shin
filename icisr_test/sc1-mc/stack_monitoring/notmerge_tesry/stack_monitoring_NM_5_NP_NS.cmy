######################################################################
# stack_monitoring_NM_5_NP_NS_0001.yaml
######################################################################
stack_monitoring_NM_5_NP_NS_0001:
  property:
    need_stack_share: true
    sc: 
      - SC1
      - SC2

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      osap: OSAP_SELF_CORE
    C2ISR1:
      type: C2ISR
      intno: INTNO_SELF_C2ISR_HIGH
      iniintpri: INT_PRI_HIGH
      rtnstat: AK_STOP
      osap: OSAP_SELF_CORE
    ICISR1:
      type: ICISR
      rtnstat: AK_ACTIVATE
      var:
        vname1:
          type: AktspStackOverflowInfo
          stk_mode: AK_SMM_MAGIC_NUMBER
          stk_intno: INTNO_SELF_C2ISR_HIGH
      osap: OSAP_SELF_CORE

  do:
    id: ICISR1
    syssrv: AktspRaiseIsrStackOverflowByInterrupt(AKTSP_OS_STACK_ADDRESS,AKTSP_OS_STACK_SIZE,&vname1)
    finish: true

  post_condition:
######################################################################
# stack_monitoring_NM_5_NP_NS_0002.yaml
######################################################################
stack_monitoring_NM_5_NP_NS_0002:
  property:
    need_stack_share: true
    sc: 
      - SC1
      - SC2

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      osap: OSAP_SELF_CORE
    C2ISR1:
      type: C2ISR
      intno: INTNO_SELF_C2ISR_HIGH
      iniintpri: INT_PRI_HIGH
      rtnstat: AK_STOP
      osap: OSAP_SELF_CORE
    ICISR1:
      type: ICISR
      rtnstat: AK_ACTIVATE
      var:
        vname1:
          type: AktspStackOverflowInfo
          stk_mode: AK_SMM_CHECK_REMAIN
          stk_intno: INTNO_SELF_C2ISR_HIGH
      osap: OSAP_SELF_CORE

  do:
    id: ICISR1
    syssrv: AktspRaiseIsrStackOverflowByInterrupt(AKTSP_OS_STACK_ADDRESS,AKTSP_OS_STACK_SIZE,&vname1)
    finish: true

  post_condition:
######################################################################
