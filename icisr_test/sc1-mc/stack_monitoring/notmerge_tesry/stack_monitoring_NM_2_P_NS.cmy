######################################################################
# stack_monitoring_NM_2_P_NS_0001.yaml
######################################################################
stack_monitoring_NM_2_P_NS_0001:
  property:
    need_stack_share: true
    sc: 
      - SC1
      - SC2

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      osap: OSAP_SELF_CORE
    TASK2:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      osap: OSAP_OTHER_OTHER_CORE
    ICISR1:
      type: ICISR
      rtnstat: AK_STOP
      osap: OSAP_SELF_CORE
    PROTECTION_HOOK1:
      type: PROTECTION_HOOK
      hookstat: AK_STOP
      coreid: CORE_SELF

  do_0:
    id: TASK1
    syssrv: AKTSP_SET_STACK_OVERFLOW_M(AKTSP_TASK_STACK_ADDRESS,AKTSP_TASK_STACK_SIZE)

  post_condition_0:

  do_1:
    id: TASK2
    syssrv: RaiseInterCoreInterrupt(ICISR1)
    rettype: StatusType
    retval: E_OK

  post_condition_1:
    TASK1:
      tstat: AK_RUNNING_WAITICISR
    TASK2:
      tstat: AK_RUNNING_WAITICISR
    PROTECTION_HOOK1:
      hookstat: AK_ACTIVATE

  do_2:
    id: PROTECTION_HOOK1
    syssrv: CheckAssert(FatalError == E_OS_STACKFAULT)

  post_condition_2:

  do_3:
    id: PROTECTION_HOOK1
    syssrv: return(PRO_IGNORE)
    finish: true

  post_condition_3:
