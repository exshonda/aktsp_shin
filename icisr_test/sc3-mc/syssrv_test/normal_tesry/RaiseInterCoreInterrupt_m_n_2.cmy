RaiseInterCoreInterrupt_m_n_2_0373:
  property:
    sc: 
      - SC3
      - SC4
    need_enadis_interrupt_source: true

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      osap: NT_OSAP_SELF_CORE
    TASK2:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      osap: TR_OSAP_OTHER_OTHER_CORE
    C2ISR2:
      type: C2ISR
      rtnstat: AK_ACTIVATE
      intno: INTNO_OTHER_ISR2_B
      iniintpri: INT_PRI_ICISR+1
      osap: TR_OSAP_OTHER_OTHER_CORE
    ICISR3:
      type: ICISR
      rtnstat: AK_STOP
      istat: AK_DISABLE
      accosap:
        - NT_OSAP_SELF_CORE
      osap: TR_OSAP_OTHER_OTHER_CORE

  do_0:
    id: TASK1
    syssrv: RaiseInterCoreInterrupt(ICISR3)
    rettype: StatusType
    retval: E_OK
    gcov: true

  post_condition_0:

  do_1:
    id: C2ISR2
    syssrv: EnableInterruptSource(ICISR3)
    rettype: StatusType
    retval: E_OK
    gcov: false

  post_condition_1:
    ICISR3:
      istat: AK_ENABLE

  do_2:
    id: C2ISR2
    syssrv: return
    gcov: false

  post_condition_2:
    ICISR3:
      rtnstat: AK_ACTIVATE
    C2ISR2:
      rtnstat: AK_STOP
