        - TR_OSAP_OTHER_OTHER_CORE

  do_0:
    id: TASK1
    syssrv: RaiseInterCoreInterrupt(ICISR2)
    rettype: StatusType
    retval: E_OK
    gcov: true

  post_condition_0:

  do_1:
    id: TASK1
    syssrv: RaiseInterCoreInterrupt(ICISR2)
    rettype: StatusType
    retval: E_OK
    gcov: false

  post_condition_1:

  do_2:
    id: TASK2
    syssrv: ReleaseSpinlock(SPINLOCK1)
    rettype: StatusType
    retval: E_OK
    gcov: false

  post_condition_2:
    ICISR2:
      rtnstat: AK_ACTIVATE
    TASK2:
      getspn:
    INT_STATE1:
      istat:
    SPINLOCK1:
      lockflg: AK_UNLOCK

  do_3:
    id: ICISR2
    syssrv: return
    gcov: false

  post_condition_3:
    ICISR2:
      rtnstat: AK_STOP
######################################################################
