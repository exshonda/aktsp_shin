######################################################################
# stack_monitoring_NM_2_NP_NS_0001.yaml
######################################################################
stack_monitoring_NM_2_NP_NS_0001:
  property:
    need_stack_share: true
    sc: 
      - SC3
      - SC4

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      osap: NT_OSAP_OTHER_OTHER_CORE
      var:
        local:
          type: AktspTfParam
    TASK2:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      osap: TR_OSAP_SELF_CORE
    ICISR1:
      type: ICISR
      rtnstat: AK_STOP
      osap: TR_OSAP_OTHER_OTHER_CORE
    TRUSTED_FUNCTION1:
      type: TRUSTED_FUNCTION
      caller: TASK1
      arg: local
      osap: TR_OSAP_OTHER_OTHER_CORE_2

  do_0:
    id: TRUSTED_FUNCTION1
    syssrv: AKTSP_SET_STACK_OVERFLOW_M(AKTSP_TASK_SYSTEM_STACK_ADDRESS_CORE_1,AKTSP_TASK_STACK_SIZE)

  post_condition_0:

  do_1:
    id: TASK2
    syssrv: RaiseInterCoreInterrupt(ICISR1)
    rettype: StatusType
    retval: E_OK
    finish: true

  post_condition_1:
