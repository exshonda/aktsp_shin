######################################################################
# stack_monitoring_NM_3_NP_NS_0001.yaml
######################################################################
stack_monitoring_NM_3_NP_NS_0001:
  property:
    need_stack_share: true
    sc: 
      - SC3
      - SC4

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      osap: TR_OSAP_SELF_CORE
    C2ISR1:
      type: C2ISR
      intno: INTNO_SELF_C2ISR_LOW
      iniintpri: INT_PRI_LOW
      rtnstat: AK_ACTIVATE
      var:
        vname1:
          type: AktspStackOverflowInfo
          stk_mode: AK_SMM_MAGIC_NUMBER
          stk_isrid: ICISR1
      osap: TR_OSAP_SELF_CORE
    ICISR1:
      type: ICISR
      rtnstat: AK_STOP
      osap: TR_OSAP_SELF_CORE

  do:
    id: C2ISR1
    syssrv: AktspRaiseIsrStackOverflowByIcIsr(AKTSP_OS_STACK_ADDRESS,AKTSP_OS_STACK_SIZE,&vname1)
    finish: true

  post_condition:
######################################################################
