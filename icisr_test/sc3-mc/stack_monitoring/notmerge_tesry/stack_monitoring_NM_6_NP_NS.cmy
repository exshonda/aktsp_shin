######################################################################
# stack_monitoring_NM_6_NP_NS_0001.yaml
######################################################################
stack_monitoring_NM_6_NP_NS_0001:
  property:
    need_stack_share: true
    sc: 
      - SC3
      - SC4

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      osap: TR_OSAP_SELF_CORE
    ICISR1:
      type: ICISR
      rtnstat: AK_ACTIVATE
      osap: TR_OSAP_SELF_CORE

  do_0:
    id: ICISR1
    syssrv: AktspRaiseIsrStackOverflowByReturn(AKTSP_OS_STACK_ADDRESS,AKTSP_OS_STACK_SIZE)

  post_condition_0:

  do_1:
    id: ICISR1
    syssrv: return
    finish: true

  post_condition_1:
######################################################################
# stack_monitoring_NM_6_NP_NS_0002.yaml
######################################################################
stack_monitoring_NM_6_NP_NS_0002:
  property:
    need_stack_share: true
    sc: 
      - SC3
      - SC4

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      osap: TR_OSAP_SELF_CORE
    C2ISR1:
      type: C2ISR
      intno: INTNO_SELF_C2ISR_LOW
      iniintpri: INT_PRI_LOW
      rtnstat: AK_ACTIVATE
      osap: TR_OSAP_SELF_CORE
    ICISR1:
      type: ICISR
      rtnstat: AK_STOP
      osap: TR_OSAP_SELF_CORE

  do_0:
    id: C2ISR1
    syssrv: RaiseInterCoreInterrupt(ICISR1)
    rettype: StatusType
    retval: E_OK

  post_condition_0:
    C2ISR1:
      rtnstat: AK_STOP
    ICISR1:
      rtnstat: AK_ACTIVATE

  do_1:
    id: ICISR1
    syssrv: AktspRaiseIsrStackOverflowByReturn(AKTSP_OS_STACK_ADDRESS,AKTSP_OS_STACK_SIZE)

  post_condition_1:

  do_2:
    id: ICISR1
    syssrv: return
    finish: true

  post_condition_2:
######################################################################
