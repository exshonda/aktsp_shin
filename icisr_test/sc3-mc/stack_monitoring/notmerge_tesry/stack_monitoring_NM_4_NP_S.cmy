      osap: TR_OSAP_SELF_CORE
      var:
        local:
          type: AktspTfParam
    ICISR1:
      type: ICISR
      rtnstat: AK_STOP
      osap: TR_OSAP_SELF_CORE
    TRUSTED_FUNCTION1:
      type: TRUSTED_FUNCTION
      caller: C2ISR1
      arg: local
      osap: TR_OSAP_SELF_CORE_2
    SHUTDOWN_HOOK1:
      type: SHUTDOWN_HOOK
      hookstat: AK_STOP
      coreid: CORE_SELF
    SHUTDOWN_HOOK2:
      type: SHUTDOWN_HOOK
