######################################################################
# stack_monitoring_NM_4_NP_S_0001.yaml
######################################################################
stack_monitoring_NM_4_NP_S_0001:
  property:
    need_stack_share: true
    sc: 
      - SC3
      - SC4

  pre_condition:
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      osap: TR_OSAP_SELF_CORE
    TASK2:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      osap: TR_OSAP_OTHER_OTHER_CORE
    C2ISR1:
      type: C2ISR
      intno: INTNO_SELF_C2ISR_LOW
      iniintpri: INT_PRI_LOW
      rtnstat: AK_ACTIVATE
      osap: TR_OSAP_SELF_CORE
    ICISR1:
      type: ICISR
      rtnstat: AK_STOP
      osap: TR_OSAP_SELF_CORE
    SHUTDOWN_HOOK1:
      type: SHUTDOWN_HOOK
      hookstat: AK_STOP
      coreid: CORE_SELF
    SHUTDOWN_HOOK2:
      type: SHUTDOWN_HOOK
      hookstat: AK_STOP
      coreid: CORE_OTHER

  do_0:
    id: C2ISR1
    syssrv: AKTSP_SET_STACK_OVERFLOW_M(AKTSP_OS_STACK_ADDRESS,AKTSP_OS_STACK_SIZE)

  post_condition_0:

  do_1:
    id: TASK2
    syssrv: RaiseInterCoreInterrupt(ICISR1)
    rettype: StatusType
    retval: E_OK

  post_condition_1:
    C2ISR1:
      rtnstat: AK_ACTIVATE_WAITICISR
    TASK1:
      tstat: AK_RUNNING_WAITICISR
    TASK2:
      tstat: AK_RUNNING_WAITICISR
    SHUTDOWN_HOOK1:
      hookstat: AK_ACTIVATE
    SHUTDOWN_HOOK2:
      hookstat: AK_ACTIVATE

  do_2:
    id: SHUTDOWN_HOOK1
    syssrv: CheckAssert(Error == E_OS_STACKFAULT)

  post_condition_2:
