######################################################################
# stack_monitoring_NM_1_NP_S_0001.yaml
######################################################################
stack_monitoring_NM_1_NP_S_0001:
  property:
    need_stack_share: true
    sc: 
      - SC3
      - SC4

  pre_condition:
    SHUTDOWN_HOOK1:
      type: SHUTDOWN_HOOK
      hookstat: AK_STOP
      coreid: CORE_SELF
    TASK1:
      type: TASK
      tstat: RUNNING
      curpri: TSK_PRI_MID
      osap: NT_OSAP_SELF_CORE
      var:
        local:
          type: AktspTfParam
    ICISR1:
      type: ICISR
      rtnstat: AK_STOP
      osap: TR_OSAP_SELF_CORE
    TRUSTED_FUNCTION1:
      type: TRUSTED_FUNCTION
      caller: TASK1
      arg: local
      osap: TR_OSAP_SELF_CORE_2
      var:
        vname1:
          type: AktspStackOverflowInfo
          stk_mode: AK_SMM_MAGIC_NUMBER
          stk_isrid: ICISR1

  do_0:
    id: TRUSTED_FUNCTION1
    syssrv: AktspRaiseTaskStackOverflowByIcIsr(AKTSP_TASK_SYSTEM_STACK_ADDRESS,AKTSP_TASK_STACK_SIZE,&vname1)

  post_condition_0:
    SHUTDOWN_HOOK1:
      hookstat: AK_ACTIVATE

  do_1:
    id: SHUTDOWN_HOOK1
    syssrv: CheckAssert(Error == E_OS_STACKFAULT)

  post_condition_1:
